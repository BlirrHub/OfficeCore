<Window x:Class="OfficeCore.DesktopClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:OfficeCore.DesktopClient"
        mc:Ignorable="d"
        Title="OfficeCore" Height="720" Width="1280" Background="#F3F4F6" WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- The WebView, hidden by default until connected -->
        <wv2:WebView2 x:Name="webView" Visibility="Collapsed" />

        <!-- The Input Panel, centered on screen -->
        <Border x:Name="InputPanel" VerticalAlignment="Center" HorizontalAlignment="Center" 
                Background="White" Padding="40" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="20" ShadowDepth="4"/>
            </Border.Effect>
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Connect to OfficeCore" FontSize="24" FontWeight="Bold" Margin="0,0,0,8" Foreground="#111827" HorizontalAlignment="Center"/>
                <TextBlock Text="Enter the local server IP address to continue" FontSize="14" Foreground="#6B7280" Margin="0,0,0,24" HorizontalAlignment="Center"/>
                
                <TextBox x:Name="IpAddressInput" Width="300" Height="40" FontSize="16" Padding="8,6" Margin="0,0,0,16" 
                         BorderBrush="#D1D5DB" BorderThickness="1"/>
                
                <Button x:Name="ConnectButton" Content="Connect" Width="300" Height="40" FontSize="16" 
                        Background="#4F46E5" Foreground="White" BorderThickness="0" Cursor="Hand" Click="ConnectButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
