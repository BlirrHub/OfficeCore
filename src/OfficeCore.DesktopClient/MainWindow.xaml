<Window x:Class="OfficeCore.DesktopClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:OfficeCore.DesktopClient"
        mc:Ignorable="d"
        Title="OfficeCore Hub — On-Premises Enterprise" Height="800" Width="1360" MinHeight="680" MinWidth="960"
        Background="#09090B" WindowStartupLocation="CenterScreen" Foreground="#F4F4F5">

    <Window.Resources>
        <!-- Modern ScrollViewer style for logs -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar Header -->
            <RowDefinition Height="*"/>    <!-- Active View Area -->
        </Grid.RowDefinitions>

        <!-- Top Header Navigation Bar -->
        <Border x:Name="WindowTopHeader" Grid.Row="0" Background="#0C0C0E" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#C026D3" Margin="0,0,12,0">
                        <TextBlock Text="OC" FontWeight="Bold" FontSize="14" Foreground="White" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="OfficeCore" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,8,0"/>
                            <Border Background="#27272A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="DESKTOP HUB" FontSize="10" FontWeight="Bold" Foreground="#A1A1AA"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Internal Enterprise &amp; Accounting System" FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center Active Mode Pill -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border x:Name="ModeBadge" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="12,4" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="ModeBadgeDot" Width="7" Height="7" Fill="#A855F7" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ModeBadgeText" Text="Server Station" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Top Right Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SwitchModeButton" Content="Switch Mode" Click="SwitchModeButton_Click" 
                            Background="#18181B" Foreground="#D4D4D8" BorderBrush="#27272A" BorderThickness="1"
                            Padding="14,6" FontSize="12" FontWeight="Medium" Cursor="Hand" Margin="0,0,10,0" Visibility="Collapsed">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Viewport Container -->
        <Grid Grid.Row="1">

            <!-- ========================================================================= -->
            <!-- 1. MODE SELECTION SCREEN (Choose Server vs Client)                         -->
            <!-- ========================================================================= -->
            <Grid x:Name="ModeSelectPanel" Visibility="Visible" Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,30" TextBlock.TextAlignment="Center">
                    <TextBlock Text="Select Station Deployment Mode" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                    <TextBlock Text="Choose how this workstation will operate within your internal company network." FontSize="14" Foreground="#A1A1AA"/>
                </StackPanel>

                <!-- Cards Grid -->
                <Grid Grid.Row="1" MaxWidth="960" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Server Station -->
                    <Border Grid.Column="0" Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="16" Padding="32">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="30" ShadowDepth="8"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <Border Background="#701A75" Width="52" Height="52" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,20">
                                    <TextBlock Text="🖥️" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="#3B0764" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <TextBlock Text="HOST &amp; DATABASE" FontSize="11" FontWeight="Bold" Foreground="#E879F9"/>
                                </Border>
                                <TextBlock Text="Setup as Server Station" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                <TextBlock Text="This computer will host the PostgreSQL database, run the OfficeCore server, and allow other client workstations on your office network (LAN/Wi-Fi) to connect." 
                                           TextWrapping="Wrap" FontSize="13" Foreground="#A1A1AA" LineHeight="20" Margin="0,0,0,20"/>

                                <StackPanel Margin="0,0,0,24">
                                    <TextBlock Text="✓ Runs PostgreSQL and API server" FontSize="13" Foreground="#34D399" Margin="0,0,0,6"/>
                                    <TextBlock Text="✓ Broadcasts local network URL to terminals" FontSize="13" Foreground="#34D399" Margin="0,0,0,6"/>
                                    <TextBlock Text="✓ Can still be used as an active terminal locally" FontSize="13" Foreground="#34D399"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Row="1" Content="Setup as Server Station" Click="SelectServerMode_Click" Height="44" 
                                    Background="#C026D3" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Card 2: Client Terminal -->
                    <Border Grid.Column="2" Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="16" Padding="32">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="30" ShadowDepth="8"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <Border Background="#1E1B4B" Width="52" Height="52" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,20">
                                    <TextBlock Text="💻" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="#172554" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <TextBlock Text="WORKSTATION TERMINAL" FontSize="11" FontWeight="Bold" Foreground="#60A5FA"/>
                                </Border>
                                <TextBlock Text="Connect as Client Terminal" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                <TextBlock Text="Connect this workstation to an existing OfficeCore server running on your office network. No database or backend setup required on this PC." 
                                           TextWrapping="Wrap" FontSize="13" Foreground="#A1A1AA" LineHeight="20" Margin="0,0,0,20"/>

                                <StackPanel Margin="0,0,0,24">
                                    <TextBlock Text="✓ Connects via Server IP address" FontSize="13" Foreground="#34D399" Margin="0,0,0,6"/>
                                    <TextBlock Text="✓ Zero local database maintenance" FontSize="13" Foreground="#34D399" Margin="0,0,0,6"/>
                                    <TextBlock Text="✓ Lightweight and fast workstation client" FontSize="13" Foreground="#34D399"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Row="1" Content="Connect as Client Terminal" Click="SelectClientMode_Click" Height="44" 
                                    Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Footer Remember Option -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,24,0,10">
                    <CheckBox x:Name="RememberChoiceCheckBox" Content="Remember my choice and skip this screen on startup" 
                              Foreground="#71717A" FontSize="13" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- ========================================================================= -->
            <!-- 2. SERVER STATION DASHBOARD (Host Panel)                                  -->
            <!-- ========================================================================= -->
            <Grid x:Name="ServerDashboardPanel" Visibility="Collapsed" Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Controls, LAN URL, and DB Config -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Server Status & Action Banner -->
                        <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Server Status:" FontSize="14" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,8,0"/>
                                        <Border x:Name="ServerStatusPill" Background="#27272A" CornerRadius="6" Padding="8,3">
                                            <TextBlock x:Name="ServerStatusText" Text="STOPPED" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Action Buttons -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="StartServerButton" Grid.Column="0" Content="▶ Start Server" Click="StartServer_Click" 
                                            Height="38" Background="#059669" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button x:Name="StopServerButton" Grid.Column="2" Content="⏹ Stop Server" Click="StopServer_Click" 
                                            Height="38" Background="#DC2626" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand" IsEnabled="False">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>

                                <Button x:Name="LaunchLocalAppButton" Content="🚀 Launch OfficeCore Locally" Click="LaunchLocalApp_Click" 
                                        Height="44" Background="#C026D3" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Local Network Sharing Card -->
                        <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Local Network Access (LAN)" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                                <TextBlock Text="Other computers on your office network can connect using this address:" 
                                           TextWrapping="Wrap" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,12"/>

                                <Border Background="#09090B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                    <Grid>
                                        <TextBlock x:Name="LanUrlTextBlock" Text="http://127.0.0.1:5026" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        <Button Content="Copy" Click="CopyLanUrl_Click" HorizontalAlignment="Right" Padding="10,4" FontSize="11" Background="#27272A" Foreground="White" BorderThickness="0" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </Border>
                                <TextBlock Text="💡 Hint: Port 5026 serves both the API &amp; Web app seamlessly." FontSize="11" Foreground="#71717A"/>
                            </StackPanel>
                        </Border>

                        <!-- PostgreSQL Database Configuration Card -->
                        <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="14" Padding="20">
                            <StackPanel>
                                <TextBlock Text="PostgreSQL Database Connection" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                                <TextBlock Text="Configure local database credentials:" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Host" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                                        <TextBox x:Name="DbHostInput" Style="{StaticResource ModernTextBox}" Text="localhost"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Port" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                                        <TextBox x:Name="DbPortInput" Style="{StaticResource ModernTextBox}" Text="5432"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Database Name" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                                    <TextBox x:Name="DbNameInput" Style="{StaticResource ModernTextBox}" Text="OfficeCoreDb"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Username" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                                        <TextBox x:Name="DbUserInput" Style="{StaticResource ModernTextBox}" Text="postgres"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Password" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                                        <PasswordBox x:Name="DbPasswordInput" Style="{StaticResource ModernPasswordBox}" Password="password"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="Test Connection" Click="TestDbConnection_Click" 
                                            Height="34" Background="#27272A" Foreground="White" FontSize="12" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Grid.Column="2" Content="Save Settings" Click="SaveDbSettings_Click" 
                                            Height="34" Background="#3F3F46" Foreground="White" FontSize="12" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                                
                                <TextBlock x:Name="DbStatusFeedback" Text="" FontSize="11" Margin="0,10,0,0" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right Column: Live Server Console Logs -->
                <Border Grid.Column="2" Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="14" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Live Server Console Logs" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,10,0"/>
                                <TextBlock Text="(stdout / stderr)" FontSize="12" Foreground="#71717A" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Content="Clear Logs" Click="ClearLogs_Click" HorizontalAlignment="Right" 
                                    Padding="10,4" FontSize="11" Background="#27272A" Foreground="#A1A1AA" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <Border Grid.Row="1" Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8">
                            <TextBox x:Name="ConsoleLogBox" IsReadOnly="True" TextWrapping="Wrap" 
                                     VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="#A1A1AA" 
                                     FontFamily="Consolas, Courier New" FontSize="12" Padding="12" BorderThickness="0"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- 3. CLIENT TERMINAL CONNECTION SCREEN                                      -->
            <!-- ========================================================================= -->
            <Grid x:Name="ClientConnectPanel" Visibility="Collapsed">
                <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="16" 
                        Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="36">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="40" ShadowDepth="10"/>
                    </Border.Effect>

                    <StackPanel>
                        <Border Background="#172554" Width="48" Height="48" CornerRadius="10" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="🌐" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Connect to OfficeCore Server" FontSize="22" FontWeight="Bold" Foreground="White" 
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Enter the IP address of your primary server station:" FontSize="13" Foreground="#A1A1AA" 
                                   HorizontalAlignment="Center" Margin="0,0,0,24"/>

                        <TextBlock Text="Server Address" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,6"/>
                        <TextBox x:Name="ClientServerUrlInput" Style="{StaticResource ModernTextBox}" Height="40" FontSize="14" 
                                 Text="http://127.0.0.1:5026" Margin="0,0,0,16"/>

                        <Button Content="Connect to Server" Click="ClientConnectButton_Click" Height="44" 
                                Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand" Margin="0,0,0,12">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="Back to Mode Selection" Click="SwitchModeButton_Click" 
                                Background="Transparent" Foreground="#71717A" BorderThickness="0" FontSize="12" Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- 4. WEBVIEW2 CONTAINER (Running Application)                               -->
            <!-- ========================================================================= -->
            <Grid x:Name="WebViewContainer" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Full Sleek Controls Bar (Single Compact Row) -->
                <Border x:Name="WebFullToolbar" Grid.Row="0" Background="#0C0A09" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="12,5">
                    <Grid>
                        <!-- Left: Navigation & Core Tools -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BackToDashboardButton" Content="← Server Dashboard" Click="BackToDashboard_Click" 
                                    Background="#18181B" Foreground="#F4F4F5" BorderBrush="#27272A" BorderThickness="1"
                                    Padding="12,5" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="🔄 Reload" Click="ReloadWebView_Click" 
                                    Background="#18181B" Foreground="#A1A1AA" BorderBrush="#27272A" BorderThickness="1"
                                    Padding="10,5" FontSize="11" Cursor="Hand" Margin="0,0,6,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="⚙️ Switch Mode" Click="SwitchModeButton_Click" 
                                    Background="#18181B" Foreground="#A1A1AA" BorderBrush="#27272A" BorderThickness="1"
                                    Padding="10,5" FontSize="11" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <!-- Center: Connected URL Pill -->
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" 
                                Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="10,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#34D399" Margin="0,0,6,0"/>
                                <TextBlock x:Name="CurrentConnectedUrlText" Text="http://localhost:5026" 
                                           FontSize="11" Foreground="#A1A1AA"/>
                            </StackPanel>
                        </Border>

                        <!-- Right: Hide Bar Toggle -->
                        <Button Click="ToggleWebToolbar_Click" ToolTip="Hide this bar for full screen view"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="Transparent" Foreground="#71717A" BorderThickness="0" 
                                Padding="8,4" FontSize="11" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Hide Bar" FontSize="11" Margin="0,0,4,0"/>
                                <TextBlock Text="▲" FontSize="9"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Mini Floating Tab (Shows when Bar is Hidden) -->
                <Border x:Name="WebMiniBar" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Background="#18181BF0" BorderBrush="#3F3F46" BorderThickness="1,0,1,1" 
                        CornerRadius="0,0,10,10" Padding="14,4" Cursor="Hand"
                        MouseLeftButtonUp="ToggleWebToolbar_Click" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="10" ShadowDepth="3"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#C026D3" Margin="0,0,6,0"/>
                        <TextBlock x:Name="WebMiniBarText" Text="🖥️ Host Controls ▾" FontSize="11" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                    </StackPanel>
                </Border>

                <!-- Embedded Edge Browser -->
                <wv2:WebView2 Grid.Row="1" x:Name="webView"/>
            </Grid>

        </Grid>
