<Window x:Class="OfficeCore.Desktop.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="OfficeCore Workstation — Client Terminal" Height="800" Width="1360" MinHeight="680" MinWidth="960"
        Background="#09090B" WindowStartupLocation="CenterScreen" Foreground="#F4F4F5">

    <Window.Resources>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ========================================================================= -->
        <!-- 1. CLIENT CONNECTION SCREEN (Shown before connecting)                     -->
        <!-- ========================================================================= -->
        <Grid x:Name="ConnectPanel" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Subtle Top Header -->
            <Border Grid.Row="0" Background="#0C0C0E" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="20,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8" Background="#2563EB" Margin="0,0,12,0">
                            <TextBlock Text="OC" FontWeight="Bold" FontSize="13" Foreground="White" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="OfficeCore" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,8,0"/>
                                <Border Background="#1E1B4B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="WORKSTATION CLIENT" FontSize="10" FontWeight="Bold" Foreground="#60A5FA"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Employee &amp; Point-of-Sale Terminal" FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Centered Connection Dialog -->
            <Grid Grid.Row="1">
                <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="16" 
                        Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="36">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="40" ShadowDepth="10"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Icon -->
                        <Border Background="#172554" Width="52" Height="52" CornerRadius="12" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="🌐" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Connect to OfficeCore Server" FontSize="22" FontWeight="Bold" Foreground="White" 
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Enter the IP address of your primary server station:" FontSize="13" Foreground="#A1A1AA" 
                                   HorizontalAlignment="Center" Margin="0,0,0,24" TextAlignment="Center"/>

                        <!-- Server URL Input -->
                        <TextBlock Text="Server Station Address / LAN IP" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="ServerUrlInput" Grid.Column="0" Style="{StaticResource ModernTextBox}" 
                                     Text="http://127.0.0.1:5026" KeyDown="ServerUrlInput_KeyDown"/>

                            <Button x:Name="TestButton" Grid.Column="2" Content="Test Ping" Click="TestButton_Click" 
                                    Background="#27272A" Foreground="#D4D4D8" BorderBrush="#3F3F46" BorderThickness="1"
                                    Padding="14,0" FontSize="12" FontWeight="Medium" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <!-- Status Feedback -->
                        <TextBlock x:Name="StatusFeedbackText" Text="" FontSize="12" Margin="0,0,0,14" HorizontalAlignment="Center"/>

                        <!-- Options -->
                        <CheckBox x:Name="AutoConnectCheckBox" Content="Automatically connect to this server on startup" 
                                  Foreground="#A1A1AA" FontSize="13" Cursor="Hand" Margin="0,0,0,22"/>

                        <!-- Connect Action Button -->
                        <Button x:Name="ConnectButton" Content="Connect to Server Station" Click="ConnectButton_Click" Height="46" 
                                Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand" Margin="0,0,0,16">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <TextBlock Text="💡 Contact your office administrator if you do not know the Server URL." 
                                   FontSize="11" Foreground="#52525B" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================================================= -->
        <!-- 2. WEBVIEW2 CONTAINER (Active Application View)                           -->
        <!-- ========================================================================= -->
        <Grid x:Name="WebViewContainer" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Full Sleek Controls Bar -->
            <Border x:Name="WebFullToolbar" Grid.Row="0" Background="#0C0A09" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="12,5">
                <Grid>
                    <!-- Left: Navigation & Core Tools -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="← Disconnect" Click="DisconnectButton_Click" 
                                Background="#18181B" Foreground="#F4F4F5" BorderBrush="#27272A" BorderThickness="1"
                                Padding="12,5" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="🔄 Reload" Click="ReloadButton_Click" 
                                Background="#18181B" Foreground="#A1A1AA" BorderBrush="#27272A" BorderThickness="1"
                                Padding="10,5" FontSize="11" Cursor="Hand" Margin="0,0,6,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <!-- Center: Connected URL Pill -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" 
                            Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="10,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#34D399" Margin="0,0,6,0"/>
                            <TextBlock x:Name="CurrentConnectedUrlText" Text="http://127.0.0.1:5026" 
                                       FontSize="11" Foreground="#A1A1AA"/>
                        </StackPanel>
                    </Border>

                    <!-- Right: Hide Bar Toggle -->
                    <Button Click="ToggleToolbar_Click" ToolTip="Hide this bar for full screen view"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" Foreground="#71717A" BorderThickness="0" 
                            Padding="8,4" FontSize="11" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Hide Bar" FontSize="11" Margin="0,0,4,0"/>
                            <TextBlock Text="▲" FontSize="9"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Mini Floating Tab (Shows when Bar is Hidden) -->
            <Border x:Name="WebMiniBar" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Background="#18181BF0" BorderBrush="#3F3F46" BorderThickness="1,0,1,1" 
                    CornerRadius="0,0,10,10" Padding="14,4" Cursor="Hand"
                    MouseLeftButtonUp="ToggleToolbar_Click" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="10" ShadowDepth="3"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#2563EB" Margin="0,0,6,0"/>
                    <TextBlock Text="💻 Workstation Controls ▾" FontSize="11" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                </StackPanel>
            </Border>

            <!-- Embedded Edge Browser -->
            <wv2:WebView2 Grid.Row="1" x:Name="webView"/>
        </Grid>
    </Grid>
</Window>
