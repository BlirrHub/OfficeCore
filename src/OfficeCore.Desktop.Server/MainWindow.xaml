<Window x:Class="OfficeCore.Desktop.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="OfficeCore Server Station — Host &amp; Database Orchestrator" Height="840" Width="1380" MinHeight="700" MinWidth="1000"
        Background="#09090B" WindowStartupLocation="CenterScreen" Foreground="#F4F4F5">

    <Window.Resources>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Grid.Column="0" Width="18" Height="18" CornerRadius="4" 
                                    Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M3,8 L7,12 L14,4" Stroke="#C026D3" StrokeThickness="2" 
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#27272A"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#C026D3"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#A855F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar Header -->
            <RowDefinition Height="*"/>    <!-- Active View Area -->
        </Grid.RowDefinitions>

        <!-- Top Header Navigation Bar -->
        <Border x:Name="WindowTopHeader" Grid.Row="0" Background="#0C0C0E" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#C026D3" Margin="0,0,12,0">
                        <TextBlock Text="OC" FontWeight="Bold" FontSize="14" Foreground="White" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="OfficeCore" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,8,0"/>
                            <Border Background="#3B0764" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="SERVER STATION" FontSize="10" FontWeight="Bold" Foreground="#E879F9"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Primary Server Host &amp; Database Orchestrator" FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center Active Mode Pill -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="12,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#C026D3" Margin="0,0,8,0"/>
                            <TextBlock Text="Dedicated Server Host" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Top Right Quick Launch -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🚀 Open Local Web App" Click="LaunchLocalApp_Click" 
                            Background="#701A75" Foreground="White" BorderThickness="0"
                            Padding="14,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Viewport Container -->
        <Grid Grid.Row="1">

            <!-- ========================================================================= -->
            <!-- 1. SERVER STATION DASHBOARD (Host Panel)                                  -->
            <!-- ========================================================================= -->
            <Grid x:Name="ServerDashboardPanel" Visibility="Visible" Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Controls, LAN URL, and DB Config -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Server Status & Action Banner -->
                        <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Server Status:" FontSize="14" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,8,0"/>
                                        <Border x:Name="ServerStatusPill" Background="#27272A" CornerRadius="6" Padding="8,3">
                                            <TextBlock x:Name="ServerStatusText" Text="STOPPED" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Action Buttons -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="StartServerButton" Grid.Column="0" Content="▶ Start Server" Click="StartServer_Click" 
                                            Height="38" Background="#059669" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button x:Name="StopServerButton" Grid.Column="2" Content="⏹ Stop Server" Click="StopServer_Click" 
                                            Height="38" Background="#DC2626" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand" IsEnabled="False">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>

                                <Button x:Name="LaunchLocalAppButton" Content="🚀 Launch OfficeCore Locally" Click="LaunchLocalApp_Click" 
                                        Height="44" Background="#C026D3" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <!-- Auto-Start Server Setting -->
                                <Border Margin="0,16,0,0" Padding="0,14,0,0" BorderBrush="#27272A" BorderThickness="0,1,0,0">
                                    <CheckBox x:Name="AutoStartServerCheckBox" Style="{StaticResource ModernCheckBox}"
                                              Click="AutoStartServerCheckBox_Click">
                                        <StackPanel Margin="0,0,0,0">
                                            <TextBlock Text="Auto-start server on app launch" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                                            <TextBlock Text="Automatically boots the unified backend when Station opens" FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Local Network Sharing Card -->
                        <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Local Network Access (LAN)" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                                <TextBlock Text="Share this address with other client workstation apps on your office network:" 
                                           TextWrapping="Wrap" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,12"/>

                                <Border Background="#09090B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                    <Grid>
                                        <TextBlock x:Name="LanUrlTextBlock" Text="http://127.0.0.1:5026" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        <Button Content="Copy URL" Click="CopyLanUrl_Click" HorizontalAlignment="Right" Padding="10,4" FontSize="11" Background="#27272A" Foreground="White" BorderThickness="0" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </Border>
                                <TextBlock Text="💡 Hint: Port 5026 serves both the API &amp; Web app seamlessly." FontSize="11" Foreground="#71717A"/>
                            </StackPanel>
                        </Border>

                        <!-- PostgreSQL Database Configuration Card -->
                        <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="14" Padding="20">
                            <StackPanel>
                                <TextBlock Text="PostgreSQL Database Connection" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                                <TextBlock Text="Configure local database credentials:" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Host" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                                        <TextBox x:Name="DbHostInput" Style="{StaticResource ModernTextBox}" Text="localhost"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Port" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                                        <TextBox x:Name="DbPortInput" Style="{StaticResource ModernTextBox}" Text="5432"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Database Name" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                                    <TextBox x:Name="DbNameInput" Style="{StaticResource ModernTextBox}" Text="OfficeCoreDb"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Username" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                                        <TextBox x:Name="DbUserInput" Style="{StaticResource ModernTextBox}" Text="postgres"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Password" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                                        <PasswordBox x:Name="DbPasswordInput" Style="{StaticResource ModernPasswordBox}" Password="password"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="Test Connection" Click="TestDbConnection_Click" 
                                            Height="34" Background="#27272A" Foreground="White" FontSize="12" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Grid.Column="2" Content="Save Settings" Click="SaveDbSettings_Click" 
                                            Height="34" Background="#3F3F46" Foreground="White" FontSize="12" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                                
                                <TextBlock x:Name="DbStatusFeedback" Text="" FontSize="11" Margin="0,10,0,0" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Database Backups & Snapshots Card -->
                        <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,16,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Database Backups &amp; Snapshots" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,8,0"/>
                                        <Border Background="#1E1B4B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="SAFETY" FontSize="9" FontWeight="Bold" Foreground="#818CF8"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Create immediate snapshots or manage automated schedules via the Disaster Recovery Console." 
                                           TextWrapping="Wrap" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="QuickSnapshotButton" Grid.Column="0" Content="📦 Quick Snapshot" Click="QuickSnapshot_Click" 
                                            Height="34" Background="#27272A" Foreground="White" FontSize="12" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Grid.Column="2" Content="🛠️ Open Console" Click="OpenBackupConsole_Click" 
                                            Height="34" Background="#4338CA" Foreground="White" FontSize="12" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>

                                <TextBlock x:Name="BackupStatusFeedback" Text="" FontSize="11" Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right Column: Live Server Console Logs -->
                <Border Grid.Column="2" Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="14" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Live Server Console Logs" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,10,0"/>
                                <TextBlock Text="(stdout / stderr)" FontSize="12" Foreground="#71717A" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Content="Clear Logs" Click="ClearLogs_Click" HorizontalAlignment="Right" 
                                    Padding="10,4" FontSize="11" Background="#27272A" Foreground="#A1A1AA" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <Border Grid.Row="1" Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8">
                            <TextBox x:Name="ConsoleLogBox" IsReadOnly="True" TextWrapping="Wrap" 
                                     VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="#A1A1AA" 
                                     FontFamily="Consolas, Courier New" FontSize="12" Padding="12" BorderThickness="0"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- 2. WEBVIEW2 CONTAINER (Local Running Application)                         -->
            <!-- ========================================================================= -->
            <Grid x:Name="WebViewContainer" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Full Sleek Controls Bar -->
                <Border x:Name="WebFullToolbar" Grid.Row="0" Background="#0C0A09" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="12,5">
                    <Grid>
                        <!-- Left: Return to Dashboard & Reload -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="← Server Dashboard" Click="BackToDashboard_Click" 
                                    Background="#18181B" Foreground="#F4F4F5" BorderBrush="#27272A" BorderThickness="1"
                                    Padding="12,5" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="◀" Click="GoBackButton_Click" ToolTip="Go Back"
                                    Background="#18181B" Foreground="#F4F4F5" BorderBrush="#27272A" BorderThickness="1"
                                    Padding="10,5" FontSize="11" Cursor="Hand" Margin="0,0,6,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="▶" Click="GoForwardButton_Click" ToolTip="Go Forward"
                                    Background="#18181B" Foreground="#F4F4F5" BorderBrush="#27272A" BorderThickness="1"
                                    Padding="10,5" FontSize="11" Cursor="Hand" Margin="0,0,6,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="🔄 Reload" Click="ReloadWebView_Click" 
                                    Background="#18181B" Foreground="#A1A1AA" BorderBrush="#27272A" BorderThickness="1"
                                    Padding="10,5" FontSize="11" Cursor="Hand" Margin="0,0,6,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <!-- Center: Connected URL Pill -->
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" 
                                Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="10,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#34D399" Margin="0,0,6,0"/>
                                <TextBlock Text="http://localhost:5026 (Local Server Host)" 
                                           FontSize="11" Foreground="#A1A1AA"/>
                            </StackPanel>
                        </Border>

                        <!-- Right: Hide Bar Toggle -->
                        <Button Click="ToggleWebToolbar_Click" ToolTip="Hide this bar for full screen view"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="Transparent" Foreground="#71717A" BorderThickness="0" 
                                Padding="8,4" FontSize="11" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Hide Bar" FontSize="11" Margin="0,0,4,0"/>
                                <TextBlock Text="▲" FontSize="9"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Mini Floating Tab (Shows when Bar is Hidden) -->
                <Border x:Name="WebMiniBar" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Background="#18181BF0" BorderBrush="#3F3F46" BorderThickness="1,0,1,1" 
                        CornerRadius="0,0,10,10" Padding="14,4" Cursor="Hand"
                        MouseLeftButtonUp="ToggleWebToolbar_Click" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="10" ShadowDepth="3"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#C026D3" Margin="0,0,6,0"/>
                        <TextBlock Text="🖥️ Host Controls ▾" FontSize="11" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                    </StackPanel>
                </Border>

                <!-- Embedded Edge Browser -->
                <wv2:WebView2 Grid.Row="1" x:Name="webView"/>
            </Grid>

        </Grid>
    </Grid>
</Window>
