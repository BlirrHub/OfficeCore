<Window x:Class="OfficeCore.Desktop.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="OfficeCore Server Station — Host &amp; Database Orchestrator" Height="840" Width="1380" MinHeight="700" MinWidth="1000"
        Background="#09090B" WindowStartupLocation="CenterScreen" Foreground="#F4F4F5">

    <Window.Resources>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Grid.Column="0" Width="18" Height="18" CornerRadius="4" 
                                    Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M3,8 L7,12 L14,4" Stroke="#C026D3" StrokeThickness="2" 
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#27272A"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#C026D3"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#A855F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar Header -->
            <RowDefinition Height="*"/>    <!-- Active View Area -->
        </Grid.RowDefinitions>

        <!-- Top Header Navigation Bar -->
        <Border x:Name="WindowTopHeader" Grid.Row="0" Background="#0C0C0E" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#C026D3" Margin="0,0,12,0">
                        <TextBlock Text="OC" FontWeight="Bold" FontSize="14" Foreground="White" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="OfficeCore" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,8,0"/>
                            <Border Background="#3B0764" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="SERVER STATION" FontSize="10" FontWeight="Bold" Foreground="#E879F9"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Primary Server Host &amp; Database Orchestrator" FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center Active Mode Pill -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="12,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#C026D3" Margin="0,0,8,0"/>
                            <TextBlock Text="Dedicated Server Host" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Top Right Quick Launch & Disaster Recovery -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🛠️ Disaster Recovery" Click="OpenBackupConsole_Click" 
                            Background="#1E1B4B" Foreground="#818CF8" BorderBrush="#312E81" BorderThickness="1"
                            Padding="12,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="🗕 Hide to Background" Click="MinimizeToTray_Click" 
                            Background="#18181B" Foreground="#D4D4D8" BorderBrush="#27272A" BorderThickness="1"
                            Padding="12,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="🚀 Open Local Web App" Click="LaunchLocalApp_Click" 
                            Background="#701A75" Foreground="White" BorderThickness="0"
                            Padding="14,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Viewport Container -->
        <Grid Grid.Row="1">

            <!-- ========================================================================= -->
            <!-- 1. SERVER STATION DASHBOARD (Host Panel)                                  -->
            <!-- ========================================================================= -->
            <Grid x:Name="ServerDashboardPanel" Visibility="Visible" Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Controls, LAN URL, and DB Config -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Server Status & Action Banner -->
                        <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Server Status:" FontSize="14" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,8,0"/>
                                        <Border x:Name="ServerStatusPill" Background="#27272A" CornerRadius="6" Padding="8,3">
                                            <TextBlock x:Name="ServerStatusText" Text="STOPPED" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Action Buttons -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="StartServerButton" Grid.Column="0" Content="▶ Start Server" Click="StartServer_Click" 
                                            Height="38" Background="#059669" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button x:Name="StopServerButton" Grid.Column="2" Content="⏹ Stop Server" Click="StopServer_Click" 
                                            Height="38" Background="#DC2626" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand" IsEnabled="False">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>

                                <Button x:Name="LaunchLocalAppButton" Content="🚀 Launch OfficeCore Locally" Click="LaunchLocalApp_Click" 
                                        Height="44" Background="#C026D3" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <!-- Auto-Start Server Setting -->
                                <Border Margin="0,16,0,0" Padding="0,14,0,0" BorderBrush="#27272A" BorderThickness="0,1,0,0">
                                    <StackPanel>
                                        <CheckBox x:Name="AutoStartServerCheckBox" Style="{StaticResource ModernCheckBox}"
                                                  Click="AutoStartServerCheckBox_Click" Margin="0,0,0,12">
                                            <StackPanel Margin="0,0,0,0">
                                                <TextBlock Text="Auto-start server on app launch" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                                                <TextBlock Text="Automatically boots the unified backend when Station opens" FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </CheckBox>

                                        <CheckBox x:Name="RunInBackgroundCheckBox" Style="{StaticResource ModernCheckBox}"
                                                  Click="RunInBackgroundCheckBox_Click" Margin="0,0,0,12">
                                            <StackPanel Margin="0,0,0,0">
                                                <TextBlock Text="Run in background (System Tray)" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                                                <TextBlock Text="Keep the server alive in the Windows notification area when minimized or closed" FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </CheckBox>

                                        <CheckBox x:Name="StartMinimizedCheckBox" Style="{StaticResource ModernCheckBox}"
                                                  Click="StartMinimizedCheckBox_Click" Margin="0,0,0,12">
                                            <StackPanel Margin="0,0,0,0">
                                                <TextBlock Text="Start minimized to tray" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                                                <TextBlock Text="Launch directly into the background without popping up the main window" FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </CheckBox>

                                        <CheckBox x:Name="StartWithWindowsCheckBox" Style="{StaticResource ModernCheckBox}"
                                                  Click="StartWithWindowsCheckBox_Click">
                                            <StackPanel Margin="0,0,0,0">
                                                <TextBlock Text="Start with Windows on system boot" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                                                <TextBlock Text="Automatically launch Server Station in background when signing in to Windows" FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Local Network Sharing Card -->
                        <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Local Network Access (LAN)" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                                <TextBlock Text="Share this address with other client workstation apps on your office network:" 
                                           TextWrapping="Wrap" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,12"/>

                                <Border Background="#09090B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                    <Grid>
                                        <TextBlock x:Name="LanUrlTextBlock" Text="http://127.0.0.1:5026" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        <Button Content="Copy URL" Click="CopyLanUrl_Click" HorizontalAlignment="Right" Padding="10,4" FontSize="11" Background="#27272A" Foreground="White" BorderThickness="0" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </Border>
                                <TextBlock Text="💡 Hint: Port 5026 serves both the API &amp; Web app seamlessly." FontSize="11" Foreground="#71717A"/>
                            </StackPanel>
                        </Border>

                        <!-- PostgreSQL Database Configuration Card -->
                        <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="14" Padding="20">
                            <StackPanel>
                                <TextBlock Text="PostgreSQL Database Connection" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                                <TextBlock Text="Configure local database credentials:" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Host" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                                        <TextBox x:Name="DbHostInput" Style="{StaticResource ModernTextBox}" Text="localhost"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Port" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                                        <TextBox x:Name="DbPortInput" Style="{StaticResource ModernTextBox}" Text="5432"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Database Name" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                                    <TextBox x:Name="DbNameInput" Style="{StaticResource ModernTextBox}" Text="OfficeCoreDb"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Username" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                                        <TextBox x:Name="DbUserInput" Style="{StaticResource ModernTextBox}" Text="postgres"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Password" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                                        <PasswordBox x:Name="DbPasswordInput" Style="{StaticResource ModernPasswordBox}" Password="password"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="Test Connection" Click="TestDbConnection_Click" 
                                            Height="34" Background="#27272A" Foreground="White" FontSize="12" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Grid.Column="2" Content="Save Settings" Click="SaveDbSettings_Click" 
                                            Height="34" Background="#3F3F46" Foreground="White" FontSize="12" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                                
                                <TextBlock x:Name="DbStatusFeedback" Text="" FontSize="11" Margin="0,10,0,0" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Database Backups & Snapshots Card -->
                        <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,16,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Database Backups &amp; Snapshots" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,8,0"/>
                                        <Border Background="#1E1B4B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="SAFETY" FontSize="9" FontWeight="Bold" Foreground="#818CF8"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Create immediate snapshots or manage automated schedules via the Disaster Recovery Console." 
                                           TextWrapping="Wrap" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="QuickSnapshotButton" Grid.Column="0" Content="📦 Quick Snapshot" Click="QuickSnapshot_Click" 
                                            Height="34" Background="#27272A" Foreground="White" FontSize="12" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Grid.Column="2" Content="🛠️ Open Console" Click="OpenBackupConsole_Click" 
                                            Height="34" Background="#4338CA" Foreground="White" FontSize="12" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>

                                <TextBlock x:Name="BackupStatusFeedback" Text="" FontSize="11" Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right Column: Live Server Console Logs -->
                <Border Grid.Column="2" Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="14" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Live Server Console Logs" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,10,0"/>
                                <TextBlock Text="(stdout / stderr)" FontSize="12" Foreground="#71717A" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Content="Clear Logs" Click="ClearLogs_Click" HorizontalAlignment="Right" 
                                    Padding="10,4" FontSize="11" Background="#27272A" Foreground="#A1A1AA" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <Border Grid.Row="1" Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8">
                            <TextBox x:Name="ConsoleLogBox" IsReadOnly="True" TextWrapping="Wrap" 
                                     VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="#A1A1AA" 
                                     FontFamily="Consolas, Courier New" FontSize="12" Padding="12" BorderThickness="0"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- 2. WEBVIEW2 CONTAINER (Local Running Application)                         -->
            <!-- ========================================================================= -->
            <Grid x:Name="WebViewContainer" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Full Sleek Controls Bar -->
                <Border x:Name="WebFullToolbar" Grid.Row="0" Background="#0C0A09" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="12,5">
                    <Grid>
                        <!-- Left: Return to Dashboard & Reload -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="← Server Dashboard" Click="BackToDashboard_Click" 
                                    Background="#18181B" Foreground="#F4F4F5" BorderBrush="#27272A" BorderThickness="1"
                                    Padding="12,5" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="◀" Click="GoBackButton_Click" ToolTip="Go Back"
                                    Background="#18181B" Foreground="#F4F4F5" BorderBrush="#27272A" BorderThickness="1"
                                    Padding="10,5" FontSize="11" Cursor="Hand" Margin="0,0,6,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="▶" Click="GoForwardButton_Click" ToolTip="Go Forward"
                                    Background="#18181B" Foreground="#F4F4F5" BorderBrush="#27272A" BorderThickness="1"
                                    Padding="10,5" FontSize="11" Cursor="Hand" Margin="0,0,6,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="🔄 Reload" Click="ReloadWebView_Click" 
                                    Background="#18181B" Foreground="#A1A1AA" BorderBrush="#27272A" BorderThickness="1"
                                    Padding="10,5" FontSize="11" Cursor="Hand" Margin="0,0,6,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <!-- Center: Connected URL Pill -->
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" 
                                Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="10,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#34D399" Margin="0,0,6,0"/>
                                <TextBlock Text="http://localhost:5026 (Local Server Host)" 
                                           FontSize="11" Foreground="#A1A1AA"/>
                            </StackPanel>
                        </Border>

                        <!-- Right: Hide Bar Toggle -->
                        <Button Click="ToggleWebToolbar_Click" ToolTip="Hide this bar for full screen view"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="Transparent" Foreground="#71717A" BorderThickness="0" 
                                Padding="8,4" FontSize="11" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Hide Bar" FontSize="11" Margin="0,0,4,0"/>
                                <TextBlock Text="▲" FontSize="9"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Mini Floating Tab (Shows when Bar is Hidden) -->
                <Border x:Name="WebMiniBar" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Background="#18181BF0" BorderBrush="#3F3F46" BorderThickness="1,0,1,1" 
                        CornerRadius="0,0,10,10" Padding="14,4" Cursor="Hand"
                        MouseLeftButtonUp="ToggleWebToolbar_Click" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="10" ShadowDepth="3"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#C026D3" Margin="0,0,6,0"/>
                        <TextBlock Text="🖥️ Host Controls ▾" FontSize="11" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                    </StackPanel>
                </Border>

                <!-- Embedded Edge Browser -->
                <wv2:WebView2 Grid.Row="1" x:Name="webView"/>
            </Grid>

            <!-- ========================================================================= -->
            <!-- 3. DISASTER RECOVERY & SYSTEM SNAPSHOTS CONSOLE PANEL                    -->
            <!-- ========================================================================= -->
            <Grid x:Name="DisasterRecoveryPanel" Visibility="Collapsed" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header and Toolbar -->
                    <RowDefinition Height="Auto"/> <!-- Metrics 4-Cards Grid -->
                    <RowDefinition Height="Auto"/> <!-- Collapsible Schedule Settings -->
                    <RowDefinition Height="*"/>    <!-- Snapshots List Container -->
                    <RowDefinition Height="Auto"/> <!-- Action Status Feedback -->
                </Grid.RowDefinitions>

                <!-- Top Header and Action Bar -->
                <Border Grid.Row="0" Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Back Button and Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="← Server Dashboard" Click="BackToDashboard_Click"
                                    Background="#18181B" Foreground="#E4E4E7" BorderBrush="#27272A" BorderThickness="1"
                                    Padding="12,7" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,16,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="PostgreSQL Disaster Recovery &amp; Snapshots" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,8,0"/>
                                    <Border Background="#1E1B4B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="SERVER STATION EXCLUSIVE" FontSize="9" FontWeight="Bold" Foreground="#818CF8"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Full database snapshots, scheduled background archives, and safety-verified 1-click restore" FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="↻ Refresh" Click="RefreshBackups_Click"
                                    Background="#18181B" Foreground="#E4E4E7" BorderBrush="#27272A" BorderThickness="1"
                                    Padding="10,6" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="📂 Open Folder" Click="OpenBackupsFolder_Click"
                                    Background="#18181B" Foreground="#E4E4E7" BorderBrush="#27272A" BorderThickness="1"
                                    Padding="10,6" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="⚙ Schedule Settings" Click="ToggleScheduleSettings_Click"
                                    Background="#18181B" Foreground="#E4E4E7" BorderBrush="#27272A" BorderThickness="1"
                                    Padding="10,6" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="📥 Import &amp; Restore .dump" Click="UploadBackup_Click"
                                    Background="#18181B" Foreground="#38BDF8" BorderBrush="#0369A1" BorderThickness="1"
                                    Padding="12,6" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button x:Name="CreateSnapshotButton" Content="📦 Create Snapshot Now" Click="CreateSnapshot_Click"
                                    Background="#4338CA" Foreground="White" BorderThickness="0"
                                    Padding="14,6" FontSize="12" FontWeight="Bold" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Metrics 4-Cards Grid -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Metric 1: Engine Status -->
                    <Border Grid.Column="0" Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="POSTGRES ENGINE STATUS" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,4"/>
                            <TextBlock x:Name="DrEngineStatusText" Text="Detecting..." FontSize="13" FontWeight="Bold" Foreground="#34D399"/>
                            <TextBlock x:Name="DrEngineBinPathText" Text="C:\Program Files\PostgreSQL\18\bin" FontSize="10" Foreground="#71717A" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Metric 2: Total Snapshots -->
                    <Border Grid.Column="2" Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="STORED SNAPSHOTS" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,4"/>
                            <TextBlock x:Name="DrTotalSnapshotsText" Text="0 archives" FontSize="13" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="DrSnapshotsBreakdownText" Text="0 manual, 0 auto, 0 safety" FontSize="10" Foreground="#71717A" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Metric 3: Storage Footprint -->
                    <Border Grid.Column="4" Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="STORAGE FOOTPRINT" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,4"/>
                            <TextBlock x:Name="DrStorageFootprintText" Text="0.0 MB" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                            <TextBlock Text="Compressed PostgreSQL .dump files" FontSize="10" Foreground="#71717A" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Metric 4: Auto-Schedule -->
                    <Border Grid.Column="6" Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="SCHEDULE ROUTINE" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,4"/>
                            <TextBlock x:Name="DrScheduleRoutineText" Text="Daily at 23:00" FontSize="13" FontWeight="Bold" Foreground="#E879F9"/>
                            <TextBlock x:Name="DrRetentionText" Text="Retaining last 14 backups" FontSize="10" Foreground="#71717A" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Collapsible Schedule Settings Card -->
                <Border x:Name="ScheduleSettingsCard" Grid.Row="2" Background="#121215" BorderBrush="#3B0764" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Automated Scheduled Backups &amp; Retention Configuration" FontSize="13" FontWeight="Bold" Foreground="#E879F9" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox x:Name="AutoBackupEnabledCheck" Grid.Column="0" Content="Enable Daily Backup" Style="{StaticResource ModernCheckBox}" VerticalAlignment="Center" Margin="0,0,14,0"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Run Time (24h HH:mm)" FontSize="10" Foreground="#A1A1AA" Margin="0,0,0,3"/>
                                <TextBox x:Name="AutoBackupTimeInput" Style="{StaticResource ModernTextBox}" Text="23:00"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="Retention Count" FontSize="10" Foreground="#A1A1AA" Margin="0,0,0,3"/>
                            </StackPanel>
                            <TextBox x:Name="AutoBackupRetentionInput" Grid.Column="4" Style="{StaticResource ModernTextBox}" Text="14"/>

                            <StackPanel Grid.Column="6" Margin="10,0,10,0">
                                <TextBlock Text="Custom PostgreSQL Bin Path (Optional)" FontSize="10" Foreground="#A1A1AA" Margin="0,0,0,3"/>
                                <TextBox x:Name="CustomPgBinPathInput" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <Button Grid.Column="7" Content="Save Schedule" Click="SaveScheduleSettings_Click"
                                    VerticalAlignment="Bottom" Height="36" Padding="14,0" Background="#701A75" Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="ScheduleSettingsFeedback" Text="" FontSize="11" Foreground="#34D399"/>
                    </StackPanel>
                </Border>

                <!-- Snapshots List Container -->
                <Border Grid.Row="3" Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="14" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Table Header -->
                        <Grid Grid.Row="0" Margin="12,4,12,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SNAPSHOT ARCHIVE" FontSize="10" FontWeight="Bold" Foreground="#71717A"/>
                            <TextBlock Grid.Column="1" Text="TYPE" FontSize="10" FontWeight="Bold" Foreground="#71717A"/>
                            <TextBlock Grid.Column="2" Text="DESCRIPTION / LABEL" FontSize="10" FontWeight="Bold" Foreground="#71717A"/>
                            <TextBlock Grid.Column="3" Text="FILE SIZE" FontSize="10" FontWeight="Bold" Foreground="#71717A"/>
                            <TextBlock Grid.Column="4" Text="TIMESTAMP" FontSize="10" FontWeight="Bold" Foreground="#71717A"/>
                            <TextBlock Grid.Column="5" Text="ACTIONS" FontSize="10" FontWeight="Bold" Foreground="#71717A" TextAlignment="Right"/>
                        </Grid>

                        <!-- Snapshots Scrollable List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl x:Name="SnapshotsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2.5*"/>
                                                        <ColumnDefinition Width="1.2*"/>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="1.5*"/>
                                                        <ColumnDefinition Width="180"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- File Name -->
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📦 " FontSize="12"/>
                                                        <TextBlock Text="{Binding FileName}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Type Badge -->
                                                    <Border Grid.Column="1" Background="{Binding TypeBg}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TypeBadge}" FontSize="9" FontWeight="Bold" Foreground="{Binding TypeColor}"/>
                                                    </Border>

                                                    <!-- Label -->
                                                    <TextBlock Grid.Column="2" Text="{Binding DisplayLabel}" FontSize="12" Foreground="#D4D4D8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                    <!-- Size -->
                                                    <TextBlock Grid.Column="3" Text="{Binding FormattedSize}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>

                                                    <!-- Created Date -->
                                                    <TextBlock Grid.Column="4" Text="{Binding FormattedDate}" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center"/>

                                                    <!-- Action Buttons -->
                                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Content="↺ Restore" Tag="{Binding FileName}" Click="ItemRestore_Click"
                                                                Background="#4338CA" Foreground="White" BorderThickness="0" Padding="8,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,0">
                                                            <Button.Resources>
                                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                                            </Button.Resources>
                                                        </Button>

                                                        <Button Content="💾" Tag="{Binding FilePath}" Click="ItemExport_Click" ToolTip="Export copy to chosen location"
                                                                Background="#27272A" Foreground="#E4E4E7" BorderThickness="0" Padding="8,4" FontSize="11" Cursor="Hand" Margin="0,0,6,0">
                                                            <Button.Resources>
                                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                                            </Button.Resources>
                                                        </Button>

                                                        <Button Content="🗑" Tag="{Binding FileName}" Click="ItemDelete_Click" ToolTip="Delete snapshot archive"
                                                                Background="#27272A" Foreground="#F87171" BorderThickness="0" Padding="8,4" FontSize="11" Cursor="Hand">
                                                            <Button.Resources>
                                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                                            </Button.Resources>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border x:Name="NoBackupsPlaceholder" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="24" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="No database snapshots found in archive." FontSize="13" FontWeight="SemiBold" Foreground="#A1A1AA" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Click 'Create Snapshot Now' above to generate an immediate system backup." FontSize="11" Foreground="#71717A" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Action Status Feedback -->
                <Border Grid.Row="4" Margin="0,10,0,0">
                    <TextBlock x:Name="DrActionFeedbackText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="#34D399" TextAlignment="Center"/>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Window>
