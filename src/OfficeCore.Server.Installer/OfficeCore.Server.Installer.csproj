<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Setup-OfficeCore-Server</AssemblyName>
    <RootNamespace>OfficeCore.Server.Installer</RootNamespace>
    <ApplicationTitle>OfficeCore Server Station Setup</ApplicationTitle>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\dist\OfficeCore-ServerStation-Portable\OfficeCore.ServerStation.exe" Condition="Exists('..\..\dist\OfficeCore-ServerStation-Portable\OfficeCore.ServerStation.exe')">
      <Link>OfficeCore.ServerStation.exe</Link>
    </EmbeddedResource>
  </ItemGroup>

</Project>
