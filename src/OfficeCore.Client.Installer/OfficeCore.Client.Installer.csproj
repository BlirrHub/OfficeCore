<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Setup-OfficeCore-Client</AssemblyName>
    <RootNamespace>OfficeCore.Client.Installer</RootNamespace>
    <ApplicationTitle>OfficeCore Workstation Setup</ApplicationTitle>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\dist\OfficeCore-Client-Portable\OfficeCore.Client.exe">
      <Link>OfficeCore.Client.exe</Link>
    </EmbeddedResource>
  </ItemGroup>

</Project>
