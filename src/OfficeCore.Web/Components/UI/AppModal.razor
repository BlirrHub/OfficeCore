@namespace OfficeCore.Web.Client.Components.UI

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <!-- Backdrop -->
        <div class="fixed inset-0 bg-black/80 backdrop-blur-sm transition-opacity animate-in fade-in duration-200" @onclick="HandleBackdropClick"></div>

        <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
            <div class="relative transform overflow-hidden rounded-2xl bg-zinc-950 border border-zinc-800 text-left shadow-2xl transition-all w-full @GetMaxWidthClass() my-8 animate-in zoom-in-95 duration-200">
                <!-- Header -->
                <div class="px-6 py-5 border-b border-zinc-800/80 flex items-center justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-white tracking-wide" id="modal-title">@Title</h3>
                        @if (!string.IsNullOrWhiteSpace(Subtitle))
                        {
                            <p class="text-xs text-zinc-400 mt-1">@Subtitle</p>
                        }
                    </div>
                    @if (ShowCloseButton)
                    {
                        <button type="button" @onclick="Close" class="rounded-lg p-1.5 text-zinc-400 hover:text-white hover:bg-zinc-800 transition-colors">
                            <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    }
                </div>

                <!-- Body -->
                <div class="px-6 py-5">
                    @ChildContent
                </div>

                <!-- Footer -->
                @if (Footer != null)
                {
                    <div class="px-6 py-4 bg-zinc-900/40 border-t border-zinc-800/80 flex items-center justify-end gap-3">
                        @Footer
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string Size { get; set; } = "md"; // sm | md | lg | xl
    [Parameter] public bool ShowCloseButton { get; set; } = true;
    [Parameter] public bool CloseOnBackdropClick { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
        await OnClosed.InvokeAsync();
    }

    private async Task HandleBackdropClick()
    {
        if (CloseOnBackdropClick)
        {
            await Close();
        }
    }

    private string GetMaxWidthClass() => Size switch
    {
        "sm" => "sm:max-w-md",
        "lg" => "sm:max-w-2xl",
        "xl" => "sm:max-w-4xl",
        _ => "sm:max-w-lg"
    };
}
