@page "/dashboard"
@attribute [Authorize]
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject HttpClient Http
@inject ToastService ToastService
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client

<PageTitle>Dashboard - OfficeCore</PageTitle>

<div class="space-y-6">
    <!-- Header with Welcome, Role Badge, and Refresh -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-zinc-800/60">
        <div>
            <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-fuchsia-500/10 border border-fuchsia-500/20 text-fuchsia-400 text-xs font-medium mb-2">
                <span class="size-1.5 rounded-full bg-fuchsia-400 animate-pulse"></span>
                <span>@(_stats?.IsManager == true ? "Management Hub" : "Employee Self-Service")</span>
                <span class="text-zinc-500">•</span>
                <span class="text-zinc-300 font-semibold">@(_stats?.RoleName ?? "Workspace Member")</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">
                Good day, @(!string.IsNullOrWhiteSpace(_firstName) ? _firstName : "Team Member")
            </h1>
            <p class="mt-1 text-zinc-400 text-xs sm:text-sm">
                @if (_stats?.IsManager == true)
                {
                    <span>Here is what's happening across your team and workspace today.</span>
                }
                else
                {
                    <span>Here is your personal attendance, tasks, and requests summary today.</span>
                }
            </p>
        </div>

        <div class="flex items-center gap-3">
            <div class="px-3.5 py-1.5 rounded-xl bg-zinc-900/70 border border-zinc-800/80 text-zinc-300 text-xs font-medium flex items-center gap-2 shadow-sm">
                <svg class="size-4 text-zinc-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 9v7.5" />
                </svg>
                <span>@DateTime.Now.ToString("dddd, MMMM d, yyyy")</span>
            </div>
            <button @onclick="LoadDashboardStats" disabled="@_isLoading"
                    class="p-2 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-zinc-400 hover:text-white transition-all disabled:opacity-50"
                    title="Refresh Dashboard">
                <svg class="size-4 @(_isLoading ? "animate-spin text-fuchsia-400" : "")" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                </svg>
            </button>
            @if (_stats?.Permissions?.CanViewBoards == true)
            {
                var boardsUrl = _stats?.PrimaryBoardId != null ? $"/boards/{_stats.PrimaryBoardId}" : "/boards";
                <a href="@boardsUrl" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-fuchsia-600 hover:bg-fuchsia-500 text-white text-xs font-semibold transition-all shadow-md shadow-fuchsia-900/30 active:scale-95" title="Go to Project Boards">
                    <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" />
                    </svg>
                    <span>Kanban Boards</span>
                </a>
            }
        </div>
    </div>

    <!-- Manager View Switcher (For managers/admins who also have personal ESS data) -->
    @if (_stats?.IsManager == true)
    {
        <div class="flex items-center gap-2 border-b border-zinc-800/60 pb-3">
            <button @onclick="() => _activeTab = DashboardTab.Team"
                    class="px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all flex items-center gap-2 @(_activeTab == DashboardTab.Team ? "bg-fuchsia-600 text-white shadow-sm shadow-fuchsia-900/40" : "bg-zinc-900/70 text-zinc-400 hover:text-white border border-zinc-800")">
                <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
                <span>Team Operations</span>
            </button>
            <button @onclick="() => _activeTab = DashboardTab.Personal"
                    class="px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all flex items-center gap-2 @(_activeTab == DashboardTab.Personal ? "bg-fuchsia-600 text-white shadow-sm shadow-fuchsia-900/40" : "bg-zinc-900/70 text-zinc-400 hover:text-white border border-zinc-800")">
                <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
                <span>My Personal Status</span>
            </button>
        </div>
    }

    @if (_isLoading && _stats == null)
    {
        <!-- Loading State Skeleton -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            @for (int i = 0; i < 4; i++)
            {
                <div class="p-5 rounded-2xl bg-zinc-900/50 border border-zinc-800/80 animate-pulse space-y-3">
                    <div class="h-3 w-24 bg-zinc-800 rounded"></div>
                    <div class="h-8 w-16 bg-zinc-700 rounded"></div>
                    <div class="h-2 w-32 bg-zinc-800 rounded"></div>
                </div>
            }
        </div>
    }
    else if (_stats?.IsManager == true && _activeTab == DashboardTab.Team)
    {
        <!-- ==========================================
             MANAGEMENT VIEW: Team Overview & Approvals
             ========================================== -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
            <!-- Metric 1: Headcount -->
            @if (_stats.Permissions.CanManageUsers || _stats.Permissions.CanManageAttendance)
            {
                var headcountUrl = _stats.Permissions.CanManageUsers ? "/admin/users" : "/admin/attendance";
                <a href="@headcountUrl" class="glass-card-interactive rounded-2xl p-5 block group">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-zinc-400">Team Headcount</span>
                        <div class="size-9 rounded-xl bg-fuchsia-500/10 border border-fuchsia-500/20 flex items-center justify-center text-fuchsia-400 group-hover:scale-105 transition-transform">
                            <svg class="size-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
                            </svg>
                        </div>
                    </div>
                    <div class="mt-4 flex items-baseline gap-2">
                        <span class="text-3xl font-bold tracking-tight text-white">@(_stats.TotalEmployees ?? 0)</span>
                        <span class="text-xs font-medium text-emerald-400 flex items-center gap-0.5">
                            <svg class="size-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5L12 3m0 0l7.5 7.5M12 3v18" /></svg>
                            Active
                        </span>
                    </div>
                    <p class="mt-1 text-xs text-zinc-500">
                        @if ((_stats.ActiveOutsideStaffCount ?? 0) > 0)
                        {
                            <span class="text-fuchsia-400 font-medium">@_stats.ActiveOutsideStaffCount on field radar</span>
                        }
                        else
                        {
                            <span>Manage workspace team members</span>
                        }
                    </p>
                </a>
            }

            <!-- Metric 2: Today's Team Attendance -->
            @if (_stats.Permissions.CanManageAttendance)
            {
                <a href="/admin/attendance" class="glass-card-interactive rounded-2xl p-5 block group">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-zinc-400">Team Attendance Today</span>
                        <div class="size-9 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 group-hover:scale-105 transition-transform">
                            <svg class="size-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                    </div>
                    <div class="mt-4 flex items-baseline gap-2">
                        <span class="text-3xl font-bold tracking-tight text-white">@(_stats.AttendanceRatePercent?.ToString("0") ?? "0")%</span>
                        <span class="text-xs font-medium text-emerald-400">@(_stats.PresentTodayCount ?? 0) Present</span>
                    </div>
                    <p class="mt-1 text-xs text-zinc-500">Wi-Fi & Biometric listener active</p>
                </a>
            }

            <!-- Metric 3: Pending Approvals -->
            @if (_stats.Permissions.CanManageLeaves || _stats.Permissions.CanManageAdvances)
            {
                var targetApprovalUrl = (_stats.PendingAdvancesCount ?? 0) > 0 && (_stats.PendingLeavesCount ?? 0) == 0 && _stats.Permissions.CanManageAdvances
                    ? "/ledger"
                    : (_stats.Permissions.CanManageLeaves ? "/admin/leave-approvals" : "/ledger");
                <div class="glass-card-interactive rounded-2xl p-5 block group relative">
                    <a href="@targetApprovalUrl" class="absolute inset-0 z-0" title="Open Approvals"></a>
                    <div class="relative z-10 pointer-events-none">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-medium text-zinc-400">Pending Approvals</span>
                            <div class="size-9 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 group-hover:scale-105 transition-transform">
                                <svg class="size-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                        </div>
                        <div class="mt-4 flex items-baseline gap-2">
                            <span class="text-3xl font-bold tracking-tight text-white">@((_stats.PendingLeavesCount ?? 0) + (_stats.PendingAdvancesCount ?? 0))</span>
                            <span class="text-xs font-medium text-amber-400">Action Required</span>
                        </div>
                        <div class="mt-2 flex items-center gap-2 text-xs pointer-events-auto">
                            @if (_stats.Permissions.CanManageLeaves)
                            {
                                <a href="/admin/leave-approvals" class="hover:underline text-fuchsia-400 font-medium">@(_stats.PendingLeavesCount ?? 0) Leaves</a>
                            }
                            else
                            {
                                <span class="text-zinc-500">@(_stats.PendingLeavesCount ?? 0) Leaves</span>
                            }
                            <span class="text-zinc-600">•</span>
                            @if (_stats.Permissions.CanManageAdvances)
                            {
                                <a href="/ledger" class="hover:underline text-amber-400 font-medium">@(_stats.PendingAdvancesCount ?? 0) Advances</a>
                            }
                            else
                            {
                                <span class="text-zinc-500">@(_stats.PendingAdvancesCount ?? 0) Advances</span>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Metric 4: Board Sprint Cards -->
            @if (_stats.Permissions.CanViewBoards)
            {
                var boardsCardUrl = _stats.PrimaryBoardId != null ? $"/boards/{_stats.PrimaryBoardId}" : "/boards";
                <a href="@boardsCardUrl" class="glass-card-interactive rounded-2xl p-5 block group">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-zinc-400">Workspace Tasks</span>
                        <div class="size-9 rounded-xl bg-violet-500/10 border border-violet-500/20 flex items-center justify-center text-violet-400 group-hover:scale-105 transition-transform">
                            <svg class="size-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" />
                            </svg>
                        </div>
                    </div>
                    <div class="mt-4 flex items-baseline gap-2">
                        <span class="text-3xl font-bold tracking-tight text-white">@(_stats.TotalTasksCount ?? 0)</span>
                        <span class="text-xs font-medium text-fuchsia-400">Total Cards</span>
                    </div>
                    <p class="mt-1 text-xs text-zinc-500">
                        @(_stats.CompletedTasksCount ?? 0) Done • @(_stats.InProgressTasksCount ?? 0) In Progress
                    </p>
                </a>
            }
        </div>

        <!-- Management Quick Actions -->
        <div class="p-4 rounded-2xl bg-zinc-900/40 border border-zinc-800/80">
            <p class="text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-3">Management Shortcuts</p>
            <div class="grid grid-cols-2 sm:grid-cols-6 gap-3">
                @if (_stats.Permissions.CanManageUsers)
                {
                    <a href="/admin/users" class="flex items-center gap-3 p-3 rounded-xl bg-zinc-900/60 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 transition-all text-xs font-medium text-zinc-200 group">
                        <span class="size-7 rounded-lg bg-fuchsia-500/10 border border-fuchsia-500/20 flex items-center justify-center text-fuchsia-400 group-hover:scale-110 transition-transform">
                            <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
                        </span>
                        <span>Team Users</span>
                    </a>
                }
                @if (_stats.Permissions.CanManageAttendance)
                {
                    <a href="/admin/attendance" class="flex items-center gap-3 p-3 rounded-xl bg-zinc-900/60 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 transition-all text-xs font-medium text-zinc-200 group">
                        <span class="size-7 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 group-hover:scale-110 transition-transform">
                            <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        </span>
                        <span>Attendance Admin</span>
                    </a>
                }
                @if (_stats.Permissions.CanManageLeaves)
                {
                    <a href="/admin/leave-approvals" class="flex items-center gap-3 p-3 rounded-xl bg-zinc-900/60 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 transition-all text-xs font-medium text-zinc-200 group">
                        <span class="size-7 rounded-lg bg-violet-500/10 border border-violet-500/20 flex items-center justify-center text-violet-400 group-hover:scale-110 transition-transform">
                            <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
                        </span>
                        <span>Leave Approvals</span>
                    </a>
                }
                @if (_stats.Permissions.CanManageAdvances)
                {
                    <a href="/ledger" class="flex items-center gap-3 p-3 rounded-xl bg-zinc-900/60 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 transition-all text-xs font-medium text-zinc-200 group">
                        <span class="size-7 rounded-lg bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 group-hover:scale-110 transition-transform">
                            <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        </span>
                        <span>Advance Approvals</span>
                    </a>
                }
                @if (_stats.Permissions.CanViewBoards)
                {
                    var boardsShortcutUrl = _stats.PrimaryBoardId != null ? $"/boards/{_stats.PrimaryBoardId}" : "/boards";
                    <a href="@boardsShortcutUrl" class="flex items-center gap-3 p-3 rounded-xl bg-zinc-900/60 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 transition-all text-xs font-medium text-zinc-200 group">
                        <span class="size-7 rounded-lg bg-fuchsia-500/10 border border-fuchsia-500/20 flex items-center justify-center text-fuchsia-400 group-hover:scale-110 transition-transform">
                            <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" /></svg>
                        </span>
                        <span>Kanban Boards</span>
                    </a>
                }
                @if (_stats.Permissions.CanViewLocations)
                {
                    <a href="/locations" class="flex items-center gap-3 p-3 rounded-xl bg-zinc-900/60 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 transition-all text-xs font-medium text-zinc-200 group">
                        <span class="size-7 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 group-hover:scale-110 transition-transform">
                            <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
                        </span>
                        <span>Field Radar</span>
                    </a>
                }
                @if (_stats.Permissions.CanViewClients)
                {
                    <a href="/clients" class="flex items-center gap-3 p-3 rounded-xl bg-zinc-900/60 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 transition-all text-xs font-medium text-zinc-200 group">
                        <span class="size-7 rounded-lg bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 group-hover:scale-110 transition-transform">
                            <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z" /></svg>
                        </span>
                        <span>Clients</span>
                    </a>
                }
            </div>
        </div>

        <!-- Management Detailed Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left 2 Cols: Sprint Overview & Tasks -->
            <div class="lg:col-span-2 space-y-6">
                <div class="glass-card rounded-2xl p-6">
                    <div class="flex items-center justify-between mb-5">
                        <div>
                            <h3 class="text-base font-semibold text-white">Task & Sprint Velocity</h3>
                            <p class="text-xs text-zinc-400 mt-0.5">Key deliverables and project progress</p>
                        </div>
                        @{
                            var openBoardVelocityUrl = _stats.PrimaryBoardId != null ? $"/boards/{_stats.PrimaryBoardId}" : "/boards";
                        }
                        <a href="@openBoardVelocityUrl" class="text-xs font-medium text-fuchsia-400 hover:text-fuchsia-300 flex items-center gap-1 transition-colors">
                            <span>Open Board</span>
                            <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
                        </a>
                    </div>

                    @{
                        var total = _stats.TotalTasksCount ?? 0;
                        var done = _stats.CompletedTasksCount ?? 0;
                        var inProg = _stats.InProgressTasksCount ?? 0;
                        var todo = Math.Max(0, total - done - inProg);
                        var donePct = total > 0 ? (int)Math.Round((double)done / total * 100) : 0;
                        var inProgPct = total > 0 ? (int)Math.Round((double)inProg / total * 100) : 0;
                        var todoPct = Math.Max(0, 100 - donePct - inProgPct);
                    }
                    <div class="space-y-2 mb-6">
                        <div class="flex items-center justify-between text-xs text-zinc-400">
                            <span>Completion Rate (@done of @total completed)</span>
                            <span class="font-semibold text-zinc-200">@donePct%</span>
                        </div>
                        <div class="h-2.5 w-full rounded-full bg-zinc-800 overflow-hidden flex">
                            <div class="bg-emerald-500 h-full transition-all duration-500" style="width: @donePct%"></div>
                            <div class="bg-fuchsia-500 h-full transition-all duration-500" style="width: @inProgPct%"></div>
                            <div class="bg-zinc-700 h-full transition-all duration-500" style="width: @todoPct%"></div>
                        </div>
                        <div class="flex items-center gap-4 text-[11px] text-zinc-400 pt-1">
                            <span class="flex items-center gap-1.5"><span class="size-2 rounded-full bg-zinc-600"></span> To Do (@todo)</span>
                            <span class="flex items-center gap-1.5"><span class="size-2 rounded-full bg-fuchsia-500"></span> In Progress (@inProg)</span>
                            <span class="flex items-center gap-1.5"><span class="size-2 rounded-full bg-emerald-500"></span> Done (@done)</span>
                        </div>
                    </div>

                    <!-- Task Status Breakdown Cards -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
                        <div class="p-4 rounded-xl bg-zinc-900/60 border border-zinc-800/80 flex items-center justify-between">
                            <div>
                                <p class="text-xs text-zinc-400">To Do</p>
                                <p class="text-xl font-bold text-white mt-1">@todo</p>
                            </div>
                            <div class="size-9 rounded-xl bg-zinc-800/80 border border-zinc-700/60 flex items-center justify-center text-zinc-400">
                                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>
                            </div>
                        </div>
                        <div class="p-4 rounded-xl bg-zinc-900/60 border border-zinc-800/80 flex items-center justify-between">
                            <div>
                                <p class="text-xs text-zinc-400">In Progress</p>
                                <p class="text-xl font-bold text-fuchsia-400 mt-1">@inProg</p>
                            </div>
                            <div class="size-9 rounded-xl bg-fuchsia-500/10 border border-fuchsia-500/20 flex items-center justify-center text-fuchsia-400">
                                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>
                            </div>
                        </div>
                        <div class="p-4 rounded-xl bg-zinc-900/60 border border-zinc-800/80 flex items-center justify-between">
                            <div>
                                <p class="text-xs text-zinc-400">Completed</p>
                                <p class="text-xl font-bold text-emerald-400 mt-1">@done</p>
                            </div>
                            <div class="size-9 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
                                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right 1 Col: Workspace Recent Activity -->
            <div class="space-y-6">
                <div class="glass-card rounded-2xl p-6 space-y-4">
                    <div class="flex items-center justify-between">
                        <div>
                            <h3 class="text-sm font-semibold text-white">Workspace Recent Activity</h3>
                            <p class="text-xs text-zinc-400 mt-0.5">Real-time team updates & events</p>
                        </div>
                        <span class="flex h-2 w-2 relative">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                        </span>
                    </div>

                    @if (_stats.WorkspaceRecentActivities != null && _stats.WorkspaceRecentActivities.Count > 0)
                    {
                        <div class="space-y-2.5">
                            @foreach (var act in _stats.WorkspaceRecentActivities)
                            {
                                var actUrl = act.Category switch
                                {
                                    "Attendance" => "/admin/attendance",
                                    "Leave" => "/admin/leave-approvals",
                                    "Advance" => "/ledger",
                                    "Location" => "/locations",
                                    "Task" => (_stats.PrimaryBoardId != null ? $"/boards/{_stats.PrimaryBoardId}" : "/boards"),
                                    _ => "/dashboard"
                                };
                                <a href="@actUrl" class="flex items-center justify-between p-3 rounded-xl bg-zinc-900/60 border border-zinc-800/80 hover:border-zinc-700 hover:bg-zinc-800/50 transition-all text-xs group block">
                                    <div class="flex items-center gap-3 min-w-0">
                                        <div class="size-8 rounded-xl bg-zinc-800/80 border border-zinc-700/60 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                                            @if (act.Category == "Attendance")
                                            {
                                                <svg class="size-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                            }
                                            else if (act.Category == "Leave")
                                            {
                                                <svg class="size-4 text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
                                            }
                                            else if (act.Category == "Advance")
                                            {
                                                <svg class="size-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                            }
                                            else if (act.Category == "Location")
                                            {
                                                <svg class="size-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
                                            }
                                            else if (act.Category == "Task")
                                            {
                                                <svg class="size-4 text-fuchsia-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>
                                            }
                                            else
                                            {
                                                <svg class="size-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" /></svg>
                                            }
                                        </div>
                                        <div class="min-w-0">
                                            <p class="font-medium text-zinc-200 group-hover:text-white truncate">@act.Title</p>
                                            <p class="text-[11px] text-zinc-400 truncate">@act.Description</p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2 shrink-0 ml-3">
                                        <span class="text-[10px] text-zinc-500 whitespace-nowrap">
                                            @FormatTimeAgo(act.Timestamp)
                                        </span>
                                        <svg class="size-3 text-zinc-600 group-hover:text-zinc-300 group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="p-6 text-center text-xs text-zinc-500 border border-dashed border-zinc-800 rounded-xl">
                            No team activity recorded today yet.
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- ==========================================
             PERSONAL VIEW: Employee Self-Service (ESS)
             ========================================== -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
            <!-- Card 1: My Attendance Today -->
            <a href="/my-attendance" class="glass-card-interactive rounded-2xl p-5 block group">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-zinc-400">My Attendance Today</span>
                    <div class="size-9 rounded-xl @(_stats?.PersonalClockedInToday == true ? "bg-emerald-500/10 border-emerald-500/20 text-emerald-400" : "bg-zinc-800 text-zinc-400") border flex items-center justify-center group-hover:scale-105 transition-transform">
                        <svg class="size-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                </div>
                <div class="mt-4 flex items-baseline gap-2">
                    @if (_stats?.PersonalClockedInToday == true)
                    {
                        <span class="text-2xl font-bold tracking-tight text-emerald-400">Clocked In</span>
                        <span class="size-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    }
                    else
                    {
                        <span class="text-2xl font-bold tracking-tight text-zinc-400">Not Clocked In</span>
                    }
                </div>
                <p class="mt-1 text-xs text-zinc-500">
                    @if (_stats?.PersonalClockedInToday == true && _stats.PersonalLastClockInTime.HasValue)
                    {
                        <span>Since @_stats.PersonalLastClockInTime.Value.ToLocalTime().ToString("h:mm tt") • ~@_stats.PersonalHoursWorkedToday hrs</span>
                    }
                    else
                    {
                        <span class="text-fuchsia-400 font-medium">Click to view log & punch</span>
                    }
                </p>
            </a>

            <!-- Card 2: My Assigned Tasks -->
            @{
                var personalBoardUrl = _stats?.PrimaryBoardId != null ? $"/boards/{_stats.PrimaryBoardId}" : "/boards";
            }
            <a href="@personalBoardUrl" class="glass-card-interactive rounded-2xl p-5 block group">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-zinc-400">My Tasks</span>
                    <div class="size-9 rounded-xl bg-violet-500/10 border border-violet-500/20 flex items-center justify-center text-violet-400 group-hover:scale-105 transition-transform">
                        <svg class="size-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" />
                        </svg>
                    </div>
                </div>
                <div class="mt-4 flex items-baseline gap-2">
                    <span class="text-3xl font-bold tracking-tight text-white">@(_stats?.PersonalAssignedTasksCount ?? 0)</span>
                    <span class="text-xs font-medium text-violet-400">Assigned Cards</span>
                </div>
                <p class="mt-1 text-xs text-zinc-500">Tasks assigned to you on boards</p>
            </a>

            <!-- Card 3: My Leaves -->
            <a href="/myleaves" class="glass-card-interactive rounded-2xl p-5 block group">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-zinc-400">My Leaves</span>
                    <div class="size-9 rounded-xl bg-fuchsia-500/10 border border-fuchsia-500/20 flex items-center justify-center text-fuchsia-400 group-hover:scale-105 transition-transform">
                        <svg class="size-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                        </svg>
                    </div>
                </div>
                <div class="mt-4 flex items-baseline gap-2">
                    <span class="text-3xl font-bold tracking-tight text-white">@(_stats?.PersonalPendingLeavesCount ?? 0)</span>
                    <span class="text-xs font-medium text-amber-400">Pending</span>
                </div>
                <p class="mt-1 text-xs text-zinc-500">@(_stats?.PersonalApprovedLeavesCount ?? 0) approved leaves this year</p>
            </a>

            <!-- Card 4: My Advances & Loans -->
            <a href="/advances" class="glass-card-interactive rounded-2xl p-5 block group">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-zinc-400">My Advances / Loans</span>
                    <div class="size-9 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 group-hover:scale-105 transition-transform">
                        <svg class="size-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                </div>
                <div class="mt-4 flex items-baseline gap-2">
                    @if (_stats?.PersonalActiveAdvanceAmount.HasValue == true)
                    {
                        <span class="text-2xl font-bold tracking-tight text-white">₱@(_stats.PersonalActiveAdvanceAmount.Value.ToString("N0"))</span>
                        <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20">
                            @_stats.PersonalActiveAdvanceStatus
                        </span>
                    }
                    else
                    {
                        <span class="text-2xl font-bold tracking-tight text-zinc-400">₱0.00</span>
                        <span class="text-xs font-medium text-emerald-400">No Debt</span>
                    }
                </div>
                <p class="mt-1 text-xs text-zinc-500">Apply or view deduction schedules</p>
            </a>
        </div>

        <!-- Personal Quick Actions -->
        <div class="p-4 rounded-2xl bg-zinc-900/40 border border-zinc-800/80">
            <p class="text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-3">My Shortcuts</p>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <a href="/my-attendance" class="flex items-center gap-3 p-3 rounded-xl bg-zinc-900/60 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 transition-all text-xs font-medium text-zinc-200 group">
                    <span class="size-7 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 group-hover:scale-110 transition-transform">
                        <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    </span>
                    <span>Clock In / Out</span>
                </a>
                <a href="/myleaves" class="flex items-center gap-3 p-3 rounded-xl bg-zinc-900/60 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 transition-all text-xs font-medium text-zinc-200 group">
                    <span class="size-7 rounded-lg bg-violet-500/10 border border-violet-500/20 flex items-center justify-center text-violet-400 group-hover:scale-110 transition-transform">
                        <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
                    </span>
                    <span>File Leave</span>
                </a>
                <a href="/advances" class="flex items-center gap-3 p-3 rounded-xl bg-zinc-900/60 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 transition-all text-xs font-medium text-zinc-200 group">
                    <span class="size-7 rounded-lg bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 group-hover:scale-110 transition-transform">
                        <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    </span>
                    <span>Apply Advance</span>
                </a>
                <a href="@personalBoardUrl" class="flex items-center gap-3 p-3 rounded-xl bg-zinc-900/60 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 transition-all text-xs font-medium text-zinc-200 group">
                    <span class="size-7 rounded-lg bg-fuchsia-500/10 border border-fuchsia-500/20 flex items-center justify-center text-fuchsia-400 group-hover:scale-110 transition-transform">
                        <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" /></svg>
                    </span>
                    <span>View Tasks</span>
                </a>
            </div>
        </div>

        <!-- Personal Tasks & Personal Activity Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left 2 Cols: My Assigned Tasks -->
            <div class="lg:col-span-2 space-y-6">
                <div class="glass-card rounded-2xl p-6">
                    <div class="flex items-center justify-between mb-5">
                        <div>
                            <h3 class="text-base font-semibold text-white">Tasks Assigned to Me</h3>
                            <p class="text-xs text-zinc-400 mt-0.5">Active cards requiring your attention</p>
                        </div>
                        <a href="@personalBoardUrl" class="text-xs font-medium text-fuchsia-400 hover:text-fuchsia-300 flex items-center gap-1 transition-colors">
                            <span>Open Boards</span>
                            <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
                        </a>
                    </div>

                    @if (_stats?.PersonalTasks != null && _stats.PersonalTasks.Count > 0)
                    {
                        <div class="space-y-2.5">
                            @foreach (var task in _stats.PersonalTasks)
                            {
                                var taskLink = task.BoardId != Guid.Empty ? $"/boards/{task.BoardId}" : personalBoardUrl;
                                <a href="@taskLink" class="flex items-center justify-between p-3.5 rounded-xl bg-zinc-900/60 border border-zinc-800/80 hover:border-zinc-700 hover:bg-zinc-800/50 transition-all text-xs block group">
                                    <div class="flex items-center gap-3 min-w-0">
                                        @{
                                            var isDone = task.ListName.Contains("Done", StringComparison.OrdinalIgnoreCase);
                                            var daysDiff = task.DueDate.HasValue ? (task.DueDate.Value.Date - DateTime.UtcNow.Date).TotalDays : 999;
                                            var dotClass = isDone ? "bg-emerald-400" :
                                                           (task.DueDate.HasValue && daysDiff <= 3) ? "bg-red-500" :
                                                           (task.DueDate.HasValue && daysDiff <= 7) ? "bg-orange-500" :
                                                           "bg-fuchsia-500";
                                        }
                                        <span class="size-2 rounded-full @dotClass shrink-0"></span>
                                        <div class="min-w-0">
                                            <p class="font-medium text-zinc-200 group-hover:text-white truncate">@task.Title</p>
                                            <p class="text-[11px] text-zinc-500 mt-0.5">List: <span class="text-zinc-400">@task.ListName</span></p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2 shrink-0 ml-3">
                                        @if (task.DueDate.HasValue)
                                        {
                                            var pillClass = isDone ? "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20" :
                                                            daysDiff <= 3 ? "bg-red-500/10 text-red-400 border border-red-500/20" :
                                                            daysDiff <= 7 ? "bg-orange-500/10 text-orange-400 border border-orange-500/20" :
                                                            "bg-zinc-800 text-zinc-400 border border-zinc-700/40";
                                            
                                            <span class="text-[10px] px-2 py-0.5 rounded-md @pillClass">
                                                Due @task.DueDate.Value.ToString("MMM dd")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-[10px] px-2 py-0.5 rounded-md bg-zinc-800 text-zinc-400">
                                                No Due Date
                                            </span>
                                        }
                                        <svg class="size-3 text-zinc-600 group-hover:text-zinc-300 group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="p-8 text-center text-xs text-zinc-500 border border-dashed border-zinc-800 rounded-xl">
                            No tasks currently assigned to you.
                        </div>
                    }
                </div>
            </div>

            <!-- Right 1 Col: My Recent Timeline -->
            <div class="space-y-6">
                <div class="glass-card rounded-2xl p-6 space-y-4">
                    <h3 class="text-sm font-semibold text-white">My Recent Activity</h3>
                    @if (_stats?.PersonalRecentActivities != null && _stats.PersonalRecentActivities.Count > 0)
                    {
                        <div class="space-y-3">
                            @foreach (var act in _stats.PersonalRecentActivities)
                            {
                                var personalActUrl = act.Category switch
                                {
                                    "Attendance" => "/my-attendance",
                                    "Leave" => "/myleaves",
                                    "Advance" => "/advances",
                                    "Task" => personalBoardUrl,
                                    _ => "/dashboard"
                                };
                                <a href="@personalActUrl" class="p-2.5 rounded-xl bg-zinc-900/50 border border-zinc-800/60 hover:border-zinc-700 hover:bg-zinc-800/40 transition-all text-xs block group">
                                    <div class="flex items-center justify-between">
                                        <span class="font-medium text-zinc-200 group-hover:text-white">@act.Title</span>
                                        <span class="text-[10px] text-zinc-500">@FormatTimeAgo(act.Timestamp)</span>
                                    </div>
                                    <p class="text-[11px] text-zinc-400 mt-0.5">@act.Description</p>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-xs text-zinc-500 py-4 text-center">No personal activity logged today.</p>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private enum DashboardTab { Team, Personal }
    private DashboardTab _activeTab = DashboardTab.Team;

    private string? _firstName;
    private DashboardStatsDto? _stats;
    private bool _isLoading = false;
    private HubConnection? _hubConnection;

    public class DashboardPermissionsDto
    {
        public bool CanManageLeaves { get; set; }
        public bool CanManageAttendance { get; set; }
        public bool CanManageUsers { get; set; }
        public bool CanManageAdvances { get; set; }
        public bool CanManagePayroll { get; set; }
        public bool CanViewBoards { get; set; }
        public bool CanViewLocations { get; set; }
        public bool CanViewClients { get; set; }
        public bool CanViewInvoices { get; set; }
    }

    public class PersonalTaskItemDto
    {
        public Guid CardId { get; set; }
        public Guid BoardId { get; set; }
        public string Title { get; set; } = string.Empty;
        public string ListName { get; set; } = string.Empty;
        public DateTime? DueDate { get; set; }
    }

    public class DashboardStatsDto
    {
        public string RoleName { get; set; } = "Employee";
        public bool IsManager { get; set; }
        public DashboardPermissionsDto Permissions { get; set; } = new();

        public bool PersonalClockedInToday { get; set; }
        public DateTimeOffset? PersonalLastClockInTime { get; set; }
        public double PersonalHoursWorkedToday { get; set; }
        public int PersonalPendingLeavesCount { get; set; }
        public int PersonalApprovedLeavesCount { get; set; }
        public int PersonalAssignedTasksCount { get; set; }
        public List<PersonalTaskItemDto> PersonalTasks { get; set; } = new();
        public decimal? PersonalActiveAdvanceAmount { get; set; }
        public string? PersonalActiveAdvanceStatus { get; set; }

        public int? TotalEmployees { get; set; }
        public int? PresentTodayCount { get; set; }
        public double? AttendanceRatePercent { get; set; }
        public int? PendingLeavesCount { get; set; }
        public int? PendingAdvancesCount { get; set; }
        public int? TotalTasksCount { get; set; }
        public int? CompletedTasksCount { get; set; }
        public int? InProgressTasksCount { get; set; }
        public int? ActiveOutsideStaffCount { get; set; }
        public Guid? PrimaryBoardId { get; set; }
        public string DatabaseEngine { get; set; } = "PostgreSQL 18";
        public List<DashboardActivityItemDto> PersonalRecentActivities { get; set; } = new();
        public List<DashboardActivityItemDto> WorkspaceRecentActivities { get; set; } = new();
        public List<DashboardActivityItemDto> RecentActivities { get; set; } = new();
    }

    public class DashboardActivityItemDto
    {
        public string Id { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
        public string BadgeColor { get; set; } = "emerald";
        public DateTime Timestamp { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _firstName = authState.User.FindFirst("FirstName")?.Value;
        }
        catch
        {
            _firstName = null;
        }

        await LoadDashboardStats();
        await ConnectToHub();
    }

    private async Task ConnectToHub()
    {
        var hubUrl = new Uri(Http.BaseAddress!, "hubs/notifications").ToString();

        _hubConnection = new HubConnectionBuilder()
            .WithUrl(hubUrl, options =>
            {
                options.HttpMessageHandlerFactory = handler => new OfficeCore.Web.Client.Auth.CookieHandler { InnerHandler = handler };
            })
            .WithAutomaticReconnect()
            .Build();

        Func<Task> reloadData = async () =>
        {
            await LoadDashboardStats();
            await InvokeAsync(StateHasChanged);
        };

        _hubConnection.On("LeaveRequestCreated", reloadData);
        _hubConnection.On("LeaveRequestUpdated", reloadData);
        _hubConnection.On("LeaveRequestDeleted", reloadData);
        _hubConnection.On("AdvanceRequestCreated", reloadData);
        _hubConnection.On("AdvanceRequestUpdated", reloadData);
        _hubConnection.On("AdvanceRequestDeleted", reloadData);
        _hubConnection.On("ExpenseCreated", reloadData);
        _hubConnection.On("ExpenseDeleted", reloadData);
        _hubConnection.On("BoardUpdated", reloadData);
        _hubConnection.On("TaskUpdated", reloadData);
        _hubConnection.On("TaskAssigned", reloadData);
        _hubConnection.On("AttendanceUpdated", reloadData);
        _hubConnection.On("EmployeeUpdated", reloadData);
        _hubConnection.On("MemberJoined", reloadData);

        try { await _hubConnection.StartAsync(); } catch { }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
            await _hubConnection.DisposeAsync();
    }

    private async Task LoadDashboardStats()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            var result = await Http.GetFromJsonAsync<DashboardStatsDto>("api/dashboard/stats");
            if (result != null)
            {
                _stats = result;
                _activeTab = _stats.IsManager ? DashboardTab.Team : DashboardTab.Personal;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Dashboard] Failed to load stats: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private string FormatTimeAgo(DateTime timestamp)
    {
        var diff = DateTime.UtcNow - timestamp;
        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return timestamp.ToLocalTime().ToString("MMM dd");
    }
}
