@page "/my-payslips"
@attribute [Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>My Payslips - OfficeCore</PageTitle>

<div class="space-y-6 max-w-5xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold tracking-tight text-white">My Payslips</h1>
            <p class="mt-1 text-zinc-400 text-sm">
                View and print your payroll slips for each pay period.
            </p>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="flex justify-center p-12">
            <div class="animate-spin size-8 border-4 border-fuchsia-600 border-t-transparent rounded-full"></div>
        </div>
    }
    else if (_payslips == null || !_payslips.Any())
    {
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-12 text-center">
            <svg class="size-12 text-zinc-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <h3 class="text-lg font-medium text-white mb-1">No Payslips Yet</h3>
            <p class="text-zinc-500 text-sm max-w-sm mx-auto">Your payslips will appear here once payroll has been processed for your assigned pay periods.</p>
        </div>
    }
    else
    {
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden">
            <table class="w-full text-left text-sm whitespace-nowrap">
                <thead class="bg-zinc-950/50 text-zinc-400 font-medium border-b border-zinc-800">
                    <tr>
                        <th class="px-6 py-4">Payroll Period</th>
                        <th class="px-6 py-4">Gross Pay</th>
                        <th class="px-6 py-4">Net Take Home Pay</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-800/50">
                    @foreach (var p in _payslips)
                    {
                        <tr class="hover:bg-zinc-800/20 transition-colors">
                            <td class="px-6 py-4 text-white font-medium">
                                @(p.PayrollPeriodStart.ToString("MMM dd, yyyy")) - @(p.PayrollPeriodEnd.ToString("MMM dd, yyyy"))
                            </td>
                            <td class="px-6 py-4 text-zinc-300">
                                @p.GrossPay.ToString("C")
                            </td>
                            <td class="px-6 py-4">
                                <span class="font-bold text-emerald-400">@p.NetPay.ToString("C")</span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <a href="/print-payslip/@p.Id" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-fuchsia-400 hover:text-fuchsia-300 bg-fuchsia-400/10 hover:bg-fuchsia-400/20 rounded-lg transition-colors">
                                    <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                                    </svg>
                                    View / Print
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<MyPayslipDto>? _payslips;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _payslips = await Http.GetFromJsonAsync<List<MyPayslipDto>>("/api/payroll/my-payslips");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching payslips: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    public class MyPayslipDto
    {
        public Guid Id { get; set; }
        public DateOnly PayrollPeriodStart { get; set; }
        public DateOnly PayrollPeriodEnd { get; set; }
        public decimal GrossPay { get; set; }
        public decimal NetPay { get; set; }
    }
}
