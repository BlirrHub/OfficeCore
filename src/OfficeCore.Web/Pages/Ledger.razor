@page "/ledger"
@attribute [Authorize(Policy = "RequireLedger")]
@inject HttpClient Http

<PageTitle>Ledger - OfficeCore</PageTitle>

<div class="flex flex-col h-full bg-zinc-950">
    <div class="border-b border-zinc-800 px-6 pt-4 flex items-center justify-between">
        <div class="flex gap-6">
            <button @onclick='() => _activeTab = "approvals"' class='pb-3 text-sm font-medium border-b-2 transition-colors @(_activeTab == "approvals" ? "border-purple-500 text-purple-400" : "border-transparent text-zinc-500 hover:text-zinc-300")'>
                Advance & Loan Approvals
            </button>
            <button @onclick='() => _activeTab = "expenses"' class='pb-3 text-sm font-medium border-b-2 transition-colors @(_activeTab == "expenses" ? "border-purple-500 text-purple-400" : "border-transparent text-zinc-500 hover:text-zinc-300")'>
                Expenses & Equipment
            </button>
        </div>
        
        @if (_activeTab == "expenses")
        {
            <button @onclick="() => _isAddingExpense = true" class="px-4 py-2 mb-3 text-sm font-medium text-white bg-purple-600 rounded-lg hover:bg-purple-500 transition-colors shadow-lg shadow-purple-900/30 flex items-center gap-2">
                <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                Log Expense
            </button>
        }
    </div>

    <div class="flex-1 overflow-y-auto p-8 relative">
        @if (_activeTab == "approvals")
        {
            @if (_requests == null)
            {
                <div class="flex items-center justify-center py-12 text-zinc-500">Loading approvals...</div>
            }
            else
            {
                var filteredRequests = GetFilteredRequests();
                
                <!-- Filters -->
                <div class="max-w-6xl mx-auto mb-6 bg-zinc-900 border border-zinc-800 rounded-xl p-4 flex flex-wrap gap-4 items-end">
                    <div class="flex-1 min-w-[200px]">
                        <label class="block text-xs font-medium text-zinc-500 uppercase tracking-wider mb-1">Employee</label>
                        <input type="text" @bind="_filterEmployee" @bind:event="oninput" placeholder="Search by name..." class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-zinc-500 uppercase tracking-wider mb-1">Status</label>
                        <select @bind="_filterStatus" class="bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none min-w-[140px]">
                            <option value="All">All</option>
                            <option value="Pending">Pending</option>
                            <option value="Approved">Approved</option>
                            <option value="Rejected">Rejected</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-zinc-500 uppercase tracking-wider mb-1">Start Date</label>
                        <input type="date" @bind="_filterStartDate" class="bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-zinc-500 uppercase tracking-wider mb-1">End Date</label>
                        <input type="date" @bind="_filterEndDate" class="bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none" />
                    </div>
                    <button @onclick="ClearFilters" class="px-4 py-2 text-sm font-medium text-zinc-400 hover:text-white bg-zinc-800 rounded-lg transition-colors">
                        Clear
                    </button>
                </div>
                
                @if (!filteredRequests.Any())
                {
                    <div class="p-12 text-center text-zinc-500 italic text-sm">No requests match the current filters.</div>
                }
                else
                {
                    <div class="w-full">
                        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl shadow-xl overflow-hidden">
                            <table class="w-full text-left text-sm whitespace-nowrap">
                                <thead class="bg-zinc-950/50 text-zinc-500 uppercase tracking-wider text-xs font-semibold">
                                    <tr>
                                        <th class="px-6 py-4 border-b border-zinc-800">Date Requested</th>
                                        <th class="px-6 py-4 border-b border-zinc-800">Employee</th>
                                        <th class="px-6 py-4 border-b border-zinc-800">Type</th>
                                        <th class="px-6 py-4 border-b border-zinc-800 text-right">Amount</th>
                                        <th class="px-6 py-4 border-b border-zinc-800 text-right">Installments</th>
                                        <th class="px-6 py-4 border-b border-zinc-800 text-center">Status</th>
                                        <th class="px-6 py-4 border-b border-zinc-800 text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-zinc-800/50">
                                    @foreach (var req in filteredRequests)
                                {
                                    <tr class="hover:bg-zinc-800/50 transition-colors">
                                        <td class="px-6 py-4 text-zinc-300">
                                            <div class="font-medium text-white">@req.RequestDate.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="font-medium text-white">@req.EmployeeName</div>
                                            <div class="text-xs text-zinc-500 truncate max-w-[200px]" title="@req.Note">@req.Note</div>
                                        </td>
                                        <td class="px-6 py-4">
                                            @if (req.Type == AdvanceType.CashAdvance)
                                            {
                                                <span class="inline-flex items-center gap-1.5 py-1 px-2 rounded-md text-xs font-medium bg-fuchsia-900/20 text-fuchsia-400 border border-fuchsia-900/50">
                                                    Cash Advance
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center gap-1.5 py-1 px-2 rounded-md text-xs font-medium bg-emerald-900/20 text-emerald-400 border border-emerald-900/50">
                                                    E-Loan
                                                </span>
                                            }
                                        </td>
                                        <td class="px-6 py-4 text-right font-medium text-white">
                                            @req.RequestedAmount.ToString("C")
                                        </td>
                                        <td class="px-6 py-4 text-right text-zinc-400">
                                            @(req.InstallmentAmount.HasValue ? req.InstallmentAmount.Value.ToString("C") : "-")
                                        </td>
                                        <td class="px-6 py-4 text-center">
                                            @if (req.Status == AdvanceStatus.Pending)
                                            {
                                                <span class="inline-flex items-center gap-1.5 py-1 px-2 rounded-md text-xs font-medium bg-yellow-900/20 text-yellow-400 border border-yellow-900/50">
                                                    Pending
                                                </span>
                                            }
                                            else if (req.Status == AdvanceStatus.Approved)
                                            {
                                                <span class="inline-flex items-center gap-1.5 py-1 px-2 rounded-md text-xs font-medium bg-green-900/20 text-green-400 border border-green-900/50">
                                                    Approved
                                                </span>
                                            }
                                            else if (req.Status == AdvanceStatus.Rejected)
                                            {
                                                <span class="inline-flex items-center gap-1.5 py-1 px-2 rounded-md text-xs font-medium bg-red-900/20 text-red-400 border border-red-900/50">
                                                    Rejected
                                                </span>
                                            }
                                            else if (req.Status == AdvanceStatus.Cancelled)
                                            {
                                                <span class="inline-flex items-center gap-1.5 py-1 px-2 rounded-md text-xs font-medium bg-zinc-800 text-zinc-400 border border-zinc-700">
                                                    Cancelled
                                                </span>
                                            }
                                        </td>
                                        <td class="px-6 py-4 text-right">
                                            @if (req.Status == AdvanceStatus.Pending)
                                            {
                                                <div class="flex justify-end gap-2">
                                                    <button @onclick="() => ShowApprovalModal(req)" class="text-xs font-medium px-2.5 py-1.5 bg-green-900/30 text-green-400 rounded hover:bg-green-800/50 transition-colors border border-green-900/50">Approve</button>
                                                    <button @onclick="() => RejectRequest(req.Id)" class="text-xs font-medium px-2.5 py-1.5 bg-red-900/30 text-red-400 rounded hover:bg-red-800/50 transition-colors border border-red-900/50">Reject</button>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
        else if (_activeTab == "expenses")
        {
            @if (_isAddingExpense)
            {
                <div class="max-w-2xl mx-auto bg-zinc-900 border border-zinc-800 rounded-2xl p-8 shadow-xl mb-8">
                    <div class="flex items-center justify-between border-b border-zinc-800 pb-4 mb-6">
                        <h2 class="text-xl font-bold text-white uppercase tracking-wider">Log Company Expense</h2>
                    </div>

                    <div class="space-y-6">
                        <div>
                            <label class="block text-sm font-medium text-zinc-400 mb-2">Category</label>
                            <select @bind="_newExpense.Category" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-white focus:border-purple-500 focus:outline-none">
                                <option value="@ExpenseCategory.GeneralExpense">General Expense</option>
                                <option value="@ExpenseCategory.EquipmentPurchase">Equipment Purchase</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-zinc-400 mb-2">Description</label>
                            <input type="text" @bind="_newExpense.Description" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-white focus:border-purple-500 focus:outline-none" placeholder="e.g. Office Supplies, Monitor, etc." />
                        </div>

                        <div class="flex gap-4">
                            <div class="flex-1">
                                <label class="block text-sm font-medium text-zinc-400 mb-2">Amount</label>
                                <div class="relative">
                                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-zinc-500">$</span>
                                    <input type="number" @bind="_newExpense.Amount" step="0.01" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-8 pr-4 py-3 text-white focus:border-purple-500 focus:outline-none" placeholder="0.00" />
                                </div>
                            </div>
                            <div class="flex-1">
                                <label class="block text-sm font-medium text-zinc-400 mb-2">Date Incurred</label>
                                <input type="date" @bind="_newExpense.DateIncurred" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-white focus:border-purple-500 focus:outline-none" />
                            </div>
                        </div>
                    </div>

                    <div class="mt-8 pt-6 border-t border-zinc-800 flex justify-end gap-3">
                        <button @onclick="() => _isAddingExpense = false" class="px-5 py-2.5 text-sm font-medium text-zinc-400 hover:text-white transition-colors">Cancel</button>
                        <button @onclick="SubmitExpense" class="px-5 py-2.5 text-sm font-medium text-white bg-purple-600 rounded-lg hover:bg-purple-500 transition-colors shadow-lg shadow-purple-900/30">Save Expense</button>
                    </div>
                </div>
            }

            @if (_expenses == null)
            {
                <div class="flex items-center justify-center py-12 text-zinc-500">Loading expenses...</div>
            }
            else
            {
                <div class="w-full">
                    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl shadow-xl overflow-hidden">
                        <table class="w-full text-left text-sm whitespace-nowrap">
                            <thead class="bg-zinc-950/50 text-zinc-500 uppercase tracking-wider text-xs font-semibold">
                                <tr>
                                    <th class="px-6 py-4 border-b border-zinc-800">Date</th>
                                    <th class="px-6 py-4 border-b border-zinc-800">Description</th>
                                    <th class="px-6 py-4 border-b border-zinc-800">Category</th>
                                    <th class="px-6 py-4 border-b border-zinc-800 text-right">Amount</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-zinc-800/50">
                                @foreach (var exp in _expenses)
                                {
                                    <tr class="hover:bg-zinc-800/50 transition-colors">
                                        <td class="px-6 py-4 text-zinc-300">@exp.DateIncurred.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                        <td class="px-6 py-4 font-medium text-white">@exp.Description</td>
                                        <td class="px-6 py-4">
                                            @if (exp.Category == ExpenseCategory.GeneralExpense)
                                            {
                                                <span class="inline-flex items-center gap-1.5 py-1 px-2 rounded-md text-xs font-medium bg-blue-900/20 text-blue-400 border border-blue-900/50">
                                                    General
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center gap-1.5 py-1 px-2 rounded-md text-xs font-medium bg-orange-900/20 text-orange-400 border border-orange-900/50">
                                                    Equipment
                                                </span>
                                            }
                                        </td>
                                        <td class="px-6 py-4 text-right font-bold text-red-400">
                                            -@exp.Amount.ToString("C")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    </div>
</div>

@if (_approvingRequest != null)
{
    <div class="fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center z-50 p-4">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-md shadow-2xl overflow-hidden transform transition-all">
            <div class="px-6 py-4 border-b border-zinc-800 flex items-center justify-between bg-zinc-900/50">
                <h3 class="text-lg font-bold text-white tracking-wide uppercase">Approve @(_approvingRequest.Type == AdvanceType.ELoan ? "E-Loan" : "Cash Advance")</h3>
                <button @onclick="() => _approvingRequest = null" class="text-zinc-500 hover:text-white transition-colors">
                    <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>
            <div class="p-6">
                <div class="mb-6 space-y-2">
                    <div class="flex justify-between text-sm">
                        <span class="text-zinc-500">Employee:</span>
                        <span class="font-medium text-white">@_approvingRequest.EmployeeName</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-zinc-500">Requested Amount:</span>
                        <span class="font-bold text-emerald-400">@_approvingRequest.RequestedAmount.ToString("C")</span>
                    </div>
                </div>

                @if (_approvingRequest.Type == AdvanceType.ELoan)
                {
                    <div class="space-y-4">
                        <div class="p-4 bg-emerald-900/10 border border-emerald-900/30 rounded-xl">
                            <p class="text-sm text-emerald-400/80 mb-3">Set the amount to be deducted from the employee's salary each payroll period until the E-Loan is fully paid.</p>
                            <label class="block text-xs font-medium text-emerald-500 uppercase tracking-wider mb-2">Installment Amount (per payroll)</label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-emerald-600/50">$</span>
                                <input type="number" @bind="_approvalInstallment" step="0.01" class="w-full bg-zinc-950 border border-emerald-900/50 rounded-lg pl-8 pr-4 py-3 text-white focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-all" placeholder="0.00" />
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-sm text-zinc-400 bg-zinc-950 p-4 rounded-xl border border-zinc-800">
                        This Cash Advance will be deducted entirely from the employee's next payroll.
                    </p>
                }

                <div class="mt-8 flex gap-3">
                    <button @onclick="() => _approvingRequest = null" class="flex-1 py-2.5 rounded-lg text-sm font-medium text-zinc-400 bg-zinc-800/50 hover:bg-zinc-800 hover:text-white transition-all">Cancel</button>
                    <button @onclick="ConfirmApprove" class="flex-1 py-2.5 rounded-lg text-sm font-bold text-white bg-green-600 hover:bg-green-500 shadow-lg shadow-green-900/20 transition-all">Confirm Approval</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string _activeTab = "approvals";
    
    // Approvals State
    private List<AdminAdvanceRequestDto>? _requests;
    private AdminAdvanceRequestDto? _approvingRequest;
    private decimal _approvalInstallment = 0;
    
    // Filters for Approvals
    private string _filterStatus = "All";
    private DateTime? _filterStartDate;
    private DateTime? _filterEndDate;
    private string _filterEmployee = "";

    private IEnumerable<AdminAdvanceRequestDto> GetFilteredRequests()
    {
        if (_requests == null) return Array.Empty<AdminAdvanceRequestDto>();
        var query = _requests.AsEnumerable();
        
        if (_filterStatus != "All")
        {
            if (Enum.TryParse<AdvanceStatus>(_filterStatus, out var status))
                query = query.Where(r => r.Status == status);
        }
        
        if (_filterStartDate.HasValue)
            query = query.Where(r => r.RequestDate.Date >= _filterStartDate.Value.Date);
            
        if (_filterEndDate.HasValue)
            query = query.Where(r => r.RequestDate.Date <= _filterEndDate.Value.Date);
            
        if (!string.IsNullOrWhiteSpace(_filterEmployee))
            query = query.Where(r => r.EmployeeName.Contains(_filterEmployee, StringComparison.OrdinalIgnoreCase));
            
        return query;
    }

    private void ClearFilters()
    {
        _filterStatus = "All";
        _filterStartDate = null;
        _filterEndDate = null;
        _filterEmployee = "";
    }

    // Expenses State
    private List<CompanyExpenseDto>? _expenses;
    private bool _isAddingExpense = false;
    private CreateCompanyExpenseDto _newExpense = new() { DateIncurred = DateTime.Today };

    protected override async Task OnInitializedAsync()
    {
        await LoadRequests();
        await LoadExpenses();
    }

    private async Task LoadRequests()
    {
        _requests = await Http.GetFromJsonAsync<List<AdminAdvanceRequestDto>>("/api/advancerequest");
    }

    private async Task LoadExpenses()
    {
        _expenses = await Http.GetFromJsonAsync<List<CompanyExpenseDto>>("/api/companyexpense");
    }

    private void ShowApprovalModal(AdminAdvanceRequestDto request)
    {
        _approvingRequest = request;
        _approvalInstallment = request.RequestedAmount * 0.1m; // Default to 10%
    }

    private async Task ConfirmApprove()
    {
        if (_approvingRequest == null) return;

        var dto = new { InstallmentAmount = _approvingRequest.Type == AdvanceType.ELoan ? (decimal?)_approvalInstallment : null };
        var response = await Http.PutAsJsonAsync($"/api/advancerequest/{_approvingRequest.Id}/approve", dto);
        
        if (response.IsSuccessStatusCode)
        {
            _approvingRequest = null;
            await LoadRequests();
        }
    }

    private async Task RejectRequest(Guid id)
    {
        var response = await Http.PutAsync($"/api/advancerequest/{id}/reject", null);
        if (response.IsSuccessStatusCode)
        {
            await LoadRequests();
        }
    }

    private async Task SubmitExpense()
    {
        if (_newExpense.Amount <= 0 || string.IsNullOrWhiteSpace(_newExpense.Description)) return;

        var response = await Http.PostAsJsonAsync("/api/companyexpense", _newExpense);
        if (response.IsSuccessStatusCode)
        {
            _isAddingExpense = false;
            _newExpense = new CreateCompanyExpenseDto { DateIncurred = DateTime.Today };
            await LoadExpenses();
        }
    }

    public enum AdvanceType { CashAdvance, ELoan }
    public enum AdvanceStatus { Pending, Approved, Rejected, Cancelled }
    public enum ExpenseCategory { GeneralExpense, EquipmentPurchase }

    public class AdminAdvanceRequestDto
    {
        public Guid Id { get; set; }
        public AdvanceType Type { get; set; }
        public decimal RequestedAmount { get; set; }
        public string Note { get; set; } = string.Empty;
        public AdvanceStatus Status { get; set; }
        public DateTime RequestDate { get; set; }
        public decimal? RemainingBalance { get; set; }
        public decimal? InstallmentAmount { get; set; }
        public string EmployeeName { get; set; } = string.Empty;
    }

    public class CompanyExpenseDto
    {
        public Guid Id { get; set; }
        public string Description { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public ExpenseCategory Category { get; set; }
        public DateTime DateIncurred { get; set; }
    }

    public class CreateCompanyExpenseDto
    {
        public string Description { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public ExpenseCategory Category { get; set; }
        public DateTime DateIncurred { get; set; }
    }
}
