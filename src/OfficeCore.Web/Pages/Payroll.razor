@page "/payroll"
@attribute [Authorize(Policy = "RequirePayroll")]
@inject HttpClient Http

<PageTitle>Payroll - OfficeCore</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight text-white">Payroll</h1>
        <p class="mt-2 text-zinc-400">Process employee payroll, salaries, and manage deduction settings.</p>
    </div>

    <!-- Tabs -->
    <div class="flex border-b border-zinc-800">
        <button @onclick="() => _activeTab = Tab.Generation"
                class="@(_activeTab == Tab.Generation ? "border-fuchsia-500 text-fuchsia-400" : "border-transparent text-zinc-400 hover:text-zinc-300 hover:border-zinc-700") px-4 py-3 border-b-2 font-medium text-sm transition-colors">
            Payroll Generation
        </button>
        <AuthorizeView Roles="Admin">
            <button @onclick="() => _activeTab = Tab.Settings"
                    class="@(_activeTab == Tab.Settings ? "border-fuchsia-500 text-fuchsia-400" : "border-transparent text-zinc-400 hover:text-zinc-300 hover:border-zinc-700") px-4 py-3 border-b-2 font-medium text-sm transition-colors">
                Deduction Settings
            </button>
        </AuthorizeView>
    </div>

    @if (_activeTab == Tab.Generation)
    {
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-12 flex items-center justify-center">
            <p class="text-zinc-500 italic">This module is under construction.</p>
        </div>
    }
    else if (_activeTab == Tab.Settings)
    {
        <div class="bg-zinc-950 border border-zinc-800 rounded-2xl overflow-hidden p-6 max-w-4xl">
            <h2 class="text-xl font-semibold text-white mb-4">Government Deductions (Monthly)</h2>
            <p class="text-sm text-zinc-400 mb-6">Set the global monthly deduction amounts for SSS, PhilHealth, and Pag-IBIG. The system will automatically calculate the proportional amount for each payroll generated.</p>

            @if (_settings == null)
            {
                <div class="flex items-center gap-3 text-zinc-500 text-sm">
                    <svg class="animate-spin size-5" viewBox="0 0 24 24" fill="none">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                    </svg>
                    Loading settings...
                </div>
            }
            else
            {
                <div class="space-y-4">
                    <table class="w-full text-sm text-left">
                        <thead class="border-b border-zinc-800 text-zinc-400">
                            <tr>
                                <th class="pb-3 font-medium">Agency</th>
                                <th class="pb-3 font-medium">Employee Share (₱)</th>
                                <th class="pb-3 font-medium">Employer Share (₱)</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-zinc-800/50">
                            @foreach (var setting in _settings)
                            {
                                <tr class="hover:bg-zinc-900/50 transition-colors group">
                                    <td class="py-4 font-medium text-white">@setting.AgencyName</td>
                                    <td class="py-4">
                                        <input type="number" step="0.01" @bind="setting.EmployeeShare" class="w-32 rounded-lg bg-zinc-900 border border-zinc-700 px-3 py-1.5 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none transition-colors" />
                                    </td>
                                    <td class="py-4">
                                        <input type="number" step="0.01" @bind="setting.EmployerShare" class="w-32 rounded-lg bg-zinc-900 border border-zinc-700 px-3 py-1.5 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none transition-colors" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (!string.IsNullOrEmpty(_message))
                    {
                        <p class="@(_isError ? "text-red-400" : "text-emerald-400") text-sm">@_message</p>
                    }

                    <div class="flex justify-end pt-4 border-t border-zinc-800">
                        <button @onclick="SaveSettings" disabled="@_isSaving"
                                class="flex items-center gap-2 rounded-lg bg-fuchsia-600 px-5 py-2 text-sm font-semibold text-white hover:bg-fuchsia-500 transition-colors shadow-lg shadow-fuchsia-900/30 disabled:opacity-50">
                            @if (_isSaving)
                            {
                                <svg class="animate-spin size-4" viewBox="0 0 24 24" fill="none">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                                </svg>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>Save Changes</span>
                            }
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private enum Tab { Generation, Settings }
    private Tab _activeTab = Tab.Generation;
    
    // Settings state
    private List<GovernmentDeductionSettingDto>? _settings;
    private bool _isSaving = false;
    private string? _message;
    private bool _isError = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        try
        {
            _settings = await Http.GetFromJsonAsync<List<GovernmentDeductionSettingDto>>("/api/payrollsettings/deductions");
        }
        catch (Exception)
        {
            _message = "Failed to load settings.";
            _isError = true;
        }
    }

    private async Task SaveSettings()
    {
        if (_settings == null) return;

        _isSaving = true;
        _message = null;
        _isError = false;

        try
        {
            var response = await Http.PutAsJsonAsync("/api/payrollsettings/deductions", _settings);
            if (response.IsSuccessStatusCode)
            {
                _message = "Settings saved successfully!";
            }
            else
            {
                _message = "Failed to save settings.";
                _isError = true;
            }
        }
        catch (Exception)
        {
            _message = "An error occurred while saving.";
            _isError = true;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private class GovernmentDeductionSettingDto
    {
        public Guid Id { get; set; }
        public string AgencyName { get; set; } = string.Empty;
        public decimal EmployeeShare { get; set; }
        public decimal EmployerShare { get; set; }
    }
}
