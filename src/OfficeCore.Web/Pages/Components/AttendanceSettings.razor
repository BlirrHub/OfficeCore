@using Microsoft.AspNetCore.Components.Web
@inject HttpClient Http
@inject HubConnectionFactory HubFactory
@inject ToastService ToastService
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop
@inject IJSRuntime JS

<div class="space-y-6">

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 items-start">
        
        <!-- Device Configuration + USB Connection (combined 2-col card) -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6">
            <h2 class="text-xl font-semibold text-white mb-6">Device Connection</h2>
            
            @if (_isLoading)
            {
                <div class="flex items-center justify-center py-8">
                    <svg class="animate-spin size-8 text-fuchsia-500" viewBox="0 0 24 24" fill="none">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                    </svg>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    
                    <!-- Left: Settings -->
                    <div class="space-y-4">
                        <div class="grid grid-cols-1 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-zinc-400 mb-1.5">Device Name</label>
                                <input type="text" @bind="_device.Name" @bind:event="oninput" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-2.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none focus:ring-1 focus:ring-fuchsia-500" placeholder="e.g. Main Lobby Scanner" />
                            </div>
                            
                            <div>
                                <label class="block text-sm font-medium text-zinc-400 mb-1.5">Connection Protocol</label>
                                <select @bind="_device.ConnectionType" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-2.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none focus:ring-1 focus:ring-fuchsia-500">
                                    <option value="0">Wired (USB COM Port via Browser)</option>
                                    <option value="1">Wi-Fi (TCP Server via Cloud API)</option>
                                </select>
                            </div>
                        </div>

                        @if (_device.ConnectionType == 1)
                        {
                            <div class="bg-zinc-950 border border-zinc-800 p-4 rounded-xl text-sm text-zinc-500 space-y-1">
                                <li><span class="text-zinc-300">Mode:</span> TCP Client</li>
                                <li><span class="text-zinc-300">Port:</span> 9000</li>
                            </div>
                        }
                        
                        <div class="flex items-center gap-3">
                            <input type="checkbox" id="deviceActive" @bind="_device.IsActive" class="w-4 h-4 rounded border-zinc-700 bg-zinc-950 text-fuchsia-600 focus:ring-fuchsia-600" />
                            <label for="deviceActive" class="text-sm font-medium text-white cursor-pointer">Device is Active globally</label>
                        </div>

                        <button @onclick="SaveDevice" class="w-full py-2.5 px-4 text-sm font-medium text-white bg-zinc-800 border border-zinc-700 rounded-xl hover:bg-zinc-700 transition-colors">
                            Save Configuration
                        </button>
                    </div>

                    <!-- Right: Dynamic Connection pane -->
                    <div class="border-l border-zinc-800 pl-6">
                        @if (_device.ConnectionType == 0)
                        {
                            <h3 class="text-base font-semibold text-white mb-1">Direct USB Connection</h3>
                            <p class="text-xs text-zinc-400 mb-4">Connect via USB to enroll fingerprints or provision Wi-Fi.</p>

                            @if (!_isSerialConnected)
                            {
                                <button @onclick="ConnectSerial" class="w-full py-2.5 px-4 text-sm font-medium text-fuchsia-400 bg-fuchsia-500/10 border border-fuchsia-500/20 rounded-xl hover:bg-fuchsia-500/20 transition-colors flex items-center justify-center gap-2">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                                    Connect USB Scanner
                                </button>
                            }
                            else
                            {
                                <div class="flex items-center justify-between p-3 bg-emerald-500/10 border border-emerald-500/20 rounded-xl mb-4">
                                    <div class="flex items-center gap-2 text-sm font-medium text-emerald-400">
                                        <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
                                        Scanner Connected
                                    </div>
                                    <button @onclick="DisconnectSerial" class="text-xs font-medium text-zinc-400 hover:text-white transition-colors">Disconnect</button>
                                </div>
                                
                                <div class="bg-zinc-950 border border-zinc-800 rounded-xl p-4">
                                    <h4 class="text-sm font-medium text-white mb-3">Provision Wi-Fi</h4>
                                    <div class="space-y-2">
                                        <input type="text" @bind="_wifiSsid" placeholder="Wi-Fi SSID" class="w-full bg-zinc-900 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none" />
                                        
                                        <div class="relative">
                                            <input type="@(_showWifiPassword ? "text" : "password")" @bind="_wifiPassword" placeholder="Wi-Fi Password" class="w-full bg-zinc-900 border border-zinc-800 rounded-lg pl-3 pr-10 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none" />
                                            <button type="button" @onclick="() => _showWifiPassword = !_showWifiPassword" class="absolute inset-y-0 right-0 pr-3 flex items-center text-zinc-500 hover:text-zinc-300 transition-colors">
                                                @if (_showWifiPassword)
                                                {
                                                    <svg class="size-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" /></svg>
                                                }
                                                else
                                                {
                                                    <svg class="size-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                                }
                                            </button>
                                        </div>
                                        
                                        <input type="text" @bind="_wifiServerIp" placeholder="API Server IP" class="w-full bg-zinc-900 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none" />
                                        
                                        @if (!string.IsNullOrEmpty(_wifiProvisionStatus))
                                        {
                                            <div class="text-xs font-medium px-1 py-0.5 @(_wifiProvisionStatus.ToLower().Contains("error") ? "text-red-400" : "text-emerald-400")">
                                                @_wifiProvisionStatus
                                            </div>
                                        }
                                        
                                        <button @onclick="SendWifiConfig" class="w-full py-2 text-sm font-medium text-white bg-zinc-800 border border-zinc-700 rounded-lg hover:bg-zinc-700 transition-colors">
                                            Send to Device
                                        </button>
                                    </div>
                                </div>

                                <div class="flex gap-2 mt-3">
                                    <button @onclick="PromptResetWifi" class="flex-1 py-2 text-xs font-medium text-amber-400 bg-amber-500/10 border border-amber-500/20 rounded-xl hover:bg-amber-500/20 transition-colors flex items-center justify-center gap-2">
                                        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636a9 9 0 010 12.728m0 0l-2.829-2.829m2.829 2.829L21 21M15.536 8.464a5 5 0 010 7.072m0 0l-2.829-2.829m-4.243-2.829a4.978 4.978 0 011.415-1.414M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c2.25 0 4.326.746 5.972 1.996l-3.29 3.29A4.982 4.982 0 0012 9a4.992 4.992 0 00-3.536 1.464l-3.29-3.29zm7.532 7.532l3.29 3.29m-3.29-3.29L3 21" /></svg>
                                        Disconnect Wi-Fi
                                    </button>

                                    <button @onclick="PromptWipeSensor" class="flex-1 py-2 text-xs font-medium text-red-400 bg-red-500/10 border border-red-500/20 rounded-xl hover:bg-red-500/20 transition-colors flex items-center justify-center gap-2">
                                        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                        Wipe Sensor
                                    </button>
                                </div>
                            }
                        }
                        else if (_device.ConnectionType == 1)
                        {
                            <h3 class="text-base font-semibold text-white mb-1">Wi-Fi Connection State</h3>
                            <p class="text-xs text-zinc-400 mb-4">The scanner is communicating via Wi-Fi.</p>
                            
                            <div class="space-y-4">
                                <div class="bg-zinc-950 border border-zinc-800 rounded-xl p-4">
                                    <div class="text-xs font-medium text-zinc-500 mb-1">IP Address</div>
                                    <div class="text-sm font-medium text-white font-mono flex items-center gap-2">
                                        @if (!string.IsNullOrEmpty(_device.IpAddress))
                                        {
                                            <div class="w-1.5 h-1.5 rounded-full bg-emerald-500"></div>
                                            @_device.IpAddress
                                        }
                                        else
                                        {
                                            <div class="w-1.5 h-1.5 rounded-full bg-zinc-600"></div>
                                            <span>Not connected yet</span>
                                        }
                                    </div>
                                </div>
                                <div class="bg-zinc-950 border border-zinc-800 rounded-xl p-4">
                                    <div class="text-xs font-medium text-zinc-500 mb-1">Last Seen</div>
                                    <div class="text-sm font-medium text-white">
                                        @(_device.LastSeen > DateTimeOffset.MinValue ? _device.LastSeen.ToLocalTime().ToString("MMM dd, yyyy - hh:mm tt") : "Never")
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                </div>
            }
        </div>

        <!-- Enrollment Panel -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 flex flex-col">
            <h2 class="text-xl font-semibold text-white mb-6">Biometric Enrollment</h2>
            
            <div class="space-y-5 flex-1 flex flex-col">
                <div>
                    <label class="block text-sm font-medium text-zinc-400 mb-1.5">Select Employee</label>
                    <select @bind="SelectedEmployeeId" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-2.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none focus:ring-1 focus:ring-fuchsia-500">
                        <option value="">-- Choose Employee --</option>
                        @if (_employees != null)
                        {
                            foreach (var emp in _employees)
                            {
                                <option value="@emp.EmployeePk">@emp.FirstName @emp.LastName</option>
                            }
                        }
                    </select>
                </div>

                @if (!string.IsNullOrEmpty(SelectedEmployeeId))
                {
                    <div class="flex-1 flex flex-col pt-2">
                        <h3 class="text-sm font-medium text-zinc-400 mb-3">Enrolled Fingerprints</h3>
                        <div class="bg-zinc-950 border border-zinc-800 rounded-xl flex-1 mb-6 p-2 min-h-[150px]">
                            @if (_fingerprints == null)
                            {
                                <div class="h-full flex items-center justify-center text-sm text-zinc-500">Loading records...</div>
                            }
                            else if (!_fingerprints.Any())
                            {
                                <div class="h-full flex items-center justify-center text-sm text-zinc-500">No fingerprints enrolled.</div>
                            }
                            else
                            {
                                <ul class="space-y-2">
                                    @foreach (var fp in _fingerprints)
                                    {
                                        <li class="flex items-center justify-between bg-zinc-900 px-4 py-3 rounded-lg border border-zinc-800 group">
                                            <div>
                                                <p class="text-sm font-medium text-white">Fingerprint #@fp.FingerprintId</p>
                                                <p class="text-xs text-zinc-500">Enrolled @fp.EnrolledAt.ToString("MMM dd, yyyy")</p>
                                            </div>
                                            <button @onclick="() => PromptDeleteFingerprint(fp.Id, fp.FingerprintId)" class="p-2 text-zinc-500 hover:text-red-400 rounded-lg transition-colors opacity-0 group-hover:opacity-100 focus:opacity-100">
                                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>

                        <div class="mt-auto">
                            @if (_isEnrolling)
                            {
                                <div class="bg-amber-500/10 border border-amber-500/20 rounded-xl p-4 flex items-center justify-between mb-2">
                                    <div class="flex items-center gap-3">
                                        <svg class="w-5 h-5 text-amber-500 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                                        <div>
                                            <p class="text-sm font-medium text-amber-500">Scan in Progress</p>
                                            <p class="text-xs text-amber-400/80">@_enrollStatus</p>
                                        </div>
                                    </div>
                                    <button @onclick="CancelEnrollment" class="px-3 py-1.5 text-xs font-medium text-zinc-400 bg-zinc-950 border border-zinc-800 rounded-lg hover:text-white transition-colors">
                                        Cancel
                                    </button>
                                </div>
                            }
                            else
                            {
                                <button @onclick="StartEnrollment" class="w-full py-2.5 px-4 text-sm font-medium text-zinc-900 bg-fuchsia-500 rounded-xl hover:bg-fuchsia-400 transition-colors flex items-center justify-center gap-2">
                                    Start New Enrollment
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (_showConfirmModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-sm shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
            <div class="p-6">
                <div class="w-12 h-12 rounded-full bg-red-500/10 flex items-center justify-center mb-4">
                    <svg class="w-6 h-6 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                </div>
                <h3 class="text-lg font-semibold text-white mb-2">@_confirmTitle</h3>
                <p class="text-sm text-zinc-400 mb-6">@_confirmMessage</p>
                <div class="flex gap-3">
                    <button @onclick="CancelConfirm" class="flex-1 py-2.5 px-4 text-sm font-medium text-white bg-zinc-800 hover:bg-zinc-700 rounded-xl transition-colors">
                        Cancel
                    </button>
                    <button @onclick="ExecuteConfirm" class="flex-1 py-2.5 px-4 text-sm font-medium text-white bg-red-600 hover:bg-red-500 rounded-xl transition-colors">
                        Confirm
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private DeviceDto _device = new();
    private List<EmployeeDto>? _employees;
    private List<FingerprintDto>? _fingerprints;

    private string? _selectedEmployeeId;
    public string? SelectedEmployeeId
    {
        get => _selectedEmployeeId;
        set
        {
            if (_selectedEmployeeId != value)
            {
                _selectedEmployeeId = value;
                _ = LoadFingerprints();
            }
        }
    }

    private bool _isEnrolling = false;
    private string _enrollStatus = "";
    
    // Web Serial State
    private bool _isSerialConnected = false;
    private string _wifiSsid = "";
    private string _wifiPassword = "";
    private string _wifiServerIp = "192.168.1.100";
    private bool _showWifiPassword = false;
    private string _wifiProvisionStatus = "";
    private IJSObjectReference? _serialModule;
    private DotNetObjectReference<AttendanceSettings>? _dotNetRef;
    private HubConnection? _hubConnection;

    // Modal state
    private bool _showConfirmModal = false;
    private string _confirmTitle = "";
    private string _confirmMessage = "";
    private Func<Task>? _confirmAction;

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);

        await LoadDevice();
        await LoadEmployees();
        
        _hubConnection = HubFactory.Create("attendanceHub");




        _hubConnection.On<string, string>("ReceiveEnrollmentStatus", (empId, status) =>
        {
            if (empId == SelectedEmployeeId)
            {
                _enrollStatus = status;
                if (status.StartsWith("ERROR", StringComparison.OrdinalIgnoreCase))
                {
                    _isEnrolling = false;
                    ToastService.ShowError(status);
                }
                InvokeAsync(StateHasChanged);
            }
        });

        _hubConnection.On<string>("ReceiveEnrollmentSuccess", async (empId) =>
        {
            if (empId == SelectedEmployeeId)
            {
                _isEnrolling = false;
                _enrollStatus = "Success!";
                ToastService.ShowSuccess("Fingerprint enrolled successfully!");
                await LoadFingerprints();
                await InvokeAsync(StateHasChanged);
            }
        });

        _hubConnection.On<string?, DateTimeOffset>("ReceiveDeviceConnectionStatus", (ipAddress, lastSeen) =>
        {
            _device.IpAddress = ipAddress;
            _device.LastSeen = lastSeen;
            InvokeAsync(StateHasChanged);
        });

        try { await _hubConnection.StartAsync(); } catch { }
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _serialModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/webserial.js");
                await _serialModule.InvokeVoidAsync("initSerial", _dotNetRef);
            }
            catch (Exception ex)
            {
                Console.WriteLine("Could not load webserial.js: " + ex.Message);
            }
        }
    }

    private async Task LoadDevice()
    {
        try
        {
            _isLoading = true;
            var res = await Http.GetAsync("/api/fingerprintdevice");
            if (res.IsSuccessStatusCode)
            {
                _device = await res.Content.ReadFromJsonAsync<DeviceDto>() ?? new();
            }
        }
        catch { }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveDevice()
    {
        try
        {
            var res = await Http.PostAsJsonAsync("/api/fingerprintdevice", _device);
            if (res.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("Device settings saved.");
            }
            else
            {
                ToastService.ShowError("Failed to save.");
            }
        }
        catch
        {
            ToastService.ShowError("Error saving device settings.");
        }
    }

    private async Task LoadEmployees()
    {
        try
        {
            _employees = await Http.GetFromJsonAsync<List<EmployeeDto>>("/api/user");
            _employees = _employees?.Where(e => e.IsActive).ToList() ?? new();
        }
        catch { }
    }

    private async Task LoadFingerprints()
    {
        if (string.IsNullOrEmpty(SelectedEmployeeId))
        {
            _fingerprints = null;
            return;
        }

        try
        {
            _fingerprints = await Http.GetFromJsonAsync<List<FingerprintDto>>($"/api/attendance/fingerprints/{SelectedEmployeeId}");
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private async Task StartEnrollment()
    {
        if (string.IsNullOrEmpty(SelectedEmployeeId)) return;

        _isEnrolling = true;
        _enrollStatus = "Initializing...";

        if (_device.ConnectionType == 0) // Wired via Web Serial
        {
            if (!_isSerialConnected || _serialModule == null)
            {
                ToastService.ShowError("Please connect the USB scanner first.");
                _isEnrolling = false;
                return;
            }
            
            try 
            {
                await _serialModule.InvokeVoidAsync("startEnrollment", SelectedEmployeeId);
                _enrollStatus = "Waiting for finger...";
            }
            catch
            {
                ToastService.ShowError("Serial communication failed.");
                _isEnrolling = false;
            }
        }
        else // WiFi via TCP
        {
            try
            {
                var res = await Http.PostAsync($"/api/attendance/enroll/{SelectedEmployeeId}", null);
                if (!res.IsSuccessStatusCode)
                {
                    var err = await res.Content.ReadAsStringAsync();
                    ToastService.ShowError("Failed to start enrollment: " + err);
                    _isEnrolling = false;
                }
                else
                {
                    _enrollStatus = "Waiting for finger...";
                }
            }
            catch
            {
                ToastService.ShowError("Network error starting enrollment.");
                _isEnrolling = false;
            }
        }
    }

    private async Task CancelEnrollment()
    {
        _isEnrolling = false;
        _enrollStatus = "Cancelled";
        
        if (_device.ConnectionType == 0 && _serialModule != null)
        {
            try
            {
                await _serialModule.InvokeVoidAsync("cancelEnrollment");
            }
            catch { }
        }
        else if (_device.ConnectionType == 1)
        {
            try
            {
                await Http.PostAsync("/api/attendance/cancel-enroll", null);
            }
            catch { }
        }
        
        StateHasChanged();
    }

    private void PromptDeleteFingerprint(int id, int sensorSlot)
    {
        _confirmTitle = "Remove Fingerprint";
        _confirmMessage = $"Are you sure you want to remove fingerprint #{sensorSlot}? This action cannot be undone.";
        _confirmAction = async () => await DeleteFingerprint(id, sensorSlot);
        _showConfirmModal = true;
    }

    private async Task DeleteFingerprint(int id, int sensorSlot)
    {
        try
        {
            var res = await Http.DeleteAsync($"/api/attendance/fingerprints/{id}");
            if (res.IsSuccessStatusCode)
            {
                // Also delete from sensor memory if USB connected
                if (_isSerialConnected && _serialModule != null)
                {
                    try { await _serialModule.InvokeVoidAsync("deleteModel", sensorSlot); } catch { }
                }
                ToastService.ShowSuccess("Fingerprint deleted.");
                await LoadFingerprints();
            }
            else
            {
                ToastService.ShowError("Failed to delete.");
            }
        }
        catch { }
    }

    private void PromptWipeSensor()
    {
        if (_serialModule == null || !_isSerialConnected) return;
        _confirmTitle = "Wipe All Sensor Data";
        _confirmMessage = "Are you absolutely sure you want to wipe ALL fingerprints stored on the sensor? This cannot be undone and you will have to re-enroll everyone.";
        _confirmAction = async () => await WipeSensor();
        _showConfirmModal = true;
    }

    private async Task WipeSensor()
    {
        if (_serialModule == null || !_isSerialConnected) return;
        try
        {
            await _serialModule.InvokeVoidAsync("wipeSensor");
            ToastService.ShowSuccess("Wipe command sent to device.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Wipe failed: " + ex.Message);
        }
    }

    private void PromptResetWifi()
    {
        if (_serialModule == null || !_isSerialConnected) return;
        _confirmTitle = "Disconnect Wi-Fi?";
        _confirmMessage = "Are you sure you want to erase the Wi-Fi credentials from the scanner? The scanner will reboot immediately and return to Wired Mode.";
        _confirmAction = async () => await ResetWifi();
        _showConfirmModal = true;
    }

    private async Task ResetWifi()
    {
        if (_serialModule == null || !_isSerialConnected) return;
        try
        {
            await _serialModule.InvokeVoidAsync("resetWifi");
            ToastService.ShowSuccess("Wi-Fi credentials erased. Scanner is rebooting.");
            await DisconnectSerial();
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Reset failed: " + ex.Message);
        }
    }

    private void CancelConfirm()
    {
        _showConfirmModal = false;
        _confirmAction = null;
    }

    private async Task ExecuteConfirm()
    {
        if (_confirmAction != null)
        {
            await _confirmAction();
        }
        _showConfirmModal = false;
        _confirmAction = null;
    }

    // JS Interop calls from webserial.js
    [JSInvokable]
    public void OnSerialConnected()
    {
        _isSerialConnected = true;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnSerialDisconnected()
    {
        _isSerialConnected = false;
        StateHasChanged();
    }
    
    [JSInvokable]
    public void OnSerialEnrollStatus(string status)
    {
        _enrollStatus = status;
        if (status.StartsWith("ERROR", StringComparison.OrdinalIgnoreCase))
        {
            _isEnrolling = false;
            ToastService.ShowError(status);
        }
        StateHasChanged();
    }

    [JSInvokable]
    public void OnSerialLog(string msg)
    {
        _wifiProvisionStatus = msg;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnSerialScanEvent(int fingerprintId)
    {
        // Fire and forget attendance scan POST
        // webserial.js already posts /api/attendance/scan-event; refresh UI state only
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnSerialEnrollSuccess(string employeeId, int fingerprintId)
    {
        await Http.PostAsJsonAsync("/api/attendance/enroll-success", new { EmployeeId = employeeId, FingerprintId = fingerprintId });
        
        if (SelectedEmployeeId == employeeId)
        {
            _isEnrolling = false;
            _enrollStatus = "Success!";
            await LoadFingerprints();
            StateHasChanged();
            ToastService.ShowSuccess("Fingerprint enrolled successfully via USB!");
        }
    }

    private async Task ConnectSerial()
    {
        if (_serialModule != null)
        {
            try
            {
                await _serialModule.InvokeVoidAsync("connectSerial");
            }
            catch (Exception ex)
            {
                ToastService.ShowError(ex.Message);
            }
        }
    }

    private async Task DisconnectSerial()
    {
        if (_serialModule != null)
        {
            await _serialModule.InvokeVoidAsync("disconnectSerial");
        }
    }

    private async Task SendWifiConfig()
    {
        if (_serialModule != null)
        {
            if (string.IsNullOrEmpty(_wifiSsid) || string.IsNullOrEmpty(_wifiServerIp))
            {
                ToastService.ShowError("SSID and Server IP are required.");
                return;
            }

            try
            {
                await _serialModule.InvokeVoidAsync("sendWifiConfig", _wifiSsid, _wifiPassword, _wifiServerIp);
                ToastService.ShowSuccess("Wi-Fi configuration sent!");
                _wifiProvisionStatus = "Configuration sent. Waiting for device reboot...";
                _wifiSsid = "";
                _wifiPassword = "";
                _wifiServerIp = "";
            }
            catch (Exception ex)
            {
                ToastService.ShowError("Failed to send config: " + ex.Message);
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
        // Release JS callback target before disposing the interop module and reference.
        if (_serialModule != null)
        {
            try { await _serialModule.InvokeVoidAsync("clearDotNetRef"); } catch (JSDisconnectedException) { }
            await _serialModule.DisposeAsync();
        }
        _dotNetRef?.Dispose();
    }

    private class DeviceDto
    {
        public string Name { get; set; } = string.Empty;
        public int ConnectionType { get; set; }
        public string? IpAddress { get; set; }
        public bool IsActive { get; set; } = true;
        public DateTimeOffset LastSeen { get; set; }
    }

    private class EmployeeDto
    {
        public string Id { get; set; } = string.Empty;         // ASP.NET User ID
        public string EmployeePk { get; set; } = string.Empty; // Employee table PK (FK for fingerprints)
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public bool IsActive { get; set; }
    }

    private class FingerprintDto
    {
        public int Id { get; set; }
        public int FingerprintId { get; set; }
        public DateTimeOffset EnrolledAt { get; set; }
    }
