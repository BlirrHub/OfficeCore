@using System.Net.Http.Headers
@using System.Text.Json
@inject HttpClient Http
@inject ToastService ToastService

<div class="space-y-6">
    <!-- Header Card -->
    <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-6 backdrop-blur-md">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="size-12 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-700 flex items-center justify-center text-white shadow-lg shadow-emerald-950/40">
                    <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h2 class="text-xl font-bold text-white tracking-tight">Biometric Log Importer</h2>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-950/60 text-emerald-300 border border-emerald-800/60">
                            ACBA / Standalone Scanner
                        </span>
                    </div>
                    <p class="text-xs text-zinc-400 mt-0.5">
                        Import exported attendance logs from external fingerprint or facial recognition machines (<code class="text-emerald-400 font-mono">All Report.xls</code>).
                    </p>
                </div>
            </div>

            @if (_preview != null)
            {
                <button type="button" @onclick="ResetUploader" 
                        class="px-3.5 py-2 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs font-semibold flex items-center gap-1.5 transition-colors cursor-pointer self-start md:self-auto border border-zinc-700/60">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                    <span>Upload Another Report</span>
                </button>
            }
        </div>
    </div>

    @if (_preview == null)
    {
        <!-- Uploader Card -->
        <div class="bg-zinc-900/40 border border-zinc-800/80 rounded-2xl p-8 text-center max-w-3xl mx-auto">
            <div class="size-16 rounded-2xl bg-zinc-800/80 border border-zinc-700/60 text-emerald-400 flex items-center justify-center mx-auto mb-4">
                <svg class="size-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                </svg>
            </div>

            <h3 class="text-base font-bold text-white mb-1">Select Biometric Report File</h3>
            <p class="text-xs text-zinc-400 max-w-md mx-auto mb-6">
                Upload the <span class="text-white font-medium">All Report.xls</span> or <span class="text-white font-medium">.xlsx</span> spreadsheet exported directly from your office fingerprint terminal.
            </p>

            <div class="flex flex-col items-center justify-center gap-3">
                <label for="biometric-file-input" class="px-6 py-3 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white text-sm font-semibold flex items-center gap-2 cursor-pointer shadow-lg shadow-emerald-950/50 transition-all">
                    <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    <span>Browse Excel File</span>
                </label>
                <InputFile id="biometric-file-input" OnChange="HandleFileSelected" accept=".xls,.xlsx" class="hidden" />

                @if (_selectedFile != null)
                {
                    <div class="mt-4 p-4 rounded-xl bg-zinc-950 border border-zinc-800 max-w-md w-full text-left flex items-center justify-between">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="size-8 rounded-lg bg-emerald-950/60 border border-emerald-800/40 text-emerald-400 flex items-center justify-center shrink-0">
                                📊
                            </div>
                            <div class="min-w-0">
                                <p class="text-xs font-bold text-white truncate">@_selectedFile.Name</p>
                                <p class="text-[10px] text-zinc-500">@FormatFileSize(_selectedFile.Size)</p>
                            </div>
                        </div>

                        <button type="button" @onclick="ParseSelectedFile" disabled="@_isParsing" 
                                class="px-4 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold flex items-center gap-1.5 transition-colors cursor-pointer shrink-0 disabled:opacity-50">
                            @if (_isParsing)
                            {
                                <div class="size-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                                <span>Analyzing...</span>
                            }
                            else
                            {
                                <span>Parse & Preview</span>
                            }
                        </button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="mt-4 p-3 rounded-xl bg-red-950/40 border border-red-900/50 text-red-400 text-xs max-w-md w-full text-left flex items-center gap-2">
                        <svg class="size-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <span>@_errorMessage</span>
                    </div>
                }
            </div>

            <!-- Format Info Notes -->
            <div class="mt-8 pt-6 border-t border-zinc-800/60 text-left grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="p-3 rounded-xl bg-zinc-950/40 border border-zinc-800/60">
                    <p class="text-[11px] font-semibold text-zinc-300">1. Automatic Pairing</p>
                    <p class="text-[10px] text-zinc-500 mt-0.5">Consecutive punches on the same day are automatically parsed into Clock-In & Clock-Out pairs.</p>
                </div>
                <div class="p-3 rounded-xl bg-zinc-950/40 border border-zinc-800/60">
                    <p class="text-[11px] font-semibold text-zinc-300">2. Missing Punch Detection</p>
                    <p class="text-[10px] text-zinc-500 mt-0.5">Days with odd punch counts (e.g. In without Out) are visually flagged so you can check CCTV.</p>
                </div>
                <div class="p-3 rounded-xl bg-zinc-950/40 border border-zinc-800/60">
                    <p class="text-[11px] font-semibold text-zinc-300">3. Employee Auto-Link</p>
                    <p class="text-[10px] text-zinc-500 mt-0.5">Matches Biometric Device IDs to employee profiles, with one-click mapping save for future exports.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Preview & Review Matrix -->
        <div class="space-y-6">
            <!-- Metrics Summary Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5">
                <div class="bg-zinc-900/40 border border-zinc-800/80 rounded-2xl p-4 flex items-center">
                    <div class="size-10 rounded-xl bg-emerald-950/40 border border-emerald-500/30 text-emerald-400 flex items-center justify-center shrink-0 mr-3.5">
                        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                    </div>
                    <div class="min-w-0">
                        <p class="text-[10px] font-semibold text-zinc-400 uppercase tracking-wider">Date Window</p>
                        <p class="text-xs font-bold text-white truncate mt-0.5">@_preview.DateRangeText</p>
                        <p class="text-[10px] text-zinc-500">From Attend. Logs</p>
                    </div>
                </div>

                <div class="bg-zinc-900/40 border border-zinc-800/80 rounded-2xl p-4 flex items-center">
                    <div class="size-10 rounded-xl bg-teal-950/40 border border-teal-500/30 text-teal-400 flex items-center justify-center shrink-0 mr-3.5">
                        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                    </div>
                    <div>
                        <p class="text-[10px] font-semibold text-zinc-400 uppercase tracking-wider">Staff Detected</p>
                        <p class="text-sm font-bold text-white mt-0.5">@_preview.TotalEmployeesFound employees</p>
                        <p class="text-[10px] text-emerald-400 font-medium">@_preview.TotalMatchedEmployees matched</p>
                    </div>
                </div>

                <div class="bg-zinc-900/40 border border-zinc-800/80 rounded-2xl p-4 flex items-center">
                    <div class="size-10 rounded-xl bg-indigo-950/40 border border-indigo-500/30 text-indigo-400 flex items-center justify-center shrink-0 mr-3.5">
                        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    </div>
                    <div>
                        <p class="text-[10px] font-semibold text-zinc-400 uppercase tracking-wider">Total Punches</p>
                        <p class="text-sm font-bold text-white mt-0.5">@_preview.TotalPunchesFound punches</p>
                        <p class="text-[10px] text-zinc-500">Clock-In & Out</p>
                    </div>
                </div>

                <div class="bg-zinc-900/40 border border-zinc-800/80 rounded-2xl p-4 flex items-center">
                    <div class="size-10 rounded-xl bg-amber-950/40 border border-amber-500/30 text-amber-400 flex items-center justify-center shrink-0 mr-3.5">
                        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                    </div>
                    <div>
                        <p class="text-[10px] font-semibold text-zinc-400 uppercase tracking-wider">Missing Out/In</p>
                        <p class="text-sm font-bold text-amber-400 mt-0.5">@_preview.TotalMissingPunchDays days flagged</p>
                        <p class="text-[10px] text-zinc-500">Check CCTV / manual</p>
                    </div>
                </div>

                <div class="bg-zinc-900/40 border border-zinc-800/80 rounded-2xl p-4 flex flex-col justify-center">
                    <div class="flex items-center gap-2">
                        <input type="checkbox" id="autoUpdateIds" @bind="_autoUpdateEmployeeIds" 
                               class="size-4 rounded border-zinc-700 bg-zinc-950 text-emerald-500 focus:ring-0 cursor-pointer" />
                        <label for="autoUpdateIds" class="text-xs font-semibold text-white cursor-pointer select-none">
                            Save Device IDs
                        </label>
                    </div>
                    <p class="text-[10px] text-zinc-400 mt-1 pl-6">
                        Updates employee profile with biometric ID for future 1-click matches.
                    </p>
                </div>
            </div>

            <!-- Employee Breakdown List -->
            <div class="space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <h3 class="text-sm font-bold text-white uppercase tracking-wider">Employee Attendance Verification</h3>
                    <div class="flex items-center gap-2">
                        <button type="button" @onclick="OpenAddUnlistedEmployeeModal"
                                class="px-2.5 py-1.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-emerald-400 hover:text-emerald-300 text-xs font-semibold flex items-center gap-1.5 transition-colors cursor-pointer border border-zinc-700/60">
                            <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                            <span>Add Present Employee</span>
                        </button>
                        <span class="text-xs text-zinc-400">Filter:</span>
                        <input type="text" @bind="_searchFilter" @bind:event="oninput" placeholder="Search name or ID..."
                               class="bg-zinc-950 border border-zinc-800 rounded-lg px-2.5 py-1 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-emerald-500" />
                    </div>
                </div>

                @foreach (var emp in FilteredEmployees)
                {
                    <div class="bg-zinc-900/40 border border-zinc-800/80 rounded-2xl p-4 space-y-3">
                        <!-- Employee Bar -->
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-zinc-800/80">
                            <div class="flex items-center gap-3">
                                <div class="size-9 rounded-xl bg-zinc-800 border border-zinc-700 flex items-center justify-center text-xs font-bold text-zinc-200 shrink-0">
                                    #@emp.BiometricId
                                </div>
                                <div>
                                    <div class="flex items-center gap-2">
                                        <h4 class="text-sm font-bold text-white">@emp.ReportedName</h4>
                                        @if (!string.IsNullOrEmpty(emp.Department))
                                        {
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-zinc-800 text-zinc-300 border border-zinc-700">
                                                @emp.Department
                                            </span>
                                        }
                                    </div>
                                    <p class="text-[10px] text-zinc-500 mt-0.5">
                                        Total: <span class="text-zinc-300 font-semibold">@emp.TotalPunches punches</span> across @_preview.DateRangeText
                                        @if (emp.MissingPunchCount > 0)
                                        {
                                            <span class="text-amber-400 ml-2 font-medium">• @emp.MissingPunchCount day(s) missing out punch</span>
                                        }
                                    </p>
                                </div>
                            </div>

                            <!-- Matching Selector -->
                            <div class="flex items-center gap-2">
                                <span class="text-xs text-zinc-400">Mapped Profile:</span>
                                <select @bind="emp.MatchedEmployeeId" 
                                        class="bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-1.5 text-xs text-white focus:outline-none focus:border-emerald-500 min-w-[200px]">
                                    <option value="">-- Unmapped (Skip) --</option>
                                    @foreach (var opt in _preview.AvailableEmployees)
                                    {
                                        <option value="@opt.Id">
                                            @opt.FullName @(!string.IsNullOrEmpty(opt.EmployeeId) ? $"({opt.EmployeeId})" : "")
                                        </option>
                                    }
                                </select>
                                @if (emp.IsMatched)
                                {
                                    <span class="size-6 rounded-full bg-emerald-950/60 border border-emerald-500/40 text-emerald-400 flex items-center justify-center text-xs" title="Matched successfully">
                                        ✓
                                    </span>
                                }
                                else
                                {
                                    <span class="size-6 rounded-full bg-amber-950/60 border border-amber-500/40 text-amber-400 flex items-center justify-center text-xs font-bold" title="Please select an employee profile">
                                        !
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Days Punch Row -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-2">
                            @foreach (var day in emp.Days)
                            {
                                <div class="bg-zinc-950/60 border border-zinc-800/80 rounded-xl p-2.5 flex flex-col justify-between hover:border-zinc-700 transition-colors">
                                    <div class="flex items-center justify-between mb-1.5">
                                        <span class="text-[11px] font-bold text-zinc-300">
                                            @day.Date.ToString("MMM dd") (@day.DayOfWeek)
                                        </span>
                                        <div class="flex items-center gap-1">
                                            @if (day.HasMissingPair)
                                            {
                                                <span class="px-1.5 py-0.5 rounded text-[9px] font-semibold bg-amber-950/60 text-amber-300 border border-amber-800/60" title="Odd punch count: Time Out punch missing">
                                                    Missing Out
                                                </span>
                                            }
                                            else if (day.Punches.Count > 0)
                                            {
                                                <span class="px-1.5 py-0.5 rounded text-[9px] font-semibold bg-emerald-950/60 text-emerald-300 border border-emerald-800/60">
                                                    Pair Complete
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-[10px] text-zinc-600">No punches</span>
                                            }
                                            <button type="button" @onclick="() => OpenAddPunchModal(emp, day)"
                                                    class="size-5 rounded bg-zinc-800 hover:bg-emerald-600 hover:text-white text-zinc-400 flex items-center justify-center text-xs font-bold transition-colors cursor-pointer"
                                                    title="Add missing punch">
                                                +
                                            </button>
                                        </div>
                                    </div>

                                    @if (day.Punches.Count > 0)
                                    {
                                        <div class="flex flex-wrap gap-1.5">
                                            @foreach (var punch in day.Punches)
                                            {
                                                <button type="button" @onclick="() => OpenEditPunchModal(emp, day, punch)"
                                                        class="px-2 py-0.5 rounded text-[10px] font-mono font-bold flex items-center gap-1 cursor-pointer transition-transform hover:scale-105 @(punch.IsDuplicate ? "opacity-40 line-through bg-zinc-900 text-zinc-500 border border-zinc-800" : (punch.IsOvertime ? "bg-amber-950/80 text-amber-300 border border-amber-800/70" : (punch.Type == AttendanceType.ClockIn ? "bg-emerald-950/80 text-emerald-400 border border-emerald-800/60 hover:border-emerald-400" : "bg-cyan-950/80 text-cyan-400 border border-cyan-800/60 hover:border-cyan-400")))"
                                                        title="@(punch.IsDuplicate ? "Duplicate morning punch (ignored)" : (punch.IsOvertime ? $"Overtime +{punch.OvertimeHours}h pending approval (Orig: {punch.OriginalTime})" : (punch.IsNormalized ? $"Normalized to {punch.Time} from {punch.OriginalTime}" : "Click to edit or remove punch")))">
                                                    <span>@punch.Time</span>
                                                    <span class="text-[9px] opacity-75">@(punch.Type == AttendanceType.ClockIn ? "IN" : "OUT")</span>
                                                    @if (punch.IsOvertime)
                                                    {
                                                        <span class="px-1 rounded bg-amber-900/60 text-amber-300 text-[8px] font-semibold border border-amber-700/50">OT</span>
                                                    }
                                                </button>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="flex items-center justify-between mt-1">
                                            <p class="text-[10px] text-zinc-600 italic">Off / Absent</p>
                                            <button type="button" @onclick="() => OpenAddPunchModal(emp, day)"
                                                    class="text-[10px] text-emerald-400 hover:text-emerald-300 font-semibold cursor-pointer">
                                                + Add In/Out
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Sticky Bottom Commit Bar -->
            <div class="sticky bottom-4 bg-zinc-900/90 border border-zinc-800 rounded-2xl p-4 backdrop-blur-md flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-2xl">
                <div>
                    <p class="text-xs text-zinc-300">
                        Ready to import <span class="font-bold text-white">@GetPunchesToImportCount() punches</span> for <span class="font-bold text-white">@GetMatchedStaffCount() matched staff</span>.
                    </p>
                    <p class="text-[10px] text-zinc-500">
                        Duplicates will be automatically skipped. Records are saved with source <code class="text-emerald-400 font-mono">Device</code>.
                    </p>
                </div>

                <div class="flex items-center gap-3">
                    <button type="button" @onclick="ResetUploader" 
                            class="px-4 py-2 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs font-semibold transition-colors cursor-pointer border border-zinc-700/60">
                        Cancel
                    </button>

                    <button type="button" @onclick="CommitImport" disabled="@(_isImporting || GetPunchesToImportCount() == 0)"
                            class="px-6 py-2 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white text-xs font-bold flex items-center gap-2 shadow-lg shadow-emerald-950/60 transition-all cursor-pointer disabled:opacity-50">
                        @if (_isImporting)
                        {
                            <div class="size-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                            <span>Importing Punches...</span>
                        }
                        else
                        {
                            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            <span>Confirm & Commit Import</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Punch Edit / Add Modal -->
    @if (_isPunchModalOpen && _editingEmployee != null && _editingDay != null)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm animate-in fade-in duration-200">
            <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-md shadow-2xl p-6 space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-zinc-800">
                    <div>
                        <h3 class="text-sm font-bold text-white">
                            @(_editingPunch == null ? "Add Missing Punch" : "Edit Attendance Punch")
                        </h3>
                        <p class="text-xs text-zinc-400 mt-0.5">
                            @_editingEmployee.ReportedName • @_editingDay.Date.ToString("MMM dd, yyyy (ddd)")
                        </p>
                    </div>
                    <button type="button" @onclick="ClosePunchModal" class="size-7 rounded-lg bg-zinc-800 text-zinc-400 hover:text-white flex items-center justify-center text-sm cursor-pointer">
                        ✕
                    </button>
                </div>

                <!-- Punch Direction -->
                <div>
                    <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Punch Direction</label>
                    <div class="grid grid-cols-2 gap-2">
                        <button type="button" @onclick="() => _editPunchType = AttendanceType.ClockIn"
                                class="py-2.5 px-3 rounded-xl border text-xs font-bold flex items-center justify-center gap-1.5 transition-all cursor-pointer @(_editPunchType == AttendanceType.ClockIn ? "bg-emerald-950/80 border-emerald-500 text-emerald-300 ring-1 ring-emerald-500/50" : "bg-zinc-950 border-zinc-800 text-zinc-400 hover:border-zinc-700")">
                            <span>🟢 Clock In (IN)</span>
                        </button>
                        <button type="button" @onclick="() => _editPunchType = AttendanceType.ClockOut"
                                class="py-2.5 px-3 rounded-xl border text-xs font-bold flex items-center justify-center gap-1.5 transition-all cursor-pointer @(_editPunchType == AttendanceType.ClockOut ? "bg-cyan-950/80 border-cyan-500 text-cyan-300 ring-1 ring-cyan-500/50" : "bg-zinc-950 border-zinc-800 text-zinc-400 hover:border-zinc-700")">
                            <span>🔵 Clock Out (OUT)</span>
                        </button>
                    </div>
                </div>

                <!-- Punch Time Input -->
                <div>
                    <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Punch Time (HH:mm)</label>
                    <input type="time" value="@_editPunchTime" @onchange="@(e => _editPunchTime = e.Value?.ToString() ?? string.Empty)"
                           class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-sm text-white font-mono focus:outline-none focus:border-emerald-500" />
                    
                    <!-- Quick Presets -->
                    <div class="flex flex-wrap gap-1.5 mt-2">
                        <span class="text-[10px] text-zinc-500 self-center mr-1">Presets:</span>
                        @if (_editPunchType == AttendanceType.ClockIn)
                        {
                            @foreach (var t in new[] { "07:30", "07:45", "08:00", "08:15", "08:30", "13:00" })
                            {
                                <button type="button" @onclick="() => _editPunchTime = t"
                                        class="px-2 py-0.5 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-[10px] font-mono cursor-pointer transition-colors">
                                    @t
                                </button>
                            }
                        }
                        else
                        {
                            @foreach (var t in new[] { "12:00", "17:00", "17:05", "17:30", "18:00", "19:00" })
                            {
                                <button type="button" @onclick="() => _editPunchTime = t"
                                        class="px-2 py-0.5 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-[10px] font-mono cursor-pointer transition-colors">
                                    @t
                                </button>
                            }
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_modalError))
                {
                    <div class="p-2.5 rounded-xl bg-red-950/40 border border-red-900/50 text-red-400 text-xs">
                        @_modalError
                    </div>
                }

                <!-- Modal Actions -->
                <div class="flex items-center justify-between pt-3 border-t border-zinc-800">
                    @if (_editingPunch != null)
                    {
                        <button type="button" @onclick="DeleteCurrentPunch"
                                class="px-3 py-1.5 rounded-xl bg-red-950/60 hover:bg-red-900/80 border border-red-800/60 text-red-300 text-xs font-semibold flex items-center gap-1.5 cursor-pointer transition-colors">
                            <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                            <span>Delete Punch</span>
                        </button>
                    }
                    else
                    {
                        <div></div>
                    }

                    <div class="flex items-center gap-2">
                        <button type="button" @onclick="ClosePunchModal"
                                class="px-3.5 py-1.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs font-semibold cursor-pointer transition-colors">
                            Cancel
                        </button>
                        <button type="button" @onclick="SaveCurrentPunch"
                                class="px-4 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold cursor-pointer transition-colors">
                            @(_editingPunch == null ? "Add Punch" : "Save Changes")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Add Present Employee Modal -->
    @if (_isAddEmployeeModalOpen)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm animate-in fade-in duration-200">
            <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-md shadow-2xl p-6 space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-zinc-800">
                    <div>
                        <h3 class="text-sm font-bold text-white">Add Present Employee</h3>
                        <p class="text-xs text-zinc-400 mt-0.5">
                            Add an employee whose biometric device malfunctioned during this period.
                        </p>
                    </div>
                    <button type="button" @onclick="() => _isAddEmployeeModalOpen = false" class="size-7 rounded-lg bg-zinc-800 text-zinc-400 hover:text-white flex items-center justify-center text-sm cursor-pointer">
                        ✕
                    </button>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Select Employee Profile</label>
                    <select @bind="_selectedUnlistedEmployeeId" 
                            class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-emerald-500">
                        <option value="">-- Choose Employee --</option>
                        @foreach (var opt in GetUnlistedEmployees())
                        {
                            <option value="@opt.Id">@opt.FullName @(!string.IsNullOrEmpty(opt.EmployeeId) ? $"({opt.EmployeeId})" : "")</option>
                        }
                    </select>
                </div>

                <div class="flex items-center justify-end gap-2 pt-3 border-t border-zinc-800">
                    <button type="button" @onclick="() => _isAddEmployeeModalOpen = false"
                            class="px-3.5 py-1.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs font-semibold cursor-pointer">
                        Cancel
                    </button>
                    <button type="button" @onclick="ConfirmAddUnlistedEmployee" disabled="@string.IsNullOrEmpty(_selectedUnlistedEmployeeId)"
                            class="px-4 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold disabled:opacity-50 cursor-pointer">
                        Add to Importer
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback OnImportCompleted { get; set; }

    private IBrowserFile? _selectedFile;
    private bool _isParsing = false;
    private bool _isImporting = false;
    private string? _errorMessage;
    private string _searchFilter = string.Empty;
    private bool _autoUpdateEmployeeIds = true;
    private BiometricPreviewResultDto? _preview;

    // Modal state for punch editing/adding
    private bool _isPunchModalOpen = false;
    private BiometricEmployeeLogDto? _editingEmployee;
    private BiometricDayRecordDto? _editingDay;
    private BiometricPunchDto? _editingPunch;
    private AttendanceType _editPunchType = AttendanceType.ClockIn;
    private string _editPunchTime = "08:00";
    private string? _modalError;

    // Modal state for adding unlisted employee
    private bool _isAddEmployeeModalOpen = false;
    private string _selectedUnlistedEmployeeId = string.Empty;

    private IEnumerable<BiometricEmployeeLogDto> FilteredEmployees =>
        _preview?.Employees.Where(e => 
            string.IsNullOrWhiteSpace(_searchFilter) ||
            e.ReportedName.Contains(_searchFilter, StringComparison.OrdinalIgnoreCase) ||
            e.BiometricId.Contains(_searchFilter, StringComparison.OrdinalIgnoreCase) ||
            (e.MatchedEmployeeName?.Contains(_searchFilter, StringComparison.OrdinalIgnoreCase) ?? false)
        ) ?? Enumerable.Empty<BiometricEmployeeLogDto>();

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _errorMessage = null;
    }

    private void ResetUploader()
    {
        _selectedFile = null;
        _preview = null;
        _errorMessage = null;
    }

    private async Task ParseSelectedFile()
    {
        if (_selectedFile == null) return;

        _isParsing = true;
        _errorMessage = null;

        try
        {
            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(_selectedFile.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024));
            fileContent.Headers.ContentType = new MediaTypeHeaderValue("application/octet-stream");
            content.Add(fileContent, "file", _selectedFile.Name);

            var response = await Http.PostAsync("/api/attendance/import-biometric-preview", content);
            if (response.IsSuccessStatusCode)
            {
                _preview = await response.Content.ReadFromJsonAsync<BiometricPreviewResultDto>();
                if (_preview?.Success != true)
                {
                    _errorMessage = _preview?.ErrorMessage ?? "Failed to parse biometric report.";
                    _preview = null;
                }
                else
                {
                    ToastService.ShowSuccess($"Parsed {_preview.TotalEmployeesFound} employees with {_preview.TotalPunchesFound} punches from {_selectedFile.Name}!");
                }
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                _errorMessage = !string.IsNullOrWhiteSpace(err) ? err : "Failed to parse biometric report.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Upload failed: {ex.Message}";
        }
        finally
        {
            _isParsing = false;
        }
    }

    private int GetPunchesToImportCount()
    {
        if (_preview == null) return 0;
        return _preview.Employees
            .Where(e => e.IsMatched)
            .SelectMany(e => e.Days)
            .SelectMany(d => d.Punches)
            .Count(p => !p.IsDuplicate);
    }

    private int GetMatchedStaffCount()
    {
        return _preview?.Employees.Count(e => e.IsMatched) ?? 0;
    }

    private async Task CommitImport()
    {
        if (_preview == null) return;

        _isImporting = true;
        try
        {
            var punches = new List<BiometricCommitPunchItemDto>();
            var mappings = new Dictionary<string, string>();

            foreach (var emp in _preview.Employees.Where(e => e.IsMatched))
            {
                if (!string.IsNullOrEmpty(emp.MatchedEmployeeId))
                {
                    mappings[emp.BiometricId] = emp.MatchedEmployeeId;

                    foreach (var day in emp.Days)
                    {
                        foreach (var punch in day.Punches.Where(p => !p.IsDuplicate))
                        {
                            punches.Add(new BiometricCommitPunchItemDto
                            {
                                EmployeeId = emp.MatchedEmployeeId,
                                Timestamp = punch.Timestamp,
                                Type = punch.Type,
                                BiometricId = emp.BiometricId
                            });
                        }
                    }
                }
            }

            var req = new BiometricCommitRequestDto
            {
                Punches = punches,
                BiometricIdToEmployeeMappings = mappings,
                AutoUpdateEmployeeIds = _autoUpdateEmployeeIds
            };

            var res = await Http.PostAsJsonAsync("/api/attendance/import-biometric-commit", req);
            if (res.IsSuccessStatusCode)
            {
                var resultJson = await res.Content.ReadFromJsonAsync<CommitResponseDto>();
                ToastService.ShowSuccess(resultJson?.message ?? "Punches imported successfully!");
                _preview = null;
                _selectedFile = null;
                await OnImportCompleted.InvokeAsync();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                ToastService.ShowError($"Import failed: {err}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Import failed: {ex.Message}");
        }
        finally
        {
            _isImporting = false;
        }
    }

    private void OpenAddPunchModal(BiometricEmployeeLogDto emp, BiometricDayRecordDto day)
    {
        _editingEmployee = emp;
        _editingDay = day;
        _editingPunch = null;
        _modalError = null;

        if (day.Punches.Count > 0 && day.Punches.Last().Type == AttendanceType.ClockIn)
        {
            _editPunchType = AttendanceType.ClockOut;
            _editPunchTime = "17:00";
        }
        else if (day.Punches.Count > 0 && day.Punches.Last().Type == AttendanceType.ClockOut)
        {
            _editPunchType = AttendanceType.ClockIn;
            _editPunchTime = "17:30";
        }
        else
        {
            _editPunchType = AttendanceType.ClockIn;
            _editPunchTime = "08:00";
        }

        _isPunchModalOpen = true;
    }

    private void OpenEditPunchModal(BiometricEmployeeLogDto emp, BiometricDayRecordDto day, BiometricPunchDto punch)
    {
        _editingEmployee = emp;
        _editingDay = day;
        _editingPunch = punch;
        _editPunchType = punch.Type;
        _editPunchTime = punch.Time;
        _modalError = null;
        _isPunchModalOpen = true;
    }

    private void ClosePunchModal()
    {
        _isPunchModalOpen = false;
        _editingEmployee = null;
        _editingDay = null;
        _editingPunch = null;
        _modalError = null;
    }

    private void SaveCurrentPunch()
    {
        _modalError = null;
        if (_editingEmployee == null || _editingDay == null) return;

        if (!TimeSpan.TryParse(_editPunchTime, out var timeSpan))
        {
            _modalError = "Please enter a valid time (HH:mm).";
            return;
        }

        var punchDateTime = _editingDay.Date.Date.Add(timeSpan);
        var punchTimestamp = new DateTimeOffset(punchDateTime, TimeSpan.FromHours(8));
        var formattedTime = $"{timeSpan.Hours:D2}:{timeSpan.Minutes:D2}";

        if (_editingPunch != null)
        {
            _editingPunch.Time = formattedTime;
            _editingPunch.Type = _editPunchType;
            _editingPunch.Timestamp = punchTimestamp;
            _editingPunch.IsDuplicate = false;
            ToastService.ShowSuccess($"Updated punch to {_editingPunch.Time} ({_editingPunch.Type})");
        }
        else
        {
            var newPunch = new BiometricPunchDto
            {
                Time = formattedTime,
                Timestamp = punchTimestamp,
                Type = _editPunchType,
                IsDuplicate = false
            };
            _editingDay.Punches.Add(newPunch);
            ToastService.ShowSuccess($"Added {formattedTime} ({_editPunchType}) punch");
        }

        _editingDay.Punches = _editingDay.Punches.OrderBy(p => p.Timestamp).ToList();
        RecalculateDay(_editingDay);
        ClosePunchModal();
    }

    private void DeleteCurrentPunch()
    {
        if (_editingEmployee == null || _editingDay == null || _editingPunch == null) return;

        _editingDay.Punches.Remove(_editingPunch);
        RecalculateDay(_editingDay);
        ToastService.ShowSuccess("Punch removed.");
        ClosePunchModal();
    }

    private void RecalculateDay(BiometricDayRecordDto day)
    {
        if (day.Punches.Count == 0)
        {
            day.Status = "No Punches";
            day.HasMissingPair = false;
        }
        else if (day.Punches.Count % 2 != 0)
        {
            day.HasMissingPair = true;
            day.Status = day.Punches.Last().Type == AttendanceType.ClockIn ? "Missing Out" : "Missing In";
        }
        else
        {
            day.HasMissingPair = false;
            day.Status = "Complete Pair";
        }

        if (_preview != null)
        {
            _preview.TotalPunchesFound = _preview.Employees.Sum(e => e.TotalPunches);
            _preview.TotalMissingPunchDays = _preview.Employees.Sum(e => e.MissingPunchCount);
        }
    }

    private void OpenAddUnlistedEmployeeModal()
    {
        _selectedUnlistedEmployeeId = string.Empty;
        _isAddEmployeeModalOpen = true;
    }

    private IEnumerable<EmployeeOptionDto> GetUnlistedEmployees()
    {
        if (_preview == null) return Enumerable.Empty<EmployeeOptionDto>();
        return _preview.AvailableEmployees.Where(a => !_preview.Employees.Any(e => e.MatchedEmployeeId == a.Id));
    }

    private void ConfirmAddUnlistedEmployee()
    {
        if (_preview == null || string.IsNullOrEmpty(_selectedUnlistedEmployeeId)) return;

        var opt = _preview.AvailableEmployees.FirstOrDefault(e => e.Id == _selectedUnlistedEmployeeId);
        if (opt == null) return;

        var newEmp = new BiometricEmployeeLogDto
        {
            BiometricId = opt.EmployeeId ?? "MANUAL",
            ReportedName = opt.FullName,
            Department = opt.Department ?? "Staff",
            MatchedEmployeeId = opt.Id,
            MatchedEmployeeName = opt.FullName
        };

        var templateDays = _preview.Employees.FirstOrDefault()?.Days;
        if (templateDays != null)
        {
            foreach (var d in templateDays)
            {
                newEmp.Days.Add(new BiometricDayRecordDto
                {
                    Date = d.Date,
                    DayNumber = d.DayNumber,
                    DayOfWeek = d.DayOfWeek,
                    Status = "No Punches",
                    HasMissingPair = false
                });
            }
        }
        else if (_preview.StartDate.HasValue && _preview.EndDate.HasValue)
        {
            for (var dt = _preview.StartDate.Value; dt <= _preview.EndDate.Value; dt = dt.AddDays(1))
            {
                newEmp.Days.Add(new BiometricDayRecordDto
                {
                    Date = dt,
                    DayNumber = dt.Day,
                    DayOfWeek = dt.ToString("ddd"),
                    Status = "No Punches",
                    HasMissingPair = false
                });
            }
        }

        _preview.Employees.Add(newEmp);
        _preview.TotalEmployeesFound = _preview.Employees.Count;
        _preview.TotalMatchedEmployees = _preview.Employees.Count(e => e.IsMatched);

        ToastService.ShowSuccess($"Added {opt.FullName} to biometric preview.");
        _isAddEmployeeModalOpen = false;
        _selectedUnlistedEmployeeId = string.Empty;
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F2} MB";
    }

    public enum AttendanceType
    {
        ClockIn = 0,
        ClockOut = 1
    }

    public class BiometricPunchDto
    {
        public string Time { get; set; } = string.Empty;
        public string OriginalTime { get; set; } = string.Empty;
        public DateTimeOffset Timestamp { get; set; }
        public AttendanceType Type { get; set; }
        public bool IsDuplicate { get; set; }
        public bool IsNormalized { get; set; }
        public bool IsOvertime { get; set; }
        public double OvertimeHours { get; set; }
    }

    public class BiometricDayRecordDto
    {
        public DateTime Date { get; set; }
        public int DayNumber { get; set; }
        public string DayOfWeek { get; set; } = string.Empty;
        public string RawPunchText { get; set; } = string.Empty;
        public List<BiometricPunchDto> Punches { get; set; } = new();
        public string Status { get; set; } = "Normal";
        public bool HasMissingPair { get; set; }
    }

    public class BiometricEmployeeLogDto
    {
        public string BiometricId { get; set; } = string.Empty;
        public string ReportedName { get; set; } = string.Empty;
        public string Department { get; set; } = string.Empty;
        public string? MatchedEmployeeId { get; set; }
        public string? MatchedEmployeeName { get; set; }
        public bool IsMatched => !string.IsNullOrEmpty(MatchedEmployeeId);
        public List<BiometricDayRecordDto> Days { get; set; } = new();
        public int TotalPunches => Days.Sum(d => d.Punches.Count);
        public int MissingPunchCount => Days.Count(d => d.HasMissingPair);
    }

    public class BiometricPreviewResultDto
    {
        public bool Success { get; set; }
        public string? ErrorMessage { get; set; }
        public string ReportTitle { get; set; } = "Biometric Attendance Report";
        public string DateRangeText { get; set; } = string.Empty;
        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }
        public int TotalEmployeesFound { get; set; }
        public int TotalMatchedEmployees { get; set; }
        public int TotalPunchesFound { get; set; }
        public int TotalMissingPunchDays { get; set; }
        public List<BiometricEmployeeLogDto> Employees { get; set; } = new();
        public List<EmployeeOptionDto> AvailableEmployees { get; set; } = new();
    }

    public class EmployeeOptionDto
    {
        public string Id { get; set; } = string.Empty;
        public string? EmployeeId { get; set; }
        public string FullName { get; set; } = string.Empty;
        public string? Department { get; set; }
    }

    public class BiometricCommitPunchItemDto
    {
        public string EmployeeId { get; set; } = string.Empty;
        public DateTimeOffset Timestamp { get; set; }
        public AttendanceType Type { get; set; }
        public string? BiometricId { get; set; }
    }

    public class BiometricCommitRequestDto
    {
        public List<BiometricCommitPunchItemDto> Punches { get; set; } = new();
        public Dictionary<string, string> BiometricIdToEmployeeMappings { get; set; } = new();
        public bool AutoUpdateEmployeeIds { get; set; } = true;
    }

    public class CommitResponseDto
    {
        public string message { get; set; } = string.Empty;
        public int insertedCount { get; set; }
        public int skippedDuplicates { get; set; }
        public int updatedMappings { get; set; }
    }
}
