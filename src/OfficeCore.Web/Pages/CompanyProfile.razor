@page "/organization"
@attribute [Authorize(Policy = "RequireOrganization")]
@inject HttpClient Http
@inject ToastService ToastService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IConfiguration Configuration
@inject IJSRuntime JS

<PageTitle>Company Profile - OfficeCore</PageTitle>

<div class="space-y-6 max-w-5xl">
    <div>
        <h1 class="text-3xl font-bold tracking-tight text-white">Company Profile</h1>
        <p class="mt-1 text-zinc-400 text-sm">Manage workspace details and settings</p>
    </div>

    @if (_isLoading)
    {
        <div class="text-zinc-400 text-sm">Loading workspace details...</div>
    }
    else if (_org != null)
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
            <div class="lg:col-span-2 bg-zinc-900 border border-zinc-800 rounded-2xl p-6 shadow-xl space-y-6">
                <h3 class="text-lg font-medium text-white mb-4">Workspace Details</h3>
                
                <div class="mt-6 flex flex-col sm:flex-row gap-8 items-start">
                    <div class="shrink-0 flex flex-col items-center space-y-4">
                        <div class="relative group size-32 rounded-xl overflow-hidden border-2 border-zinc-800 bg-zinc-950 flex items-center justify-center text-zinc-700">
                            @if (!string.IsNullOrEmpty(_logoUrl))
                            {
                                <img src="@(Configuration["ApiBaseUrl"] + _logoUrl)" alt="Workspace Logo" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                <svg class="size-16" fill="currentColor" viewBox="0 0 24 24"><path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                            }
                            
                            <label class="absolute inset-0 bg-black/60 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer">
                                <svg class="size-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" /></svg>
                                <InputFile class="hidden" OnChange="HandleLogoSelected" accept="image/*" />
                            </label>
                        </div>
                        
                        @if (_isUploadingImage)
                        {
                            <div class="text-xs text-fuchsia-400 animate-pulse">Uploading...</div>
                        }
                        else
                        {
                            <div class="text-[10px] text-zinc-500 text-center max-w-[120px]">
                                Click to upload a new logo. JPG, GIF or PNG.
                            </div>
                        }
                    </div>

                    <div class="flex-1 space-y-4 w-full">
                        <div>
                            <label class="block text-sm font-medium text-zinc-400 mb-1">Workspace Name</label>
                            <input type="text" @bind="_orgName" class="block w-full rounded-lg bg-zinc-950 border border-zinc-800 px-3 py-2 text-white focus:border-fuchsia-500 focus:ring-fuchsia-500 sm:text-sm" />
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-zinc-400 mb-1">Address</label>
                            <textarea @bind="_address" rows="3" class="block w-full rounded-lg bg-zinc-950 border border-zinc-800 px-3 py-2 text-white focus:border-fuchsia-500 focus:ring-fuchsia-500 sm:text-sm"></textarea>
                        </div>

                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <label class="block text-sm font-medium text-zinc-400">Phone Numbers</label>
                                <button type="button" @onclick="AddPhone" class="text-xs text-fuchsia-400 hover:text-fuchsia-300 font-medium flex items-center gap-1">
                                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                                    Add Phone
                                </button>
                            </div>
                            
                            <div class="space-y-2">
                                @foreach (var phone in _phones)
                                {
                                    <div class="flex items-center gap-2">
                                        <input type="text" @bind="phone.Number" placeholder="Phone Number" class="block w-full rounded-lg bg-zinc-950 border border-zinc-800 px-3 py-2 text-white focus:border-fuchsia-500 focus:ring-fuchsia-500 sm:text-sm" />
                                        <select @bind="phone.Type" class="block rounded-lg bg-zinc-950 border border-zinc-800 px-3 py-2 text-white focus:border-fuchsia-500 focus:ring-fuchsia-500 sm:text-sm w-32">
                                            <option value="Telephone">Telephone</option>
                                            <option value="Mobile">Mobile</option>
                                        </select>
                                        <button type="button" @onclick="() => RemovePhone(phone)" class="p-2 text-zinc-500 hover:text-red-400 transition-colors">
                                            <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                        </button>
                                    </div>
                                }
                                @if (!_phones.Any())
                                {
                                    <p class="text-xs text-zinc-500 italic">No phone numbers added yet.</p>
                                }
                            </div>
                        </div>

                        <div class="pt-4 flex justify-end">
                            <button type="button" @onclick="HandleUpdateOrg" disabled="@_isSaving" class="rounded-lg bg-fuchsia-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-fuchsia-500 transition-colors disabled:opacity-50">
                                @if (_isSaving)
                                {
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <span>Save Changes</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-red-950/20 border border-red-900/50 rounded-2xl p-6 shadow-xl space-y-4">
                <h3 class="text-lg font-medium text-red-500">Danger Zone</h3>
                <p class="text-sm text-zinc-400">Permanently delete this workspace and all of its data. This action cannot be undone.</p>
                
                <div>
                    <button type="button" @onclick="() => _showDeleteConfirm = true" class="rounded-lg bg-red-600/10 border border-red-600/20 px-4 py-2 text-sm font-semibold text-red-500 hover:bg-red-600/20 transition-colors w-full">
                        Delete Workspace
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@if (_showCropModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm p-4">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden flex flex-col max-h-[90vh]">
            <div class="p-4 border-b border-zinc-800 flex items-center justify-between">
                <h3 class="text-lg font-bold text-white">Crop Logo</h3>
                <button @onclick="CancelCrop" class="text-zinc-400 hover:text-white transition-colors">
                    <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>
            
            <div class="p-4 flex-1 overflow-hidden flex items-center justify-center bg-black min-h-[300px]">
                @if (!string.IsNullOrEmpty(_unzoomedImageUrl))
                {
                    <img @ref="_cropImageRef" src="@_unzoomedImageUrl" class="max-w-full max-h-full block" />
                }
            </div>

            <div class="p-4 border-t border-zinc-800 flex justify-end gap-3 bg-zinc-950">
                <button type="button" @onclick="CancelCrop" class="px-4 py-2 text-sm font-semibold text-zinc-300 hover:text-white transition-colors">
                    Cancel
                </button>
                <button type="button" @onclick="SaveCrop" disabled="@_isUploadingImage" class="rounded-lg bg-fuchsia-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-fuchsia-500 transition-colors disabled:opacity-50">
                    @if (_isUploadingImage)
                    {
                        <span>Uploading...</span>
                    }
                    else
                    {
                        <span>Save & Upload</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@if (_showDeleteConfirm)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm p-4">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl shadow-2xl w-full max-w-md overflow-hidden flex flex-col">
            <div class="p-6">
                <div class="flex items-center gap-4 mb-4">
                    <div class="size-12 rounded-full bg-red-500/10 flex items-center justify-center shrink-0">
                        <svg class="size-6 text-red-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-white">Delete Workspace</h3>
                        <p class="text-sm text-zinc-400 mt-1">Are you sure you want to delete this workspace? All data will be permanently removed.</p>
                    </div>
                </div>
                <div class="mt-4">
                    <label class="block text-sm font-medium text-zinc-400 mb-1">Enter your password to confirm</label>
                    <input type="password" @bind="_deletePassword" class="block w-full rounded-lg bg-zinc-950 border border-zinc-800 px-3 py-2 text-white focus:border-red-500 focus:ring-red-500 sm:text-sm" placeholder="Your password" />
                </div>
            </div>
            
            <div class="p-4 border-t border-zinc-800 flex justify-end gap-3 bg-zinc-950">
                <button type="button" @onclick="() => _showDeleteConfirm = false" class="px-4 py-2 text-sm font-semibold text-zinc-300 hover:text-white transition-colors">
                    Cancel
                </button>
                <button type="button" @onclick="HandleDeleteOrg" disabled="@(_isDeleting || string.IsNullOrWhiteSpace(_deletePassword))" class="rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500 transition-colors disabled:opacity-50">
                    @if (_isDeleting)
                    {
                        <span>Deleting...</span>
                    }
                    else
                    {
                        <span>Yes, delete workspace</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private bool _isSaving = false;
    private bool _isDeleting = false;
    private bool _showDeleteConfirm = false;
    
    private OrganizationDto? _org;
    private string _orgName = "";
    private string? _address;
    private string? _logoUrl;
    private List<PhoneDto> _phones = new();

    private bool _showCropModal = false;
    private string? _unzoomedImageUrl;
    private ElementReference _cropImageRef;
    private bool _isUploadingImage = false;
    
    private string _deletePassword = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadOrganization();
    }

    private async Task LoadOrganization()
    {
        try
        {
            _org = await Http.GetFromJsonAsync<OrganizationDto>("/api/organizations/current");
            if (_org != null)
            {
                _orgName = _org.Name;
                _address = _org.Address;
                _logoUrl = _org.LogoUrl;
                _phones = _org.Phones?.ToList() ?? new List<PhoneDto>();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Failed to load workspace details.");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void AddPhone()
    {
        _phones.Add(new PhoneDto { Number = "", Type = "Telephone" });
    }

    private void RemovePhone(PhoneDto phone)
    {
        _phones.Remove(phone);
    }

    private async Task HandleUpdateOrg()
    {
        if (string.IsNullOrWhiteSpace(_orgName))
        {
            ToastService.ShowWarning("Workspace name cannot be empty.");
            return;
        }

        if (_phones.Any(p => string.IsNullOrWhiteSpace(p.Number)))
        {
            ToastService.ShowWarning("Phone numbers cannot be empty.");
            return;
        }

        _isSaving = true;
        try
        {
            var response = await Http.PutAsJsonAsync($"/api/organizations/{_org!.Id}", new { 
                name = _orgName,
                address = _address,
                phones = _phones
            });
            
            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("Workspace updated successfully!");
                if (AuthStateProvider is OfficeCore.Web.Client.Auth.CookieAuthStateProvider cookieAuth)
                {
                    cookieAuth.NotifyAuthStateChanged();
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                ToastService.ShowError("Only workspace admins can update the workspace profile.");
            }
            else
            {
                ToastService.ShowError("Failed to update workspace.");
            }
        }
        catch
        {
            ToastService.ShowError("An error occurred while updating workspace.");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task HandleLogoSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        if (e.File == null) return;
        
        try
        {
            var format = e.File.ContentType;
            var resizedImageFile = await e.File.RequestImageFileAsync(format, 800, 800);
            var buffer = new byte[resizedImageFile.Size];
            await resizedImageFile.OpenReadStream(10 * 1024 * 1024).ReadAsync(buffer);
            var base64 = Convert.ToBase64String(buffer);
            _unzoomedImageUrl = $"data:{format};base64,{base64}";
            _showCropModal = true;
            StateHasChanged();
            
            await Task.Delay(100);
            await JS.InvokeVoidAsync("cropperInterop.init", _cropImageRef);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error reading image: {ex.Message}");
        }
    }

    private async Task CancelCrop()
    {
        _showCropModal = false;
        _unzoomedImageUrl = null;
        await JS.InvokeVoidAsync("cropperInterop.destroy");
    }

    private async Task SaveCrop()
    {
        _isUploadingImage = true;
        
        try
        {
            var croppedDataUrl = await JS.InvokeAsync<string>("cropperInterop.getCroppedCanvasData");
            if (string.IsNullOrEmpty(croppedDataUrl)) return;
            
            var base64Data = croppedDataUrl.Substring(croppedDataUrl.IndexOf(",") + 1);
            var bytes = Convert.FromBase64String(base64Data);

            using var content = new MultipartFormDataContent();
            var fileContent = new ByteArrayContent(bytes);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("image/jpeg");
            content.Add(fileContent, "file", "logo.jpg");
            
            var response = await Http.PostAsync($"/api/organizations/{_org!.Id}/logo", content);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                if (result.TryGetProperty("logoUrl", out var urlProp))
                {
                    _logoUrl = urlProp.GetString();
                    
                    if (AuthStateProvider is OfficeCore.Web.Client.Auth.CookieAuthStateProvider cookieAuth)
                    {
                        cookieAuth.NotifyAuthStateChanged();
                    }
                    
                    await CancelCrop();
                }
            }
            else
            {
                ToastService.ShowError("Failed to upload logo.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error uploading logo: {ex.Message}");
        }
        finally
        {
            _isUploadingImage = false;
        }
    }

    private async Task HandleDeleteOrg()
    {
        if (string.IsNullOrWhiteSpace(_deletePassword))
        {
            ToastService.ShowWarning("Please enter your password to confirm.");
            return;
        }

        _isDeleting = true;
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Delete, $"/api/organizations/{_org!.Id}");
            request.Content = System.Net.Http.Json.JsonContent.Create(new { password = _deletePassword });
            var response = await Http.SendAsync(request);
            
            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("Workspace deleted successfully.");
                _showDeleteConfirm = false;
                
                if (AuthStateProvider is OfficeCore.Web.Client.Auth.CookieAuthStateProvider cookieAuth)
                {
                    cookieAuth.NotifyAuthStateChanged();
                }
                
                Nav.NavigateTo("/workspaces", forceLoad: true);
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                ToastService.ShowError("Only workspace admins can delete the workspace.");
                _showDeleteConfirm = false;
            }
            else
            {
                var errorMsg = await response.Content.ReadAsStringAsync();
                ToastService.ShowError(errorMsg ?? "Failed to delete workspace.");
                _deletePassword = "";
            }
        }
        catch
        {
            ToastService.ShowError("An error occurred while deleting workspace.");
            _showDeleteConfirm = false;
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private class OrganizationDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string? Address { get; set; }
        public string? LogoUrl { get; set; }
        public IEnumerable<PhoneDto>? Phones { get; set; }
    }

    private class PhoneDto
    {
        public Guid? Id { get; set; }
        public string Number { get; set; } = "";
        public string Type { get; set; } = "Telephone";
    }
}

