@page "/boards"
@attribute [Authorize(Policy = "RequireBoards")]
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IConfiguration Configuration

<PageTitle>Boards - OfficeCore</PageTitle>

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold tracking-tight text-white">Project Boards</h1>
            <p class="mt-1 text-zinc-400 text-sm">Manage your tasks, projects, and team workflows.</p>
        </div>
        <div class="flex items-center gap-3">
            <button @onclick="LoadBoards" class="inline-flex items-center gap-2 rounded-lg bg-zinc-900 border border-zinc-800 px-4 py-2.5 text-sm font-medium text-zinc-300 hover:bg-zinc-800 hover:text-white transition-all shadow-sm">
                <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
                Refresh
            </button>
            <button @onclick="() => _showCreateModal = true" class="inline-flex items-center gap-2 rounded-lg bg-fuchsia-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-fuchsia-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fuchsia-600 transition-all">
                <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                New Board
            </button>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            @for (int i = 0; i < 4; i++)
            {
                <div class="bg-zinc-950 border border-zinc-800 rounded-2xl p-6 h-48 animate-pulse">
                    <div class="h-6 w-3/4 bg-zinc-800 rounded mb-4"></div>
                    <div class="h-4 w-full bg-zinc-800 rounded mb-2"></div>
                    <div class="h-4 w-5/6 bg-zinc-800 rounded mb-8"></div>
                    <div class="flex gap-2">
                        <div class="size-8 rounded-full bg-zinc-800"></div>
                        <div class="size-8 rounded-full bg-zinc-800"></div>
                    </div>
                </div>
            }
        </div>
    }
    else if (_boards == null || !_boards.Any())
    {
        <div class="flex flex-col items-center justify-center py-20 bg-zinc-950 border border-zinc-800 rounded-2xl text-center">
            <div class="size-20 bg-zinc-900 rounded-full flex items-center justify-center mb-4">
                <svg class="size-10 text-zinc-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" /></svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">No boards yet</h3>
            <p class="text-zinc-400 max-w-sm mb-6">Create your first board to start tracking tasks and collaborating with your team.</p>
            <button @onclick="() => _showCreateModal = true" class="inline-flex items-center gap-2 rounded-lg bg-white/10 px-4 py-2 text-sm font-medium text-white hover:bg-white/20 transition-all">
                Create a Board
            </button>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            @foreach (var board in _boards)
            {
                <div @onclick="() => NavigateToBoard(board.Id)" class="group cursor-pointer bg-zinc-950 border border-zinc-800 rounded-2xl p-6 hover:border-fuchsia-500/50 hover:bg-zinc-900/50 transition-all relative overflow-hidden flex flex-col h-56 shadow-lg">
                    <div class="absolute inset-0 bg-gradient-to-br from-fuchsia-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                    
                    <button @onclick="() => ToggleStar(board)" @onclick:stopPropagation="true" class="absolute top-4 right-4 text-zinc-500 hover:text-yellow-400 transition-colors z-10" title="Pin Board">
                        <svg class="size-6 @(board.IsStarred ? "fill-yellow-400 text-yellow-400" : "")" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" /></svg>
                    </button>

                    <div class="relative flex-1 pr-8">
                        <h3 class="text-lg font-bold text-white group-hover:text-fuchsia-400 transition-colors mb-2 line-clamp-1">@board.Name</h3>
                        <p class="text-sm text-zinc-500 line-clamp-3">@(string.IsNullOrEmpty(board.Description) ? "No description provided." : board.Description)</p>
                    </div>
                    
                    <div class="relative pt-4 flex items-center justify-between border-t border-zinc-800/50">
                        <div class="flex items-center gap-2">
                            <div class="flex -space-x-2">
                                @for (int i = 0; i < Math.Min(3, board.MembersCount); i++)
                                {
                                    var avatar = board.MemberAvatars != null && board.MemberAvatars.Count > i ? board.MemberAvatars[i] : null;
                                    if (!string.IsNullOrEmpty(avatar))
                                    {
                                        <img src="@(Configuration["ApiBaseUrl"] + avatar)" class="size-7 rounded-full object-cover border-2 border-zinc-950" />
                                    }
                                    else
                                    {
                                        <div class="size-7 rounded-full bg-zinc-800 border-2 border-zinc-950 flex items-center justify-center">
                                            <svg class="size-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                                        </div>
                                    }
                                }
                            </div>
                            @if (board.MembersCount > 3)
                            {
                                <span class="text-xs font-medium text-zinc-500">+@(board.MembersCount - 3)</span>
                            }
                        </div>
                        <div class="text-[10px] font-medium text-zinc-600 uppercase tracking-wider">
                            By @board.CreatorName
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (_showCreateModal)
{
    <div class="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-50 p-4">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-md shadow-2xl overflow-hidden">
            <div class="px-6 py-4 border-b border-zinc-800 flex items-center justify-between bg-zinc-900">
                <h3 class="text-lg font-bold text-white tracking-wide">Create New Board</h3>
                <button @onclick="() => _showCreateModal = false" class="text-zinc-500 hover:text-white transition-colors">
                    <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>
            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-zinc-500 uppercase mb-2">Board Name</label>
                    <input type="text" @bind="_newBoardModel.Name" placeholder="e.g. Q3 Roadmap, Marketing Campaign" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-zinc-500 uppercase mb-2">Description <span class="text-zinc-700 normal-case font-normal">(Optional)</span></label>
                    <textarea @bind="_newBoardModel.Description" rows="3" placeholder="What is this board for?" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none resize-none"></textarea>
                </div>
            </div>
            <div class="px-6 py-4 border-t border-zinc-800 flex justify-end gap-3 bg-zinc-900/50">
                <button @onclick="() => _showCreateModal = false" class="px-4 py-2 text-sm font-medium text-zinc-400 hover:text-white transition-colors">Cancel</button>
                <button @onclick="CreateBoard" disabled="@string.IsNullOrWhiteSpace(_newBoardModel.Name)" class="px-4 py-2 text-sm font-bold text-white bg-fuchsia-600 rounded-lg hover:bg-fuchsia-500 disabled:opacity-50 disabled:cursor-not-allowed transition-all shadow-lg shadow-fuchsia-900/20">Create Board</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private List<BoardSummaryDto>? _boards;
    private bool _showCreateModal = false;
    private CreateBoardRequest _newBoardModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadBoards();
    }

    private async Task LoadBoards()
    {
        _isLoading = true;
        var fetched = await Http.GetFromJsonAsync<List<BoardSummaryDto>>("/api/boards");
        _boards = fetched?.OrderByDescending(b => b.IsStarred).ThenByDescending(b => b.CreatedAt).ToList();
        _isLoading = false;
    }

    private async Task ToggleStar(BoardSummaryDto board)
    {
        var response = await Http.PutAsync($"/api/boards/{board.Id}/star", null);
        if (response.IsSuccessStatusCode)
        {
            board.IsStarred = !board.IsStarred;
            if (_boards != null)
            {
                _boards = _boards.OrderByDescending(b => b.IsStarred).ThenByDescending(b => b.CreatedAt).ToList();
            }
        }
    }

    private void NavigateToBoard(Guid id)
    {
        NavigationManager.NavigateTo($"/boards/{id}");
    }

    private async Task CreateBoard()
    {
        if (string.IsNullOrWhiteSpace(_newBoardModel.Name)) return;

        var response = await Http.PostAsJsonAsync("/api/boards", _newBoardModel);
        if (response.IsSuccessStatusCode)
        {
            _showCreateModal = false;
            _newBoardModel = new();
            var createdBoard = await response.Content.ReadFromJsonAsync<BoardSummaryDto>();
            if (createdBoard != null)
            {
                NavigateToBoard(createdBoard.Id);
            }
        }
    }

    public class BoardSummaryDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string CreatorName { get; set; } = string.Empty;
        public int MembersCount { get; set; }
        public bool IsStarred { get; set; }
        public DateTime CreatedAt { get; set; }
        public List<string?> MemberAvatars { get; set; } = new();
    }

    public class CreateBoardRequest
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
    }
}
