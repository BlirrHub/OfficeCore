@page "/advances"
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>Advances & Loans - OfficeCore</PageTitle>

<div class="flex flex-col h-full bg-zinc-950">
    <div class="border-b border-zinc-800 px-6 pt-4 flex items-center justify-between">
        <div class="flex gap-6">
            <button class="pb-3 text-sm font-medium border-b-2 transition-colors border-fuchsia-500 text-fuchsia-400">
                My Requests
            </button>
        </div>
        
        <button @onclick="() => _isRequesting = true" class="px-4 py-2 mb-3 text-sm font-medium text-white bg-fuchsia-600 rounded-lg hover:bg-fuchsia-500 transition-colors shadow-lg shadow-fuchsia-900/30 flex items-center gap-2">
            <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            New Request
        </button>
    </div>

    <div class="flex-1 overflow-y-auto p-8 relative">
        @if (_isRequesting)
        {
            <div class="max-w-2xl mx-auto bg-zinc-900 border border-zinc-800 rounded-2xl p-8 shadow-xl">
                <div class="flex items-center justify-between border-b border-zinc-800 pb-4 mb-6">
                    <h2 class="text-xl font-bold text-white uppercase tracking-wider">Request Advance or ELoan</h2>
                </div>

                <div class="space-y-6">
                    <div>
                        <label class="block text-sm font-medium text-zinc-400 mb-2">Request Type</label>
                        <div class="flex gap-4">
                            <label class="flex-1 relative border border-zinc-700 rounded-xl p-4 cursor-pointer hover:border-fuchsia-500 transition-colors group @(_newRequest.Type == AdvanceType.CashAdvance ? "bg-fuchsia-900/10 border-fuchsia-500" : "bg-zinc-950")">
                                <input type="radio" name="requestType" checked="@(_newRequest.Type == AdvanceType.CashAdvance)" @onchange="() => _newRequest.Type = AdvanceType.CashAdvance" class="sr-only" />
                                <div class="font-medium text-white mb-1">Cash Advance</div>
                                <div class="text-xs text-zinc-500">Deducted entirely from your next payroll.</div>
                            </label>
                            <label class="flex-1 relative border border-zinc-700 rounded-xl p-4 cursor-pointer hover:border-emerald-500 transition-colors group @(_newRequest.Type == AdvanceType.ELoan ? "bg-emerald-900/10 border-emerald-500" : "bg-zinc-950")">
                                <input type="radio" name="requestType" checked="@(_newRequest.Type == AdvanceType.ELoan)" @onchange="() => _newRequest.Type = AdvanceType.ELoan" class="sr-only" />
                                <div class="font-medium text-white mb-1">E-Loan</div>
                                <div class="text-xs text-zinc-500">Deducted in installments with a running balance.</div>
                            </label>
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-zinc-400 mb-2">Requested Amount</label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-zinc-500">$</span>
                            <input type="number" @bind="_newRequest.RequestedAmount" step="0.01" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-8 pr-4 py-3 text-white focus:border-fuchsia-500 focus:outline-none" placeholder="0.00" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-zinc-400 mb-2">Reason / Note</label>
                        <textarea @bind="_newRequest.Note" rows="3" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-white focus:border-fuchsia-500 focus:outline-none" placeholder="Briefly explain the reason for this request..."></textarea>
                    </div>
                </div>

                <div class="mt-8 pt-6 border-t border-zinc-800 flex justify-end gap-3">
                    <button @onclick="() => _isRequesting = false" class="px-5 py-2.5 text-sm font-medium text-zinc-400 hover:text-white transition-colors">Cancel</button>
                    <button @onclick="SubmitRequest" class="px-5 py-2.5 text-sm font-medium text-white bg-fuchsia-600 rounded-lg hover:bg-fuchsia-500 transition-colors shadow-lg shadow-fuchsia-900/30">Submit Request</button>
                </div>
            </div>
        }
        else if (_requests == null)
        {
            <div class="flex items-center justify-center py-12">
                <div class="text-zinc-500">Loading...</div>
            </div>
        }
        else if (!_requests.Any())
        {
            <div class="absolute inset-0 flex flex-col items-center justify-center">
                <div class="text-center space-y-4">
                    <div class="mx-auto size-24 bg-zinc-900 rounded-full flex items-center justify-center">
                        <svg class="size-10 text-zinc-700" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-medium text-white">No requests found</h3>
                    <p class="text-sm text-zinc-500 max-w-sm">You haven't requested any Cash Advances or E-Loans yet.</p>
                </div>
            </div>
        }
        else
        {
            <div class="w-full">
                <div class="bg-zinc-900 border border-zinc-800 rounded-2xl shadow-xl overflow-hidden">
                    <table class="w-full text-left text-sm whitespace-nowrap">
                        <thead class="bg-zinc-950/50 text-zinc-500 uppercase tracking-wider text-xs font-semibold">
                            <tr>
                                <th class="px-6 py-4 border-b border-zinc-800">Date Requested</th>
                                <th class="px-6 py-4 border-b border-zinc-800">Type</th>
                                <th class="px-6 py-4 border-b border-zinc-800 text-right">Amount</th>
                                <th class="px-6 py-4 border-b border-zinc-800 text-right">Balance</th>
                                <th class="px-6 py-4 border-b border-zinc-800 text-center">Status</th>
                                <th class="px-6 py-4 border-b border-zinc-800"></th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-zinc-800/50">
                            @foreach (var req in _requests)
                            {
                                <tr class="hover:bg-zinc-800/50 transition-colors">
                                    <td class="px-6 py-4 text-zinc-300">
                                        <div class="font-medium text-white">@req.RequestDate.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                        <div class="text-xs text-zinc-500">@req.Note</div>
                                    </td>
                                    <td class="px-6 py-4">
                                        @if (req.Type == AdvanceType.CashAdvance)
                                        {
                                            <span class="inline-flex items-center gap-1.5 py-1 px-2 rounded-md text-xs font-medium bg-fuchsia-900/20 text-fuchsia-400 border border-fuchsia-900/50">
                                                Cash Advance
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1.5 py-1 px-2 rounded-md text-xs font-medium bg-emerald-900/20 text-emerald-400 border border-emerald-900/50">
                                                E-Loan
                                            </span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right font-medium text-white">
                                        @req.RequestedAmount.ToString("C")
                                    </td>
                                    <td class="px-6 py-4 text-right text-zinc-400">
                                        @(req.Type == AdvanceType.ELoan && req.RemainingBalance.HasValue ? req.RemainingBalance.Value.ToString("C") : "-")
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        @if (req.Status == AdvanceStatus.Pending)
                                        {
                                            <span class="inline-flex items-center gap-1.5 py-1 px-2 rounded-md text-xs font-medium bg-yellow-900/20 text-yellow-400 border border-yellow-900/50">
                                                Pending
                                            </span>
                                        }
                                        else if (req.Status == AdvanceStatus.Approved)
                                        {
                                            <span class="inline-flex items-center gap-1.5 py-1 px-2 rounded-md text-xs font-medium bg-green-900/20 text-green-400 border border-green-900/50">
                                                Approved
                                            </span>
                                        }
                                        else if (req.Status == AdvanceStatus.Rejected)
                                        {
                                            <span class="inline-flex items-center gap-1.5 py-1 px-2 rounded-md text-xs font-medium bg-red-900/20 text-red-400 border border-red-900/50">
                                                Rejected
                                            </span>
                                        }
                                        else if (req.Status == AdvanceStatus.Cancelled)
                                        {
                                            <span class="inline-flex items-center gap-1.5 py-1 px-2 rounded-md text-xs font-medium bg-zinc-800 text-zinc-400 border border-zinc-700">
                                                Cancelled
                                            </span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        @if (req.Status == AdvanceStatus.Pending)
                                        {
                                            <button @onclick="() => CancelRequest(req.Id)" class="text-xs font-medium text-zinc-500 hover:text-red-400 transition-colors">Cancel</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<AdvanceRequestDto>? _requests;
    private bool _isRequesting = false;
    private AdvanceRequestDto _newRequest = new() { Type = AdvanceType.CashAdvance };

    protected override async Task OnInitializedAsync()
    {
        await LoadRequests();
    }

    private async Task LoadRequests()
    {
        _requests = await Http.GetFromJsonAsync<List<AdvanceRequestDto>>("/api/advancerequest/my");
    }

    private async Task SubmitRequest()
    {
        if (_newRequest.RequestedAmount <= 0) return;

        var response = await Http.PostAsJsonAsync("/api/advancerequest", _newRequest);
        if (response.IsSuccessStatusCode)
        {
            _isRequesting = false;
            _newRequest = new AdvanceRequestDto { Type = AdvanceType.CashAdvance };
            await LoadRequests();
        }
    }

    private async Task CancelRequest(Guid id)
    {
        var response = await Http.PutAsync($"/api/advancerequest/{id}/cancel", null);
        if (response.IsSuccessStatusCode)
        {
            await LoadRequests();
        }
    }

    public enum AdvanceType { CashAdvance, ELoan }
    public enum AdvanceStatus { Pending, Approved, Rejected, Cancelled }

    public class AdvanceRequestDto
    {
        public Guid Id { get; set; }
        public AdvanceType Type { get; set; }
        public decimal RequestedAmount { get; set; }
        public string Note { get; set; } = string.Empty;
        public AdvanceStatus Status { get; set; }
        public DateTime RequestDate { get; set; }
        public decimal? RemainingBalance { get; set; }
    }
}
