@page "/advances"
@attribute [Authorize]
@inject HttpClient Http
@inject OfficeCore.Web.Services.ToastService ToastService
@inject NavigationManager Navigation
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client

<PageTitle>Advances & Loans - OfficeCore</PageTitle>

<div class="space-y-6">
    <PageHeader Title="Advances & Loans" Subtitle="Request and manage your Cash Advances and E-Loans">
        <Actions>
            <div class="flex items-center gap-3">
                <button @onclick="RefreshData" disabled="@_isLoading" class="p-2 text-zinc-400 hover:text-white bg-zinc-900 border border-zinc-800 rounded-lg transition-colors" title="Refresh">
                    <svg class="size-4 @(_isLoading ? "animate-spin text-fuchsia-400" : "")" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
                </button>
                <AppButton OnClick="() => _isRequesting = true">
                    <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                    New Request
                </AppButton>
            </div>
        </Actions>
    </PageHeader>

    <div>
        @if (_isRequesting)
        {
            <div class="max-w-2xl mx-auto bg-zinc-950 border border-zinc-800 rounded-2xl p-8 shadow-xl">
                <div class="flex items-center justify-between border-b border-zinc-800 pb-4 mb-6">
                    <h2 class="text-xl font-bold text-white uppercase tracking-wider">Request Advance or ELoan</h2>
                </div>

                <div class="space-y-6">
                    <div>
                        <label class="block text-sm font-medium text-zinc-400 mb-2">Request Type</label>
                        <div class="flex gap-4">
                            <label class="flex-1 relative border border-zinc-700 rounded-xl p-4 cursor-pointer hover:border-fuchsia-500 transition-colors group @(_newRequest.Type == AdvanceType.CashAdvance ? "bg-fuchsia-900/10 border-fuchsia-500" : "bg-zinc-950")">
                                <input type="radio" name="requestType" checked="@(_newRequest.Type == AdvanceType.CashAdvance)" @onchange="() => _newRequest.Type = AdvanceType.CashAdvance" class="sr-only" />
                                <div class="font-medium text-white mb-1">Cash Advance</div>
                                <div class="text-xs text-zinc-500">Deducted entirely from your next payroll.</div>
                            </label>
                            <label class="flex-1 relative border border-zinc-700 rounded-xl p-4 cursor-pointer hover:border-emerald-500 transition-colors group @(_newRequest.Type == AdvanceType.ELoan ? "bg-emerald-900/10 border-emerald-500" : "bg-zinc-950")">
                                <input type="radio" name="requestType" checked="@(_newRequest.Type == AdvanceType.ELoan)" @onchange="() => _newRequest.Type = AdvanceType.ELoan" class="sr-only" />
                                <div class="font-medium text-white mb-1">E-Loan</div>
                                <div class="text-xs text-zinc-500">Deducted in installments with a running balance.</div>
                            </label>
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-zinc-400 mb-2">Requested Amount</label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-zinc-500">₱</span>
                            <input type="number" @bind="_newRequest.RequestedAmount" step="0.01" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-8 pr-4 py-3 text-white focus:border-fuchsia-500 focus:outline-none" placeholder="0.00" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-zinc-400 mb-2">Reason / Note</label>
                        <textarea @bind="_newRequest.Note" rows="3" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-white focus:border-fuchsia-500 focus:outline-none" placeholder="Briefly explain the reason for this request..."></textarea>
                    </div>
                </div>

                <div class="mt-8 pt-6 border-t border-zinc-800 flex justify-end gap-3">
                    <button @onclick="() => _isRequesting = false" class="px-5 py-2.5 text-sm font-medium text-zinc-400 hover:text-white transition-colors">Cancel</button>
                    <button @onclick="SubmitRequest" class="px-5 py-2.5 text-sm font-medium text-white bg-fuchsia-600 rounded-lg hover:bg-fuchsia-500 transition-colors shadow-lg shadow-fuchsia-900/30">Submit Request</button>
                </div>
            </div>
        }
        else if (_requests == null)
        {
            <div class="flex items-center justify-center py-12">
                <div class="text-zinc-500">Loading...</div>
            </div>
        }
        else if (!_requests.Any())
        {
            <AppCard>
                <EmptyState Title="No requests found" Description="You haven't requested any Cash Advances or E-Loans yet.">
                    <Action>
                        <AppButton OnClick="() => _isRequesting = true">Request Now</AppButton>
                    </Action>
                </EmptyState>
            </AppCard>
        }
        else
        {
            <div class="bg-zinc-950 border border-zinc-800 rounded-2xl overflow-hidden shadow-xl">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-zinc-800 text-zinc-400 text-left bg-zinc-900/40">
                            <th class="px-6 py-4 font-medium">Date Requested</th>
                            <th class="px-6 py-4 font-medium">Type</th>
                            <th class="px-6 py-4 font-medium text-right">Amount</th>
                            <th class="px-6 py-4 font-medium text-right">Balance</th>
                            <th class="px-6 py-4 font-medium text-center">Status</th>
                            <th class="px-6 py-4 font-medium"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-800/50">
                            @foreach (var req in _requests)
                            {
                                <tr class="hover:bg-zinc-800/30 transition-colors">
                                    <td class="px-6 py-4 text-zinc-300">
                                        <div class="font-medium text-white">@req.RequestDate.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                        <div class="text-xs text-zinc-500">@req.Note</div>
                                    </td>
                                    <td class="px-6 py-4">
                                        @if (req.Type == AdvanceType.CashAdvance)
                                        {
                                            <AppBadge Variant="primary">Cash Advance</AppBadge>
                                        }
                                        else
                                        {
                                            <AppBadge Variant="success">E-Loan</AppBadge>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right font-medium text-white">
                                        @req.RequestedAmount.ToString("C")
                                    </td>
                                    <td class="px-6 py-4 text-right text-zinc-400">
                                        @(req.Type == AdvanceType.ELoan && req.RemainingBalance.HasValue ? req.RemainingBalance.Value.ToString("C") : "-")
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        @if (req.Status == AdvanceStatus.Pending)
                                        {
                                            <AppBadge Variant="warning" Dot="true">Pending</AppBadge>
                                        }
                                        else if (req.Status == AdvanceStatus.Approved)
                                        {
                                            <AppBadge Variant="success" Dot="true">Approved</AppBadge>
                                        }
                                        else if (req.Status == AdvanceStatus.Rejected)
                                        {
                                            <AppBadge Variant="danger" Dot="true">Rejected</AppBadge>
                                        }
                                        else if (req.Status == AdvanceStatus.Cancelled)
                                        {
                                            <AppBadge Variant="default" Dot="true">Cancelled</AppBadge>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        @if (req.Status == AdvanceStatus.Pending)
                                        {
                                            <button @onclick="() => ShowCancelConfirmation(req.Id)" class="text-xs font-medium text-zinc-500 hover:text-red-400 transition-colors">Cancel</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
            </div>
        }
    </div>
</div>

@if (_showCancelModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm p-4">
        <div class="bg-zinc-950 border border-zinc-800 rounded-2xl w-full max-w-sm shadow-2xl p-6 relative">
            <h3 class="text-lg font-bold text-white mb-2">Cancel Request</h3>
            <p class="text-sm text-zinc-400 mb-6">Are you sure you want to cancel this advance request?</p>
            <div class="flex gap-3">
                <button @onclick="() => _showCancelModal = false" class="flex-1 py-2.5 rounded-lg text-sm font-medium text-zinc-400 bg-zinc-800/50 hover:bg-zinc-800 hover:text-white transition-all">Go Back</button>
                <button @onclick="ConfirmCancelRequest" class="flex-1 py-2.5 rounded-lg text-sm font-bold text-white bg-red-600 hover:bg-red-500 shadow-lg shadow-red-900/20 transition-all flex justify-center items-center">
                    @if (_isCancelling)
                    {
                        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                        <span>Cancelling...</span>
                    }
                    else
                    {
                        <span>Yes, Cancel</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<AdvanceRequestDto>? _requests;
    private bool _isRequesting = false;
    private bool _isLoading = false;
    private AdvanceRequestDto _newRequest = new() { Type = AdvanceType.CashAdvance };
    private bool _showCancelModal = false;
    private Guid? _requestToCancel;
    private bool _isCancelling = false;

    // SignalR
    private HubConnection? _hubConnection;

    protected override async Task OnInitializedAsync()
    {
        await RefreshData();
        await ConnectToHub();
    }

    private async Task RefreshData()
    {
        if (_isLoading) return;
        _isLoading = true;
        try
        {
            await LoadRequests();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ConnectToHub()
    {
        var hubUrl = new Uri(Http.BaseAddress!, "hubs/notifications").ToString();

        _hubConnection = new HubConnectionBuilder()
            .WithUrl(hubUrl)
            .WithAutomaticReconnect()
            .Build();

        // When admin approves or rejects, update the employee's list live
        _hubConnection.On("AdvanceRequestUpdated", async () =>
        {
            await LoadRequests();
            await InvokeAsync(StateHasChanged);
            ToastService.ShowSuccess("Your advance/loan request was updated.");
        });

        try { await _hubConnection.StartAsync(); } catch { /* Hub is optional; page works without it */ }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
            await _hubConnection.DisposeAsync();
    }

    private async Task LoadRequests()
    {
        _requests = await Http.GetFromJsonAsync<List<AdvanceRequestDto>>("/api/advancerequest/my");
    }

    private async Task SubmitRequest()
    {
        if (_newRequest.RequestedAmount <= 0) return;

        var response = await Http.PostAsJsonAsync("/api/advancerequest", _newRequest);
        if (response.IsSuccessStatusCode)
        {
            _isRequesting = false;
            _newRequest = new AdvanceRequestDto { Type = AdvanceType.CashAdvance };
            await LoadRequests();
            ToastService.ShowSuccess("Advance request submitted successfully.");
        }
        else
        {
            ToastService.ShowError("Failed to submit request.");
        }
    }

    private void ShowCancelConfirmation(Guid id)
    {
        _requestToCancel = id;
        _showCancelModal = true;
    }

    private async Task ConfirmCancelRequest()
    {
        if (_requestToCancel == null) return;
        _isCancelling = true;

        try
        {
            var response = await Http.PutAsync($"/api/advancerequest/{_requestToCancel}/cancel", null);
            if (response.IsSuccessStatusCode)
            {
                _showCancelModal = false;
                await LoadRequests();
                ToastService.ShowSuccess("Request cancelled successfully.");
            }
            else
            {
                ToastService.ShowError("Failed to cancel request.");
            }
        }
        catch
        {
            ToastService.ShowError("An error occurred while cancelling.");
        }
        finally
        {
            _isCancelling = false;
            _requestToCancel = null;
        }
    }

    public enum AdvanceType { CashAdvance, ELoan }
    public enum AdvanceStatus { Pending, Approved, Rejected, Cancelled }

    public class AdvanceRequestDto
    {
        public Guid Id { get; set; }
        public AdvanceType Type { get; set; }
        public decimal RequestedAmount { get; set; }
        public string Note { get; set; } = string.Empty;
        public AdvanceStatus Status { get; set; }
        public DateTime RequestDate { get; set; }
        public decimal? RemainingBalance { get; set; }
    }
}
