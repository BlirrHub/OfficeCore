@page "/my-overtime"
@attribute [Authorize]
@inject HttpClient Http
@inject OfficeCore.Web.Services.ToastService ToastService
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client
@using OfficeCore.Web.Services

<PageTitle>My Overtime - OfficeCore</PageTitle>

<div class="space-y-6">
    <PageHeader Title="My Overtime" Subtitle="Request pre-shift/post-shift overtime and monitor approval status.">
        <Actions>
            <div class="flex items-center gap-3">
                <button @onclick="RefreshData" disabled="@_isLoading" class="p-2 text-zinc-400 hover:text-white bg-zinc-900 border border-zinc-800 rounded-lg transition-colors cursor-pointer" title="Refresh">
                    <svg class="size-4 @(_isLoading ? "animate-spin text-fuchsia-400" : "")" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
                </button>
                <AppButton OnClick="() => _isCreating = true">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                    Request Pre-OT
                </AppButton>
            </div>
        </Actions>
    </PageHeader>

    <!-- Stats row -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5 shadow-lg">
            <div class="flex items-center justify-between text-zinc-400 text-xs font-semibold uppercase tracking-wider">
                <span>Pending Approvals</span>
                <span class="size-2 rounded-full bg-amber-400"></span>
            </div>
            <p class="text-3xl font-bold text-white mt-2">@(_requests?.Count(r => r.Status == 0) ?? 0)</p>
            <p class="text-xs text-zinc-500 mt-1">Awaiting management review</p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5 shadow-lg">
            <div class="flex items-center justify-between text-zinc-400 text-xs font-semibold uppercase tracking-wider">
                <span>Approved Hours</span>
                <span class="size-2 rounded-full bg-emerald-400"></span>
            </div>
            <p class="text-3xl font-bold text-emerald-400 mt-2">
                @((_requests?.Where(r => r.Status == 1).Sum(r => r.ApprovedHours ?? r.RequestedHours) ?? 0).ToString("0.##")) <span class="text-sm font-normal text-zinc-400">hrs</span>
            </p>
            <p class="text-xs text-zinc-500 mt-1">Credited into payroll</p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5 shadow-lg">
            <div class="flex items-center justify-between text-zinc-400 text-xs font-semibold uppercase tracking-wider">
                <span>Pre-Overtime Filed</span>
                <span class="size-2 rounded-full bg-fuchsia-400"></span>
            </div>
            <p class="text-3xl font-bold text-fuchsia-400 mt-2">@(_requests?.Count(r => r.Type == 0) ?? 0)</p>
            <p class="text-xs text-zinc-500 mt-1">Prior requests</p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5 shadow-lg">
            <div class="flex items-center justify-between text-zinc-400 text-xs font-semibold uppercase tracking-wider">
                <span>Auto-Detected Post-OT</span>
                <span class="size-2 rounded-full bg-cyan-400"></span>
            </div>
            <p class="text-3xl font-bold text-cyan-400 mt-2">@(_requests?.Count(r => r.Type == 1) ?? 0)</p>
            <p class="text-xs text-zinc-500 mt-1">15m+ post-shift punches</p>
        </div>
    </div>

    <!-- Main Card -->
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden shadow-xl">
        <div class="p-4 border-b border-zinc-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-zinc-900/50">
            <div class="relative w-full sm:w-72">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 size-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                <input type="text" @bind="_searchQuery" @bind:event="oninput" @bind:after="ResetPage" placeholder="Search reason..." class="bg-zinc-950 border border-zinc-800 rounded-lg pl-9 pr-4 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none w-full" />
            </div>
            <div class="flex items-center gap-2 flex-wrap">
                <select @bind="_statusFilter" @bind:after="ResetPage" class="bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none cursor-pointer">
                    <option value="-1">All Statuses</option>
                    <option value="0">Pending</option>
                    <option value="1">Approved</option>
                    <option value="2">Rejected</option>
                    <option value="3">Cancelled</option>
                </select>
                <select @bind="_typeFilter" @bind:after="ResetPage" class="bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none cursor-pointer">
                    <option value="-1">All Types</option>
                    <option value="0">Pre-Overtime</option>
                    <option value="1">Post-Overtime</option>
                </select>
            </div>
        </div>

        @if (_requests == null)
        {
            <div class="p-12 text-center text-zinc-500">
                <svg class="animate-spin size-8 mx-auto mb-4 text-fuchsia-400" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" /><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" /></svg>
                Loading overtime records...
            </div>
        }
        else
        {
            var filtered = _requests.Where(r =>
                (string.IsNullOrWhiteSpace(_searchQuery) || (r.Reason != null && r.Reason.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))) &&
                (_statusFilter == -1 || r.Status == _statusFilter) &&
                (_typeFilter == -1 || r.Type == _typeFilter)
            ).ToList();

            if (!filtered.Any())
            {
                <EmptyState Card="false"
                            Title="No overtime records found"
                            Description="No requests match your current filters. Click 'Request Pre-OT' to file in advance." />
            }
            else
            {
                var paged = filtered.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm whitespace-nowrap">
                        <thead class="bg-zinc-950/50 text-zinc-400 font-medium border-b border-zinc-800/80">
                            <tr>
                                <th class="px-6 py-4">Work Date</th>
                                <th class="px-6 py-4">Type</th>
                                <th class="px-6 py-4">Time Window</th>
                                <th class="px-6 py-4">Hours</th>
                                <th class="px-6 py-4">Reason / Notes</th>
                                <th class="px-6 py-4">Status & Details</th>
                                <th class="px-6 py-4 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-zinc-800/60 text-zinc-300">
                            @foreach (var req in paged)
                            {
                                <tr class="hover:bg-zinc-800/30 transition-colors">
                                    <td class="px-6 py-4">
                                        <div class="font-medium text-white">@req.Date.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                        <div class="text-[11px] text-zinc-500">@req.Date.ToLocalTime().ToString("dddd")</div>
                                    </td>
                                    <td class="px-6 py-4">
                                        @if (req.Type == 0)
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-fuchsia-950/80 text-fuchsia-300 border border-fuchsia-800/60">
                                                <span class="size-1.5 rounded-full bg-fuchsia-400"></span>
                                                Pre-Overtime
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-cyan-950/80 text-cyan-300 border border-cyan-800/60">
                                                <span class="size-1.5 rounded-full bg-cyan-400"></span>
                                                Post-Overtime
                                            </span>
                                        }
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="font-mono text-xs text-zinc-200">
                                            @FormatTimeSpanString(req.StartTime) — @FormatTimeSpanString(req.EndTime)
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="font-semibold text-white">
                                            @(req.ApprovedHours.HasValue ? req.ApprovedHours.Value.ToString("0.##") : req.RequestedHours.ToString("0.##")) hrs
                                        </div>
                                        @if (req.ApprovedHours.HasValue && req.ApprovedHours.Value != req.RequestedHours)
                                        {
                                            <div class="text-[10px] text-zinc-500 line-through">Requested: @req.RequestedHours.ToString("0.##") hrs</div>
                                        }
                                    </td>
                                    <td class="px-6 py-4 max-w-xs">
                                        <div class="truncate text-xs text-zinc-400" title="@req.Reason">
                                            @(string.IsNullOrWhiteSpace(req.Reason) ? "—" : req.Reason)
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        @if (req.Status == 0)
                                        {
                                            <AppBadge Variant="warning" Dot="true">Pending Review</AppBadge>
                                        }
                                        else if (req.Status == 1)
                                        {
                                            <div class="flex flex-col gap-0.5">
                                                <AppBadge Variant="success" Dot="true">Approved</AppBadge>
                                                @if (!string.IsNullOrEmpty(req.ReviewedByName))
                                                {
                                                    <span class="text-[10px] text-zinc-500">By @req.ReviewedByName</span>
                                                }
                                            </div>
                                        }
                                        else if (req.Status == 2)
                                        {
                                            <div class="flex flex-col gap-0.5">
                                                <AppBadge Variant="danger" Dot="true">Rejected</AppBadge>
                                                <span class="text-[10px] text-zinc-500" title="@req.RejectionReason">
                                                    @(string.IsNullOrWhiteSpace(req.RejectionReason) ? "Clamped to shift end" : req.RejectionReason)
                                                </span>
                                            </div>
                                        }
                                        else if (req.Status == 3)
                                        {
                                            <AppBadge Variant="default" Dot="true">Cancelled</AppBadge>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        @if (req.Status == 0 && req.Type == 0)
                                        {
                                            <button @onclick="() => CancelRequest(req.Id)" class="px-2.5 py-1 text-xs font-medium text-red-400 hover:text-red-300 hover:bg-red-950/40 rounded-lg border border-red-900/40 transition-colors cursor-pointer" title="Cancel Pre-OT Request">
                                                Cancel
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-zinc-600 text-xs">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <PaginationToolbar @bind-Page="_page" @bind-PageSize="_pageSize" TotalCount="filtered.Count" />
            }
        }
    </div>
</div>

<!-- Request Pre-OT Modal -->
@if (_isCreating)
{
    <div class="fixed inset-0 bg-black/75 backdrop-blur-sm flex items-center justify-center z-50 p-4 animate-in fade-in duration-200">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-lg shadow-2xl flex flex-col overflow-hidden">
            <div class="px-6 py-4 border-b border-zinc-800 flex items-center justify-between shrink-0 bg-zinc-950/40">
                <div>
                    <h3 class="text-base font-bold text-white tracking-wide">Request Pre-Overtime</h3>
                    <p class="text-xs text-zinc-400 mt-0.5">Submit an overtime request for an upcoming shift to get advance approval.</p>
                </div>
                <button type="button" @onclick="() => _isCreating = false" class="text-zinc-500 hover:text-white transition-colors cursor-pointer">
                    <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>

            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Shift Date</label>
                    <input type="date" @bind="_newDate" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none cursor-pointer" />
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Start Time</label>
                        <input type="time" @bind="_newStartTime" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none cursor-pointer font-mono" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">End Time</label>
                        <input type="time" @bind="_newEndTime" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none cursor-pointer font-mono" />
                    </div>
                </div>

                <!-- Live Duration Pill -->
                <div class="p-3 bg-zinc-950 rounded-xl border border-zinc-800 flex items-center justify-between text-xs">
                    <span class="text-zinc-400 font-medium">Estimated Overtime Duration:</span>
                    <span class="font-bold font-mono @(CalculateNewDuration() >= 0.25 ? "text-fuchsia-400" : "text-amber-400")">
                        @(CalculateNewDuration() > 0 ? $"{CalculateNewDuration():0.##} hours" : "Invalid window")
                    </span>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Purpose / Reason</label>
                    <textarea @bind="_newReason" rows="3" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none placeholder-zinc-600" placeholder="Describe the deliverable, emergency task, or client urgency..."></textarea>
                </div>

                @if (!string.IsNullOrEmpty(_modalError))
                {
                    <div class="p-3 bg-red-950/50 border border-red-900/50 rounded-lg">
                        <p class="text-xs text-red-400 font-medium">@_modalError</p>
                    </div>
                }
            </div>

            <div class="px-6 py-4 border-t border-zinc-800 flex justify-end gap-3 shrink-0 bg-zinc-950/40">
                <button type="button" @onclick="() => _isCreating = false" class="px-4 py-2 text-xs font-medium text-zinc-400 hover:text-white bg-zinc-800 hover:bg-zinc-700 rounded-lg transition-colors cursor-pointer">
                    Cancel
                </button>
                <button type="button" @onclick="SubmitRequest" disabled="@_isSubmitting" class="px-4 py-2 text-xs font-semibold text-white bg-fuchsia-600 hover:bg-fuchsia-500 rounded-lg transition-colors shadow-lg shadow-fuchsia-900/30 flex items-center gap-2 cursor-pointer disabled:opacity-50">
                    @if (_isSubmitting)
                    {
                        <svg class="animate-spin size-3.5" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" /><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" /></svg>
                        <span>Submitting...</span>
                    }
                    else
                    {
                        <span>Submit Request</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<OvertimeDto>? _requests;
    private bool _isLoading = true;
    private bool _isCreating = false;
    private bool _isSubmitting = false;
    private string? _modalError;

    private string _searchQuery = "";
    private int _statusFilter = -1;
    private int _typeFilter = -1;

    private int _page = 1;
    private int _pageSize = 10;

    private DateTime _newDate = DateTime.Today;
    private TimeOnly _newStartTime = new TimeOnly(17, 0);
    private TimeOnly _newEndTime = new TimeOnly(19, 30);
    private string _newReason = "";

    private HubConnection? _hubConnection;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await SetupSignalR();
    }

    private async Task SetupSignalR()
    {
        try
        {
            var apiBase = Configuration["ApiBaseUrl"] ?? "http://localhost:5000";
            _hubConnection = new HubConnectionBuilder()
                .WithUrl($"{apiBase}/hubs/notifications")
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On("OvertimeUpdated", async () =>
            {
                await InvokeAsync(async () =>
                {
                    await LoadData();
                    StateHasChanged();
                });
            });

            await _hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SignalR] Could not connect to notifications hub: {ex.Message}");
        }
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            _requests = await Http.GetFromJsonAsync<List<OvertimeDto>>("api/overtime/my");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load overtime records: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshData()
    {
        await LoadData();
        ToastService.ShowSuccess("Overtime records refreshed.");
    }

    private void ResetPage()
    {
        _page = 1;
    }

    private double CalculateNewDuration()
    {
        var startTs = _newStartTime.ToTimeSpan();
        var endTs = _newEndTime.ToTimeSpan();
        if (endTs <= startTs) return 0;
        return (endTs - startTs).TotalHours;
    }

    private async Task SubmitRequest()
    {
        _modalError = null;
        var startTs = _newStartTime.ToTimeSpan();
        var endTs = _newEndTime.ToTimeSpan();

        if (endTs <= startTs)
        {
            _modalError = "End time must be after start time.";
            return;
        }

        var duration = (endTs - startTs).TotalHours;
        if (duration < 0.25)
        {
            _modalError = "Overtime window must be at least 15 minutes.";
            return;
        }

        _isSubmitting = true;
        try
        {
            var payload = new
            {
                Date = _newDate,
                StartTime = startTs,
                EndTime = endTs,
                Reason = _newReason
            };

            var res = await Http.PostAsJsonAsync("api/overtime/request", payload);
            if (res.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("Pre-Overtime request filed successfully!");
                _isCreating = false;
                _newReason = "";
                await LoadData();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                _modalError = string.IsNullOrWhiteSpace(err) ? "Failed to file request." : err;
            }
        }
        catch (Exception ex)
        {
            _modalError = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task CancelRequest(Guid id)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/overtime/{id}");
            if (res.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("Overtime request cancelled.");
                await LoadData();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                ToastService.ShowError($"Could not cancel request: {err}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private string FormatTimeSpanString(string? tsStr)
    {
        if (string.IsNullOrEmpty(tsStr)) return "—";
        if (TimeSpan.TryParse(tsStr, out var ts))
        {
            var dt = DateTime.Today.Add(ts);
            return dt.ToString("hh:mm tt");
        }
        return tsStr;
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    public class OvertimeDto
    {
        public Guid Id { get; set; }
        public string EmployeeId { get; set; } = string.Empty;
        public DateTime Date { get; set; }
        public int Type { get; set; }
        public string TypeName { get; set; } = string.Empty;
        public string StartTime { get; set; } = string.Empty;
        public string EndTime { get; set; } = string.Empty;
        public double RequestedHours { get; set; }
        public double? ApprovedHours { get; set; }
        public string? Reason { get; set; }
        public int Status { get; set; }
        public string StatusName { get; set; } = string.Empty;
        public string? ReviewedByUserId { get; set; }
        public string? ReviewedByName { get; set; }
        public DateTime? ActionTakenAt { get; set; }
        public string? RejectionReason { get; set; }
        public DateTime CreatedAt { get; set; }
    }
}
