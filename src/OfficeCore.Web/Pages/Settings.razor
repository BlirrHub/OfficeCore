@page "/settings"
@page "/profile"
@page "/organization"
@attribute [Authorize]
@inject HttpClient Http
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject ToastService ToastService

<PageTitle>Settings - OfficeCore</PageTitle>

<div class="max-w-6xl mx-auto space-y-6">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-zinc-800/80">
        <div>
            <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-fuchsia-500/10 border border-fuchsia-500/20 text-fuchsia-400 text-xs font-medium mb-1.5">
                <span>Preferences & Configuration</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">Settings</h1>
            <p class="mt-1 text-zinc-400 text-xs sm:text-sm">Manage your personal profile, security credentials, and organization workspace settings.</p>
        </div>

        <!-- Tab Switcher Navigation -->
        <div class="p-1 rounded-xl bg-zinc-900/80 border border-zinc-800/80 inline-flex items-center gap-1 self-start sm:self-auto">
            <button @onclick='() => SetTab("profile")'
                    class="flex items-center gap-2 px-3.5 py-2 rounded-lg text-xs font-semibold transition-all @(_activeTab == "profile" ? "bg-fuchsia-600/15 border border-fuchsia-500/30 text-fuchsia-300 shadow-sm" : "text-zinc-400 hover:text-white hover:bg-zinc-800/60 border border-transparent")">
                <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                </svg>
                <span>Profile</span>
            </button>

            <AuthorizeView Policy="RequireOrganization">
                <Authorized>
                    <button @onclick='() => SetTab("company")'
                            class="flex items-center gap-2 px-3.5 py-2 rounded-lg text-xs font-semibold transition-all @(_activeTab == "company" ? "bg-fuchsia-600/15 border border-fuchsia-500/30 text-fuchsia-300 shadow-sm" : "text-zinc-400 hover:text-white hover:bg-zinc-800/60 border border-transparent")">
                        <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" />
                        </svg>
                        <span>Company Profile</span>
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    <!-- TAB 1: MY PROFILE -->
    @if (_activeTab == "profile")
    {
        @if (_mustChangePassword)
        {
            <div class="rounded-2xl bg-amber-950/30 border border-amber-800/50 p-4 flex items-center gap-3 text-amber-200 text-xs sm:text-sm">
                <div class="size-8 rounded-xl bg-amber-500/20 flex items-center justify-center text-amber-400 shrink-0">
                    <svg class="size-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                    </svg>
                </div>
                <div>
                    <h4 class="font-semibold text-amber-300">Password Change Required</h4>
                    <p class="text-xs text-amber-400/80 mt-0.5">You must update your temporary password before accessing all modules.</p>
                </div>
            </div>
        }

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
            <!-- Personal Info Card -->
            <div class="glass-card rounded-2xl p-6 sm:p-7 space-y-6">
                <div class="flex items-center justify-between pb-4 border-b border-zinc-800/60">
                    <div>
                        <h2 class="text-base font-semibold text-white">Personal Information</h2>
                        <p class="text-xs text-zinc-400 mt-0.5">Your public profile and contact details.</p>
                    </div>
                    <span class="px-2.5 py-1 rounded-full bg-zinc-800 text-zinc-300 text-xs font-medium">@(_roleText)</span>
                </div>

                <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6">
                    <!-- Avatar Preview & Upload -->
                    <div class="shrink-0 flex flex-col items-center space-y-2">
                        <div class="relative group size-28 rounded-full overflow-hidden border-2 border-zinc-800 bg-zinc-950 flex items-center justify-center text-zinc-600 shadow-xl">
                            @if (!string.IsNullOrEmpty(_profilePictureUrl))
                            {
                                <img src="@(Configuration["ApiBaseUrl"] + _profilePictureUrl)" alt="Profile" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                <div class="size-full bg-gradient-to-br from-fuchsia-950 to-zinc-900 flex items-center justify-center text-fuchsia-400 font-bold text-2xl">
                                    @GetInitials($"{_firstName} {_lastName}")
                                </div>
                            }

                            <label class="absolute inset-0 bg-black/70 backdrop-blur-xs flex flex-col items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer text-white">
                                <svg class="size-6 mb-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
                                </svg>
                                <span class="text-[10px] font-semibold">Change</span>
                                <InputFile class="hidden" OnChange="HandleProfilePictureSelected" accept="image/*" />
                            </label>
                        </div>
                        <span class="text-[10px] text-zinc-500 text-center">Click avatar to change</span>
                    </div>

                    <!-- Input Fields -->
                    <div class="flex-1 w-full space-y-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1">First Name</label>
                                <input type="text" @bind="_firstName" placeholder="First Name"
                                       class="block w-full rounded-xl bg-zinc-900/80 border border-zinc-800 px-3.5 py-2 text-white text-sm focus:outline-none focus:border-fuchsia-500/80 focus:ring-2 focus:ring-fuchsia-500/20 transition-all" />
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1">Last Name</label>
                                <input type="text" @bind="_lastName" placeholder="Last Name"
                                       class="block w-full rounded-xl bg-zinc-900/80 border border-zinc-800 px-3.5 py-2 text-white text-sm focus:outline-none focus:border-fuchsia-500/80 focus:ring-2 focus:ring-fuchsia-500/20 transition-all" />
                            </div>
                        </div>

                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider">Email Address</label>
                                <span class="text-[10px] font-semibold text-emerald-400 flex items-center gap-1">
                                    <span class="size-1.5 rounded-full bg-emerald-400"></span> Verified
                                </span>
                            </div>
                            <input type="email" value="@_email" disabled
                                   class="block w-full rounded-xl bg-zinc-900/40 border border-zinc-800/60 px-3.5 py-2 text-zinc-400 text-sm cursor-not-allowed" />
                        </div>
                    </div>
                </div>

                <div class="pt-4 border-t border-zinc-800/60 flex justify-end">
                    <button type="button" @onclick="HandleUpdateProfile" disabled="@_isUpdatingProfile"
                            class="px-4 py-2 rounded-xl bg-fuchsia-600 hover:bg-fuchsia-500 text-white text-xs font-semibold transition-all shadow-md shadow-fuchsia-950/40 active:scale-98 disabled:opacity-50 flex items-center gap-2">
                        @if (_isUpdatingProfile)
                        {
                            <svg class="animate-spin size-3.5" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Save Profile</span>
                        }
                    </button>
                </div>
            </div>

            <!-- Security & Password Card -->
            <div class="glass-card rounded-2xl p-6 sm:p-7 space-y-6">
                <div class="pb-4 border-b border-zinc-800/60">
                    <h2 class="text-base font-semibold text-white">Security & Password</h2>
                    <p class="text-xs text-zinc-400 mt-0.5">Ensure your account is using a secure password.</p>
                </div>

                <EditForm Model="_pwdModel" OnValidSubmit="HandleChangePassword">
                    <DataAnnotationsValidator />
                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1">Current Password</label>
                            <InputText @bind-Value="_pwdModel.CurrentPassword" type="password" placeholder="••••••••"
                                       class="block w-full rounded-xl bg-zinc-900/80 border border-zinc-800 px-3.5 py-2 text-white text-sm focus:outline-none focus:border-fuchsia-500/80 focus:ring-2 focus:ring-fuchsia-500/20 transition-all" />
                            <ValidationMessage For="() => _pwdModel.CurrentPassword" class="mt-1 text-xs text-red-400" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1">New Password</label>
                            <InputText @bind-Value="_pwdModel.NewPassword" type="password" placeholder="••••••••"
                                       class="block w-full rounded-xl bg-zinc-900/80 border border-zinc-800 px-3.5 py-2 text-white text-sm focus:outline-none focus:border-fuchsia-500/80 focus:ring-2 focus:ring-fuchsia-500/20 transition-all" />
                            <ValidationMessage For="() => _pwdModel.NewPassword" class="mt-1 text-xs text-red-400" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1">Confirm New Password</label>
                            <InputText @bind-Value="_pwdModel.ConfirmPassword" type="password" placeholder="••••••••"
                                       class="block w-full rounded-xl bg-zinc-900/80 border border-zinc-800 px-3.5 py-2 text-white text-sm focus:outline-none focus:border-fuchsia-500/80 focus:ring-2 focus:ring-fuchsia-500/20 transition-all" />
                            <ValidationMessage For="() => _pwdModel.ConfirmPassword" class="mt-1 text-xs text-red-400" />
                        </div>

                        <div class="pt-2 border-t border-zinc-800/60 flex justify-end">
                            <button type="submit" disabled="@_isChangingPassword"
                                    class="px-4 py-2 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-white text-xs font-semibold transition-all active:scale-98 disabled:opacity-50 flex items-center gap-2">
                                @if (_isChangingPassword)
                                {
                                    <svg class="animate-spin size-3.5" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                                    <span>Updating...</span>
                                }
                                else
                                {
                                    <span>Update Password</span>
                                }
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- TAB 2: COMPANY PROFILE -->
    @if (_activeTab == "company")
    {
        @if (_isLoadingOrg)
        {
            <div class="flex items-center justify-center py-20 text-zinc-400 text-sm font-medium">
                <svg class="animate-spin size-5 text-fuchsia-500 mr-3" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                <span>Loading company profile...</span>
            </div>
        }
        else if (_org != null)
        {
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
                <!-- Workspace Details (2 cols) -->
                <div class="lg:col-span-2 glass-card rounded-2xl p-6 sm:p-7 space-y-6">
                    <div class="pb-4 border-b border-zinc-800/60 flex items-center justify-between">
                        <div>
                            <h2 class="text-base font-semibold text-white">Workspace Details</h2>
                            <p class="text-xs text-zinc-400 mt-0.5">Customize your company identity and contact information.</p>
                        </div>
                        <span class="px-2.5 py-1 rounded-full bg-fuchsia-500/10 border border-fuchsia-500/20 text-fuchsia-400 text-xs font-semibold">Workspace Admin</span>
                    </div>

                    <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6">
                        <!-- Workspace Logo Upload -->
                        <div class="shrink-0 flex flex-col items-center space-y-2">
                            <div class="relative group size-28 rounded-2xl overflow-hidden border-2 border-zinc-800 bg-zinc-950 flex items-center justify-center text-zinc-600 shadow-xl">
                                @if (!string.IsNullOrEmpty(_logoUrl))
                                {
                                    <img src="@(Configuration["ApiBaseUrl"] + _logoUrl)" alt="Logo" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <div class="size-full bg-gradient-to-br from-fuchsia-600 to-violet-600 flex items-center justify-center text-white font-bold text-2xl">
                                        @GetInitials(_orgName)
                                    </div>
                                }

                                <AuthorizeView Policy="Permission:organization.manage">
                                    <label class="absolute inset-0 bg-black/70 backdrop-blur-xs flex flex-col items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer text-white">
                                        <svg class="size-6 mb-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
                                        </svg>
                                        <span class="text-[10px] font-semibold">Change</span>
                                        <InputFile class="hidden" OnChange="HandleLogoSelected" accept="image/*" />
                                    </label>
                                </AuthorizeView>
                            </div>
                            <AuthorizeView Policy="Permission:organization.manage">
                                <span class="text-[10px] text-zinc-500 text-center">Click logo to upload</span>
                            </AuthorizeView>
                        </div>

                        <!-- Workspace Form -->
                        <div class="flex-1 w-full space-y-4">
                            <div>
                                <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1">Company / Workspace Name</label>
                                <input type="text" @bind="_orgName" placeholder="e.g. Acme Corporation"
                                       class="block w-full rounded-xl bg-zinc-900/80 border border-zinc-800 px-3.5 py-2 text-white text-sm focus:outline-none focus:border-fuchsia-500/80 focus:ring-2 focus:ring-fuchsia-500/20 transition-all" />
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1">Physical Address</label>
                                <textarea @bind="_address" rows="2" placeholder="e.g. 123 Corporate Blvd, Metro Manila"
                                          class="block w-full rounded-xl bg-zinc-900/80 border border-zinc-800 px-3.5 py-2 text-white text-sm focus:outline-none focus:border-fuchsia-500/80 focus:ring-2 focus:ring-fuchsia-500/20 transition-all"></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Phone Numbers Sub-Section -->
                    <div class="pt-4 border-t border-zinc-800/60 space-y-3">
                        <div class="flex items-center justify-between">
                            <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider">Contact Phone Numbers</label>
                            <AuthorizeView Policy="Permission:organization.manage">
                                <button type="button" @onclick="AddPhone"
                                        class="text-xs font-semibold text-fuchsia-400 hover:text-fuchsia-300 flex items-center gap-1 transition-colors">
                                    <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                                    <span>Add Number</span>
                                </button>
                            </AuthorizeView>
                        </div>

                        <div class="space-y-2.5">
                            @foreach (var phone in _phones)
                            {
                                <div class="flex items-center gap-2">
                                    <input type="text" @bind="phone.Number" placeholder="+63 900 000 0000"
                                           class="flex-1 rounded-xl bg-zinc-900/80 border border-zinc-800 px-3.5 py-2 text-white text-sm focus:outline-none focus:border-fuchsia-500/80 focus:ring-2 focus:ring-fuchsia-500/20 transition-all" />
                                    <select @bind="phone.Type"
                                            class="w-32 rounded-xl bg-zinc-900 border border-zinc-800 px-3 py-2 text-zinc-300 text-xs focus:outline-none focus:border-fuchsia-500">
                                        <option value="Telephone">Telephone</option>
                                        <option value="Mobile">Mobile</option>
                                    </select>
                                    <AuthorizeView Policy="Permission:organization.manage">
                                        <button type="button" @onclick="() => RemovePhone(phone)"
                                                class="p-2 text-zinc-500 hover:text-red-400 rounded-lg hover:bg-zinc-800 transition-colors">
                                            <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                                        </button>
                                    </AuthorizeView>
                                </div>
                            }
                            @if (!_phones.Any())
                            {
                                <p class="text-xs text-zinc-500 italic py-1">No phone numbers configured.</p>
                            }
                        </div>
                    </div>

                    <AuthorizeView Policy="Permission:organization.manage">
                        <div class="pt-4 border-t border-zinc-800/60 flex justify-end">
                            <button type="button" @onclick="HandleUpdateOrg" disabled="@_isSavingOrg"
                                    class="px-4 py-2 rounded-xl bg-fuchsia-600 hover:bg-fuchsia-500 text-white text-xs font-semibold transition-all shadow-md shadow-fuchsia-950/40 active:scale-98 disabled:opacity-50 flex items-center gap-2">
                                @if (_isSavingOrg)
                                {
                                    <svg class="animate-spin size-3.5" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <span>Save Changes</span>
                                }
                            </button>
                        </div>
                    </AuthorizeView>
                </div>

                <AuthorizeView Policy="Permission:organization.manage">
                    <!-- Danger Zone Card -->
                    <div class="glass-card rounded-2xl p-6 border-red-900/30 space-y-4">
                        <div class="flex items-center gap-2.5 text-red-400">
                            <svg class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                            </svg>
                            <h3 class="text-sm font-semibold">Danger Zone</h3>
                        </div>
                        <p class="text-xs text-zinc-400 leading-relaxed">Permanently delete this organization and its associated boards, employees, schedules, and payroll records. This action cannot be reversed.</p>
                        
                        <button type="button" @onclick="() => _showDeleteConfirm = true"
                                class="w-full py-2.5 px-4 rounded-xl bg-red-950/40 hover:bg-red-900/40 border border-red-800/50 text-red-300 hover:text-red-200 text-xs font-semibold transition-all">
                            Delete Workspace
                        </button>
                    </div>
                </AuthorizeView>
            </div>
        }
    }
</div>

<!-- Unified Cropper Modal -->
@if (_showCropModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm p-4">
        <div class="glass-card rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden flex flex-col max-h-[90vh] border border-zinc-800">
            <div class="p-4 border-b border-zinc-800 flex items-center justify-between">
                <h3 class="text-sm font-bold text-white">Crop & Adjust Image</h3>
                <button @onclick="CancelCrop" class="text-zinc-400 hover:text-white transition-colors">
                    <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>
            
            <div class="p-4 flex-1 overflow-hidden flex items-center justify-center bg-black min-h-[300px]">
                @if (!string.IsNullOrEmpty(_unzoomedImageUrl))
                {
                    <img @ref="_cropImageRef" src="@_unzoomedImageUrl" class="max-w-full max-h-full block" />
                }
            </div>

            <div class="p-4 border-t border-zinc-800 flex justify-end gap-3 bg-zinc-950">
                <button type="button" @onclick="CancelCrop" class="px-4 py-2 text-xs font-semibold text-zinc-300 hover:text-white transition-colors">
                    Cancel
                </button>
                <button type="button" @onclick="SaveCrop" disabled="@_isUploadingImage"
                        class="rounded-xl bg-fuchsia-600 px-4 py-2 text-xs font-semibold text-white shadow-md hover:bg-fuchsia-500 transition-colors disabled:opacity-50 flex items-center gap-2">
                    @if (_isUploadingImage)
                    {
                        <svg class="animate-spin size-3.5" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                        <span>Uploading...</span>
                    }
                    else
                    {
                        <span>Save & Apply</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Workspace Confirmation Modal -->
@if (_showDeleteConfirm)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm p-4">
        <div class="glass-card rounded-2xl shadow-2xl w-full max-w-md overflow-hidden flex flex-col border border-red-900/40">
            <div class="p-6">
                <div class="flex items-center gap-4 mb-4">
                    <div class="size-12 rounded-2xl bg-red-500/10 border border-red-500/20 flex items-center justify-center shrink-0 text-red-400">
                        <svg class="size-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-white">Delete Workspace</h3>
                        <p class="text-xs text-zinc-400 mt-0.5">Are you sure you want to delete <span class="text-zinc-200 font-semibold">@_orgName</span>?</p>
                    </div>
                </div>
                <div class="mt-4">
                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1">Enter password to confirm</label>
                    <input type="password" @bind="_deletePassword" placeholder="Your account password"
                           class="block w-full rounded-xl bg-zinc-900 border border-zinc-800 px-3.5 py-2 text-white text-sm focus:border-red-500 focus:ring-1 focus:ring-red-500" />
                </div>
            </div>
            
            <div class="p-4 border-t border-zinc-800 flex justify-end gap-3 bg-zinc-950">
                <button type="button" @onclick="() => _showDeleteConfirm = false" class="px-4 py-2 text-xs font-semibold text-zinc-300 hover:text-white transition-colors">
                    Cancel
                </button>
                <button type="button" @onclick="HandleDeleteOrg" disabled="@(_isDeletingOrg || string.IsNullOrWhiteSpace(_deletePassword))"
                        class="rounded-xl bg-red-600 px-4 py-2 text-xs font-semibold text-white shadow-sm hover:bg-red-500 transition-colors disabled:opacity-50">
                    @if (_isDeletingOrg)
                    {
                        <span>Deleting...</span>
                    }
                    else
                    {
                        <span>Confirm Deletion</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? tab { get; set; }

    private string _activeTab = "profile";

    // Profile State
    private bool _mustChangePassword = false;
    private string _firstName = "";
    private string _lastName = "";
    private string _email = "";
    private string? _profilePictureUrl;
    private string _roleText = "Employee";
    private bool _isUpdatingProfile = false;

    // Password State
    private PasswordForm _pwdModel = new();
    private bool _isChangingPassword = false;

    // Org State
    private bool _isLoadingOrg = false;
    private bool _isSavingOrg = false;
    private bool _isDeletingOrg = false;
    private bool _showDeleteConfirm = false;
    private OrganizationDto? _org;
    private string _orgName = "";
    private string? _address;
    private string? _logoUrl;
    private List<PhoneDto> _phones = new();
    private string _deletePassword = "";

    // Unified Crop State
    private bool _showCropModal = false;
    private string? _unzoomedImageUrl;
    private ElementReference _cropImageRef;
    private bool _isUploadingImage = false;
    private string _cropTarget = "avatar"; // "avatar" or "logo"

    protected override async Task OnInitializedAsync()
    {
        await LoadProfile();
    }

    protected override async Task OnParametersSetAsync()
    {
        var uri = Nav.Uri;
        if (string.Equals(tab, "company", StringComparison.OrdinalIgnoreCase) || uri.Contains("/organization"))
        {
            _activeTab = "company";
            if (_org == null)
            {
                await LoadOrganization();
            }
        }
        else
        {
            _activeTab = "profile";
        }
    }

    private void SetTab(string newTab)
    {
        _activeTab = newTab;
        Nav.NavigateTo($"/settings?tab={newTab}", replace: false);
        if (_activeTab == "company" && _org == null)
        {
            _ = LoadOrganization();
        }
    }

    private async Task LoadProfile()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        _firstName = user.FindFirst("FirstName")?.Value ?? "";
        _lastName = user.FindFirst("LastName")?.Value ?? "";
        _email = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
        _mustChangePassword = user.FindFirst("MustChangePassword")?.Value == "True";
        _profilePictureUrl = user.FindFirst("ProfilePictureUrl")?.Value;

        var titleRole = user.FindFirst("TitleRole")?.Value;
        var roles = user.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
        _roleText = !string.IsNullOrWhiteSpace(titleRole) ? titleRole : (roles.Any() ? string.Join(", ", roles) : "Member");
    }

    private async Task LoadOrganization()
    {
        _isLoadingOrg = true;
        try
        {
            _org = await Http.GetFromJsonAsync<OrganizationDto>("/api/organizations/current");
            if (_org != null)
            {
                _orgName = _org.Name;
                _address = _org.Address;
                _logoUrl = _org.LogoUrl;
                _phones = _org.Phones?.ToList() ?? new List<PhoneDto>();
            }
        }
        catch
        {
            // User may not have permission or current org not selected
        }
        finally
        {
            _isLoadingOrg = false;
        }
    }

    private async Task HandleUpdateProfile()
    {
        if (string.IsNullOrWhiteSpace(_firstName) || string.IsNullOrWhiteSpace(_lastName))
        {
            ToastService.ShowWarning("First and last name are required.");
            return;
        }

        _isUpdatingProfile = true;
        try
        {
            var response = await Http.PutAsJsonAsync("/api/auth/profile", new
            {
                firstName = _firstName,
                lastName = _lastName
            });

            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("Profile updated successfully!");
                if (AuthProvider is OfficeCore.Web.Client.Auth.CookieAuthStateProvider cookieAuth)
                {
                    cookieAuth.NotifyAuthStateChanged();
                }
            }
            else
            {
                ToastService.ShowError("Failed to update profile.");
            }
        }
        catch
        {
            ToastService.ShowError("An error occurred while updating profile.");
        }
        finally
        {
            _isUpdatingProfile = false;
        }
    }

    private async Task HandleChangePassword()
    {
        if (_pwdModel.NewPassword != _pwdModel.ConfirmPassword)
        {
            ToastService.ShowWarning("New passwords do not match.");
            return;
        }

        _isChangingPassword = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/auth/change-password", new
            {
                currentPassword = _pwdModel.CurrentPassword,
                newPassword = _pwdModel.NewPassword
            });

            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("Password updated successfully!");
                _pwdModel = new();
                _mustChangePassword = false;

                if (AuthProvider is OfficeCore.Web.Client.Auth.CookieAuthStateProvider cookieAuth)
                {
                    cookieAuth.NotifyAuthStateChanged();
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ToastService.ShowError(string.IsNullOrWhiteSpace(error) ? "Failed to change password." : error);
            }
        }
        catch
        {
            ToastService.ShowError("An error occurred while changing password.");
        }
        finally
        {
            _isChangingPassword = false;
        }
    }

    private async Task HandleUpdateOrg()
    {
        if (string.IsNullOrWhiteSpace(_orgName))
        {
            ToastService.ShowWarning("Workspace name cannot be empty.");
            return;
        }

        if (_phones.Any(p => string.IsNullOrWhiteSpace(p.Number)))
        {
            ToastService.ShowWarning("Phone numbers cannot be empty.");
            return;
        }

        _isSavingOrg = true;
        try
        {
            var response = await Http.PutAsJsonAsync($"/api/organizations/{_org!.Id}", new
            {
                name = _orgName,
                address = _address,
                phones = _phones
            });

            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("Workspace updated successfully!");
                if (AuthProvider is OfficeCore.Web.Client.Auth.CookieAuthStateProvider cookieAuth)
                {
                    cookieAuth.NotifyAuthStateChanged();
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                ToastService.ShowError("Only workspace admins can update the workspace profile.");
            }
            else
            {
                ToastService.ShowError("Failed to update workspace.");
            }
        }
        catch
        {
            ToastService.ShowError("An error occurred while updating workspace.");
        }
        finally
        {
            _isSavingOrg = false;
        }
    }

    private void AddPhone()
    {
        _phones.Add(new PhoneDto { Number = "", Type = "Telephone" });
    }

    private void RemovePhone(PhoneDto phone)
    {
        _phones.Remove(phone);
    }

    private async Task HandleDeleteOrg()
    {
        if (string.IsNullOrWhiteSpace(_deletePassword))
        {
            ToastService.ShowWarning("Please enter your password to confirm.");
            return;
        }

        _isDeletingOrg = true;
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Delete, $"/api/organizations/{_org!.Id}")
            {
                Content = JsonContent.Create(new { password = _deletePassword })
            };
            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("Workspace deleted successfully.");
                _showDeleteConfirm = false;

                if (AuthProvider is OfficeCore.Web.Client.Auth.CookieAuthStateProvider cookieAuth)
                {
                    cookieAuth.NotifyAuthStateChanged();
                }

                Nav.NavigateTo("/workspaces", forceLoad: true);
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                ToastService.ShowError("Only workspace admins can delete the workspace.");
                _showDeleteConfirm = false;
            }
            else
            {
                var errorMsg = await response.Content.ReadAsStringAsync();
                ToastService.ShowError(string.IsNullOrWhiteSpace(errorMsg) ? "Failed to delete workspace." : errorMsg);
                _deletePassword = "";
            }
        }
        catch
        {
            ToastService.ShowError("An error occurred while deleting workspace.");
            _showDeleteConfirm = false;
        }
        finally
        {
            _isDeletingOrg = false;
        }
    }

    // Unified Image Upload & Crop
    private async Task HandleProfilePictureSelected(InputFileChangeEventArgs e)
    {
        _cropTarget = "avatar";
        await ProcessImageSelection(e);
    }

    private async Task HandleLogoSelected(InputFileChangeEventArgs e)
    {
        _cropTarget = "logo";
        await ProcessImageSelection(e);
    }

    private async Task ProcessImageSelection(InputFileChangeEventArgs e)
    {
        if (e.File == null) return;
        try
        {
            var format = e.File.ContentType;
            var resizedImageFile = await e.File.RequestImageFileAsync(format, 800, 800);
            var buffer = new byte[resizedImageFile.Size];
            await resizedImageFile.OpenReadStream(10 * 1024 * 1024).ReadAsync(buffer);
            var base64 = Convert.ToBase64String(buffer);
            _unzoomedImageUrl = $"data:{format};base64,{base64}";
            _showCropModal = true;
            StateHasChanged();

            await Task.Delay(100);
            await JS.InvokeVoidAsync("cropperInterop.init", _cropImageRef);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error reading image: {ex.Message}");
        }
    }

    private async Task CancelCrop()
    {
        _showCropModal = false;
        _unzoomedImageUrl = null;
        await JS.InvokeVoidAsync("cropperInterop.destroy");
    }

    private async Task SaveCrop()
    {
        _isUploadingImage = true;
        try
        {
            var croppedDataUrl = await JS.InvokeAsync<string>("cropperInterop.getCroppedCanvasData");
            if (string.IsNullOrEmpty(croppedDataUrl)) return;

            var base64Data = croppedDataUrl.Substring(croppedDataUrl.IndexOf(",") + 1);
            var bytes = Convert.FromBase64String(base64Data);

            using var content = new MultipartFormDataContent();
            var fileContent = new ByteArrayContent(bytes);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("image/jpeg");

            if (_cropTarget == "avatar")
            {
                content.Add(fileContent, "file", "profile.jpg");
                var response = await Http.PostAsync("/api/auth/profile-picture", content);
                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                    if (result.TryGetProperty("profilePictureUrl", out var urlProp))
                    {
                        _profilePictureUrl = urlProp.GetString();
                        ToastService.ShowSuccess("Profile picture updated!");
                        if (AuthProvider is OfficeCore.Web.Client.Auth.CookieAuthStateProvider cookieAuth)
                        {
                            cookieAuth.NotifyAuthStateChanged();
                        }
                        await CancelCrop();
                    }
                }
                else
                {
                    ToastService.ShowError("Failed to upload profile picture.");
                }
            }
            else if (_cropTarget == "logo" && _org != null)
            {
                content.Add(fileContent, "file", "logo.jpg");
                var response = await Http.PostAsync($"/api/organizations/{_org.Id}/logo", content);
                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                    if (result.TryGetProperty("logoUrl", out var urlProp))
                    {
                        _logoUrl = urlProp.GetString();
                        ToastService.ShowSuccess("Workspace logo updated!");
                        if (AuthProvider is OfficeCore.Web.Client.Auth.CookieAuthStateProvider cookieAuth)
                        {
                            cookieAuth.NotifyAuthStateChanged();
                        }
                        await CancelCrop();
                    }
                }
                else
                {
                    ToastService.ShowError("Failed to upload logo.");
                }
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving image: {ex.Message}");
        }
        finally
        {
            _isUploadingImage = false;
        }
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "OC";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name.Substring(0, Math.Min(2, name.Length)).ToUpper();
    }

    private class PasswordForm
    {
        [Required(ErrorMessage = "Current password is required")]
        public string CurrentPassword { get; set; } = "";

        [Required(ErrorMessage = "New password is required")]
        [MinLength(6, ErrorMessage = "Password must be at least 6 characters")]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Please confirm your new password")]
        public string ConfirmPassword { get; set; } = "";
    }

    private class OrganizationDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string? Address { get; set; }
        public string? LogoUrl { get; set; }
        public IEnumerable<PhoneDto>? Phones { get; set; }
    }

    private class PhoneDto
    {
        public Guid? Id { get; set; }
        public string Number { get; set; } = "";
        public string Type { get; set; } = "Telephone";
    }
}
