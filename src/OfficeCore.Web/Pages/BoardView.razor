@page "/boards/{Id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.SignalR.Client
@using OfficeCore.Web.Client.Pages.Components
@using OfficeCore.Web.Services
@inject HttpClient Http
@inject HubConnectionFactory HubFactory
@inject NavigationManager NavigationManager
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthProvider
@inject OfficeCore.Web.Services.ToastService ToastService
@implements IAsyncDisposable

<PageTitle>@(_board?.Name ?? "Loading Board...") - OfficeCore</PageTitle>

@if (_isLoading)
{
    <div class="h-full flex items-center justify-center">
        <div class="animate-spin size-8 border-4 border-zinc-800 border-t-fuchsia-600 rounded-full"></div>
    </div>
}
else if (_board == null)
{
    <div class="h-full flex flex-col items-center justify-center">
        <h3 class="text-xl font-bold text-white mb-2">Board not found</h3>
        <p class="text-zinc-400 mb-6">The board may have been deleted or you don't have access to it.</p>
        <button @onclick='() => NavigationManager.NavigateTo("/boards")' class="text-fuchsia-400 hover:text-fuchsia-300">Back to Boards</button>
    </div>
}
else
{
    <div class="flex flex-col bg-zinc-950 -m-6 p-6 min-h-[calc(100%+3rem)]">
        <!-- Board Header -->
        <div class="flex items-center justify-between shrink-0 mb-6">
            <div class="flex items-center gap-4">
                <button @onclick='() => NavigationManager.NavigateTo("/boards")' class="size-8 flex items-center justify-center rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-400 hover:text-white hover:border-zinc-700 transition-colors">
                    <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
                </button>
                <div>
                    <h1 class="text-2xl font-bold tracking-tight text-white flex items-center gap-3">
                        @_board.Name
                        @if (_isOwner)
                        {
                            <span class="px-2 py-0.5 rounded-full bg-fuchsia-950/30 text-fuchsia-400 text-[10px] uppercase tracking-wider font-bold border border-fuchsia-900/50">Owner</span>
                        }
                    </h1>
                    @if (!string.IsNullOrEmpty(_board.Description))
                    {
                        <p class="mt-1 text-zinc-400 text-sm">@_board.Description</p>
                    }
                </div>
            </div>
            <div class="flex items-center gap-3">
                <div class="flex -space-x-2 mr-2">
                    @foreach (var member in _board.Members.Take(5))
                    {
                        <div class="size-8 rounded-full bg-zinc-800 border-2 border-zinc-950 flex items-center justify-center group relative cursor-pointer overflow-hidden">
                            @if (!string.IsNullOrEmpty(member.User.ProfilePictureUrl))
                            {
                                <img src="@(Configuration["ApiBaseUrl"] + member.User.ProfilePictureUrl)" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                <span class="text-xs font-bold text-zinc-300">@(member.User.FirstName[0])</span>
                            }
                            <div class="absolute bottom-full mb-2 hidden group-hover:block whitespace-nowrap bg-zinc-800 text-white text-xs px-2 py-1 rounded shadow-lg z-50">
                                @member.User.FirstName @member.User.LastName
                            </div>
                        </div>
                    }
                    @if (_board.Members.Count > 5)
                    {
                        <div class="size-8 rounded-full bg-zinc-900 border-2 border-zinc-950 flex items-center justify-center">
                            <span class="text-[10px] font-bold text-zinc-500">+@(_board.Members.Count - 5)</span>
                        </div>
                    }
                </div>

                @if (_isOwner || _canManageBoardMembers)
                {
                    <button @onclick="() => _showMembersModal = true" class="inline-flex items-center gap-2 rounded-lg bg-zinc-900 border border-zinc-800 px-3 py-2 text-sm font-medium text-white hover:bg-zinc-800 transition-all">
                        <svg class="size-4 text-zinc-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zM4 19.235v-.11a6.375 6.375 0 0112.75 0v.109A12.318 12.318 0 0110.374 21c-2.331 0-4.512-.645-6.374-1.766z" /></svg>
                        Members
                    </button>
                }
                @if (_isOwner)
                {
                    <button @onclick="() => _showDeleteBoardModal = true" class="inline-flex items-center gap-2 rounded-lg bg-red-950/30 border border-red-900/50 px-3 py-2 text-sm font-medium text-red-400 hover:bg-red-900/50 hover:text-red-300 transition-all ml-2">
                        <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
                        Delete Board
                    </button>
                }
            </div>
        </div>

        <!-- Kanban Board Area -->
        <div class="flex-1 overflow-x-auto overflow-y-hidden pb-4">
            <div class="flex h-full gap-6 items-start">
                
                @foreach (var list in _board.Lists.OrderBy(l => l.OrderIndex))
                {
                    <div @key="list.Id" class="w-80 shrink-0 bg-zinc-900/50 border border-zinc-800/80 rounded-2xl flex flex-col max-h-full overflow-hidden"
                         draggable="@(_isViewer ? "false" : "true")"
                         @ondragstart="() => HandleListDragStart(list)"
                         ondragover="event.preventDefault();"
                         @ondrop="() => HandleDropOnList(list.Id)">
                        
                        <!-- List Header -->
                        <div class="p-3.5 border-b flex items-center justify-between shrink-0 @(_isViewer ? "" : "cursor-grab active:cursor-grabbing") rounded-t-2xl transition-colors @(string.IsNullOrEmpty(list.ColorHex) ? "bg-zinc-900/80 border-zinc-800/50" : "")"
                             style="@(string.IsNullOrEmpty(list.ColorHex) ? "" : $"background-color: {list.ColorHex}; border-color: {list.ColorHex};")">
                            @if (_editingListId == list.Id)
                            {
                                <div class="w-full flex flex-col gap-2.5" @onclick:stopPropagation="true">
                                    <div class="flex items-center gap-2">
                                        <input type="text" @bind="_editingListName" @onkeydown="@(async (e) => { if (e.Key == "Enter") await SaveListEdit(list); else if (e.Key == "Escape") CancelListEdit(); })" class="flex-1 min-w-0 bg-black/50 border border-white/20 focus:border-white/60 rounded-lg px-2.5 py-1 text-sm font-bold text-white focus:outline-none placeholder-white/40 shadow-inner" placeholder="List name..." autofocus />
                                        <button @onclick="() => SaveListEdit(list)" class="p-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg transition-colors shadow-sm" title="Save changes">
                                            <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                                        </button>
                                        <button @onclick="CancelListEdit" class="p-1.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white rounded-lg transition-colors" title="Cancel">
                                            <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                                        </button>
                                    </div>
                                    <div class="flex items-center justify-between gap-1 pt-1.5 border-t border-white/10">
                                        <div class="flex items-center gap-1.5 flex-wrap">
                                            @foreach (var c in _presetColors)
                                            {
                                                <button type="button" @onclick="() => _editingListColor = c" class="size-5 rounded-full border border-white/30 transition-all hover:scale-125 shadow-sm @(_editingListColor == c ? "ring-2 ring-white ring-offset-1 ring-offset-black/50 scale-110" : "")" style="background-color: @c;" title="@c"></button>
                                            }
                                        </div>
                                        <label class="relative flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-black/50 hover:bg-black/70 border border-white/20 hover:border-white/40 cursor-pointer transition-colors shrink-0 shadow-sm" title="Choose custom color">
                                            <span class="size-3.5 rounded-full border border-white/30 shadow-inner shrink-0" style="background-color: @(_editingListColor);"></span>
                                            <span class="text-[10px] font-semibold text-white/90">Custom</span>
                                            <input type="color" @bind="_editingListColor" class="sr-only" />
                                        </label>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="flex items-center gap-2">
                                    <h3 class="font-bold text-white tracking-wide">@list.Name</h3>
                                    <span class="px-2 py-0.5 rounded-full bg-zinc-950/50 text-white/70 text-xs font-medium border border-white/10">@list.Cards.Count</span>
                                </div>
                                @if (_canEditBoardStructure)
                                {
                                    <div class="flex items-center">
                                        <button @onclick="() => StartEditList(list)" class="text-white/50 hover:text-white transition-colors p-1" title="Edit List">
                                            <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                                        </button>
                                        <button @onclick='() => PromptDelete("Delete List", $"Are you sure you want to delete the list \"{list.Name}\"?", async () => await DeleteList(list.Id))' class="text-white/50 hover:text-red-400 transition-colors p-1" title="Delete List">
                                            <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                        
                        <!-- List Cards -->
                        <div class="flex-1 overflow-y-auto p-3 space-y-3 custom-scrollbar">
                            @foreach (var card in list.Cards.OrderBy(c => c.OrderIndex))
                            {
                                <div @key="card.Id" class="bg-zinc-950 border border-zinc-800/80 rounded-xl p-4 @(_isViewer ? "cursor-pointer" : "cursor-grab active:cursor-grabbing") hover:border-fuchsia-500/50 hover:shadow-lg hover:shadow-fuchsia-900/10 transition-all group"
                                     draggable="@(_isViewer ? "false" : "true")"
                                     @ondragstart="() => HandleDragStart(card)"
                                     @ondragstart:stopPropagation="true"
                                     ondragover="event.preventDefault();"
                                     @ondrop="() => HandleDropOnCard(card)"
                                     @ondrop:stopPropagation="true"
                                     @onclick="() => EditCard(card)">
                                    
                                    @if (card.Labels.Any())
                                    {
                                        <div class="flex flex-wrap gap-1 mb-2">
                                            @foreach(var l in card.Labels)
                                            {
                                                var labelObj = l.Label ?? _board?.Labels.FirstOrDefault(x => x.Id == l.LabelId);
                                                var color = !string.IsNullOrEmpty(labelObj?.ColorHex) ? labelObj.ColorHex : "#71717a";
                                                var name = labelObj?.Name ?? "Label";
                                                <span class="w-8 h-2 rounded-full" style="background-color: @color" title="@name"></span>
                                            }
                                        </div>
                                    }

                                    <div class="flex justify-between items-start gap-2 mb-2">
                                        <h4 class="text-sm font-semibold text-zinc-200 leading-tight">@card.Title</h4>
                                        @if (!_isViewer)
                                        {
                                            <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                                                <button @onclick="() => EditCard(card)" @onclick:stopPropagation="true" class="text-zinc-600 hover:text-fuchsia-400 transition-colors p-1" title="Edit Card">
                                                    <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.89 1.14l-2.811.93a.75.75 0 01-.95-.95l.93-2.811a4.5 4.5 0 011.14-1.89l13.611-13.61z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 7.125L16.875 4.5" /></svg>
                                                </button>
                                                @if (_canEditBoardStructure)
                                                {
                                                    <button @onclick='() => PromptDelete("Delete Card", $"Are you sure you want to delete the card \"{card.Title}\"?", async () => await DeleteCard(card.Id))' @onclick:stopPropagation="true" class="text-zinc-600 hover:text-red-400 transition-colors p-1" title="Delete Card">
                                                        <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                    
                                    @if (!string.IsNullOrEmpty(card.Description))
                                    {
                                        <p class="text-xs text-zinc-500 line-clamp-2 mb-3">@card.Description</p>
                                    }
                                    
                                    <div class="flex items-center justify-between mt-3">
                                        <div class="flex flex-wrap items-center gap-2">
                                            @if (card.DueDate.HasValue)
                                            {
                                                var isDone = list.Name.Equals("Done", StringComparison.OrdinalIgnoreCase);
                                                var daysLeft = (card.DueDate.Value.Date - DateTime.UtcNow.Date).TotalDays;
                                                var isRed = !isDone && daysLeft <= 3;
                                                var isOrange = !isDone && daysLeft > 3 && daysLeft <= 7;
                                                var dueColor = isRed ? "text-red-400 bg-red-400/10 border border-red-500/20" : 
                                                               isOrange ? "text-orange-400 bg-orange-400/10 border border-orange-500/20" : 
                                                               "text-zinc-400 bg-zinc-800/50 border border-zinc-700/50";
                                                
                                                <div class="flex items-center gap-1 @dueColor px-1.5 py-0.5 rounded text-[10px] font-semibold tracking-wide">
                                                    @if (isRed || isOrange)
                                                    {
                                                        <svg class="size-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                                                    }
                                                    else
                                                    {
                                                        <svg class="size-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                                    }
                                                    @card.DueDate.Value.ToString("MMM dd")
                                                </div>
                                            }

                                            @if (!string.IsNullOrEmpty(card.Description))
                                            {
                                                <div class="flex items-center gap-1 text-zinc-500 text-[10px] font-medium" title="This card has a description">
                                                    <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H12" /></svg>
                                                </div>
                                            }
                                            
                                            @if (card.Checklists.Any())
                                            {
                                                var total = card.Checklists.SelectMany(c => c.Items).Count();
                                                var completed = card.Checklists.SelectMany(c => c.Items).Count(i => i.IsCompleted);
                                                <div class="flex items-center gap-1 text-zinc-500 text-[10px] font-medium" title="Checklist items">
                                                    <svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
                                                    @completed/@total
                                                </div>
                                            }

                                            @if (card.Attachments.Any())
                                            {
                                                <div class="flex items-center gap-1 text-zinc-500 text-[10px] font-medium" title="Attachments">
                                                    <svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
                                                    @card.Attachments.Count
                                                </div>
                                            }

                                            @if (card.Comments.Any())
                                            {
                                                <div class="flex items-center gap-1 text-zinc-500 text-[10px] font-medium" title="Comments">
                                                    <svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                                                    @card.Comments.Count
                                                </div>
                                            }
                                        </div>
                                        
                                        @{
                                            var cardAssignees = card.GetAssignees().ToList();
                                        }
                                        @if (cardAssignees.Count > 0)
                                        {
                                            <div class="flex items-center -space-x-1.5 overflow-hidden" title="@string.Join(", ", cardAssignees.Select(u => $"{u.FirstName} {u.LastName}".Trim()))">
                                                @foreach (var user in cardAssignees.Take(3))
                                                {
                                                    <div class="size-6 rounded-full bg-zinc-800 border border-zinc-700 flex items-center justify-center overflow-hidden shrink-0 hover:z-10 transition-transform hover:scale-110">
                                                        @if (!string.IsNullOrEmpty(user.ProfilePictureUrl))
                                                        {
                                                            <img src="@(Configuration["ApiBaseUrl"] + user.ProfilePictureUrl)" class="w-full h-full object-cover" />
                                                        }
                                                        else
                                                        {
                                                            <span class="text-[9px] font-bold text-zinc-300">@(user.FirstName.Length > 0 ? user.FirstName[0] : 'U')</span>
                                                        }
                                                    </div>
                                                }
                                                @if (cardAssignees.Count > 3)
                                                {
                                                    <div class="size-6 rounded-full bg-zinc-900 border border-zinc-700 flex items-center justify-center text-[9px] font-bold text-zinc-400 shrink-0">
                                                        +@(cardAssignees.Count - 3)
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @if (_canEditBoardStructure)
                            {
                                <!-- Add Card Button inside List -->
                                <button @onclick="() => ShowAddCardModal(list.Id)" class="w-full py-2.5 flex items-center justify-center gap-2 text-sm font-medium text-zinc-500 hover:text-white hover:bg-zinc-800 rounded-lg transition-colors border border-dashed border-zinc-700 hover:border-zinc-600">
                                    <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                                    Add Card
                                </button>
                            }
                        </div>
                    </div>
                }

                @if (_canEditBoardStructure)
                {
                    <!-- Add List Button -->
                    <div class="w-80 shrink-0">
                        @if (_isAddingList)
                        {
                            <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-4 shadow-xl space-y-3">
                                <input type="text" @bind="_newListName" @bind:event="oninput" @onkeyup="HandleListInputKeyUp" placeholder="Enter list title..." class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none" autofocus />
                                <div class="space-y-1.5">
                                    <label class="block text-[10px] font-bold text-zinc-500 uppercase tracking-widest">List Color</label>
                                    <div class="flex items-center justify-between gap-1">
                                        <div class="flex items-center gap-1.5 flex-wrap">
                                            @foreach (var c in _presetColors)
                                            {
                                                <button type="button" @onclick="() => _newListColor = c" class="size-5 rounded-full border border-white/20 transition-all hover:scale-125 shadow-sm @(_newListColor == c ? "ring-2 ring-white ring-offset-1 ring-offset-zinc-900 scale-110" : "")" style="background-color: @c;" title="@c"></button>
                                            }
                                        </div>
                                        <label class="relative flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-zinc-950 border border-zinc-700 hover:border-zinc-500 cursor-pointer transition-colors shrink-0 shadow-sm" title="Choose custom color">
                                            <span class="size-3.5 rounded-full border border-white/20 shadow-inner shrink-0" style="background-color: @(_newListColor);"></span>
                                            <span class="text-[10px] font-semibold text-zinc-300">Custom</span>
                                            <input type="color" @bind="_newListColor" class="sr-only" />
                                        </label>
                                    </div>
                                </div>
                                <div class="flex items-center justify-end gap-2 pt-1 border-t border-zinc-800/80">
                                    <button @onclick="() => _isAddingList = false" class="px-3 py-1.5 text-xs font-medium text-zinc-400 hover:text-white transition-colors">Cancel</button>
                                    <button @onclick="CreateList" disabled="@string.IsNullOrWhiteSpace(_newListName)" class="px-3 py-1.5 text-xs font-bold text-white bg-fuchsia-600 rounded-lg hover:bg-fuchsia-500 disabled:opacity-50 transition-colors shadow-sm">Add List</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <button @onclick="() => _isAddingList = true" class="w-full py-3 flex items-center justify-center gap-2 text-sm font-medium text-zinc-400 hover:text-white bg-zinc-900/30 hover:bg-zinc-900 border border-dashed border-zinc-800 hover:border-zinc-700 rounded-2xl transition-all">
                                <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                                Add another list
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- Add/Edit Card Modal -->
@if (_showCardModal)
{
    <div class="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-50 p-4">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-4xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
            <div class="px-6 py-4 border-b border-zinc-800 flex items-center justify-between bg-zinc-900 shrink-0">
                <h3 class="text-lg font-bold text-white tracking-wide">@(_editingCard == null ? "Add Card" : (_canEditBoardStructure ? "Edit Card" : "Card Details"))</h3>
                <button @onclick="CloseCardModal" class="text-zinc-500 hover:text-white transition-colors">
                    <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>
            
            <div class="p-6 overflow-y-auto overflow-x-hidden custom-scrollbar flex flex-col md:flex-row gap-6">
                
                <!-- Main Content (Left) -->
                <div class="flex-1 min-w-0 space-y-6">
                    <div>
                    <label class="block text-xs font-semibold text-zinc-500 uppercase tracking-wider mb-2">Title</label>
                    <input type="text" @bind="_cardModel.Title" disabled="@(!_canEditBoardStructure)" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none disabled:opacity-60 disabled:cursor-not-allowed" autofocus="@_canEditBoardStructure" />
                </div>
                
                <div>
                    <label class="block text-xs font-semibold text-zinc-500 uppercase tracking-wider mb-2">Description</label>
                    <textarea @bind="_cardModel.Description" disabled="@(!_canEditBoardStructure)" rows="4" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none resize-none disabled:opacity-60 disabled:cursor-not-allowed" placeholder="@(!_canEditBoardStructure ? "No description provided." : "Add a more detailed description...")"></textarea>
                </div>

                @if (_editingCard != null)
                {
                    <div class="border-t border-zinc-800/50 pt-6 mt-2 space-y-8">
                            
                            <!-- Checklists -->
                            <div class="space-y-4">
                                <div class="flex items-center justify-between">
                                    <h4 class="text-sm font-bold text-white flex items-center gap-2">
                                        <svg class="size-4 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
                                        Checklists
                                    </h4>
                                    @if (_canEditBoardStructure)
                                    {
                                        <div class="flex items-center gap-2">
                                            <input type="text" @bind="_newChecklistTitle" placeholder="Checklist title..." class="bg-zinc-950 border border-zinc-800 rounded px-2 py-1 text-xs text-white focus:outline-none focus:border-fuchsia-500 w-32 md:w-40" />
                                            <button @onclick="AddChecklist" class="bg-zinc-800 hover:bg-zinc-700 text-white px-2 py-1 rounded text-xs font-semibold transition-colors border border-zinc-700 hover:border-zinc-600">Add</button>
                                        </div>
                                    }
                                </div>
                                
                                @foreach (var cl in _editingCard.Checklists)
                                {
                                    var progress = cl.Items.Any() ? (int)((cl.Items.Count(i => i.IsCompleted) / (double)cl.Items.Count) * 100) : 0;
                                    <div class="bg-zinc-950 border border-zinc-800/60 rounded-xl p-4 space-y-3 shadow-inner">
                                        <div class="flex items-center justify-between mb-2">
                                            <h5 class="text-xs font-semibold text-zinc-300">@cl.Title</h5>
                                            @if (_canEditBoardStructure)
                                            {
                                                <button @onclick='() => PromptDelete("Delete Checklist", $"Are you sure you want to delete the checklist \"{cl.Title}\"?", async () => await DeleteChecklist(cl))' class="text-zinc-600 hover:text-red-400 p-1 transition-colors" title="Delete Checklist">
                                                    <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                                                </button>
                                            }
                                        </div>
                                        <div class="flex items-center gap-3">
                                            <span class="text-[10px] text-zinc-500 w-8">@progress%</span>
                                            <div class="flex-1 h-1.5 bg-zinc-900 rounded-full overflow-hidden">
                                                <div class="h-full bg-fuchsia-600 transition-all duration-300" style="width: @progress%"></div>
                                            </div>
                                        </div>
                                        
                                        <div class="space-y-2 mt-2">
                                            @foreach (var item in cl.Items)
                                            {
                                                <div class="flex items-center gap-3 group px-1">
                                                    <input type="checkbox" checked="@item.IsCompleted" @onchange="() => ToggleChecklistItem(cl.Id, item)" disabled="@_isViewer" class="size-4 rounded border-zinc-700 bg-zinc-900 text-fuchsia-600 focus:ring-fuchsia-600 focus:ring-offset-zinc-950 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" />
                                                    <span class="text-sm @(item.IsCompleted ? "text-zinc-500 line-through" : "text-zinc-300")">@item.Text</span>
                                                </div>
                                            }
                                        </div>

                                        @if (_canEditBoardStructure)
                                        {
                                            <div class="flex items-center gap-2 pt-3 mt-2 border-t border-zinc-800/50">
                                                <input type="text" value="@(_newChecklistItemTexts.ContainsKey(cl.Id) ? _newChecklistItemTexts[cl.Id] : "")" @onchange="(e) => _newChecklistItemTexts[cl.Id] = e.Value?.ToString() ?? string.Empty" placeholder="Add an item..." class="bg-zinc-900 border border-zinc-800 rounded px-3 py-1.5 text-xs text-white focus:outline-none focus:border-fuchsia-500 flex-1" />
                                                <button @onclick="() => AddChecklistItem(cl.Id)" class="bg-zinc-800 hover:bg-zinc-700 text-white px-3 py-1.5 rounded text-xs font-semibold transition-colors border border-zinc-700">Add</button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Attachments -->
                            <div class="space-y-4">
                                <div class="flex items-center justify-between">
                                    <h4 class="text-sm font-bold text-white flex items-center gap-2">
                                        <svg class="size-4 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
                                        Attachments
                                    </h4>
                                    @if (!_isViewer)
                                    {
                                        <div>
                                            <InputFile @key="_fileInputKey" OnChange="HandleFileUpload" id="file-upload" class="hidden" disabled="@_isUploadingAttachment" />
                                            <label for="file-upload" class="cursor-pointer bg-zinc-800 hover:bg-zinc-700 text-white px-3 py-1.5 rounded text-xs font-semibold transition-colors border border-zinc-700 flex items-center gap-2 @(_isUploadingAttachment ? "opacity-50 pointer-events-none" : "")">
                                                @if (_isUploadingAttachment)
                                                {
                                                    <span class="inline-block size-3.5 border-2 border-fuchsia-500 border-t-transparent rounded-full animate-spin"></span>
                                                    <span>Uploading...</span>
                                                }
                                                else
                                                {
                                                    <svg class="size-3.5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.5v15m7.5-7.5h-15"></path></svg>
                                                    <span>Upload File</span>
                                                }
                                            </label>
                                        </div>
                                    }
                                </div>

                                @if (_editingCard.Attachments.Any())
                                {
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                        @foreach (var att in _editingCard.Attachments)
                                        {
                                            <div class="bg-zinc-950 border border-zinc-800 rounded-lg p-3 flex items-center justify-between group h-14">
                                                <button type="button" @onclick="() => OpenAttachmentViewer(att)" class="flex items-center gap-3 overflow-hidden text-left cursor-pointer flex-1">
                                                    <div class="size-8 rounded bg-zinc-900 border border-zinc-800 flex items-center justify-center shrink-0 text-fuchsia-500">
                                                        <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
                                                    </div>
                                                    <div class="overflow-hidden">
                                                        <p class="text-xs font-semibold text-zinc-300 truncate w-32 md:w-36 hover:text-fuchsia-400" title="@att.FileName">@att.FileName</p>
                                                        <p class="text-[10px] text-zinc-600">@((att.FileSize / 1024).ToString("N0")) KB</p>
                                                    </div>
                                                </button>
                                                @if (!_isViewer && (_canEditBoardStructure || att.UserId == _currentEmployeeId))
                                                {
                                                    <button @onclick='() => PromptDelete("Delete Attachment", $"Are you sure you want to delete the attachment \"{att.FileName}\"?", async () => await DeleteAttachment(att))' class="text-zinc-600 hover:text-red-400 md:opacity-0 group-hover:opacity-100 transition-all p-1" title="Delete Attachment">
                                                        <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Comments -->
                            <div class="space-y-4">
                                <h4 class="text-sm font-bold text-white flex items-center gap-2">
                                    <svg class="size-4 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                                    Comments Activity
                                </h4>
                                
                                <div class="bg-zinc-950 border border-zinc-800 rounded-xl p-3 flex gap-3">
                                    <div class="size-8 rounded-full bg-zinc-800 border border-zinc-700 flex items-center justify-center shrink-0">
                                        <svg class="size-4 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                                    </div>
                                    <div class="flex-1 space-y-2">
                                        <textarea @bind="_newCommentText" rows="2" placeholder="Write a comment..." class="w-full bg-zinc-900 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none resize-none"></textarea>
                                        <button @onclick="AddComment" disabled="@string.IsNullOrWhiteSpace(_newCommentText)" class="bg-fuchsia-600 hover:bg-fuchsia-500 disabled:opacity-50 text-white px-3 py-1.5 rounded transition-colors text-xs font-bold shadow shadow-fuchsia-900/20">Save Comment</button>
                                    </div>
                                </div>
                                
                                <div class="space-y-4 mt-6">
                                    @foreach (var comment in _editingCard.Comments)
                                    {
                                        <div class="flex gap-3">
                                            <div class="size-8 rounded-full bg-zinc-800 border border-zinc-800 flex items-center justify-center shrink-0 mt-1 overflow-hidden">
                                                @if (!string.IsNullOrEmpty(comment.User.ProfilePictureUrl))
                                                {
                                                    <img src="@(Configuration["ApiBaseUrl"] + comment.User.ProfilePictureUrl)" class="w-full h-full object-cover" />
                                                }
                                                else
                                                {
                                                    <span class="text-xs font-bold text-zinc-300">@(comment.User.FirstName[0])</span>
                                                }
                                            </div>
                                            <div class="flex-1">
                                                <div class="flex items-center gap-2 mb-1">
                                                    <span class="text-xs font-bold text-zinc-300">@comment.User.FirstName @comment.User.LastName</span>
                                                    <span class="text-[10px] text-zinc-600">@comment.CreatedAt.ToLocalTime().ToString("MMM dd 'at' hh:mm tt")</span>
                                                </div>
                                                <div class="bg-zinc-950 border border-zinc-800/80 rounded-lg rounded-tl-none p-3 text-sm text-zinc-300">
                                                    @comment.Text
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Sidebar (Right) -->
                <div class="w-full md:w-64 shrink-0 space-y-6">
                    <div class="bg-zinc-950/50 border border-zinc-800/80 p-4 rounded-xl space-y-4 shadow-sm">
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <label class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest">Assignees</label>
                                @if (_cardModel.AssigneeIds.Any())
                                {
                                    <span class="text-[10px] font-semibold text-fuchsia-400 bg-fuchsia-500/10 px-1.5 py-0.5 rounded-full border border-fuchsia-500/20">
                                        @_cardModel.AssigneeIds.Count selected
                                    </span>
                                }
                            </div>

                            @if (_cardModel.AssigneeIds.Any())
                            {
                                <div class="flex flex-wrap gap-1.5 mb-2.5">
                                    @foreach (var empId in _cardModel.AssigneeIds)
                                    {
                                        var memberUser = _board?.Members.FirstOrDefault(m => m.User.Id == empId)?.User;
                                        if (memberUser != null)
                                        {
                                            <div class="inline-flex items-center gap-1.5 pl-1.5 pr-2 py-1 rounded-lg bg-zinc-900 border border-zinc-700/80 text-xs text-zinc-200 shadow-sm">
                                                <div class="size-4.5 rounded-full bg-zinc-800 flex items-center justify-center overflow-hidden shrink-0">
                                                    @if (!string.IsNullOrEmpty(memberUser.ProfilePictureUrl))
                                                    {
                                                        <img src="@(Configuration["ApiBaseUrl"] + memberUser.ProfilePictureUrl)" class="w-full h-full object-cover" />
                                                    }
                                                    else
                                                    {
                                                        <span class="text-[8px] font-bold text-zinc-300">@(memberUser.FirstName.Length > 0 ? memberUser.FirstName[0] : 'U')</span>
                                                    }
                                                </div>
                                                <span class="truncate max-w-[100px] text-[11px]">@memberUser.FirstName</span>
                                                @if (_canEditBoardStructure)
                                                {
                                                    <button type="button" @onclick="() => ToggleAssignee(empId)" class="text-zinc-500 hover:text-red-400 ml-0.5 transition-colors" title="Remove assignee">
                                                        <svg class="size-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            }

                            <div class="space-y-1 max-h-44 overflow-y-auto pr-1 border border-zinc-800 rounded-lg p-1.5 bg-zinc-900/60 custom-scrollbar">
                                @if (_board != null && _board.Members.Any())
                                {
                                    @foreach (var member in _board.Members)
                                    {
                                        var isAssigned = _cardModel.AssigneeIds.Contains(member.User.Id);
                                        <button type="button" @onclick="() => ToggleAssignee(member.User.Id)"
                                                disabled="@(!_canEditBoardStructure)"
                                                class="w-full flex items-center justify-between px-2.5 py-1.5 rounded-md text-xs transition-colors disabled:opacity-50 disabled:cursor-not-allowed @(isAssigned ? "bg-fuchsia-600/15 text-white border border-fuchsia-500/30" : "text-zinc-400 hover:text-white hover:bg-zinc-800/70")">
                                            <div class="flex items-center gap-2 min-w-0">
                                                <div class="size-5 rounded-full bg-zinc-800 border border-zinc-700 flex items-center justify-center overflow-hidden shrink-0">
                                                    @if (!string.IsNullOrEmpty(member.User.ProfilePictureUrl))
                                                    {
                                                        <img src="@(Configuration["ApiBaseUrl"] + member.User.ProfilePictureUrl)" class="w-full h-full object-cover" />
                                                    }
                                                    else
                                                    {
                                                        <span class="text-[8px] font-bold text-zinc-300">@(member.User.FirstName.Length > 0 ? member.User.FirstName[0] : 'U')</span>
                                                    }
                                                </div>
                                                <span class="truncate text-[11px] font-medium">@member.User.FirstName @member.User.LastName</span>
                                            </div>
                                            <div class="size-4 rounded flex items-center justify-center shrink-0 @(isAssigned ? "bg-fuchsia-600 text-white" : "border border-zinc-700")">
                                                @if (isAssigned)
                                                {
                                                    <svg class="size-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                                                }
                                            </div>
                                        </button>
                                    }
                                }
                                else
                                {
                                    <div class="text-[11px] text-zinc-500 p-2 text-center">No board members found</div>
                                }
                            </div>
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-zinc-500 uppercase tracking-widest mb-2">Due Date</label>
                            <input type="date" @bind="_cardModel.DueDate" disabled="@(!_canEditBoardStructure)" class="w-full bg-zinc-900 border border-zinc-700 hover:border-zinc-600 rounded-lg px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none cursor-pointer transition-colors disabled:opacity-50 disabled:cursor-not-allowed [color-scheme:dark]" />
                        </div>
                    </div>

                    @if (_editingCard != null)
                    {
                        <div class="bg-zinc-950/50 border border-zinc-800/80 p-4 rounded-xl space-y-4 shadow-sm">
                            <h4 class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest">Card Labels</h4>
                            
                            @if (_canEditBoardStructure)
                            {
                                <div class="space-y-2">
                                    <div class="flex items-center gap-1.5">
                                        <label class="relative size-7 rounded-lg border border-zinc-700 hover:border-zinc-500 cursor-pointer flex items-center justify-center shrink-0 shadow-sm overflow-hidden" title="Choose custom color">
                                            <span class="absolute inset-0" style="background-color: @(_newLabelColor);"></span>
                                            <input type="color" @bind="_newLabelColor" class="sr-only" />
                                        </label>
                                        <input type="text" @bind="_newLabelName" @bind:event="oninput" @onkeydown="@(async (e) => { if (e.Key == "Enter") await CreateLabel(); })" placeholder="New label name..." class="flex-1 min-w-0 bg-zinc-900 border border-zinc-700 rounded-lg px-2.5 py-1.5 text-xs text-white focus:outline-none focus:border-fuchsia-500" />
                                        <button type="button" @onclick="CreateLabel" disabled="@string.IsNullOrWhiteSpace(_newLabelName)" class="px-2.5 py-1.5 bg-fuchsia-600 hover:bg-fuchsia-500 text-white text-xs font-bold rounded-lg transition-colors disabled:opacity-50 shrink-0">Add</button>
                                    </div>
                                    <div class="flex items-center gap-1.5 flex-wrap pt-0.5">
                                        @foreach (var c in _presetColors)
                                        {
                                            <button type="button" @onclick="() => _newLabelColor = c" class="size-4 rounded-full border border-white/20 transition-all hover:scale-125 @(_newLabelColor == c ? "ring-2 ring-white ring-offset-1 ring-offset-zinc-950 scale-110" : "")" style="background-color: @c;" title="@c"></button>
                                        }
                                    </div>
                                </div>
                            }

                            @if (_board != null && _board.Labels.Any())
                            {
                                <div class="flex flex-col gap-1.5 max-h-48 overflow-y-auto pr-1 custom-scrollbar">
                                    @foreach (var lbl in _board.Labels)
                                    {
                                        var isActive = _editingCard.Labels.Any(l => l.LabelId == lbl.Id);
                                        <div class="flex items-center gap-1.5 group/lbl">
                                            <button type="button" @onclick="() => ToggleLabel(lbl.Id)" disabled="@(!_canEditBoardStructure)" class="flex-1 min-w-0 relative flex items-center justify-between px-2.5 py-1.5 rounded-lg border transition-all text-left disabled:cursor-not-allowed @(isActive ? "border-transparent text-white shadow-inner font-bold" : "border-zinc-800 bg-zinc-950 text-zinc-400 hover:border-zinc-700 hover:text-white")" title="@(!_canEditBoardStructure ? lbl.Name : (isActive ? "Click to remove from card" : "Click to add to card"))">
                                                @if (isActive)
                                                {
                                                    <div class="absolute inset-0 rounded-lg opacity-20" style="background-color: @lbl.ColorHex;"></div>
                                                    <div class="absolute inset-0 rounded-lg border-2 opacity-50" style="border-color: @lbl.ColorHex;"></div>
                                                }
                                                <span class="flex items-center gap-2 relative z-10 text-xs shadow-black drop-shadow-md min-w-0 truncate">
                                                    <span class="size-2.5 rounded-full shrink-0" style="background-color: @lbl.ColorHex;"></span>
                                                    <span class="truncate">@lbl.Name</span>
                                                </span>
                                                @if (isActive)
                                                {
                                                    <svg class="size-3.5 relative z-10 shrink-0 ml-1" style="color: @lbl.ColorHex;" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                                                }
                                            </button>
                                            @if (_canEditBoardStructure)
                                            {
                                                <button type="button" @onclick='() => PromptDelete("Delete Label", $"Are you sure you want to delete label \"{lbl.Name}\" from this board? It will be removed from all cards.", async () => await DeleteBoardLabel(lbl))' class="p-1 text-zinc-500 hover:text-red-400 hover:bg-zinc-800 rounded transition-colors shrink-0" title="Delete label from board">
                                                    <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-xs text-zinc-500 italic">No labels defined on this board yet.</p>
                            }
                        </div>
                    }
                </div>
            </div>
            
            <div class="px-6 py-4 border-t border-zinc-800 flex justify-end gap-2 bg-zinc-900 shrink-0">
                @if (_canEditBoardStructure)
                {
                    <button @onclick="CloseCardModal" class="px-4 py-2 text-sm font-medium text-zinc-400 hover:text-white transition-colors">Cancel</button>
                    <button @onclick="SaveCard" disabled="@string.IsNullOrWhiteSpace(_cardModel.Title)" class="px-4 py-2 text-sm font-bold text-white bg-fuchsia-600 rounded-lg hover:bg-fuchsia-500 disabled:opacity-50 transition-colors">Save Card</button>
                }
                else
                {
                    <button @onclick="CloseCardModal" class="px-4 py-2 text-sm font-bold text-white bg-zinc-800 rounded-lg hover:bg-zinc-700 transition-colors">Close</button>
                }
            </div>
        </div>
    </div>
}
<!-- Delete Board Modal -->
@if (_showDeleteBoardModal)
{
    <div class="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-50 p-4">
        <div class="bg-zinc-900 border border-red-900/50 rounded-2xl w-full max-w-md shadow-2xl overflow-hidden flex flex-col">
            <div class="px-6 py-4 border-b border-zinc-800 flex items-center justify-between bg-zinc-900 shrink-0">
                <h3 class="text-lg font-bold text-white tracking-wide">Delete Board</h3>
                <button @onclick="() => _showDeleteBoardModal = false" class="text-zinc-500 hover:text-white transition-colors">
                    <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>
            
            <div class="p-6">
                <p class="text-zinc-300 text-sm mb-6">Are you sure you want to delete this board? This action cannot be undone.</p>
                
                <div class="flex justify-end gap-3">
                    <button @onclick="() => _showDeleteBoardModal = false" class="px-4 py-2 text-sm font-bold text-white bg-zinc-800 rounded-lg hover:bg-zinc-700 transition-all">Cancel</button>
                    <button @onclick="ConfirmDeleteBoard" class="px-4 py-2 text-sm font-bold text-white bg-red-600 rounded-lg hover:bg-red-500 transition-all">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Generic Delete Modal -->
@if (_showGenericDeleteModal)
{
    <div class="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-[60] p-4">
        <div class="bg-zinc-900 border border-red-900/50 rounded-2xl w-full max-w-sm shadow-2xl p-6 relative">
            <h3 class="text-lg font-bold text-white mb-2">@_genericDeleteTitle</h3>
            <p class="text-sm text-zinc-400 mb-6">@_genericDeleteText</p>
            <div class="flex justify-end gap-3">
                <button @onclick="() => _showGenericDeleteModal = false" class="px-4 py-2 text-sm font-bold text-white bg-zinc-800 rounded-lg hover:bg-zinc-700 transition-all">Cancel</button>
                <button @onclick="ConfirmGenericDelete" class="px-4 py-2 text-sm font-bold text-white bg-red-600 rounded-lg hover:bg-red-500 transition-all">Delete</button>
            </div>
        </div>
    </div>
}

<!-- Members Modal -->
@if (_showMembersModal)
{
    <div class="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-50 p-4">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-md shadow-2xl overflow-hidden flex flex-col max-h-[80vh]">
            <div class="px-6 py-4 border-b border-zinc-800 flex items-center justify-between bg-zinc-900 shrink-0">
                <h3 class="text-lg font-bold text-white tracking-wide">Board Members</h3>
                <button @onclick="() => _showMembersModal = false" class="text-zinc-500 hover:text-white transition-colors">
                    <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>
            
            <div class="p-6 overflow-y-auto custom-scrollbar">
                @if (_board != null)
                {
                    <div class="space-y-4 mb-8">
                        <h4 class="text-xs font-semibold text-zinc-500 uppercase tracking-wider mb-2">Current Members</h4>
                        @foreach (var member in _board.Members)
                        {
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div class="size-8 rounded-full bg-zinc-800 border border-zinc-700 flex items-center justify-center overflow-hidden">
                                        @if (!string.IsNullOrEmpty(member.User.ProfilePictureUrl))
                                        {
                                            <img src="@(Configuration["ApiBaseUrl"] + member.User.ProfilePictureUrl)" class="w-full h-full object-cover" />
                                        }
                                        else
                                        {
                                            <span class="text-xs font-bold text-zinc-300">@(member.User.FirstName[0])</span>
                                        }
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-white">@member.User.FirstName @member.User.LastName</p>
                                        @if (_canManageBoardMembers && member.Role != BoardMemberRole.Owner)
                                        {
                                            <div class="flex items-center gap-2 mt-0.5">
                                                <select value="@member.Role" @onchange="(e) => ChangeMemberRole(member.User.Id, e.Value?.ToString())" class="bg-zinc-950 border border-zinc-800 rounded px-1.5 py-[1px] text-[10px] font-medium text-zinc-400 hover:text-white focus:outline-none focus:border-fuchsia-500 transition-colors uppercase tracking-wider">
                                                    <option value="@BoardMemberRole.Admin">Admin</option>
                                                    <option value="@BoardMemberRole.Member">Member</option>
                                                    <option value="@BoardMemberRole.Viewer">Viewer</option>
                                                </select>
                                                <button @onclick="() => ConfirmRemoveMember(member.User)" class="text-[10px] text-red-500 hover:text-red-400 font-bold px-1.5 py-[1px] bg-red-500/10 hover:bg-red-500/20 rounded transition-colors uppercase tracking-wider">Remove</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <p class="text-[10px] text-zinc-500 uppercase">@((BoardMemberRole)member.Role)</p>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (_canManageBoardMembers)
                    {
                        <div class="space-y-4 pt-4 border-t border-zinc-800/50">
                            <h4 class="text-xs font-semibold text-zinc-500 uppercase tracking-wider mb-2">Add Member</h4>
                            <div class="flex gap-2">
                                <select @bind="_newMemberUserId" class="flex-1 bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none appearance-none">
                                    <option value="">Select an employee...</option>
                                    @foreach (var user in _allUsers.Where(u => !_board.Members.Any(m => m.User.Id == u.Id)))
                                    {
                                        <option value="@user.Id">@user.FirstName @user.LastName</option>
                                    }
                                </select>
                                <select @bind="_newMemberRole" class="w-28 bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none appearance-none">
                                    <option value="@BoardMemberRole.Member">Member</option>
                                    <option value="@BoardMemberRole.Admin">Admin</option>
                                    <option value="@BoardMemberRole.Viewer">Viewer</option>
                                </select>
                            </div>
                            <button @onclick="AddMember" disabled="@string.IsNullOrEmpty(_newMemberUserId)" class="w-full py-2 text-sm font-bold text-white bg-fuchsia-600 rounded-lg hover:bg-fuchsia-500 disabled:opacity-50 transition-all">
                                Add to Board
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="pt-4 border-t border-zinc-800/50 text-center py-2">
                            <p class="text-xs text-zinc-500">Only workspace owners and administrators can add or remove board members.</p>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

<!-- Remove Member Modal -->
@if (_showRemoveMemberModal && _memberToRemove != null)
{
    <div class="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-[60] p-4">
        <div class="bg-zinc-900 border border-red-900/50 rounded-2xl w-full max-w-sm shadow-2xl overflow-hidden flex flex-col">
            <div class="px-6 py-4 border-b border-zinc-800 flex items-center justify-between bg-zinc-900 shrink-0">
                <h3 class="text-lg font-bold text-white tracking-wide">Remove Member</h3>
                <button @onclick="() => _showRemoveMemberModal = false" class="text-zinc-500 hover:text-white transition-colors">
                    <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>
            
            <div class="p-6">
                <p class="text-zinc-300 text-sm mb-6">Are you sure you want to remove <strong>@_memberToRemove.FirstName @_memberToRemove.LastName</strong> from this board?</p>
                
                <div class="flex justify-end gap-3">
                    <button @onclick="() => _showRemoveMemberModal = false" class="px-4 py-2 text-sm font-bold text-white bg-zinc-800 rounded-lg hover:bg-zinc-700 transition-all">Cancel</button>
                    <button @onclick="ExecuteRemoveMember" class="px-4 py-2 text-sm font-bold text-white bg-red-600 rounded-lg hover:bg-red-500 transition-all">Remove</button>
                </div>
            </div>
        </div>
    </div>
}

