@page "/clients"
@attribute [Authorize(Policy = "RequireClients")]
@inject HttpClient Http
@inject OfficeCore.Web.Services.ToastService ToastService

<PageTitle>Clients - OfficeCore</PageTitle>

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold tracking-tight text-white">Clients</h1>
            <p class="mt-1 text-zinc-400 text-sm">Manage your clients and their associated businesses</p>
        </div>
        <div class="flex items-center gap-3">
            <button @onclick="LoadClients" disabled="@_isLoading" class="p-2 text-zinc-400 hover:text-white bg-zinc-900 border border-zinc-800 rounded-lg transition-colors cursor-pointer" title="Refresh">
                <svg class="size-4 @(_isLoading ? "animate-spin text-fuchsia-400" : "")" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
            </button>
            <AuthorizeView Policy="Permission:clients.manage">
                <button @onclick="ShowAddClientModal" class="px-4 py-2 text-sm font-bold text-white bg-fuchsia-600 rounded-lg hover:bg-fuchsia-500 shadow-lg shadow-fuchsia-900/30 transition-colors flex items-center gap-2 cursor-pointer">
                    <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                    Add Client
                </button>
            </AuthorizeView>
        </div>
    </div>

    <div class="flex items-center gap-4 bg-zinc-950 p-4 rounded-2xl border border-zinc-800">
        <div class="relative flex-1 max-w-md">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="size-4 text-zinc-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
            </div>
            <input type="text" @bind="_searchTerm" @bind:event="oninput" @bind:after="ResetPage" class="w-full bg-zinc-900 border border-zinc-700 rounded-lg pl-10 pr-4 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none" placeholder="Search clients or businesses..." />
        </div>
    </div>

    <div class="bg-zinc-950 border border-zinc-800 rounded-2xl overflow-hidden">
        @if (_clients == null)
        {
            <div class="flex items-center justify-center py-12 text-zinc-500">Loading clients...</div>
        }
        else if (!FilteredClients.Any())
        {
            <AuthorizeView Policy="Permission:clients.manage">
                <Authorized>
                    <EmptyState Card="false"
                                Title="@(string.IsNullOrWhiteSpace(_searchTerm) ? "No clients found" : "No matching clients")"
                                Description="@(string.IsNullOrWhiteSpace(_searchTerm) ? "Add your first client to start managing their accounts and businesses." : "Try adjusting your search terms or clear the filter.")"
                                ActionText="Add Client"
                                OnAction="ShowAddClientModal">
                        <Icon>
                            <svg class="size-10 text-zinc-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" /></svg>
                        </Icon>
                    </EmptyState>
                </Authorized>
                <NotAuthorized>
                    <EmptyState Card="false"
                                Title="@(string.IsNullOrWhiteSpace(_searchTerm) ? "No clients found" : "No matching clients")"
                                Description="@(string.IsNullOrWhiteSpace(_searchTerm) ? "No clients have been added yet." : "Try adjusting your search terms or clear the filter.")">
                        <Icon>
                            <svg class="size-10 text-zinc-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" /></svg>
                        </Icon>
                    </EmptyState>
                </NotAuthorized>
            </AuthorizeView>
        }
        else
        {
            var filteredList = FilteredClients.ToList();
            var pagedClients = filteredList.Skip((_page - 1) * _pageSize).Take(_pageSize);
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-zinc-800 text-zinc-400 text-left bg-zinc-900/50">
                        <th class="px-6 py-4 font-medium">Client</th>
                        <th class="px-6 py-4 font-medium">Contact Info</th>
                        <th class="px-6 py-4 font-medium w-1/2">Businesses</th>
                        <th class="px-6 py-4 font-medium w-24">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-800/50">
                    @foreach (var client in pagedClients)
                    {
                        <tr class="hover:bg-zinc-900/30 transition-colors align-top">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="size-10 rounded-xl bg-purple-900/20 border border-purple-500/20 flex items-center justify-center text-purple-400 font-bold text-lg shrink-0">
                                        @(string.IsNullOrWhiteSpace(client.FullName) ? "?" : client.FullName[0].ToString().ToUpper())
                                    </div>
                                    <span class="font-bold text-white text-base">@client.FullName</span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex flex-col gap-1.5 text-zinc-400">
                                    @if (!string.IsNullOrEmpty(client.Email))
                                    {
                                        <div class="flex items-center gap-2">
                                            <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
                                            @client.Email
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(client.PhoneNumber))
                                    {
                                        <div class="flex items-center gap-2">
                                            <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.48-4.18-7.076-7.076l1.293-.97c.362-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
                                            @client.PhoneNumber
                                        </div>
                                    }
                                    @if (string.IsNullOrEmpty(client.Email) && string.IsNullOrEmpty(client.PhoneNumber))
                                    {
                                        <span class="text-zinc-600 italic">No contact info</span>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex flex-col gap-3">
                                    @if (client.Businesses != null && client.Businesses.Any())
                                    {
                                        @foreach (var biz in client.Businesses)
                                        {
                                            <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-3 group/biz @(!biz.IsActive ? "opacity-75 bg-zinc-900/50" : "")">
                                                <div class="flex items-start justify-between">
                                                    <div>
                                                        <div class="font-medium text-zinc-200 flex items-center gap-2 flex-wrap">
                                                            <span>@biz.Name</span>
                                                            @if (biz.IsActive)
                                                            {
                                                                <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Active</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold bg-zinc-800 text-zinc-400 border border-zinc-700">Inactive</span>
                                                            }
                                                            @if (!string.IsNullOrEmpty(biz.BusinessType))
                                                            {
                                                                <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-indigo-950/50 text-indigo-300 border border-indigo-800/60">@biz.BusinessType</span>
                                                            }
                                                            @if (biz.IsVatRegistered)
                                                            {
                                                                <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-fuchsia-900/30 text-fuchsia-400 border border-fuchsia-900/50">VAT</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-zinc-800 text-zinc-400 border border-zinc-700">NON-VAT</span>
                                                            }
                                                        </div>
                                                        <div class="mt-1.5 text-xs text-zinc-400 flex flex-col gap-0.5">
                                                            @if (!string.IsNullOrEmpty(biz.TinId))
                                                            {
                                                                <div class="flex items-center gap-1.5 text-[11px] text-zinc-300 font-mono">
                                                                    <span class="text-zinc-500 font-sans font-medium">TIN:</span>
                                                                    <span class="bg-zinc-950 px-1.5 py-0.5 rounded border border-zinc-800">@biz.TinId</span>
                                                                </div>
                                                            }
                                                            @if (!string.IsNullOrEmpty(biz.Address)) { <span class="text-zinc-500">@biz.Address</span> }
                                                            @if (!string.IsNullOrEmpty(biz.PhoneNumber)) { <span class="text-zinc-500">@biz.PhoneNumber</span> }
                                                        </div>
                                                    </div>
                                                    <AuthorizeView Policy="Permission:clients.manage">
                                                        <div class="flex items-center gap-1 opacity-0 group-hover/biz:opacity-100 transition-opacity">
                                                            <button @onclick="() => EditBusiness(client, biz)" class="p-1.5 text-zinc-400 hover:text-fuchsia-400 bg-zinc-950 rounded border border-zinc-800 hover:border-fuchsia-900/50 transition-colors" title="Edit Business">
                                                                <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" /></svg>
                                                            </button>
                                                            <button @onclick='() => PromptDeleteBusiness(client, biz)' class="p-1.5 text-zinc-400 hover:text-red-400 bg-zinc-950 rounded border border-zinc-800 hover:border-red-900/50 transition-colors" title="Delete Business">
                                                                <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                                                            </button>
                                                        </div>
                                                    </AuthorizeView>
                                                </div>
                                            </div>
                                        }
                                    }
                                    <AuthorizeView Policy="Permission:clients.manage">
                                        <button @onclick="() => ShowAddBusinessModal(client)" class="self-start text-xs font-medium text-purple-400 hover:text-purple-300 transition-colors flex items-center gap-1 py-1 px-2 rounded hover:bg-purple-900/20">
                                            <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                                            Add Business
                                        </button>
                                    </AuthorizeView>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <AuthorizeView Policy="Permission:clients.manage">
                                    <div class="flex items-center gap-2">
                                        <button @onclick="() => EditClient(client)" class="p-2 text-zinc-400 hover:text-fuchsia-400 bg-zinc-900 rounded-lg border border-zinc-800 hover:border-fuchsia-900/50 transition-all" title="Edit Client">
                                            <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" /></svg>
                                        </button>
                                        <button @onclick="() => ShowArchiveConfirmation(client)" class="p-2 text-zinc-400 hover:text-red-400 bg-zinc-900 rounded-lg border border-zinc-800 hover:border-red-900/50 transition-all" title="Archive Client">
                                            <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
                                        </button>
                                    </div>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <PaginationToolbar @bind-Page="_page" @bind-PageSize="_pageSize" TotalCount="filteredList.Count" />
        }
    </div>
</div>

<!-- Client Form Modal -->
@if (_showClientForm)
{
    <div class="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-50 p-4">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-md shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
            <div class="px-6 py-4 border-b border-zinc-800 flex items-center justify-between bg-zinc-900 shrink-0">
                <h3 class="text-lg font-bold text-white tracking-wide">@(_editingClient ? "Edit Client" : "New Client")</h3>
                <button @onclick="CloseModals" class="text-zinc-500 hover:text-white transition-colors">
                    <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>
            <div class="p-6 space-y-5 overflow-y-auto flex-1 custom-scrollbar">
                <div>
                    <label class="block text-sm font-medium text-zinc-400 mb-2">Full Name *</label>
                    <input type="text" @bind="_clientModel.FullName" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-white focus:border-purple-500 focus:outline-none" placeholder="Jane Doe" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-zinc-400 mb-2">Email Address</label>
                    <input type="email" @bind="_clientModel.Email" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-white focus:border-purple-500 focus:outline-none" placeholder="jane@example.com" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-zinc-400 mb-2">Phone Number</label>
                    <input type="text" @bind="_clientModel.PhoneNumber" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-white focus:border-purple-500 focus:outline-none" placeholder="+1 (555) 000-0000" />
                </div>
            </div>
            <div class="px-6 py-4 border-t border-zinc-800 flex gap-3 bg-zinc-900 shrink-0">
                <button @onclick="CloseModals" class="flex-1 py-2.5 rounded-lg text-sm font-medium text-zinc-400 bg-zinc-800/50 hover:bg-zinc-800 hover:text-white transition-all">Cancel</button>
                <button @onclick="SaveClient" class="flex-1 py-2.5 rounded-lg text-sm font-bold text-white bg-fuchsia-600 hover:bg-fuchsia-500 shadow-lg shadow-fuchsia-900/20 transition-all">Save Client</button>
            </div>
        </div>
    </div>
}

<!-- Business Form Modal -->
@if (_showBusinessForm && _activeClientForBusiness != null)
{
    <div class="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-50 p-4">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-lg shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
            <div class="px-6 py-4 border-b border-zinc-800 flex items-center justify-between bg-zinc-900 shrink-0">
                <h3 class="text-lg font-bold text-white tracking-wide">@(_editingBusiness ? "Edit Business" : "Add Business")</h3>
                <button @onclick="CloseModals" class="text-zinc-500 hover:text-white transition-colors">
                    <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>
            <div class="p-6 space-y-5 overflow-y-auto flex-1 custom-scrollbar">
                <div class="bg-purple-900/10 border border-purple-500/20 rounded-lg p-3 text-sm text-purple-300">
                    Client: <span class="font-bold text-white">@_activeClientForBusiness.FullName</span>
                </div>
                <div>
                    <label class="block text-sm font-medium text-zinc-400 mb-2">Business Name *</label>
                    <input type="text" @bind="_businessModel.Name" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-white focus:border-fuchsia-500 focus:outline-none" placeholder="e.g. Acme Corporation" />
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-zinc-400 mb-2">Type of Business *</label>
                        <select @bind="_businessModel.BusinessType" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-white focus:border-fuchsia-500 focus:outline-none text-sm">
                            <option value="Sole Proprietorship">Sole Proprietorship</option>
                            <option value="Partnership">Partnership</option>
                            <option value="Corporation">Corporation</option>
                            <option value="OPC (One Person Corporation)">OPC (One Person Corporation)</option>
                            <option value="Cooperative">Cooperative</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-zinc-400 mb-2">TIN ID</label>
                        <input type="text" @bind="_businessModel.TinId" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-white font-mono placeholder:font-sans focus:border-fuchsia-500 focus:outline-none text-sm" placeholder="000-123-456-000" />
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-zinc-400 mb-2">Address</label>
                    <textarea @bind="_businessModel.Address" rows="2" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-white focus:border-fuchsia-500 focus:outline-none text-sm" placeholder="123 Business St..."></textarea>
                </div>
                <div>
                    <label class="block text-sm font-medium text-zinc-400 mb-2">Business Phone Number</label>
                    <input type="text" @bind="_businessModel.PhoneNumber" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-white focus:border-fuchsia-500 focus:outline-none text-sm" placeholder="+1 (555) 123-4567" />
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-zinc-400 mb-2">Tax Classification *</label>
                    <div class="grid grid-cols-2 gap-3">
                        <button type="button" @onclick="() => _businessModel.IsVatRegistered = true"
                                class="p-3 rounded-xl border text-left transition-all cursor-pointer @(_businessModel.IsVatRegistered ? "bg-fuchsia-500/10 border-fuchsia-500 text-white shadow-md shadow-fuchsia-950/40" : "bg-zinc-950 border-zinc-800 text-zinc-400 hover:text-white hover:border-zinc-700")">
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-xs font-bold uppercase tracking-wider text-fuchsia-400">VAT Registered</span>
                                <span class="size-2 rounded-full @(_businessModel.IsVatRegistered ? "bg-fuchsia-400 ring-4 ring-fuchsia-400/20" : "bg-zinc-700")"></span>
                            </div>
                            <p class="text-[11px] text-zinc-400">Standard 12% Output/Input VAT</p>
                        </button>
                        <button type="button" @onclick="() => _businessModel.IsVatRegistered = false"
                                class="p-3 rounded-xl border text-left transition-all cursor-pointer @(!_businessModel.IsVatRegistered ? "bg-zinc-800 border-zinc-600 text-white shadow-md" : "bg-zinc-950 border-zinc-800 text-zinc-400 hover:text-white hover:border-zinc-700")">
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-xs font-bold uppercase tracking-wider text-zinc-300">Non-VAT</span>
                                <span class="size-2 rounded-full @(!_businessModel.IsVatRegistered ? "bg-zinc-300 ring-4 ring-zinc-300/20" : "bg-zinc-700")"></span>
                            </div>
                            <p class="text-[11px] text-zinc-400">Percentage Tax or Exempt</p>
                        </button>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-zinc-400 mb-2">Business Status</label>
                    <div class="grid grid-cols-2 gap-3">
                        <button type="button" @onclick="() => _businessModel.IsActive = true"
                                class="p-3 rounded-xl border text-left transition-all cursor-pointer @(_businessModel.IsActive ? "bg-emerald-500/10 border-emerald-500 text-white shadow-md shadow-emerald-950/40" : "bg-zinc-950 border-zinc-800 text-zinc-400 hover:text-white hover:border-zinc-700")">
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">Active</span>
                                <span class="size-2 rounded-full @(_businessModel.IsActive ? "bg-emerald-400 ring-4 ring-emerald-400/20" : "bg-zinc-700")"></span>
                            </div>
                            <p class="text-[11px] text-zinc-400">Operational & currently engaged</p>
                        </button>
                        <button type="button" @onclick="() => _businessModel.IsActive = false"
                                class="p-3 rounded-xl border text-left transition-all cursor-pointer @(!_businessModel.IsActive ? "bg-zinc-800 border-zinc-600 text-white shadow-md" : "bg-zinc-950 border-zinc-800 text-zinc-400 hover:text-white hover:border-zinc-700")">
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-xs font-bold uppercase tracking-wider text-zinc-300">Inactive</span>
                                <span class="size-2 rounded-full @(!_businessModel.IsActive ? "bg-zinc-300 ring-4 ring-zinc-300/20" : "bg-zinc-700")"></span>
                            </div>
                            <p class="text-[11px] text-zinc-400">Dormant or closed account</p>
                        </button>
                    </div>
                </div>
            </div>

            <div class="px-6 py-4 border-t border-zinc-800 flex gap-3 bg-zinc-900 shrink-0">
                <button @onclick="CloseModals" class="flex-1 py-2.5 rounded-lg text-sm font-medium text-zinc-400 bg-zinc-800/50 hover:bg-zinc-800 hover:text-white transition-all">Cancel</button>
                <button @onclick="SaveBusiness" class="flex-1 py-2.5 rounded-lg text-sm font-bold text-white bg-fuchsia-600 hover:bg-fuchsia-500 shadow-lg shadow-fuchsia-900/20 transition-all">Save Business</button>
            </div>
        </div>
    </div>
}

<!-- Archive Confirmation Modal -->
@if (_showArchiveConfirmation && _clientToArchive != null)
{
    <div class="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-[60] p-4">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-sm shadow-2xl overflow-hidden p-6 text-center">
            <div class="size-16 rounded-full bg-red-900/20 text-red-500 flex items-center justify-center mx-auto mb-4 border border-red-500/20">
                <svg class="size-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Archive Client?</h3>
            <p class="text-zinc-400 text-sm mb-8">Are you sure you want to archive <strong>@_clientToArchive.FullName</strong>? Their data will be hidden but preserved.</p>
            
            <div class="flex gap-3">
                <button @onclick="CloseModals" class="flex-1 py-2.5 rounded-lg text-sm font-medium text-zinc-400 bg-zinc-800/50 hover:bg-zinc-800 hover:text-white transition-all">Cancel</button>
                <button @onclick="ConfirmArchiveClient" class="flex-1 py-2.5 rounded-lg text-sm font-bold text-white bg-red-600 hover:bg-red-500 shadow-lg shadow-red-900/20 transition-all">Archive</button>
            </div>
        </div>
    </div>
}

<!-- Generic Delete Modal -->
@if (_showGenericDeleteModal)
{
    <div class="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-[60] p-4">
        <div class="bg-zinc-900 border border-red-900/50 rounded-2xl w-full max-w-sm shadow-2xl p-6 relative">
            <h3 class="text-lg font-bold text-white mb-2">@_genericDeleteTitle</h3>
            <p class="text-sm text-zinc-400 mb-6">@_genericDeleteText</p>
            <div class="flex justify-end gap-3">
                <button @onclick="() => _showGenericDeleteModal = false" class="px-4 py-2 text-sm font-bold text-white bg-zinc-800 rounded-lg hover:bg-zinc-700 transition-all">Cancel</button>
                <button @onclick="ConfirmGenericDelete" class="px-4 py-2 text-sm font-bold text-white bg-red-600 rounded-lg hover:bg-red-500 transition-all">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<ClientDto>? _clients;
    
    // UI State
    private bool _showClientForm = false;
    private bool _showBusinessForm = false;
    private bool _showArchiveConfirmation = false;
    private bool _editingClient = false;
    private bool _editingBusiness = false;
    
    private string _searchTerm = "";
    private int _page = 1;
    private int _pageSize = 25;

    // Models
    private ClientDto _clientModel = new();
    private BusinessDto _businessModel = new();
    private ClientDto? _activeClientForBusiness;
    private ClientDto? _clientToArchive;

    private bool _showGenericDeleteModal = false;
    private string _genericDeleteTitle = "";
    private string _genericDeleteText = "";
    private Func<Task>? _genericDeleteAction;

    private void PromptDeleteBusiness(ClientDto client, BusinessDto biz)
    {
        _genericDeleteTitle = "Delete Business";
        _genericDeleteText = $"Are you sure you want to remove the business \"{biz.Name}\" from {client.FullName}?";
        _genericDeleteAction = async () => await RemoveBusiness(client, biz);
        _showGenericDeleteModal = true;
    }

    private async Task ConfirmGenericDelete()
    {
        if (_genericDeleteAction != null) await _genericDeleteAction();
        _showGenericDeleteModal = false;
    }

    private bool _isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadClients();
    }

    private async Task LoadClients()
    {
        _isLoading = true;
        try
        {
            _clients = await Http.GetFromJsonAsync<List<ClientDto>>("/api/client");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private IEnumerable<ClientDto> FilteredClients
    {
        get
        {
            if (_clients == null) return Enumerable.Empty<ClientDto>();
            var query = _clients.Where(c => c.IsActive);
            
            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var search = _searchTerm.ToLower();
                query = query.Where(c => 
                    (c.FullName != null && c.FullName.ToLower().Contains(search)) ||
                    (c.Email != null && c.Email.ToLower().Contains(search)) ||
                    (c.Businesses != null && c.Businesses.Any(b => 
                        (b.Name != null && b.Name.ToLower().Contains(search)) ||
                        (b.TinId != null && b.TinId.ToLower().Contains(search)) ||
                        (b.BusinessType != null && b.BusinessType.ToLower().Contains(search))
                    ))
                );
            }
            return query;
        }
    }

    private void ResetPage()
    {
        _page = 1;
    }

    private void ShowAddClientModal()
    {
        _clientModel = new ClientDto();
        _editingClient = false;
        _showClientForm = true;
    }

    private void EditClient(ClientDto client)
    {
        _clientModel = new ClientDto
        {
            Id = client.Id,
            FullName = client.FullName,
            Email = client.Email,
            PhoneNumber = client.PhoneNumber,
            IsActive = client.IsActive,
            Businesses = client.Businesses?.Select(b => new BusinessDto 
            { 
                Id = b.Id, 
                Name = b.Name, 
                Address = b.Address, 
                PhoneNumber = b.PhoneNumber,
                TinId = b.TinId,
                BusinessType = b.BusinessType,
                IsVatRegistered = b.IsVatRegistered,
                IsActive = b.IsActive
            }).ToList() ?? new List<BusinessDto>()
        };
        _editingClient = true;
        _showClientForm = true;
    }

    private void ShowAddBusinessModal(ClientDto client)
    {
        _activeClientForBusiness = client;
        _businessModel = new BusinessDto { BusinessType = "Sole Proprietorship", IsActive = true };
        _editingBusiness = false;
        _showBusinessForm = true;
    }

    private void EditBusiness(ClientDto client, BusinessDto biz)
    {
        _activeClientForBusiness = client;
        _businessModel = new BusinessDto
        {
            Id = biz.Id,
            Name = biz.Name,
            Address = biz.Address,
            PhoneNumber = biz.PhoneNumber,
            TinId = biz.TinId,
            BusinessType = string.IsNullOrEmpty(biz.BusinessType) ? "Sole Proprietorship" : biz.BusinessType,
            IsVatRegistered = biz.IsVatRegistered,
            IsActive = biz.IsActive
        };
        _editingBusiness = true;
        _showBusinessForm = true;
    }

    private void CloseModals()
    {
        _showClientForm = false;
        _showBusinessForm = false;
        _showArchiveConfirmation = false;
        _activeClientForBusiness = null;
        _clientToArchive = null;
    }

    private async Task SaveClient()
    {
        if (string.IsNullOrWhiteSpace(_clientModel.FullName)) return;

        if (_editingClient)
        {
            var response = await Http.PutAsJsonAsync($"/api/client/{_clientModel.Id}", _clientModel);
            if (response.IsSuccessStatusCode)
            {
                await LoadClients();
                CloseModals();
                ToastService.ShowSuccess("Client updated successfully.");
            }
            else
            {
                ToastService.ShowError("Failed to update client.");
            }
        }
        else
        {
            var response = await Http.PostAsJsonAsync("/api/client", _clientModel);
            if (response.IsSuccessStatusCode)
            {
                await LoadClients();
                CloseModals();
                ToastService.ShowSuccess("Client created successfully.");
            }
            else
            {
                ToastService.ShowError("Failed to create client.");
            }
        }
    }

    private async Task SaveBusiness()
    {
        if (string.IsNullOrWhiteSpace(_businessModel.Name) || _activeClientForBusiness == null) return;

        // Since the API accepts updating a client to add a business, let's just push it through the client edit endpoint
        var clientUpdate = new ClientDto
        {
            Id = _activeClientForBusiness.Id,
            FullName = _activeClientForBusiness.FullName,
            Email = _activeClientForBusiness.Email,
            PhoneNumber = _activeClientForBusiness.PhoneNumber,
            IsActive = _activeClientForBusiness.IsActive,
            Businesses = _activeClientForBusiness.Businesses?.ToList() ?? new List<BusinessDto>()
        };
        
        if (_editingBusiness)
        {
            var existingBizIndex = clientUpdate.Businesses.FindIndex(b => b.Id == _businessModel.Id);
            if (existingBizIndex >= 0)
            {
                clientUpdate.Businesses[existingBizIndex] = _businessModel;
            }
        }
        else
        {
            clientUpdate.Businesses.Add(_businessModel);
        }
        
        var response = await Http.PutAsJsonAsync($"/api/client/{clientUpdate.Id}", clientUpdate);
        if (response.IsSuccessStatusCode)
        {
            await LoadClients();
            CloseModals();
            ToastService.ShowSuccess(_editingBusiness ? "Business updated successfully." : "Business added successfully.");
        }
        else
        {
            ToastService.ShowError(_editingBusiness ? "Failed to update business." : "Failed to add business.");
        }
    }

    private async Task RemoveBusiness(ClientDto client, BusinessDto bizToRemove)
    {
        var clientUpdate = new ClientDto
        {
            Id = client.Id,
            FullName = client.FullName,
            Email = client.Email,
            PhoneNumber = client.PhoneNumber,
            IsActive = client.IsActive,
            Businesses = client.Businesses?.Where(b => b.Id != bizToRemove.Id).ToList() ?? new List<BusinessDto>()
        };

        var response = await Http.PutAsJsonAsync($"/api/client/{client.Id}", clientUpdate);
        if (response.IsSuccessStatusCode)
        {
            await LoadClients();
            ToastService.ShowSuccess("Business removed.");
        }
        else
        {
            ToastService.ShowError("Failed to remove business.");
        }
    }

    private void ShowArchiveConfirmation(ClientDto client)
    {
        _clientToArchive = client;
        _showArchiveConfirmation = true;
    }

    private async Task ConfirmArchiveClient()
    {
        if (_clientToArchive == null) return;
        
        var response = await Http.DeleteAsync($"/api/client/{_clientToArchive.Id}");
        if (response.IsSuccessStatusCode)
        {
            await LoadClients();
            CloseModals();
            ToastService.ShowSuccess("Client archived.");
        }
        else
        {
            ToastService.ShowError("Failed to archive client.");
        }
    }

    // DTOs
    public class ClientDto
    {
        public Guid Id { get; set; }
        public string FullName { get; set; } = string.Empty;
        public string? Email { get; set; }
        public string? PhoneNumber { get; set; }
        public DateTime DateAdded { get; set; }
        public bool IsActive { get; set; } = true;
        public List<BusinessDto> Businesses { get; set; } = new();
    }

    public class BusinessDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Address { get; set; }
        public string? PhoneNumber { get; set; }
        public string? TinId { get; set; }
        public string? BusinessType { get; set; }
        public bool IsVatRegistered { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
