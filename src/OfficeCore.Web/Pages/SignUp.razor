@page "/register"
@layout EmptyLayout
@inject HttpClient Http
@inject CookieAuthStateProvider AuthProvider
@inject NavigationManager Nav

<PageTitle>Create Account - OfficeCore</PageTitle>

<div class="min-h-screen bg-zinc-950 flex items-center justify-center p-4 sm:p-6 relative overflow-hidden">
    <!-- Floating Theme Toggle -->
    <div class="absolute top-4 right-4 z-20">
        <ThemeToggle />
    </div>

    <!-- Ambient Subtle Glows -->
    <div class="absolute -top-40 -left-40 size-96 rounded-full bg-fuchsia-600/10 blur-[130px] pointer-events-none"></div>
    <div class="absolute -bottom-40 -right-40 size-96 rounded-full bg-violet-600/10 blur-[130px] pointer-events-none"></div>

    <div class="w-full max-w-lg relative z-10 my-6">
        <!-- Logo / brand -->
        <div class="text-center mb-6">
            <div class="relative inline-flex items-center justify-center mb-3">
                <div class="absolute -inset-2 rounded-2xl bg-gradient-to-r from-fuchsia-600 to-violet-600 opacity-30 blur-md"></div>
                <div class="relative size-13 rounded-2xl bg-zinc-900 border border-zinc-800 flex items-center justify-center text-white font-bold text-xl shadow-xl">
                    <span class="bg-gradient-to-br from-fuchsia-400 to-violet-400 bg-clip-text text-transparent">OC</span>
                </div>
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Create your account</h1>
            <p class="mt-1 text-zinc-400 text-xs sm:text-sm">Get started with your intelligent company operating system</p>
        </div>

        <!-- Card -->
        <div class="glass-card rounded-2xl p-6 sm:p-8 shadow-2xl shadow-black/80 border border-zinc-800/80">
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="mb-5 flex items-start gap-3 rounded-xl bg-red-950/60 border border-red-800/80 px-4 py-3 text-xs sm:text-sm text-red-300 animate-in fade-in">
                    <svg class="size-4 shrink-0 text-red-400 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                    </svg>
                    <span>@_errorMessage</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(_infoMessage))
            {
                <div class="mb-5 flex items-start gap-3 rounded-xl bg-emerald-950/60 border border-emerald-800/80 px-4 py-3 text-xs sm:text-sm text-emerald-300 animate-in fade-in">
                    <svg class="size-4 shrink-0 text-emerald-400 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>@_infoMessage</span>
                </div>
            }

            <EditForm Model="_model" OnValidSubmit="HandleRegister" FormName="register">
                <DataAnnotationsValidator />

                <div class="space-y-4">
                    <!-- Name row -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        <div>
                            <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1">First name</label>
                            <InputText @bind-Value="_model.FirstName" type="text"
                                       class="block w-full rounded-xl bg-zinc-900/70 border border-zinc-800 px-3.5 py-2.5 text-white text-sm
                                              placeholder:text-zinc-600 focus:outline-none focus:border-fuchsia-500/80 focus:ring-2 focus:ring-fuchsia-500/20 transition-all"
                                       placeholder="Jane" autocomplete="given-name" />
                            <ValidationMessage For="() => _model.FirstName" class="mt-1 text-xs text-red-400" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1">Last name</label>
                            <InputText @bind-Value="_model.LastName" type="text"
                                       class="block w-full rounded-xl bg-zinc-900/70 border border-zinc-800 px-3.5 py-2.5 text-white text-sm
                                              placeholder:text-zinc-600 focus:outline-none focus:border-fuchsia-500/80 focus:ring-2 focus:ring-fuchsia-500/20 transition-all"
                                       placeholder="Smith" autocomplete="family-name" />
                            <ValidationMessage For="() => _model.LastName" class="mt-1 text-xs text-red-400" />
                        </div>
                    </div>

                    <!-- Email & OTP Section -->
                    <div class="rounded-xl border border-zinc-800/80 bg-zinc-900/40 p-3.5 space-y-3">
                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider">Email address</label>
                                @if (_isEmailVerified)
                                {
                                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-400">
                                        <svg class="size-3.5" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                        </svg>
                                        Verified
                                    </span>
                                }
                            </div>
                            <div class="flex gap-2">
                                <div class="relative flex-1">
                                    <InputText @bind-Value="_model.Email" type="email" disabled="@_isEmailVerified"
                                               class="block w-full rounded-xl bg-zinc-900/70 border border-zinc-800 px-3.5 py-2.5 text-white text-sm
                                                      placeholder:text-zinc-600 focus:outline-none focus:border-fuchsia-500/80 focus:ring-2 focus:ring-fuchsia-500/20 transition-all disabled:opacity-75 disabled:cursor-not-allowed"
                                               placeholder="jane@company.com" autocomplete="email" />
                                </div>
                                <button type="button" @onclick="SendOtpCode" disabled="@(_isSendingOtp || _isEmailVerified || string.IsNullOrWhiteSpace(_model.Email))"
                                        class="shrink-0 px-3.5 py-2.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-xs font-semibold text-white transition-all disabled:opacity-50 disabled:cursor-not-allowed border border-zinc-700/60 cursor-pointer">
                                    @if (_isSendingOtp)
                                    {
                                        <span class="flex items-center gap-1.5">
                                            <svg class="animate-spin size-3.5" viewBox="0 0 24 24" fill="none">
                                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                                            </svg>
                                            Sending...
                                        </span>
                                    }
                                    else if (_otpSent)
                                    {
                                        <span>Resend Code</span>
                                    }
                                    else
                                    {
                                        <span>Send Code</span>
                                    }
                                </button>
                            </div>
                            <ValidationMessage For="() => _model.Email" class="mt-1 text-xs text-red-400" />
                        </div>

                        @if (_otpSent && !_isEmailVerified)
                        {
                            <div class="pt-2 border-t border-zinc-800/80 space-y-2 animate-in fade-in">
                                <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider">6-Digit Verification Code</label>
                                <div class="flex gap-2">
                                    <InputText @bind-Value="_model.OtpCode" maxlength="6"
                                               class="block w-full rounded-xl bg-zinc-900/90 border border-fuchsia-500/50 px-3.5 py-2 text-white text-sm tracking-widest font-mono text-center
                                                      placeholder:text-zinc-600 focus:outline-none focus:border-fuchsia-500 focus:ring-2 focus:ring-fuchsia-500/20 transition-all"
                                               placeholder="000000" />
                                    <button type="button" @onclick="VerifyOtpCode" disabled="@(_isVerifyingOtp || string.IsNullOrWhiteSpace(_model.OtpCode))"
                                            class="shrink-0 px-4 py-2 rounded-xl bg-fuchsia-600 hover:bg-fuchsia-500 text-xs font-semibold text-white transition-all disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer shadow-sm">
                                        @if (_isVerifyingOtp)
                                        {
                                            <span>Verifying...</span>
                                        }
                                        else
                                        {
                                            <span>Verify</span>
                                        }
                                    </button>
                                </div>
                                @if (!string.IsNullOrEmpty(_debugOtp))
                                {
                                    <div class="flex items-center justify-between text-[11px] text-zinc-400 bg-zinc-900/90 p-2 rounded-lg border border-zinc-800">
                                        <span>💡 Simulation OTP: <strong class="text-fuchsia-400 font-mono">@_debugOtp</strong></span>
                                        <button type="button" @onclick="() => _model.OtpCode = _debugOtp" class="text-fuchsia-400 hover:underline font-semibold cursor-pointer">Auto-fill</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Mobile Number (Standard Profile Field) -->
                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1">Mobile number</label>
                        <InputText @bind-Value="_model.PhoneNumber" type="tel"
                                   class="block w-full rounded-xl bg-zinc-900/70 border border-zinc-800 px-3.5 py-2.5 text-white text-sm
                                          placeholder:text-zinc-600 focus:outline-none focus:border-fuchsia-500/80 focus:ring-2 focus:ring-fuchsia-500/20 transition-all"
                                   placeholder="0917 123 4567 or +63..." autocomplete="tel" />
                        <ValidationMessage For="() => _model.PhoneNumber" class="mt-1 text-xs text-red-400" />
                    </div>

                    <!-- Password and Confirm Password inputs -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        <div>
                            <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1">Password</label>
                            <div class="relative">
                                <InputText @bind-Value="_model.Password" type="@(_showPassword ? "text" : "password")"
                                           class="block w-full rounded-xl bg-zinc-900/70 border border-zinc-800 pl-3.5 pr-9 py-2.5 text-white text-sm
                                                  placeholder:text-zinc-600 focus:outline-none focus:border-fuchsia-500/80 focus:ring-2 focus:ring-fuchsia-500/20 transition-all"
                                           placeholder="Min. 8 chars" autocomplete="new-password" />
                                <button type="button" @onclick="() => _showPassword = !_showPassword" class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-zinc-500 hover:text-zinc-300 transition-colors">
                                    @if (_showPassword)
                                    {
                                        <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" /></svg>
                                    }
                                    else
                                    {
                                        <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                    }
                                </button>
                            </div>
                            <ValidationMessage For="() => _model.Password" class="mt-1 text-xs text-red-400" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1">Confirm password</label>
                            <InputText @bind-Value="_model.ConfirmPassword" type="@(_showPassword ? "text" : "password")"
                                       class="block w-full rounded-xl bg-zinc-900/70 border border-zinc-800 px-3.5 py-2.5 text-white text-sm
                                              placeholder:text-zinc-600 focus:outline-none focus:border-fuchsia-500/80 focus:ring-2 focus:ring-fuchsia-500/20 transition-all"
                                       placeholder="Repeat password" autocomplete="new-password" />
                            <ValidationMessage For="() => _model.ConfirmPassword" class="mt-1 text-xs text-red-400" />
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <div class="pt-2">
                        <button type="submit" disabled="@_isLoading"
                                class="w-full rounded-xl bg-fuchsia-600 py-2.5 px-4 text-xs sm:text-sm font-semibold text-white
                                       hover:bg-fuchsia-500 active:scale-[0.98] transition-all disabled:opacity-50 disabled:cursor-not-allowed shadow-lg shadow-fuchsia-950/40 cursor-pointer">
                            @if (_isLoading)
                            {
                                <span class="flex items-center justify-center gap-2">
                                    <svg class="animate-spin size-4" viewBox="0 0 24 24" fill="none">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                                    </svg>
                                    <span>Creating account...</span>
                                </span>
                            }
                            else
                            {
                                <span>Create Account</span>
                            }
                        </button>
                    </div>

                    <div class="relative flex items-center py-1">
                        <div class="flex-grow border-t border-zinc-800"></div>
                        <span class="flex-shrink-0 mx-3 text-zinc-500 text-xs">or continue with</span>
                        <div class="flex-grow border-t border-zinc-800"></div>
                    </div>

                    <a href="/api/auth/google-login"
                       class="w-full rounded-xl bg-white text-black py-2.5 px-4 text-xs sm:text-sm font-semibold 
                              hover:bg-zinc-100 active:scale-[0.98] transition-all flex items-center justify-center gap-2 shadow-sm">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                        </svg>
                        <span>Google</span>
                    </a>
                </div>
            </EditForm>
        </div>

        <p class="mt-5 text-center text-xs sm:text-sm text-zinc-400">
            Already have an account? <a href="/login" class="text-fuchsia-400 hover:text-fuchsia-300 font-medium transition-colors">Sign in</a>
        </p>
    </div>
</div>

@code {
    private RegisterModel _model = new();
    private string? _errorMessage;
    private string? _infoMessage;
    private bool _isLoading;
    private bool _showPassword;
    private bool _isSendingOtp;
    private bool _isVerifyingOtp;
    private bool _otpSent;
    private bool _isEmailVerified;
    private string? _debugOtp;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            Nav.NavigateTo("/workspaces", forceLoad: true);
        }
    }

    private async Task SendOtpCode()
    {
        _errorMessage = null;
        _infoMessage = null;

        if (string.IsNullOrWhiteSpace(_model.Email) || !_model.Email.Contains('@'))
        {
            _errorMessage = "Please enter a valid email address before requesting a verification code.";
            return;
        }

        _isSendingOtp = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/auth/send-otp", new { email = _model.Email });
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<OtpResponse>();
                _otpSent = true;
                _debugOtp = result?.DebugCode;
                _infoMessage = result?.Message ?? "Verification code has been dispatched. Enter the 6-digit code below.";
            }
            else
            {
                var err = await response.Content.ReadFromJsonAsync<ApiErrorResponse>();
                _errorMessage = err?.Message ?? "Unable to send verification code.";
            }
        }
        catch
        {
            _errorMessage = "Network error. Could not request verification code.";
        }
        finally
        {
            _isSendingOtp = false;
        }
    }

    private async Task VerifyOtpCode()
    {
        _errorMessage = null;
        _infoMessage = null;

        if (string.IsNullOrWhiteSpace(_model.OtpCode) || _model.OtpCode.Trim().Length != 6)
        {
            _errorMessage = "Please enter the 6-digit verification code.";
            return;
        }

        _isVerifyingOtp = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/auth/verify-otp", new 
            { 
                email = _model.Email,
                code = _model.OtpCode 
            });

            if (response.IsSuccessStatusCode)
            {
                _isEmailVerified = true;
                _infoMessage = "Email address verified successfully!";
            }
            else
            {
                var err = await response.Content.ReadFromJsonAsync<ApiErrorResponse>();
                _errorMessage = err?.Message ?? "Invalid or expired verification code.";
            }
        }
        catch
        {
            _errorMessage = "Error validating code. Please try again.";
        }
        finally
        {
            _isVerifyingOtp = false;
        }
    }

    private async Task HandleRegister()
    {
        _isLoading = true;
        _errorMessage = null;
        _infoMessage = null;

        if (_model.Password != _model.ConfirmPassword)
        {
            _errorMessage = "Passwords do not match. Please verify your confirmation password.";
            _isLoading = false;
            return;
        }

        if (!_isEmailVerified)
        {
            _errorMessage = "Please verify your email address using the 6-digit verification code before creating your account.";
            _isLoading = false;
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("/api/auth/register", new
            {
                email = _model.Email,
                password = _model.Password,
                firstName = _model.FirstName,
                lastName = _model.LastName,
                phoneNumber = _model.PhoneNumber,
                otpCode = _model.OtpCode
            });

            if (response.IsSuccessStatusCode)
            {
                AuthProvider.NotifyAuthStateChanged();
                Nav.NavigateTo("/workspaces", forceLoad: true);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _errorMessage = "Registration failed. " + error;
            }
        }
        catch
        {
            _errorMessage = "Unable to connect to the server. Please try again later.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private class OtpResponse
    {
        public string? Message { get; set; }
        public string? DebugCode { get; set; }
        public string? Email { get; set; }
    }

    private class ApiErrorResponse
    {
        public string? Message { get; set; }
    }

    private class RegisterModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "First name is required")]
        public string FirstName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Last name is required")]
        public string LastName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Invalid email format")]
        public string Email { get; set; } = string.Empty;

        public string? PhoneNumber { get; set; }

        public string OtpCode { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required")]
        [System.ComponentModel.DataAnnotations.MinLength(8, ErrorMessage = "Password must be at least 8 characters")]
        public string Password { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please confirm your password")]
        [System.ComponentModel.DataAnnotations.Compare(nameof(Password), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
