@page "/time-off"
@attribute [Authorize(Policy = "RequireTimeOff")]
@inject HttpClient Http
@inject OfficeCore.Web.Services.ToastService ToastService

<PageTitle>Time Off & Holidays - OfficeCore</PageTitle>

<div class="space-y-6 h-full flex flex-col">
    <div class="flex items-center justify-between shrink-0">
        <div>
            <h1 class="text-3xl font-bold tracking-tight text-white">Time Off & Holidays</h1>
            <p class="mt-1 text-zinc-400 text-sm">Configure company holidays and time-off policies</p>
        </div>
        <div>
            <button @onclick="RefreshAll" disabled="@_isLoadingAll" class="p-2 text-zinc-400 hover:text-white bg-zinc-900 border border-zinc-800 rounded-lg transition-colors cursor-pointer" title="Refresh">
                <svg class="size-4 @(_isLoadingAll ? "animate-spin text-fuchsia-400" : "")" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
            </button>
        </div>
    </div>

    <!-- Top Tabs Header -->
    @{
        var policiesClass = _activeTab == "Policies" ? "border-fuchsia-500 text-fuchsia-400" : "border-transparent text-zinc-400 hover:text-zinc-300 hover:border-zinc-700";
        var holidaysClass = _activeTab == "Holidays" ? "border-fuchsia-500 text-fuchsia-400" : "border-transparent text-zinc-400 hover:text-zinc-300 hover:border-zinc-700";
    }
    <div class="border-b border-zinc-800 flex gap-6 shrink-0">
        <button class="pb-3 text-sm font-medium border-b-2 transition-colors @policiesClass" 
                @onclick='() => SetActiveTab("Policies")'>
            Time Off Policies
        </button>
        <button class="pb-3 text-sm font-medium border-b-2 transition-colors @holidaysClass" 
                @onclick='() => SetActiveTab("Holidays")'>
            Holidays
        </button>
    </div>

    <div class="flex flex-1 bg-zinc-950 border border-zinc-800 rounded-2xl overflow-hidden">

    @if (_activeTab == "Policies")
    {
        <div class="flex-1 p-6 flex flex-col h-full overflow-hidden">
            <div class="flex items-center justify-between pb-6 border-b border-zinc-800 shrink-0">
                <div>
                    <h2 class="text-lg font-semibold text-white">Leave &amp; Time Off Policies</h2>
                    <p class="text-xs text-zinc-400">Define employee leave types, standard yearly allowances, and paid leave settings.</p>
                </div>
                <AuthorizeView Policy="Permission:time-off.manage">
                    <button @onclick="OpenCreatePolicyModal" class="px-3.5 py-2 bg-fuchsia-600 hover:bg-fuchsia-500 text-white rounded-xl text-xs font-semibold flex items-center gap-1.5 transition-colors shadow-lg shadow-fuchsia-600/20">
                        <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                        New Policy
                    </button>
                </AuthorizeView>
            </div>

            @if (_isLoadingPolicies)
            {
                <div class="flex-1 flex items-center justify-center">
                    <p class="text-sm text-zinc-500">Loading policies...</p>
                </div>
            }
            else if (_policies.Count == 0)
            {
                <div class="flex-1 flex flex-col items-center justify-center p-8">
                    <AuthorizeView Policy="Permission:time-off.manage">
                        <Authorized>
                            <EmptyState Card="false"
                                        Title="No Leave Policies Defined"
                                        Description="Create your company's standard leave rules (e.g. 15-day Vacation Leave, 10-day Sick Leave)."
                                        ActionText="Add First Policy"
                                        OnAction="OpenCreatePolicyModal">
                                <Icon>
                                    <svg class="size-10 text-zinc-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                    </svg>
                                </Icon>
                            </EmptyState>
                        </Authorized>
                        <NotAuthorized>
                            <EmptyState Card="false"
                                        Title="No Leave Policies Defined"
                                        Description="No leave policies have been configured yet.">
                                <Icon>
                                    <svg class="size-10 text-zinc-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                    </svg>
                                </Icon>
                            </EmptyState>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 pt-6 overflow-y-auto">
                    @foreach (var policy in _policies)
                    {
                        <div class="bg-zinc-900/60 border border-zinc-800 rounded-2xl p-5 hover:border-zinc-700 transition-all flex flex-col justify-between group">
                            <div>
                                <div class="flex items-start justify-between mb-3">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold @(policy.LeaveType == 0 ? "bg-amber-500/10 text-amber-400 border border-amber-500/20" : "bg-sky-500/10 text-sky-400 border border-sky-500/20")">
                                        <span class="size-1.5 rounded-full @(policy.LeaveType == 0 ? "bg-amber-400" : "bg-sky-400")"></span>
                                        @(policy.LeaveType == 0 ? "Sick Leave" : "Vacation Leave")
                                    </span>
                                    <span class="text-xs font-medium @(policy.IsPaid ? "text-emerald-400" : "text-zinc-500")">
                                        @(policy.IsPaid ? "Paid" : "Unpaid")
                                    </span>
                                </div>
                                <h4 class="text-base font-bold text-white mb-1">@policy.Name</h4>
                                <div class="flex items-baseline gap-1.5 my-3">
                                    <span class="text-3xl font-extrabold text-white">@policy.DefaultDaysPerYear.ToString("G29")</span>
                                    <span class="text-xs text-zinc-400 font-medium">days / year</span>
                                </div>
                                <div class="space-y-1 text-xs text-zinc-400">
                                    <p class="flex items-center gap-1.5">
                                        <span class="@(policy.RequiresAttachment ? "text-amber-400" : "text-zinc-600")">●</span>
                                        @(policy.RequiresAttachment ? "Medical certificate required" : "No certificate required")
                                    </p>
                                </div>
                            </div>

                            <AuthorizeView Policy="Permission:time-off.manage">
                                <div class="pt-4 mt-4 border-t border-zinc-800/80 flex items-center justify-end gap-2">
                                    <button @onclick="() => EditPolicy(policy)" class="p-1.5 text-zinc-400 hover:text-white hover:bg-zinc-800 rounded-lg transition-colors text-xs font-medium">
                                        Edit
                                    </button>
                                    <button @onclick="() => DeletePolicy(policy.Id)" class="p-1.5 text-red-400 hover:text-red-300 hover:bg-red-950/30 rounded-lg transition-colors text-xs font-medium">
                                        Delete
                                    </button>
                                </div>
                            </AuthorizeView>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (_activeTab == "Holidays")
    {
        <div class="flex flex-1 overflow-hidden">
            <!-- Sidebar for Calendars -->
            <div class="w-72 border-r border-zinc-800 bg-zinc-900/50 flex flex-col">
                <div class="p-4 border-b border-zinc-800">
                    <div class="relative mb-4">
                        <svg class="absolute left-3 top-1/2 -translate-y-1/2 size-4 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        <input type="text" @bind="_calendarSearch" @bind:event="oninput" placeholder="Search calendars" class="w-full bg-zinc-900 border border-zinc-800 rounded-lg pl-9 pr-3 py-1.5 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none" />
                    </div>
                    
                    <AuthorizeView Policy="Permission:time-off.manage">
                        <button @onclick="CreateNewCalendar" class="flex items-center gap-2 text-fuchsia-400 text-sm font-medium hover:text-fuchsia-300 transition-colors w-full">
                            <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                            Add new calendar
                        </button>
                    </AuthorizeView>
                </div>
                
                <div class="flex-1 overflow-y-auto p-4 space-y-2">
                    @if (_calendars == null)
                    {
                        <div class="text-sm text-zinc-500">Loading...</div>
                    }
                    else if (!FilteredCalendars.Any())
                    {
                        <div class="text-sm text-zinc-500">@(string.IsNullOrWhiteSpace(_calendarSearch) ? "No calendars added yet." : "No matching calendars.")</div>
                    }
                    else
                    {
                        foreach (var cal in FilteredCalendars)
                        {
                            var calClass = _selectedCalendar?.Id == cal.Id ? "bg-fuchsia-950/20 text-white" : "hover:bg-zinc-900 text-zinc-300";
                            <button @onclick="() => SelectCalendar(cal)" class="w-full text-left px-3 py-3 rounded-lg transition-colors flex flex-col gap-1 @calClass">
                                <span class="text-sm font-medium">@cal.Name</span>
                                @if (cal.IsDefault)
                                {
                                    <span class="text-[10px] font-bold text-fuchsia-400 uppercase tracking-wider">Default</span>
                                }
                            </button>
                        }
                    }
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="flex-1 bg-zinc-950 overflow-y-auto p-8 relative">
                @if (_isCreating)
                {
                    <div class="max-w-3xl mx-auto bg-zinc-900 border border-zinc-800 rounded-2xl p-8 shadow-xl">
                        <div class="space-y-8">
                            <div class="flex items-center justify-between border-b border-zinc-800 pb-4">
                                <h2 class="text-xl font-bold text-white uppercase tracking-wider">Calendar Editor</h2>
                                <div class="flex gap-3">
                                    <button @onclick="CancelEdit" class="px-4 py-2 text-sm font-medium text-zinc-400 hover:text-white transition-colors">Cancel</button>
                                    <button @onclick="SaveCalendar" class="px-4 py-2 text-sm font-bold text-white bg-fuchsia-600 rounded-lg hover:bg-fuchsia-500 transition-colors shadow-lg shadow-fuchsia-900/30">Save Changes</button>
                                </div>
                            </div>

                            <div class="space-y-6">
                                <!-- Calendar Name -->
                                <div class="flex gap-8 items-center">
                                    <label class="w-40 text-sm font-medium text-zinc-400">Calendar name</label>
                                    <input type="text" @bind="_editModel.Name" class="flex-1 bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none" placeholder="Calendar name" />
                                </div>

                                <!-- Make Default -->
                                <div class="flex gap-8 items-center">
                                    <label class="w-40 text-sm font-medium text-zinc-400"></label>
                                    <label class="flex items-center gap-3 cursor-pointer">
                                        <input type="checkbox" @bind="_editModel.IsDefault" class="sr-only peer" />
                                        <div class="w-5 h-5 rounded border border-zinc-700 bg-zinc-900 peer-checked:bg-fuchsia-600 peer-checked:border-fuchsia-600 flex items-center justify-center text-white transition-colors">
                                            <svg class="size-3.5 opacity-0 peer-checked:opacity-100 transition-opacity" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                                        </div>
                                        <span class="text-sm text-zinc-300">Make default</span>
                                    </label>
                                </div>
                                <div class="flex gap-8 items-start">
                                    <div class="w-40"></div>
                                    <p class="text-xs text-zinc-500">Auto-assign this calendar to all users in the organization by default.</p>
                                </div>

                                <!-- Holidays Options -->
                                <div class="flex gap-8 items-start pt-4 border-t border-zinc-800">
                                    <label class="w-40 text-sm font-medium text-zinc-400 mt-2">Holidays</label>
                                    <div class="flex-1 space-y-4">
                                        <label class="flex items-center gap-3 cursor-pointer group">
                                            <input type="radio" name="importType" checked="@(_importMode == ImportMode.Import)" @onchange="() => SetImportMode(ImportMode.Import)" class="sr-only peer" />
                                            <div class="w-5 h-5 rounded-full border-2 border-zinc-600 peer-checked:border-fuchsia-500 flex items-center justify-center transition-colors">
                                                <div class="w-2.5 h-2.5 rounded-full bg-fuchsia-500 opacity-0 peer-checked:opacity-100 transition-opacity"></div>
                                            </div>
                                            <span class="text-sm font-medium text-zinc-300 group-hover:text-white transition-colors">Import from a calendar</span>
                                        </label>

                                        @if (_importMode == ImportMode.Import)
                                        {
                                            <div class="pl-8 flex gap-3">
                                                <select @bind="_selectedCountry" class="bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none w-64">
                                                    <option value="">Select country or region</option>
                                                    @foreach (var c in _countries)
                                                    {
                                                        <option value="@c.Id">@c.Name</option>
                                                    }
                                                </select>
                                                <select @bind="_selectedYear" class="bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none">
                                                    @for (int year = DateTime.Now.Year; year <= DateTime.Now.Year + 3; year++)
                                                    {
                                                        <option value="@year">@year</option>
                                                    }
                                                </select>
                                            </div>
                                        }

                                        <label class="flex items-center gap-3 cursor-pointer group mt-4">
                                            <input type="radio" name="importType" checked="@(_importMode == ImportMode.Manual)" @onchange="() => SetImportMode(ImportMode.Manual)" class="sr-only peer" />
                                            <div class="w-5 h-5 rounded-full border-2 border-zinc-600 peer-checked:border-fuchsia-500 flex items-center justify-center transition-colors">
                                                <div class="w-2.5 h-2.5 rounded-full bg-fuchsia-500 opacity-0 peer-checked:opacity-100 transition-opacity"></div>
                                            </div>
                                            <span class="text-sm font-medium text-zinc-300 group-hover:text-white transition-colors">Add manually</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (_selectedCalendar != null)
                {
                    <div class="max-w-4xl mx-auto space-y-6">
                        <!-- Header -->
                        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 shadow-md flex items-center justify-between">
                            <h2 class="text-2xl font-bold text-white flex items-center gap-3">
                                @_selectedCalendar.Name
                                @if (_selectedCalendar.IsDefault)
                                {
                                    <span class="text-[10px] font-bold text-fuchsia-400 bg-fuchsia-900/20 px-2 py-1 rounded uppercase tracking-wider">Default</span>
                                }
                            </h2>
                            <AuthorizeView Policy="Permission:time-off.manage">
                                <div class="flex gap-2">
                                    <button @onclick="PromptDeleteCalendar" class="p-2 text-zinc-500 hover:text-red-400 bg-zinc-950 hover:bg-zinc-800 rounded-lg transition-colors" title="Delete Calendar">
                                        <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                    </button>
                                    <button @onclick="() => _isEditing = !_isEditing" class="p-2 text-zinc-500 hover:text-fuchsia-400 bg-zinc-950 hover:bg-zinc-800 rounded-lg transition-colors" title="Edit Calendar Settings">
                                        <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.89 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.89l10.685-10.686z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 7.125L16.875 4.5" /></svg>
                                    </button>
                                </div>
                            </AuthorizeView>
                        </div>

                        <!-- Edit Settings Dropdown -->
                        @if (_isEditing)
                        {
                            <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 shadow-md flex items-center justify-between">
                                <div class="flex items-center gap-6">
                                    <input type="text" @bind="_selectedCalendar.Name" class="bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none w-64" />
                                    <label class="flex items-center gap-3 cursor-pointer">
                                        <input type="checkbox" @bind="_selectedCalendar.IsDefault" class="sr-only peer" />
                                        <div class="w-5 h-5 rounded border border-zinc-700 bg-zinc-900 peer-checked:bg-fuchsia-600 peer-checked:border-fuchsia-600 flex items-center justify-center text-white transition-colors">
                                            <svg class="size-3.5 opacity-0 peer-checked:opacity-100 transition-opacity" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                                        </div>
                                        <span class="text-sm text-zinc-300">Make default</span>
                                    </label>
                                </div>
                                <div class="flex gap-2">
                                    <button @onclick="() => _isEditing = false" class="px-4 py-2 text-sm font-medium text-zinc-400 hover:text-white transition-colors">Cancel</button>
                                    <button @onclick="UpdateCalendarSettings" class="px-4 py-2 text-sm font-medium text-white bg-fuchsia-600 rounded-lg hover:bg-fuchsia-500 transition-colors shadow-lg shadow-fuchsia-900/30">Save Changes</button>
                                </div>
                            </div>
                        }

                        <!-- Holidays List -->
                        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl shadow-xl overflow-hidden">
                            <div class="p-6 border-b border-zinc-800 flex items-center justify-between bg-zinc-900">
                                <div class="flex gap-2">
                                    @for (int y = DateTime.Now.Year; y <= DateTime.Now.Year + 2; y++)
                                    {
                                        int year = y;
                                        var btnClass = _selectedViewYear == year ? "bg-fuchsia-950/20 text-fuchsia-400 border border-fuchsia-900/50" : "text-zinc-500 hover:text-zinc-300 border border-transparent";
                                        <button class="px-4 py-1.5 rounded-md text-sm font-medium transition-colors @btnClass"
                                                @onclick="() => { _selectedViewYear = year; _holidayPage = 1; }">
                                            @year
                                        </button>
                                    }
                                </div>
                                
                                <AuthorizeView Policy="Permission:time-off.manage">
                                    <button @onclick="() => { _isAddingHoliday = true; _editingHoliday = false; _newHoliday = new HolidayDto { Date = DateTime.Now }; }" class="px-4 py-2 text-sm font-medium text-white bg-fuchsia-600 rounded-lg hover:bg-fuchsia-500 transition-colors shadow-lg shadow-fuchsia-900/30 flex items-center gap-2">
                                        <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                                        Add Holiday
                                    </button>
                                </AuthorizeView>
                            </div>

                            @if (_isAddingHoliday)
                            {
                                <div class="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-50 p-4">
                                    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-md shadow-2xl overflow-hidden">
                                        <div class="px-6 py-4 border-b border-zinc-800 flex items-center justify-between bg-zinc-900">
                                            <h3 class="text-lg font-bold text-white tracking-wide">@(_editingHoliday ? "Edit Holiday" : "Add Holiday")</h3>
                                        </div>
                                        <div class="p-6 space-y-4">
                                            <div>
                                                <label class="block text-xs font-semibold text-zinc-500 uppercase mb-2">Name</label>
                                                <input type="text" @bind="_newHoliday.Name" placeholder="Holiday name" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none" />
                                            </div>
                                            <div>
                                                <label class="block text-xs font-semibold text-zinc-500 uppercase mb-2">Date</label>
                                                <input type="date" @bind="_newHoliday.Date" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none" />
                                            </div>
                                        </div>
                                        <div class="px-6 py-4 border-t border-zinc-800 flex justify-end gap-3">
                                            <button @onclick="() => _isAddingHoliday = false" class="px-4 py-2 text-sm font-medium text-zinc-400 hover:text-white transition-colors">Cancel</button>
                                            <button @onclick="SaveNewHoliday" class="px-4 py-2 text-sm font-bold text-white bg-fuchsia-600 rounded-lg hover:bg-fuchsia-500 transition-colors shadow-lg shadow-fuchsia-900/30">Save</button>
                                        </div>
                                    </div>
                                </div>
                            }

                            @{
                                var holidaysToDisplay = _selectedCalendar.Holidays
                                    .Where(h => h.Date.Year == _selectedViewYear)
                                    .OrderBy(h => h.Date)
                                    .ToList();
                                var pagedHolidays = holidaysToDisplay
                                    .Skip((_holidayPage - 1) * _holidayPageSize)
                                    .Take(_holidayPageSize)
                                    .ToList();
                            }

                            @if (!holidaysToDisplay.Any() && !_isAddingHoliday)
                            {
                                <div class="py-16 flex flex-col items-center justify-center text-center">
                                    <div class="relative w-24 h-24 mb-4 opacity-50">
                                        <svg class="w-full h-full text-zinc-700" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                                        </svg>
                                    </div>
                                    <h3 class="text-lg font-bold text-white mb-2">No holidays</h3>
                                    <p class="text-sm text-zinc-500 max-w-sm mb-6">There are no holidays scheduled for this calendar in @_selectedViewYear. Remember to take some time off!</p>
                                    <button @onclick="() => { _isAddingHoliday = true; _editingHoliday = false; _newHoliday = new HolidayDto { Date = new DateTime(_selectedViewYear, 1, 1) }; }" class="px-5 py-2 text-sm font-medium text-white bg-fuchsia-600 rounded-lg hover:bg-fuchsia-500 transition-colors shadow-lg shadow-fuchsia-900/30">
                                        Add Holiday
                                    </button>
                                </div>
                            }
                            else if (holidaysToDisplay.Any())
                            {
                                <table class="w-full text-left text-sm whitespace-nowrap">
                                    <thead class="bg-zinc-950/50 text-zinc-500 uppercase tracking-wider text-xs font-semibold">
                                        <tr>
                                            <th class="px-6 py-4 border-b border-zinc-800">Holiday Name</th>
                                            <th class="px-6 py-4 border-b border-zinc-800">Date</th>
                                            <th class="px-6 py-4 border-b border-zinc-800">Day</th>
                                            <th class="px-6 py-4 border-b border-zinc-800 w-32 text-right"></th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-zinc-800/50">
                                        @foreach (var h in pagedHolidays)
                                        {
                                            <tr class="hover:bg-zinc-800/50 transition-colors group">
                                                <td class="px-6 py-4 text-white font-medium">@h.Name</td>
                                                <td class="px-6 py-4 text-zinc-300">@h.Date.ToString("MMM dd, yyyy")</td>
                                                <td class="px-6 py-4 text-zinc-500">@h.Date.ToString("dddd")</td>
                                                <td class="px-6 py-4 text-right">
                                                    <AuthorizeView Policy="Permission:time-off.manage">
                                                        <button @onclick="() => PromptDeleteHoliday(h)" class="text-xs font-medium text-zinc-500 hover:text-red-400">Delete</button>
                                                    </AuthorizeView>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <PaginationToolbar @bind-Page="_holidayPage" @bind-PageSize="_holidayPageSize" TotalCount="holidaysToDisplay.Count" />
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="absolute inset-0 flex flex-col items-center justify-center p-8">
                        <AuthorizeView Policy="Permission:time-off.manage">
                            <Authorized>
                                <EmptyState Card="false"
                                            Title="No calendar selected"
                                            Description="Select a calendar from the sidebar or create a new one to manage company holidays."
                                            ActionText="Add New Calendar"
                                            OnAction="CreateNewCalendar">
                                    <Icon>
                                        <svg class="size-10 text-zinc-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                                        </svg>
                                    </Icon>
                                </EmptyState>
                            </Authorized>
                            <NotAuthorized>
                                <EmptyState Card="false"
                                            Title="No calendar selected"
                                            Description="Select a calendar from the sidebar to view company holidays.">
                                    <Icon>
                                        <svg class="size-10 text-zinc-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                                        </svg>
                                    </Icon>
                                </EmptyState>
                            </NotAuthorized>
                        </AuthorizeView>
                    </div>
                }
            </div>
        </div>
    }
    </div>
</div>

<!-- Generic Delete Modal -->
@if (_showGenericDeleteModal)
{
    <div class="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-[60] p-4">
        <div class="bg-zinc-900 border border-red-900/50 rounded-2xl w-full max-w-sm shadow-2xl p-6 relative">
            <h3 class="text-lg font-bold text-white mb-2">@_genericDeleteTitle</h3>
            <p class="text-sm text-zinc-400 mb-6">@_genericDeleteText</p>
            <div class="flex justify-end gap-3">
                <button @onclick="() => _showGenericDeleteModal = false" class="px-4 py-2 text-sm font-bold text-white bg-zinc-800 rounded-lg hover:bg-zinc-700 transition-all">Cancel</button>
                <button @onclick="ConfirmGenericDelete" class="px-4 py-2 text-sm font-bold text-white bg-red-600 rounded-lg hover:bg-red-500 transition-all">Delete</button>
            </div>
        </div>
    </div>
}

@if (_showPolicyModal)
{
    <div class="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-md p-6 shadow-2xl space-y-4">
            <div class="flex items-center justify-between border-b border-zinc-800 pb-3">
                <h3 class="text-base font-bold text-white">@(_editingPolicyId == null ? "Create Leave Policy" : "Edit Leave Policy")</h3>
                <button @onclick="() => _showPolicyModal = false" class="size-8 rounded-full hover:bg-zinc-800 text-zinc-400 hover:text-white flex items-center justify-center transition-colors cursor-pointer" title="Close">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>

            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-semibold text-zinc-400 mb-1">Policy Name</label>
                    <input type="text" @bind="_policyModel.Name" placeholder="e.g. Standard Vacation Leave" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 mb-1">Leave Type</label>
                        <select @bind="_policyModel.LeaveType" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none">
                            <option value="0">Sick Leave</option>
                            <option value="1">Vacation Leave</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 mb-1">Days Per Year</label>
                        <input type="number" step="0.5" @bind="_policyModel.DefaultDaysPerYear" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none" />
                    </div>
                </div>

                <div class="space-y-2 pt-2 border-t border-zinc-800">
                    <label class="flex items-center gap-2.5 cursor-pointer">
                        <input type="checkbox" @bind="_policyModel.IsPaid" class="rounded bg-zinc-950 border-zinc-800 text-fuchsia-600 focus:ring-fuchsia-500" />
                        <span class="text-xs text-zinc-300 font-medium">Paid Time Off (PTO)</span>
                    </label>
                    <label class="flex items-center gap-2.5 cursor-pointer">
                        <input type="checkbox" @bind="_policyModel.RequiresAttachment" class="rounded bg-zinc-950 border-zinc-800 text-fuchsia-600 focus:ring-fuchsia-500" />
                        <span class="text-xs text-zinc-300 font-medium">Require Document Attachment (e.g. Med Cert)</span>
                    </label>
                </div>
            </div>

            <div class="flex justify-end gap-2 pt-3 border-t border-zinc-800">
                <button @onclick="() => _showPolicyModal = false" class="px-4 py-2 text-xs font-medium text-zinc-400 hover:text-white bg-zinc-800 rounded-xl transition-colors">Cancel</button>
                <button @onclick="SavePolicy" class="px-4 py-2 text-xs font-bold text-white bg-fuchsia-600 hover:bg-fuchsia-500 rounded-xl transition-colors">Save Policy</button>
            </div>
        </div>
    </div>
}

@code {

    private bool _editingHoliday = false;
    private string _activeTab = "Policies"; // Default to Policies
    
    private void SetActiveTab(string tab) => _activeTab = tab;
    private void SetImportMode(ImportMode mode) => _importMode = mode;

    // Time Off Policies State
    private List<TimeOffPolicyDto> _policies = new();
    private bool _isLoadingPolicies = false;
    private bool _showPolicyModal = false;
    private Guid? _editingPolicyId = null;
    private TimeOffPolicyDto _policyModel = new();
    
    private List<HolidayCalendarDto>? _calendars;
    private HolidayCalendarDto? _selectedCalendar;
    private string _calendarSearch = string.Empty;

    private IEnumerable<HolidayCalendarDto> FilteredCalendars =>
        _calendars?.Where(c => string.IsNullOrWhiteSpace(_calendarSearch) ||
            c.Name.Contains(_calendarSearch.Trim(), StringComparison.OrdinalIgnoreCase))
        ?? Enumerable.Empty<HolidayCalendarDto>();
    
    private bool _isCreating = false;
    private bool _isEditing = false;
    private HolidayCalendarDto _editModel = new();
    
    // Import state
    private enum ImportMode { Import, Manual }
    private ImportMode _importMode = ImportMode.Import;
    private List<CountryDto> _countries = new();
    private string _selectedCountry = "";
    private int _selectedYear = DateTime.Now.Year;
    
    // View state
    private int _selectedViewYear = DateTime.Now.Year;
    private int _holidayPage = 1;
    private int _holidayPageSize = 25;
    private bool _isAddingHoliday = false;
    private HolidayDto _newHoliday = new() { Date = DateTime.Now };

    private bool _showGenericDeleteModal = false;
    private string _genericDeleteTitle = "";
    private string _genericDeleteText = "";
    private Func<Task>? _genericDeleteAction;

    private void PromptDeleteCalendar()
    {
        if (_selectedCalendar == null) return;
        _genericDeleteTitle = "Delete Calendar";
        _genericDeleteText = $"Are you sure you want to delete the calendar \"{_selectedCalendar.Name}\"?";
        _genericDeleteAction = async () => await DeleteCalendar();
        _showGenericDeleteModal = true;
    }

    private void PromptDeleteHoliday(HolidayDto holiday)
    {
        _genericDeleteTitle = "Delete Holiday";
        _genericDeleteText = $"Are you sure you want to delete \"{holiday.Name}\"?";
        _genericDeleteAction = async () => await DeleteHoliday(holiday);
        _showGenericDeleteModal = true;
    }

    private async Task ConfirmGenericDelete()
    {
        if (_genericDeleteAction != null) await _genericDeleteAction();
        _showGenericDeleteModal = false;
    }

    private bool _isLoadingAll = false;

    private async Task RefreshAll()
    {
        _isLoadingAll = true;
        try
        {
            await LoadPolicies();
            await LoadData();
        }
        finally
        {
            _isLoadingAll = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPolicies();
        await LoadData();
        _countries = await Http.GetFromJsonAsync<List<CountryDto>>("/api/holidaycalendar/import/countries") ?? new();
    }

    private async Task LoadData()
    {
        _calendars = await Http.GetFromJsonAsync<List<HolidayCalendarDto>>("/api/holidaycalendar");
    }

    private void CreateNewCalendar()
    {
        _selectedCalendar = null;
        _isCreating = true;
        _editModel = new HolidayCalendarDto { Name = "", IsDefault = false };
        _importMode = ImportMode.Import;
        _selectedCountry = "";
    }

    private void SelectCalendar(HolidayCalendarDto cal)
    {
        _selectedCalendar = cal;
        _isCreating = false;
        _isEditing = false;
        _isAddingHoliday = false;
        _holidayPage = 1;
    }

    private void CancelEdit()
    {
        _isCreating = false;
    }

    private async Task SaveCalendar()
    {
        if (string.IsNullOrWhiteSpace(_editModel.Name)) return;

        // Fetch imported holidays if selected
        if (_importMode == ImportMode.Import && !string.IsNullOrEmpty(_selectedCountry))
        {
            var imported = await Http.GetFromJsonAsync<List<HolidayDto>>($"/api/holidaycalendar/import/{_selectedCountry}?year={_selectedYear}");
            if (imported != null)
            {
                _editModel.Holidays.AddRange(imported);
            }
        }

        var response = await Http.PostAsJsonAsync("/api/holidaycalendar", _editModel);
        if (response.IsSuccessStatusCode)
        {
            await LoadData();
            _isCreating = false;
            // auto-select the newly created one
            var saved = await response.Content.ReadFromJsonAsync<HolidayCalendarDto>();
            if (saved != null)
            {
                _selectedCalendar = _calendars?.FirstOrDefault(c => c.Id == saved.Id);
            }
            ToastService.ShowSuccess("Calendar created successfully.");
        }
        else
        {
            ToastService.ShowError("Failed to create calendar.");
        }
    }

    private async Task UpdateCalendarSettings()
    {
        if (_selectedCalendar == null || string.IsNullOrWhiteSpace(_selectedCalendar.Name)) return;

        var response = await Http.PutAsJsonAsync($"/api/holidaycalendar/{_selectedCalendar.Id}", _selectedCalendar);
        if (response.IsSuccessStatusCode)
        {
            await LoadData();
            _isEditing = false;
            ToastService.ShowSuccess("Calendar settings updated.");
        }
        else
        {
            ToastService.ShowError("Failed to update calendar settings.");
        }
    }

    private async Task DeleteCalendar()
    {
        if (_selectedCalendar == null) return;
        var response = await Http.DeleteAsync($"/api/holidaycalendar/{_selectedCalendar.Id}");
        if (response.IsSuccessStatusCode)
        {
            _selectedCalendar = null;
            await LoadData();
            ToastService.ShowSuccess("Calendar deleted.");
        }
        else
        {
            ToastService.ShowError("Failed to delete calendar.");
        }
    }

    private async Task SaveNewHoliday()
    {
        if (_selectedCalendar == null || string.IsNullOrWhiteSpace(_newHoliday.Name)) return;

        _selectedCalendar.Holidays.Add(new HolidayDto 
        { 
            Name = _newHoliday.Name, 
            Date = _newHoliday.Date 
        });

        var response = await Http.PutAsJsonAsync($"/api/holidaycalendar/{_selectedCalendar.Id}", _selectedCalendar);
        if (response.IsSuccessStatusCode)
        {
            await LoadData();
            _selectedCalendar = _calendars?.FirstOrDefault(c => c.Id == _selectedCalendar.Id);
            _isAddingHoliday = false;
            _newHoliday = new HolidayDto { Date = new DateTime(_selectedViewYear, DateTime.Now.Month, DateTime.Now.Day) };
            ToastService.ShowSuccess("Holiday added successfully.");
        }
        else
        {
            ToastService.ShowError("Failed to add holiday.");
        }
    }

    private async Task DeleteHoliday(HolidayDto holiday)
    {
        if (_selectedCalendar == null) return;
        
        var itemToRemove = _selectedCalendar.Holidays.FirstOrDefault(h => h.Name == holiday.Name && h.Date == holiday.Date);
        if (itemToRemove != null)
        {
            _selectedCalendar.Holidays.Remove(itemToRemove);
            var response = await Http.PutAsJsonAsync($"/api/holidaycalendar/{_selectedCalendar.Id}", _selectedCalendar);
            if (response.IsSuccessStatusCode)
            {
                await LoadData();
                _selectedCalendar = _calendars?.FirstOrDefault(c => c.Id == _selectedCalendar.Id);
                ToastService.ShowSuccess("Holiday deleted.");
            }
            else
            {
                ToastService.ShowError("Failed to delete holiday.");
            }
        }
    }

    public class HolidayCalendarDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public bool IsDefault { get; set; }
        public List<HolidayDto> Holidays { get; set; } = new();
    }

    public class HolidayDto
    {
        public string Name { get; set; } = string.Empty;
        public DateTime Date { get; set; }
    }

    public class CountryDto
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
    }

    public class TimeOffPolicyDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public int LeaveType { get; set; }
        public decimal DefaultDaysPerYear { get; set; } = 15;
        public bool IsPaid { get; set; } = true;
        public bool RequiresAttachment { get; set; }
        public bool IsActive { get; set; } = true;
    }

    private async Task LoadPolicies()
    {
        _isLoadingPolicies = true;
        try
        {
            _policies = await Http.GetFromJsonAsync<List<TimeOffPolicyDto>>("/api/timeoffpolicies") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading policies: {ex.Message}");
        }
        finally
        {
            _isLoadingPolicies = false;
        }
    }

    private void OpenCreatePolicyModal()
    {
        _editingPolicyId = null;
        _policyModel = new TimeOffPolicyDto { Name = "", LeaveType = 1, DefaultDaysPerYear = 15, IsPaid = true };
        _showPolicyModal = true;
    }

    private void EditPolicy(TimeOffPolicyDto policy)
    {
        _editingPolicyId = policy.Id;
        _policyModel = new TimeOffPolicyDto
        {
            Id = policy.Id,
            Name = policy.Name,
            LeaveType = policy.LeaveType,
            DefaultDaysPerYear = policy.DefaultDaysPerYear,
            IsPaid = policy.IsPaid,
            RequiresAttachment = policy.RequiresAttachment
        };
        _showPolicyModal = true;
    }

    private async Task SavePolicy()
    {
        if (string.IsNullOrWhiteSpace(_policyModel.Name))
        {
            ToastService.ShowError("Please specify a policy name.");
            return;
        }

        try
        {
            if (_editingPolicyId == null)
            {
                var response = await Http.PostAsJsonAsync("/api/timeoffpolicies", _policyModel);
                if (response.IsSuccessStatusCode)
                {
                    ToastService.ShowSuccess("Policy created successfully.");
                }
            }
            else
            {
                var response = await Http.PutAsJsonAsync($"/api/timeoffpolicies/{_editingPolicyId}", _policyModel);
                if (response.IsSuccessStatusCode)
                {
                    ToastService.ShowSuccess("Policy updated successfully.");
                }
            }

            _showPolicyModal = false;
            await LoadPolicies();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving policy: {ex.Message}");
        }
    }

    private async Task DeletePolicy(Guid id)
    {
        try
        {
            var response = await Http.DeleteAsync($"/api/timeoffpolicies/{id}");
            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("Policy deleted.");
                await LoadPolicies();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error deleting policy: {ex.Message}");
        }
    }
}
