@page "/myleaves"
@attribute [Authorize]
@inject HttpClient Http
@inject OfficeCore.Web.Services.ToastService ToastService
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client
@using OfficeCore.Web.Client.Pages.Components
@using OfficeCore.Web.Services

<PageTitle>My Leaves - OfficeCore</PageTitle>

<div class="space-y-6">
    <PageHeader Title="My Leaves" Subtitle="Request and manage your sick and vacation leaves.">
        <Actions>
            <div class="flex items-center gap-3">
                <button @onclick="RefreshData" disabled="@_isLoading" class="p-2 text-zinc-400 hover:text-white bg-zinc-900 border border-zinc-800 rounded-lg transition-colors" title="Refresh">
                    <svg class="size-4 @(_isLoading ? "animate-spin text-fuchsia-400" : "")" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
                </button>
                <AppButton OnClick="() => _isCreating = true">
                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                Request Leave
                </AppButton>
            </div>
        </Actions>
    </PageHeader>

    @if (_isCreating)
    {
        <div class="fixed inset-0 bg-black/70 backdrop-blur-sm flex items-center justify-center z-50 p-4">
            <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-lg shadow-2xl flex flex-col max-h-[90vh] overflow-hidden">
                <div class="px-6 py-4 border-b border-zinc-800 flex items-center justify-between shrink-0">
                    <div>
                        <h3 class="text-lg font-bold text-white tracking-wide uppercase">Request Leave</h3>
                        <p class="text-xs text-zinc-500 mt-1">Submit a sick or vacation leave application for approval.</p>
                    </div>
                    <button type="button" @onclick="() => _isCreating = false" class="text-zinc-500 hover:text-white transition-colors self-start">
                        <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                    </button>
                </div>
                <EditForm Model="_newRequest" OnValidSubmit="SubmitRequest" class="flex flex-col overflow-hidden min-h-0">
                    <div class="p-6 space-y-5 overflow-y-auto flex-1 custom-scrollbar">
                        <div>
                            <label class="block text-sm font-medium text-zinc-400 mb-1">Leave Type</label>
                            <select @bind="_newRequest.Type" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none">
                                <option value="Vacation">Vacation Leave</option>
                                <option value="Sick">Sick Leave</option>
                            </select>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-zinc-400 mb-1">Start Date</label>
                                <input type="date" @bind="_newRequest.StartDate" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none cursor-pointer" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-zinc-400 mb-1">End Date</label>
                                <input type="date" @bind="_newRequest.EndDate" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none cursor-pointer" />
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-zinc-400 mb-1">Reason</label>
                            <textarea @bind="_newRequest.Reason" rows="3" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none placeholder-zinc-600" placeholder="Please provide details..."></textarea>
                        </div>
                        
                        @if (_newRequest.Type == "Sick")
                        {
                            <div>
                                <label class="block text-sm font-medium text-zinc-400 mb-1">Medical Certificate / Attachment (Image)</label>
                                <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-zinc-800 border-dashed rounded-xl bg-zinc-950 hover:bg-zinc-900/50 transition-colors">
                                    <div class="space-y-1 text-center">
                                        <svg class="mx-auto h-12 w-12 text-zinc-500" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                                            <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                        <div class="flex text-sm text-zinc-400 justify-center">
                                            <label class="relative cursor-pointer bg-transparent rounded-md font-medium text-fuchsia-400 hover:text-fuchsia-300 focus-within:outline-none">
                                                <span>Upload a file</span>
                                                <InputFile OnChange="HandleFileSelected" class="sr-only" accept="image/*" />
                                            </label>
                                            <p class="pl-1">or drag and drop</p>
                                        </div>
                                        <p class="text-xs text-zinc-500">PNG, JPG, GIF up to 10MB</p>
                                    </div>
                                </div>
                                @if (_selectedFile != null)
                                {
                                    <p class="mt-2 text-sm text-fuchsia-400">Selected file: @_selectedFile.Name</p>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(_modalError))
                        {
                            <div class="p-3 bg-red-950/50 border border-red-900/50 rounded-lg">
                                <p class="text-sm text-red-400">@_modalError</p>
                            </div>
                        }

                    </div>
                    <div class="px-6 py-4 border-t border-zinc-800 flex justify-end gap-3 shrink-0">
                        <button type="button" @onclick="() => _isCreating = false" class="px-5 py-2.5 text-sm font-medium text-zinc-400 hover:text-white transition-colors">Cancel</button>
                        <button type="submit" disabled="@_isSubmitting" class="px-5 py-2.5 text-sm font-medium text-white bg-fuchsia-600 rounded-lg hover:bg-fuchsia-500 transition-colors shadow-lg shadow-fuchsia-900/30 disabled:opacity-50">
                            @if (_isSubmitting)
                            {
                                <span class="flex items-center gap-2">
                                    <svg class="animate-spin size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                                    Submitting...
                                </span>
                            }
                            else
                            {
                                <span>Submit Request</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (_requests == null)
    {
        <div class="p-12 text-center text-zinc-500">
            <svg class="animate-spin size-8 mx-auto mb-4" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" /><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" /></svg>
            Loading requests...
        </div>
    }
    else if (!_requests.Any())
    {
        <AppCard>
            <EmptyState Title="No Leave Requests" Description="You haven't submitted any leave requests yet.">
                <Action>
                    <AppButton OnClick="() => _isCreating = true">Request Leave</AppButton>
                </Action>
            </EmptyState>
        </AppCard>
    }
    else
    {
        <div class="bg-zinc-950 border border-zinc-800 rounded-2xl overflow-hidden shadow-xl">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm whitespace-nowrap">
                    <thead class="bg-zinc-950/50 text-zinc-400 font-medium">
                        <tr>
                            <th class="px-6 py-4">Type</th>
                            <th class="px-6 py-4">Dates</th>
                            <th class="px-6 py-4">Reason</th>
                            <th class="px-6 py-4">Attachment</th>
                            <th class="px-6 py-4">Requested On</th>
                            <th class="px-6 py-4 text-right">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-800/50">
                        @foreach (var request in _requests)
                        {
                            <tr class="hover:bg-zinc-800/30 transition-colors">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-2">
                                        @if (request.Type == 0) // Sick
                                        {
                                            <span class="w-2 h-2 rounded-full bg-red-400"></span>
                                            <span class="text-white font-medium">Sick Leave</span>
                                        }
                                        else
                                        {
                                            <span class="w-2 h-2 rounded-full bg-blue-400"></span>
                                            <span class="text-white font-medium">Vacation Leave</span>
                                        }
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-zinc-300">
                                    @request.StartDate.ToString("MMM dd, yyyy") - @request.EndDate.ToString("MMM dd, yyyy")
                                </td>
                                <td class="px-6 py-4">
                                    <div class="max-w-xs truncate text-zinc-400" title="@request.Reason">
                                        @request.Reason
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    @if (!string.IsNullOrEmpty(request.AttachmentPath))
                                    {
                                        <button type="button" @onclick='() => OpenViewer(request.AttachmentPath, "Medical Certificate")' class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-zinc-800 hover:bg-zinc-700 text-fuchsia-400 hover:text-fuchsia-300 text-xs font-medium border border-zinc-700/60 transition-colors cursor-pointer">
                                            <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                            <span>View Photo</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-zinc-600 text-xs">—</span>
                                    }
                                </td>
                                <td class="px-6 py-4">
                                    <div class="text-zinc-300 font-medium text-xs">@request.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                    <div class="text-[11px] text-zinc-500">@request.CreatedAt.ToLocalTime().ToString("h:mm tt")</div>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    @if (request.Status == LeaveRequestStatus.Pending)
                                    {
                                        <div class="flex items-center justify-end gap-2">
                                            <AppBadge Variant="warning" Dot="true">Pending</AppBadge>
                                            <button @onclick="() => ShowCancelConfirmation(request.Id)" class="text-xs font-medium text-zinc-500 hover:text-red-400 transition-colors" title="Cancel Request">Cancel</button>
                                        </div>
                                    }
                                    else if (request.Status == LeaveRequestStatus.Approved)
                                    {
                                        <div class="flex flex-col items-end gap-1">
                                            <AppBadge Variant="success" Dot="true">Approved</AppBadge>
                                            @if (request.ActionTakenAt.HasValue)
                                            {
                                                <span class="text-[10px] text-zinc-500" title="Approved at">@request.ActionTakenAt.Value.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")</span>
                                            }
                                        </div>
                                    }
                                    else if (request.Status == LeaveRequestStatus.Rejected)
                                    {
                                        <div class="flex flex-col items-end gap-1">
                                            <AppBadge Variant="danger" Dot="true">Rejected</AppBadge>
                                            @if (request.ActionTakenAt.HasValue)
                                            {
                                                <span class="text-[10px] text-zinc-500" title="Rejected at">@request.ActionTakenAt.Value.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")</span>
                                            }
                                        </div>
                                    }
                                    else if (request.Status == LeaveRequestStatus.Cancelled)
                                    {
                                        <div class="flex flex-col items-end gap-1">
                                            <AppBadge Variant="default" Dot="true">Cancelled</AppBadge>
                                            @if (request.ActionTakenAt.HasValue)
                                            {
                                                <span class="text-[10px] text-zinc-500" title="Cancelled at">@request.ActionTakenAt.Value.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")</span>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (_showCancelModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm p-4">
        <div class="bg-zinc-950 border border-zinc-800 rounded-2xl w-full max-w-sm shadow-2xl p-6 relative">
            <h3 class="text-lg font-bold text-white mb-2">Cancel Request</h3>
            <p class="text-sm text-zinc-400 mb-6">Are you sure you want to cancel this leave request?</p>
            <div class="flex gap-3">
                <button @onclick="() => _showCancelModal = false" class="flex-1 py-2.5 rounded-lg text-sm font-medium text-zinc-400 bg-zinc-800/50 hover:bg-zinc-800 hover:text-white transition-all">Go Back</button>
                <button @onclick="ConfirmCancelRequest" class="flex-1 py-2.5 rounded-lg text-sm font-bold text-white bg-red-600 hover:bg-red-500 shadow-lg shadow-red-900/20 transition-all flex justify-center items-center">
                    @if (_isCancelling)
                    {
                        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                        <span>Cancelling...</span>
                    }
                    else
                    {
                        <span>Yes, Cancel</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<MediaViewerModal @bind-IsOpen="_isViewerOpen"
                  FileUrl="@_viewerUrl"
                  FileName="@_viewerFileName"
                  Title="@_viewerTitle" />

@code {
    private bool _isViewerOpen = false;
    private string _viewerUrl = "";
    private string _viewerFileName = "";
    private string _viewerTitle = "Medical Certificate";

    private void OpenViewer(string? path, string title)
    {
        if (string.IsNullOrWhiteSpace(path)) return;
        _viewerUrl = MediaUrlHelper.Resolve(path, Configuration);
        _viewerFileName = Path.GetFileName(path);
        _viewerTitle = title;
        _isViewerOpen = true;
    }

    private List<LeaveRequestDto>? _requests;
    private bool _isCreating = false;
    private bool _isSubmitting = false;
    private bool _isLoading = false;
    private string? _modalError;
    
    private CreateForm _newRequest = new() { StartDate = DateTime.Now, EndDate = DateTime.Now };
    private IBrowserFile? _selectedFile;

    // SignalR
    private HubConnection? _hubConnection;

    protected override async Task OnInitializedAsync()
    {
        await RefreshData();
        await ConnectToHub();
    }

    private async Task RefreshData()
    {
        if (_isLoading) return;
        _isLoading = true;
        try
        {
            await LoadRequests();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private bool _showCancelModal = false;
    private Guid? _requestToCancel;
    private bool _isCancelling = false;

    private void ShowCancelConfirmation(Guid id)
    {
        _requestToCancel = id;
        _showCancelModal = true;
    }

    private async Task ConfirmCancelRequest()
    {
        if (_requestToCancel == null) return;
        _isCancelling = true;

        try
        {
            var res = await Http.PutAsync($"/api/leaverequest/{_requestToCancel}/cancel", null);
            if (res.IsSuccessStatusCode)
            {
                _showCancelModal = false;
                ToastService.ShowSuccess("Leave request cancelled successfully.");
                await RefreshData();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                ToastService.ShowError(!string.IsNullOrWhiteSpace(err) ? err : "Failed to cancel request.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"An error occurred while cancelling: {ex.Message}");
        }
        finally
        {
            _isCancelling = false;
            _requestToCancel = null;
        }
    }

    private async Task ConnectToHub()
    {
        var hubUrl = new Uri(Http.BaseAddress!, "hubs/notifications").ToString();

        _hubConnection = new HubConnectionBuilder()
            .WithUrl(hubUrl)
            .WithAutomaticReconnect()
            .Build();

        // When the admin approves/rejects, update the personal leave list
        _hubConnection.On("LeaveRequestUpdated", async () =>
        {
            await LoadRequests();
            await InvokeAsync(StateHasChanged);
        });

        try { await _hubConnection.StartAsync(); } catch { /* Hub is optional; page works without it */ }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
            await _hubConnection.DisposeAsync();
    }

    private async Task LoadRequests()
    {
        _requests = await Http.GetFromJsonAsync<List<LeaveRequestDto>>("/api/leaverequest/my");
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
    }

    private async Task SubmitRequest()
    {
        if (string.IsNullOrWhiteSpace(_newRequest.Reason))
        {
            _modalError = "Please provide a reason for your leave.";
            return;
        }

        if (_newRequest.Type == "Sick" && _selectedFile == null)
        {
            _modalError = "A medical certificate or attachment is required for Sick Leave.";
            return;
        }

        _isSubmitting = true;
        _modalError = null;

        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(_newRequest.Type == "Sick" ? "0" : "1"), "Type");
            content.Add(new StringContent(_newRequest.StartDate.ToString("o")), "StartDate");
            content.Add(new StringContent(_newRequest.EndDate.ToString("o")), "EndDate");
            content.Add(new StringContent(_newRequest.Reason), "Reason");

            if (_newRequest.Type == "Sick" && _selectedFile != null)
            {
                var fileContent = new StreamContent(_selectedFile.OpenReadStream(maxAllowedSize: 10485760)); // 10MB max
                fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(_selectedFile.ContentType);
                content.Add(fileContent, "Attachment", _selectedFile.Name);
            }

            var response = await Http.PostAsync("/api/leaverequest", content);
            if (response.IsSuccessStatusCode)
            {
                await LoadRequests();
                _isCreating = false;
                _newRequest = new CreateForm { StartDate = DateTime.Now, EndDate = DateTime.Now };
                _selectedFile = null;
                ToastService.ShowSuccess("Leave request submitted successfully.");
            }
            else
            {
                ToastService.ShowError("Failed to submit request. Please try again.");
            }
        }
        catch (Exception)
        {
            ToastService.ShowError("An error occurred while submitting your request.");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private class CreateForm
    {
        public string Type { get; set; } = "Vacation";
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }
        public string Reason { get; set; } = string.Empty;
    }

    public enum LeaveRequestStatus
    {
        Pending = 0,
        Approved = 1,
        Rejected = 2,
        Cancelled = 3
    }

    private class LeaveRequestDto
    {
        public Guid Id { get; set; }
        public int Type { get; set; }
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }
        public string Reason { get; set; } = string.Empty;
        public string? AttachmentPath { get; set; }
        public LeaveRequestStatus Status { get; set; }
        public DateTime CreatedAt { get; set; }
        public DateTime? ActionTakenAt { get; set; }
    }
}
