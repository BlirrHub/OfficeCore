@page "/invoices"
@attribute [Authorize(Policy = "RequireInvoices")]

<PageTitle>Invoices - OfficeCore</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight text-white">Invoices</h1>
        <p class="mt-1 text-zinc-400 text-sm">Manage, generate, and send client invoices.</p>
    </div>
    <EmptyState Title="Invoicing Module In Development"
                Description="Client billing, recurring invoicing, and payment processing are coming in a future update.">
        <Icon>
            <svg class="size-10 text-zinc-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z" />
            </svg>
        </Icon>
    </EmptyState>
</div>
