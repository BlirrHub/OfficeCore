@page "/attendance"
@attribute [Authorize]
@using Microsoft.AspNetCore.SignalR.Client
@using System.Security.Claims
@implements IAsyncDisposable
@inject HttpClient Http
@inject NavigationManager Nav
@inject ToastService ToastService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Attendance - OfficeCore</PageTitle>

<div class="space-y-6">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold tracking-tight text-white">Attendance</h1>
            <p class="mt-1 text-zinc-400 text-sm">
                @if (_canManageAttendance)
                {
                    <span>Track personal work hours and manage company-wide biometric records.</span>
                }
                else
                {
                    <span>Log your daily hours, review shifts, and track your attendance record.</span>
                }
            </p>
        </div>

        @if (_canManageAttendance && _activeTab == "company")
        {
            <button @onclick="ShowCreateModal" class="self-start sm:self-auto px-4 py-2 text-sm font-bold text-white bg-fuchsia-600 rounded-lg hover:bg-fuchsia-500 shadow-lg shadow-fuchsia-900/30 transition-colors cursor-pointer">
                + Manual Entry
            </button>
        }
    </div>

    <!-- Role-Aware Tabs (Only visible to managers / admins with Attendance claim) -->
    @if (_canManageAttendance)
    {
        <div class="flex gap-4 border-b border-zinc-800">
            <button @onclick='() => _activeTab = "my"' class="@(_activeTab == "my" ? "text-fuchsia-400 border-b-2 border-fuchsia-500 font-bold" : "text-zinc-500 hover:text-zinc-300 font-medium") pb-2 px-2 text-sm transition-colors cursor-pointer flex items-center gap-2">
                <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
                My Attendance
            </button>
            <button @onclick='() => SwitchTab("company")' class="@(_activeTab == "company" ? "text-fuchsia-400 border-b-2 border-fuchsia-500 font-bold" : "text-zinc-500 hover:text-zinc-300 font-medium") pb-2 px-2 text-sm transition-colors cursor-pointer flex items-center gap-2">
                <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" /></svg>
                Company Records
            </button>
            <button @onclick='() => _activeTab = "import"' class="@(_activeTab == "import" ? "text-emerald-400 border-b-2 border-emerald-500 font-bold" : "text-zinc-500 hover:text-zinc-300 font-medium") pb-2 px-2 text-sm transition-colors cursor-pointer flex items-center gap-2">
                <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                <span>Biometric Import</span>
                <span class="px-1.5 py-0.5 rounded text-[9px] font-semibold bg-emerald-950/60 text-emerald-400 border border-emerald-800/40">ACBA</span>
            </button>
            <button @onclick='() => _activeTab = "settings"' class="@(_activeTab == "settings" ? "text-fuchsia-400 border-b-2 border-fuchsia-500 font-bold" : "text-zinc-500 hover:text-zinc-300 font-medium") pb-2 px-2 text-sm transition-colors cursor-pointer flex items-center gap-2">
                <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" /></svg>
                Device Settings
            </button>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- 1. PERSONAL ATTENDANCE HUB (Visible to ALL Employees)                     -->
    <!-- ========================================================================= -->
    @if (_activeTab == "my")
    {
        <!-- Hero Punch Card -->
        <div class="relative bg-zinc-900 border border-zinc-800 rounded-3xl p-6 sm:p-8 backdrop-blur-md overflow-hidden shadow-2xl">
            <!-- Background Accent Glow -->
            <div class="absolute -right-16 -top-16 size-64 bg-fuchsia-600/10 rounded-full blur-3xl pointer-events-none"></div>

            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10">
                <!-- Clock & Status Info -->
                <div class="space-y-3">
                    <div class="flex items-center gap-2 text-zinc-400 text-xs font-semibold uppercase tracking-widest">
                        <svg class="size-4 text-fuchsia-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        Workstation Time Clock
                    </div>
                    
                    <div>
                        <div class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight font-mono">
                            @_currentTime.ToString("hh:mm:ss") <span class="text-2xl text-zinc-400">@_currentTime.ToString("tt")</span>
                        </div>
                        <div class="text-zinc-400 text-sm mt-1 font-medium">
                            @_currentTime.ToString("dddd, MMMM dd, yyyy")
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center gap-3 pt-1">
                        @if (_myStatus?.IsClockedIn == true)
                        {
                            <span class="inline-flex items-center gap-2 rounded-full bg-emerald-950/70 border border-emerald-500/30 px-3.5 py-1 text-xs font-semibold text-emerald-400">
                                <span class="size-2 rounded-full bg-emerald-400 animate-pulse"></span>
                                CLOCKED IN since @(_myStatus.LastPunchTime?.ToLocalTime().ToString("hh:mm tt"))
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-2 rounded-full bg-zinc-950/70 border border-zinc-700/50 px-3.5 py-1 text-xs font-semibold text-zinc-400">
                                <span class="size-2 rounded-full bg-zinc-500"></span>
                                CLOCKED OUT @(_myStatus?.LastPunchTime.HasValue == true ? $"(Last: {_myStatus.LastPunchTime.Value.ToLocalTime():hh:mm tt})" : "")
                            </span>
                        }

                        <span class="inline-flex items-center gap-1.5 text-xs text-zinc-400 bg-zinc-950/60 border border-zinc-800 rounded-lg px-2.5 py-1">
                            <svg class="size-3.5 text-zinc-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 9v7.5" /></svg>
                            Shift: @(_myStatus?.ScheduledShiftText ?? "Flexible Schedule")
                        </span>
                    </div>
                </div>

                <!-- Punch Action Button -->
                <div class="flex flex-col items-start md:items-end justify-center">
                    @if (_myStatus?.IsClockedIn == true)
                    {
                        <button @onclick="Punch" disabled="@_isPunching" 
                                class="w-full md:w-auto px-8 py-4 rounded-2xl text-base font-bold text-white bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-500 hover:to-rose-500 shadow-xl shadow-red-950/40 transition-all flex items-center justify-center gap-3 disabled:opacity-50 cursor-pointer group">
                            @if (_isPunching)
                            {
                                <svg class="animate-spin size-5 text-white" viewBox="0 0 24 24" fill="none">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                                </svg>
                                <span>Recording Punch...</span>
                            }
                            else
                            {
                                <svg class="size-6 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" /></svg>
                                <div class="text-left">
                                    <div class="leading-tight">Clock Out</div>
                                    <div class="text-[11px] font-normal text-rose-200">End work session</div>
                                </div>
                            }
                        </button>
                    }
                    else
                    {
                        <button @onclick="Punch" disabled="@_isPunching" 
                                class="w-full md:w-auto px-8 py-4 rounded-2xl text-base font-bold text-white bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 shadow-xl shadow-emerald-950/40 transition-all flex items-center justify-center gap-3 disabled:opacity-50 cursor-pointer group">
                            @if (_isPunching)
                            {
                                <svg class="animate-spin size-5 text-white" viewBox="0 0 24 24" fill="none">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                                </svg>
                                <span>Recording Punch...</span>
                            }
                            else
                            {
                                <svg class="size-6 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" /></svg>
                                <div class="text-left">
                                    <div class="leading-tight">Clock In</div>
                                    <div class="text-[11px] font-normal text-emerald-200">Begin work session</div>
                                </div>
                            }
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- 4 Personal Metric Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-zinc-900/60 border border-zinc-800 rounded-2xl p-5 backdrop-blur-md">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-zinc-400">Hours Worked Today</span>
                    <span class="p-2 rounded-lg bg-fuchsia-600/10 text-fuchsia-400">
                        <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    </span>
                </div>
                <div class="mt-3 flex items-baseline gap-1">
                    <span class="text-2xl font-bold text-white">@(_myStatus?.TodayTotalHours.ToString("F2") ?? "0.00")</span>
                    <span class="text-xs text-zinc-500">hrs</span>
                </div>
                <div class="text-[11px] text-zinc-500 mt-1">Calculated from punch pairs</div>
            </div>

            <div class="bg-zinc-900/60 border border-zinc-800 rounded-2xl p-5 backdrop-blur-md">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-zinc-400">Scheduled Shift</span>
                    <span class="p-2 rounded-lg bg-blue-600/10 text-blue-400">
                        <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 9v7.5" /></svg>
                    </span>
                </div>
                <div class="mt-3 text-base font-bold text-white truncate" title="@(_myStatus?.ScheduledShiftText ?? "Flexible")">
                    @(_myStatus?.ScheduledShiftText ?? "Flexible")
                </div>
                <div class="text-[11px] text-zinc-500 mt-1">Assigned company schedule</div>
            </div>

            <div class="bg-zinc-900/60 border border-zinc-800 rounded-2xl p-5 backdrop-blur-md">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-zinc-400">Total Hours (Month)</span>
                    <span class="p-2 rounded-lg bg-emerald-600/10 text-emerald-400">
                        <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5" /></svg>
                    </span>
                </div>
                <div class="mt-3 flex items-baseline gap-1">
                    <span class="text-2xl font-bold text-white">@(_myStatus?.MonthTotalHours.ToString("F2") ?? "0.00")</span>
                    <span class="text-xs text-zinc-500">hrs</span>
                </div>
                <div class="text-[11px] text-zinc-500 mt-1">Current calendar month</div>
            </div>

            <div class="bg-zinc-900/60 border border-zinc-800 rounded-2xl p-5 backdrop-blur-md">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-zinc-400">Days Present (Month)</span>
                    <span class="p-2 rounded-lg bg-purple-600/10 text-purple-400">
                        <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    </span>
                </div>
                <div class="mt-3 flex items-baseline gap-1">
                    <span class="text-2xl font-bold text-white">@(_myStatus?.DaysPresent ?? 0)</span>
                    <span class="text-xs text-zinc-500">days</span>
                </div>
                <div class="text-[11px] text-zinc-500 mt-1">Attended work sessions</div>
            </div>
        </div>

        <!-- Personal Attendance Log Section -->
        <div class="space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <h2 class="text-lg font-bold text-white">My Attendance History</h2>
                <div class="flex flex-wrap items-center gap-2">
                    <input type="date" @bind="_myFilterStartDate" class="bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-1.5 text-xs text-white focus:border-fuchsia-500 focus:outline-none" />
                    <span class="text-zinc-600 text-xs">to</span>
                    <input type="date" @bind="_myFilterEndDate" class="bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-1.5 text-xs text-white focus:border-fuchsia-500 focus:outline-none" />
                    <button @onclick="ClearMyFilters" class="px-3 py-1.5 text-xs font-medium text-zinc-400 hover:text-white bg-zinc-800 rounded-lg transition-colors cursor-pointer">
                        Clear
                    </button>
                </div>
            </div>

            <div class="bg-zinc-950 border border-zinc-800 rounded-2xl overflow-hidden">
                @if (_isLoadingMy)
                {
                    <div class="p-12 flex justify-center">
                        <div class="flex items-center gap-3 text-zinc-500 text-sm">
                            <svg class="animate-spin size-5 text-fuchsia-500" viewBox="0 0 24 24" fill="none">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                            </svg>
                            Loading your attendance records...
                        </div>
                    </div>
                }
                else if (_myStatus?.Records == null || !_myStatus.Records.Any())
                {
                    <div class="p-12 text-center text-zinc-500 italic text-sm">
                        No attendance records recorded yet. Punch in above to create your first log!
                    </div>
                }
                else
                {
                    var filteredMy = GetFilteredMyRecords();
                    if (!filteredMy.Any())
                    {
                        <div class="p-12 text-center text-zinc-500 italic text-sm">No records match the selected date filter.</div>
                    }
                    else
                    {
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead>
                                    <tr class="border-b border-zinc-800 text-zinc-400 text-left">
                                        <th class="px-6 py-3.5 font-medium">Date & Time</th>
                                        <th class="px-6 py-3.5 font-medium">Event</th>
                                        <th class="px-6 py-3.5 font-medium">Source</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-zinc-800/50">
                                    @foreach (var record in filteredMy)
                                    {
                                        <tr class="hover:bg-zinc-900/50 transition-colors">
                                            <td class="px-6 py-3.5 text-zinc-300 font-mono text-xs">
                                                @record.Timestamp.ToLocalTime().ToString("MMM dd, yyyy — hh:mm:ss tt")
                                            </td>
                                            <td class="px-6 py-3.5">
                                                @if (record.Type == "ClockIn" || record.Type == "0")
                                                {
                                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-950/60 border border-emerald-500/30 px-2.5 py-0.5 text-xs font-medium text-emerald-400">
                                                        <span class="size-1.5 rounded-full bg-emerald-400"></span>
                                                        Clock In
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-orange-950/60 border border-orange-500/30 px-2.5 py-0.5 text-xs font-medium text-orange-400">
                                                        <span class="size-1.5 rounded-full bg-orange-400"></span>
                                                        Clock Out
                                                    </span>
                                                }
                                            </td>
                                            <td class="px-6 py-3.5 text-xs text-zinc-400">
                                                @if (record.Source == "Device" || record.Source == "0")
                                                {
                                                    <span class="inline-flex items-center gap-1 text-zinc-400">
                                                        <svg class="size-3.5 text-purple-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.864 4.243A7.5 7.5 0 0119.5 10.5c0 2.92-.556 5.709-1.568 8.268M5.742 6.364A7.465 7.465 0 004.5 10.5a7.464 7.464 0 01-1.15 3.993m1.989 3.559A11.209 11.209 0 008.25 10.5a3.75 3.75 0 117.5 0c0 .527-.021 1.049-.064 1.565M12 10.5a14.94 14.94 0 01-3.6 9.75m6.633-4.596a18.666 18.666 0 01-2.485 5.33" /></svg>
                                                        Fingerprint Scanner
                                                    </span>
                                                }
                                                else if (record.Source == "Web" || record.Source == "2")
                                                {
                                                    <span class="inline-flex items-center gap-1 text-zinc-400">
                                                        <svg class="size-3.5 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" /></svg>
                                                        Web Terminal
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-zinc-500">Manual Adjustment</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- 2. COMPANY RECORDS TAB (Management Self-Service — RequireAttendance)     -->
    <!-- ========================================================================= -->
    @if (_canManageAttendance && _activeTab == "company")
    {
        <!-- Filters -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-4 flex flex-wrap gap-4 items-end">
            <div class="flex-1 min-w-[200px]">
                <label class="block text-xs font-medium text-zinc-500 uppercase tracking-wider mb-1">Search Employee</label>
                <input type="text" @bind="_filterEmployee" @bind:event="oninput" placeholder="Search by name..." class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none" />
            </div>
            <div>
                <label class="block text-xs font-medium text-zinc-500 uppercase tracking-wider mb-1">Start Date</label>
                <input type="date" @bind="_filterStartDate" class="bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none" />
            </div>
            <div>
                <label class="block text-xs font-medium text-zinc-500 uppercase tracking-wider mb-1">End Date</label>
                <input type="date" @bind="_filterEndDate" class="bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none" />
            </div>
            <button @onclick="ClearCompanyFilters" class="px-4 py-2 text-sm font-medium text-zinc-400 hover:text-white bg-zinc-800 rounded-lg transition-colors cursor-pointer">
                Clear
            </button>
        </div>

        <div class="bg-zinc-950 border border-zinc-800 rounded-2xl overflow-hidden">
            @if (_isLoadingCompany)
            {
                <div class="p-12 flex justify-center">
                    <div class="flex items-center gap-3 text-zinc-500 text-sm">
                        <svg class="animate-spin size-5 text-fuchsia-500" viewBox="0 0 24 24" fill="none">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                        </svg>
                        Loading company records...
                    </div>
                </div>
            }
            else if (_records == null || !_records.Any())
            {
                <div class="p-12 text-center text-zinc-500 italic text-sm">No attendance records found across the workspace.</div>
            }
            else
            {
                var filteredRecords = GetFilteredCompanyRecords();
                if (!filteredRecords.Any())
                {
                    <div class="p-12 text-center text-zinc-500 italic text-sm">No records match the current filters.</div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="border-b border-zinc-800 text-zinc-400 text-left">
                                    <th class="px-6 py-4 font-medium">Employee Name</th>
                                    <th class="px-6 py-4 font-medium">Date & Time</th>
                                    <th class="px-6 py-4 font-medium">Type</th>
                                    <th class="px-6 py-4 font-medium">Source</th>
                                    <th class="px-6 py-4 font-medium text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-zinc-800/50">
                                @foreach (var record in filteredRecords)
                                {
                                    <tr class="hover:bg-zinc-900/50 transition-colors">
                                        <td class="px-6 py-4 text-white font-medium">@record.EmployeeName</td>
                                        <td class="px-6 py-4">
                                            <div class="flex flex-col">
                                                <span class="text-zinc-300 font-mono text-xs">@record.Timestamp.ToLocalTime().ToString("MMM dd, yyyy - hh:mm tt")</span>
                                                @if (record.Type == "ClockIn" && record.IncludeTimeTrackedBeforeScheduledStartTime && record.ScheduledStartTime.HasValue)
                                                {
                                                    var scheduledTime = record.Timestamp.ToLocalTime().Date.Add(record.ScheduledStartTime.Value);
                                                    if (record.Timestamp.ToLocalTime() < scheduledTime)
                                                    {
                                                        <span class="text-xs text-fuchsia-400 mt-0.5 font-medium">
                                                            Scheduled: @scheduledTime.ToString("hh:mm tt")
                                                        </span>
                                                    }
                                                }
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">
                                            @if (record.Type == "ClockIn" || record.Type == "0")
                                            {
                                                <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-950/60 border border-emerald-500/30 px-2.5 py-0.5 text-xs font-medium text-emerald-400">
                                                    Clock In
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center gap-1.5 rounded-full bg-orange-950/60 border border-orange-500/30 px-2.5 py-0.5 text-xs font-medium text-orange-400">
                                                    Clock Out
                                                </span>
                                            }
                                        </td>
                                        <td class="px-6 py-4 text-zinc-400 text-xs">@record.Source</td>
                                        <td class="px-6 py-4 text-right">
                                            <button @onclick="() => ShowDeleteModal(record)" class="text-xs font-medium px-2.5 py-1.5 bg-zinc-800/50 text-red-400 rounded hover:bg-red-900/30 hover:text-red-300 transition-colors border border-zinc-800 hover:border-red-900/50 cursor-pointer">
                                                Delete
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    }

    <!-- ========================================================================= -->
    <!-- 3. DEVICE SETTINGS TAB (Biometric Scanner & Fingerprint Enrollment)        -->
    <!-- ========================================================================= -->
    @if (_canManageAttendance && _activeTab == "settings")
    {
        <OfficeCore.Web.Client.Pages.Components.AttendanceSettings />
    }

    <!-- ========================================================================= -->
    <!-- 4. BIOMETRIC FILE IMPORT HUB (ACBA / Standalone Scanners)                 -->
    <!-- ========================================================================= -->
    @if (_canManageAttendance && _activeTab == "import")
    {
        <OfficeCore.Web.Client.Pages.Components.BiometricImportHub OnImportCompleted="HandleImportCompleted" />
    }
</div>

<!-- ========================================================================= -->
<!-- MODALS (Add Manual Entry & Delete Confirmation)                            -->
<!-- ========================================================================= -->

<!-- Create Manual Entry Modal -->
@if (_showCreateModal)
{
    <div class="fixed inset-0 z-[60] flex items-center justify-center bg-black/80 backdrop-blur-sm p-4">
        <div class="w-full max-w-md bg-zinc-900 border border-zinc-800 rounded-2xl shadow-2xl p-6">
            <h3 class="text-lg font-bold text-white mb-4">Add Manual Attendance Entry</h3>
            
            <div class="space-y-4 mb-6">
                <div>
                    <label class="block text-xs font-medium text-zinc-400 mb-1">Employee</label>
                    <select @bind="_create.EmployeeId" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none">
                        <option value="">-- Select Employee --</option>
                        @if (_employees != null)
                        {
                            @foreach (var emp in _employees)
                            {
                                <option value="@emp.Id">@emp.FirstName @emp.LastName</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-zinc-400 mb-1">Date & Time</label>
                    <input type="datetime-local" @bind="_create.Timestamp" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-zinc-400 mb-1">Type</label>
                    <select @bind="_create.Type" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none">
                        <option value="@AttendanceType.ClockIn">Clock In</option>
                        <option value="@AttendanceType.ClockOut">Clock Out</option>
                    </select>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_createError))
            {
                <p class="text-xs text-red-400 mb-4">@_createError</p>
            }

            <div class="flex gap-3">
                <button @onclick="() => _showCreateModal = false" class="flex-1 py-2.5 rounded-lg text-sm font-medium text-zinc-400 bg-zinc-800/50 hover:bg-zinc-800 hover:text-white transition-all cursor-pointer">Cancel</button>
                <button @onclick="ConfirmCreate" disabled="@_isCreating" class="flex-1 py-2.5 rounded-lg text-sm font-bold text-white bg-fuchsia-600 hover:bg-fuchsia-500 shadow-lg shadow-fuchsia-900/20 transition-all disabled:opacity-50 cursor-pointer">Save</button>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (_showDeleteModal && _recordToDelete != null)
{
    <div class="fixed inset-0 z-[60] flex items-center justify-center bg-black/80 backdrop-blur-sm p-4">
        <div class="w-full max-w-sm bg-zinc-900 border border-zinc-800 rounded-2xl shadow-2xl p-6">
            <h3 class="text-lg font-bold text-white mb-2">Delete Record</h3>
            <p class="text-sm text-zinc-400 mb-6">Are you sure you want to delete this attendance record for <span class="text-white font-medium">@_recordToDelete.EmployeeName</span>? This action cannot be undone.</p>
            
            @if (!string.IsNullOrEmpty(_deleteError))
            {
                <p class="text-xs text-red-400 mb-4">@_deleteError</p>
            }

            <div class="flex gap-3">
                <button @onclick="() => _showDeleteModal = false" class="flex-1 py-2.5 rounded-lg text-sm font-medium text-zinc-400 bg-zinc-800/50 hover:bg-zinc-800 hover:text-white transition-all cursor-pointer">Cancel</button>
                <button @onclick="ConfirmDelete" disabled="@_isDeleting" class="flex-1 py-2.5 rounded-lg text-sm font-bold text-white bg-red-600 hover:bg-red-500 shadow-lg shadow-red-900/20 transition-all disabled:opacity-50 cursor-pointer">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _canManageAttendance = false;
    private string _activeTab = "my";
    private HubConnection? _hubConnection;
    private DateTime _currentTime = DateTime.Now;
    private System.Threading.Timer? _clockTimer;

    // ESS State
    private bool _isLoadingMy = true;
    private bool _isPunching = false;
    private MyAttendanceResponse? _myStatus;
    private DateTime? _myFilterStartDate;
    private DateTime? _myFilterEndDate;

    // MSS Company State
    private bool _isLoadingCompany = false;
    private List<AttendanceRecordDto>? _records;
    private DateTime? _filterStartDate;
    private DateTime? _filterEndDate;
    private string _filterEmployee = "";

    // Create Manual Entry State
    private bool _showCreateModal = false;
    private bool _isCreating = false;
    private string? _createError;
    private AdminCreateAttendanceDto _create = new() { Timestamp = DateTime.Now };
    private List<EmployeeDto>? _employees;

    // Delete State
    private bool _showDeleteModal = false;
    private AttendanceRecordDto? _recordToDelete;
    private bool _isDeleting = false;
    private string? _deleteError;

    protected override async Task OnInitializedAsync()
    {
        // 1. Resolve Permissions
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _canManageAttendance = user.HasClaim("ModuleAccess", "Attendance") || user.IsInRole("Admin") || user.IsInRole("Owner");

        // 2. Start Live Clock
        _clockTimer = new System.Threading.Timer(_ =>
        {
            _currentTime = DateTime.Now;
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);

        // 3. Load Initial Personal Data
        await LoadMyAttendance();

        // 4. Connect SignalR
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(new Uri(Http.BaseAddress!, "attendanceHub"))
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On("ReceiveAttendanceUpdate", async () =>
        {
            await InvokeAsync(async () =>
            {
                if (_activeTab == "my")
                {
                    await LoadMyAttendance();
                }
                else if (_activeTab == "company")
                {
                    await LoadCompanyRecords();
                }
                StateHasChanged();
            });
        });

        _hubConnection.On<string>("ReceiveDeviceMessage", (message) =>
        {
            if (message.StartsWith("INFO:"))
            {
                ToastService.ShowWarning($"Scanner: {message.Substring(5).Trim()}");
            }
            else if (message.StartsWith("ERROR:"))
            {
                ToastService.ShowError($"Scanner Error: {message.Substring(6).Trim()}");
            }
            InvokeAsync(StateHasChanged);
        });

        try
        {
            await _hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR connection error: {ex.Message}");
        }
    }

    private async Task SwitchTab(string tab)
    {
        _activeTab = tab;
        if (tab == "company" && _records == null)
        {
            await LoadCompanyRecords();
        }
    }

    // =========================================================================
    // ESS METHODS
    // =========================================================================

    private async Task LoadMyAttendance()
    {
        _isLoadingMy = true;
        try
        {
            _myStatus = await Http.GetFromJsonAsync<MyAttendanceResponse>("/api/attendance/my");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading my attendance: {ex.Message}");
        }
        finally
        {
            _isLoadingMy = false;
        }
    }

    private async Task Punch()
    {
        if (_isPunching) return;
        _isPunching = true;

        try
        {
            var response = await Http.PostAsync("/api/attendance/punch", null);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PunchResult>();
                ToastService.ShowSuccess(result?.Message ?? "Punch recorded successfully.");
                await LoadMyAttendance();
            }
            else
            {
                ToastService.ShowError("Failed to record punch. Please try again.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error recording punch: {ex.Message}");
        }
        finally
        {
            _isPunching = false;
        }
    }

    private IEnumerable<MyAttendanceRecordDto> GetFilteredMyRecords()
    {
        if (_myStatus?.Records == null) return Array.Empty<MyAttendanceRecordDto>();
        var query = _myStatus.Records.AsEnumerable();

        if (_myFilterStartDate.HasValue)
            query = query.Where(r => r.Timestamp.Date >= _myFilterStartDate.Value.Date);

        if (_myFilterEndDate.HasValue)
            query = query.Where(r => r.Timestamp.Date <= _myFilterEndDate.Value.Date);

        return query;
    }

    private void ClearMyFilters()
    {
        _myFilterStartDate = null;
        _myFilterEndDate = null;
    }

    // =========================================================================
    // MSS COMPANY METHODS
    // =========================================================================

    private async Task LoadCompanyRecords()
    {
        _isLoadingCompany = true;
        try
        {
            _records = await Http.GetFromJsonAsync<List<AttendanceRecordDto>>("/api/attendance");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading company attendance: {ex.Message}");
            _records = new List<AttendanceRecordDto>();
        }
        finally
        {
            _isLoadingCompany = false;
        }
    }

    private IEnumerable<AttendanceRecordDto> GetFilteredCompanyRecords()
    {
        if (_records == null) return Array.Empty<AttendanceRecordDto>();
        var query = _records.AsEnumerable();

        if (_filterStartDate.HasValue)
            query = query.Where(r => r.Timestamp.Date >= _filterStartDate.Value.Date);

        if (_filterEndDate.HasValue)
            query = query.Where(r => r.Timestamp.Date <= _filterEndDate.Value.Date);

        if (!string.IsNullOrWhiteSpace(_filterEmployee))
            query = query.Where(r => r.EmployeeName.Contains(_filterEmployee, StringComparison.OrdinalIgnoreCase));

        return query;
    }

    private void ClearCompanyFilters()
    {
        _filterStartDate = null;
        _filterEndDate = null;
        _filterEmployee = "";
    }

    private async Task LoadEmployees()
    {
        if (_employees == null)
        {
            try
            {
                _employees = await Http.GetFromJsonAsync<List<EmployeeDto>>("/api/user");
                _employees = _employees?.Where(e => e.IsActive).ToList() ?? new List<EmployeeDto>();
            }
            catch { }
        }
    }

    private async Task ShowCreateModal()
    {
        await LoadEmployees();
        _createError = null;
        _create = new AdminCreateAttendanceDto { Timestamp = DateTime.Now };
        _showCreateModal = true;
    }

    private async Task HandleImportCompleted()
    {
        await LoadCompanyRecords();
        _activeTab = "company";
    }

    private async Task ConfirmCreate()
    {
        if (string.IsNullOrEmpty(_create.EmployeeId))
        {
            _createError = "Please select an employee.";
            return;
        }

        _isCreating = true;
        _createError = null;

        try
        {
            var response = await Http.PostAsJsonAsync("/api/attendance/admin-create", _create);
            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("Manual attendance entry created successfully.");
                _showCreateModal = false;
                await LoadCompanyRecords();
            }
            else
            {
                _createError = "Failed to create attendance record.";
            }
        }
        catch
        {
            _createError = "An unexpected error occurred.";
        }
        finally
        {
            _isCreating = false;
        }
    }

    private void ShowDeleteModal(AttendanceRecordDto record)
    {
        _recordToDelete = record;
        _deleteError = null;
        _showDeleteModal = true;
    }

    private async Task ConfirmDelete()
    {
        if (_recordToDelete == null) return;

        _isDeleting = true;
        _deleteError = null;

        try
        {
            var response = await Http.DeleteAsync($"/api/attendance/{_recordToDelete.Id}");
            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("Attendance record deleted.");
                _showDeleteModal = false;
                await LoadCompanyRecords();
            }
            else
            {
                _deleteError = "Failed to delete record.";
            }
        }
        catch
        {
            _deleteError = "An unexpected error occurred.";
        }
        finally
        {
            _isDeleting = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _clockTimer?.Dispose();
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    // =========================================================================
    // DTO DEFINITIONS
    // =========================================================================

    public class MyAttendanceResponse
    {
        public bool IsClockedIn { get; set; }
        public DateTimeOffset? LastPunchTime { get; set; }
        public double TodayTotalHours { get; set; }
        public string ScheduledShiftText { get; set; } = "Flexible Schedule";
        public TimeSpan? ScheduledStartTime { get; set; }
        public TimeSpan? ScheduledEndTime { get; set; }
        public int DaysPresent { get; set; }
        public double MonthTotalHours { get; set; }
        public List<MyAttendanceRecordDto> Records { get; set; } = new();
    }

    public class MyAttendanceRecordDto
    {
        public Guid Id { get; set; }
        public DateTimeOffset Timestamp { get; set; }
        public string Type { get; set; } = string.Empty;
        public string Source { get; set; } = string.Empty;
    }

    public class PunchResult
    {
        public string Message { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public DateTimeOffset Timestamp { get; set; }
    }

    public class AttendanceRecordDto
    {
        public Guid Id { get; set; }
        public string EmployeeName { get; set; } = string.Empty;
        public string EmployeeId { get; set; } = string.Empty;
        public DateTimeOffset Timestamp { get; set; }
        public string Type { get; set; } = string.Empty;
        public string Source { get; set; } = string.Empty;
        public bool IncludeTimeTrackedBeforeScheduledStartTime { get; set; }
        public TimeSpan? ScheduledStartTime { get; set; }
    }
    
    public class AdminCreateAttendanceDto
    {
        public string EmployeeId { get; set; } = string.Empty;
        public DateTime Timestamp { get; set; }
        public AttendanceType Type { get; set; }
    }

    public class EmployeeDto
    {
        public string Id { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public bool IsActive { get; set; }
    }

    public enum AttendanceType
    {
        ClockIn,
        ClockOut
    }
}
