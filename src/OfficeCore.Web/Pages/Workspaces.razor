@page "/workspaces"
@layout EmptyLayout
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Nav
@inject CookieAuthStateProvider AuthProvider
@inject ToastService ToastService
@inject IConfiguration Configuration

@inject IJSRuntime JS

<PageTitle>Your Workspaces - OfficeCore</PageTitle>

<div class="min-h-screen bg-zinc-950 text-white selection:bg-fuchsia-500 selection:text-white p-4 sm:p-6 md:p-8 relative overflow-hidden">
    <!-- Ambient Radial Glows -->
    <div class="absolute -top-40 -left-40 size-96 rounded-full bg-fuchsia-600/10 blur-[130px] pointer-events-none"></div>
    <div class="absolute -bottom-40 -right-40 size-96 rounded-full bg-violet-600/10 blur-[130px] pointer-events-none"></div>

    <div class="max-w-5xl mx-auto mt-8 sm:mt-12 relative z-10">
        
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-10 pb-6 border-b border-zinc-800/80">
            <div>
                <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-fuchsia-500/10 border border-fuchsia-500/20 text-fuchsia-400 text-xs font-medium mb-2">
                    <span class="size-1.5 rounded-full bg-fuchsia-400 animate-pulse"></span>
                    <span>Workspace Directory</span>
                </div>
                <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">Your Workspaces</h1>
                <p class="mt-1 text-zinc-400 text-xs sm:text-sm">Select an organization to enter, create a new one, or join with an invite code.</p>
            </div>
            
            <div class="flex items-center gap-2.5 sm:gap-3 flex-wrap sm:flex-nowrap">
                <button type="button" @onclick="OpenJoinModal" 
                        class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-600/15 hover:bg-emerald-600/25 border border-emerald-500/30 text-emerald-400 hover:text-emerald-300 text-xs font-semibold transition-all shadow-xs cursor-pointer">
                    <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zM4 19.235v-.11a6.375 6.375 0 0112.75 0v.109A12.318 12.318 0 0110.374 21c-2.331 0-4.512-.645-6.374-1.765z" />
                    </svg>
                    <span>Join with invite</span>
                </button>

                <ThemeToggle />

                @if (_user != null)
                {
                    <div class="flex items-center gap-3 px-3 py-1.5 rounded-xl bg-zinc-900/60 border border-zinc-800/80">
                        @if (!string.IsNullOrEmpty(_user.ProfilePictureUrl))
                        {
                            <img src="@($"{Configuration["ApiBaseUrl"]}{_user.ProfilePictureUrl}")" alt="@_user.FirstName" class="w-8 h-8 rounded-full object-cover border border-fuchsia-900/50" />
                        }
                        else
                        {
                            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-fuchsia-950 to-zinc-900 border border-fuchsia-500/30 flex items-center justify-center text-xs font-semibold text-fuchsia-400">
                                @GetInitials($"{_user.FirstName} {_user.LastName}")
                            </div>
                        }
                        <div class="hidden sm:block text-left">
                            <p class="text-xs font-semibold text-zinc-200">@_user.FirstName @_user.LastName</p>
                            <p class="text-[10px] text-zinc-500">@_user.Email</p>
                        </div>
                    </div>
                }
                <button @onclick="Logout" class="text-xs font-medium text-zinc-400 hover:text-white px-3 py-2 rounded-xl hover:bg-zinc-900 transition-colors">
                    Sign out
                </button>
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="flex justify-center items-center py-24">
                <div class="flex items-center gap-3 text-zinc-400 text-sm font-medium">
                    <svg class="animate-spin size-5 text-fuchsia-500" viewBox="0 0 24 24" fill="none">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                    </svg>
                    <span>Loading workspaces...</span>
                </div>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                <!-- Create New Workspace Card -->
                <div @onclick="OpenCreateModal" 
                     class="group relative bg-zinc-900/30 border border-zinc-800 border-dashed rounded-2xl p-6 hover:bg-zinc-900/60 hover:border-fuchsia-500/50 transition-all cursor-pointer flex flex-col items-center justify-center text-center h-48">
                    <div class="size-11 rounded-xl bg-zinc-800/80 group-hover:bg-fuchsia-600/20 group-hover:scale-105 flex items-center justify-center mb-3 transition-all">
                        <svg class="size-5 text-zinc-400 group-hover:text-fuchsia-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                        </svg>
                    </div>
                    <h3 class="text-sm font-semibold text-white mb-1">Create workspace</h3>
                    <p class="text-xs text-zinc-500">Set up a new organization</p>
                </div>


                <!-- Existing Workspaces -->
                @if (_organizations != null)
                {
                    @foreach (var org in _organizations)
                    {
                        <div @onclick="() => SelectOrganization(org.Id)" 
                             class="glass-card-interactive rounded-2xl p-6 cursor-pointer h-48 flex flex-col justify-between group">
                            <div class="flex items-start gap-4">
                                @if (!string.IsNullOrEmpty(org.LogoUrl))
                                {
                                    <img src="@($"{Configuration["ApiBaseUrl"]}{org.LogoUrl}")" alt="@org.Name" class="size-11 rounded-xl object-cover border border-zinc-800 shadow-md shrink-0" />
                                }
                                else
                                {
                                    <div class="size-11 rounded-xl bg-gradient-to-br from-fuchsia-600 to-violet-600 flex items-center justify-center text-white font-bold text-sm shadow-md shadow-fuchsia-900/30 shrink-0">
                                        @GetInitials(org.Name)
                                    </div>
                                }
                                <div class="min-w-0 flex-1">
                                    <h3 class="text-sm font-semibold text-white group-hover:text-fuchsia-300 transition-colors truncate">@org.Name</h3>
                                    <p class="text-xs text-zinc-500 mt-0.5">Joined @org.JoinedAt.ToString("MMM yyyy")</p>
                                </div>
                            </div>
                            
                            <div class="flex items-center justify-between pt-3 border-t border-zinc-800/60 text-xs">
                                <span class="text-zinc-500 font-medium">Workspace Active</span>
                                <span class="text-fuchsia-400 font-semibold flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
                                    <span>Enter</span>
                                    <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                    </svg>
                                </span>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Pending Invitations -->
            @if (_pendingInvitations != null && _pendingInvitations.Any())
            {
                <div class="mt-16">
                    <h2 class="text-xl font-semibold text-white mb-6 flex items-center gap-2">
                        <span>Pending Invitations</span>
                        <span class="px-2 py-0.5 rounded-full bg-fuchsia-500/20 text-fuchsia-400 text-xs">@_pendingInvitations.Count</span>
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        @foreach (var invite in _pendingInvitations)
                        {
                            <div class="bg-zinc-900/50 border border-fuchsia-500/30 rounded-2xl p-6 relative overflow-hidden flex flex-col">
                                <div class="absolute top-0 right-0 w-32 h-32 bg-fuchsia-500/10 blur-3xl rounded-full"></div>
                                <div class="flex items-center gap-4 mb-4">
                                    <div class="size-10 rounded-xl bg-gradient-to-br from-fuchsia-600 to-violet-600 flex items-center justify-center text-white font-bold text-lg shadow-lg">
                                        @GetInitials(invite.OrganizationName)
                                    </div>
                                    <div>
                                        <h3 class="text-lg font-semibold text-white">@invite.OrganizationName</h3>
                                        <p class="text-sm text-zinc-400">Invited by @invite.InvitedBy</p>
                                    </div>
                                </div>
                                <div class="mt-auto flex gap-3 pt-4 border-t border-white/5 relative z-10">
                                    <button @onclick="() => AcceptInvitation(invite.Token)" class="flex-1 py-2 px-4 rounded-xl bg-fuchsia-600 hover:bg-fuchsia-500 text-sm font-medium text-white transition-colors cursor-pointer">
                                        Accept
                                    </button>
                                    <button @onclick="() => DeclineInvitation(invite.Token)" class="flex-1 py-2 px-4 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-sm font-medium text-white transition-colors cursor-pointer">
                                        Decline
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Create Workspace Modal -->
@if (_isCreateModalOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm">
        <div class="bg-zinc-950 border border-zinc-800 rounded-2xl w-full max-w-md shadow-2xl p-6 relative">
            <button @onclick="CloseCreateModal" class="absolute top-4 right-4 p-2 text-zinc-400 hover:text-white rounded-full hover:bg-zinc-900 transition-colors">
                <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
            
            <h2 class="text-xl font-bold text-white mb-2">Create Workspace</h2>
            <p class="text-sm text-zinc-400 mb-6">Give your organization a name to get started.</p>

            <EditForm Model="_createModel" OnValidSubmit="HandleCreate">
                <DataAnnotationsValidator />
                
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-zinc-400 mb-1.5">Organization Name</label>
                        <InputText @bind-Value="_createModel.Name" 
                                   class="block w-full rounded-xl bg-zinc-900 border border-zinc-800 px-4 py-2.5 text-white text-sm focus:outline-none focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 transition-colors"
                                   placeholder="Acme Corp" />
                        <ValidationMessage For="() => _createModel.Name" class="mt-1 text-xs text-red-400" />
                    </div>
                    
                    <button type="submit" disabled="@_isCreating"
                            class="w-full rounded-xl bg-fuchsia-600 py-2.5 px-4 text-sm font-semibold text-white hover:bg-fuchsia-500 active:scale-[0.98] transition-all disabled:opacity-50 cursor-pointer">
                        @if (_isCreating)
                        {
                            <span>Creating...</span>
                        }
                        else
                        {
                            <span>Create Workspace</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Join Workspace Modal (Desktop App Friendly) -->
@if (_isJoinModalOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm">
        <div class="bg-zinc-950 border border-zinc-800 rounded-2xl w-full max-w-md shadow-2xl p-6 relative">
            <button @onclick="CloseJoinModal" class="absolute top-4 right-4 p-2 text-zinc-400 hover:text-white rounded-full hover:bg-zinc-900 transition-colors">
                <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>

            <div class="flex items-center gap-3 mb-2">
                <div class="size-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
                    <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zM4 19.235v-.11a6.375 6.375 0 0112.75 0v.109A12.318 12.318 0 0110.374 21c-2.331 0-4.512-.645-6.374-1.765z" />
                    </svg>
                </div>
                <div>
                    <h2 class="text-xl font-bold text-white">Join a Workspace</h2>
                    <p class="text-xs text-zinc-400">Enter your invitation code</p>
                </div>
            </div>

            <div class="mt-5 space-y-4">
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-xs font-medium text-zinc-300">Invitation Code</label>
                        @if (!string.IsNullOrEmpty(_joinInput))
                        {
                            <button type="button" @onclick="ClearJoinInput" class="text-[11px] text-zinc-400 hover:text-zinc-200 transition-colors cursor-pointer">
                                Clear
                            </button>
                        }
                    </div>
                    <div class="relative">
                        <input type="text"
                               value="@_joinInput"
                               @oninput="OnJoinInputChange"
                               @onkeydown="HandleJoinInputKeyDown"
                               placeholder="Enter invitation code"
                               class="block w-full rounded-xl bg-zinc-900 border border-zinc-800 px-4 py-2.5 text-white text-xs font-mono focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors placeholder:font-sans placeholder:text-zinc-500" />
                    </div>
                    <p class="mt-1.5 text-[11px] text-zinc-400">
                        Paste the invitation code given to you by an organization administrator.
                    </p>
                </div>

                @if (!string.IsNullOrEmpty(_joinError))
                {
                    <div class="rounded-xl bg-red-950/40 border border-red-900/60 p-3 flex items-start gap-2.5 text-xs text-red-300">
                        <svg class="size-4 shrink-0 mt-0.5 text-red-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                        </svg>
                        <div class="flex-1">@_joinError</div>
                    </div>
                }

                @if (_verifiedInvitation != null)
                {
                    <!-- Preview Card -->
                    <div class="rounded-xl bg-zinc-900/80 border border-emerald-500/30 p-4">
                        <div class="flex items-center gap-3">
                            <div class="size-11 rounded-xl bg-gradient-to-br from-emerald-600 to-teal-700 flex items-center justify-center text-white font-bold text-sm shadow-md shrink-0">
                                @GetInitials(_verifiedInvitation.OrganizationName)
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-1.5">
                                    <span class="text-xs font-semibold text-emerald-400">Ready to join</span>
                                    <svg class="size-3.5 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                    </svg>
                                </div>
                                <h3 class="text-sm font-bold text-white truncate">@_verifiedInvitation.OrganizationName</h3>
                                <p class="text-xs text-zinc-400">Invited by @_verifiedInvitation.InvitedBy</p>
                            </div>
                        </div>
                    </div>
                }

                <div class="pt-2 flex gap-3">
                    <button type="button" @onclick="CloseJoinModal"
                            class="flex-1 rounded-xl bg-zinc-900 border border-zinc-800 py-2.5 px-4 text-xs font-semibold text-zinc-300 hover:text-white hover:bg-zinc-800 transition-colors cursor-pointer">
                        Cancel
                    </button>

                    @if (_verifiedInvitation != null)
                    {
                        <button type="button" 
                                @onclick="ConfirmJoin" 
                                disabled="@_isJoining"
                                class="flex-1 rounded-xl bg-emerald-600 py-2.5 px-4 text-xs font-semibold text-white hover:bg-emerald-500 active:scale-[0.98] transition-all disabled:opacity-50 flex items-center justify-center gap-2 shadow-lg shadow-emerald-900/30 cursor-pointer">
                            @if (_isJoining)
                            {
                                <svg class="animate-spin size-3.5 text-white" viewBox="0 0 24 24" fill="none">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                                </svg>
                                <span>Joining...</span>
                            }
                            else
                            {
                                <span>Enter Workspace</span>
                            }
                        </button>
                    }
                    else
                    {
                        <button type="button" 
                                @onclick="LookupInvitation" 
                                disabled="@(_isLookingUp || string.IsNullOrWhiteSpace(_joinInput))"
                                class="flex-1 rounded-xl bg-emerald-600 py-2.5 px-4 text-xs font-semibold text-white hover:bg-emerald-500 active:scale-[0.98] transition-all disabled:opacity-50 flex items-center justify-center gap-2 shadow-lg shadow-emerald-900/30 cursor-pointer">
                            @if (_isLookingUp)
                            {
                                <svg class="animate-spin size-3.5 text-white" viewBox="0 0 24 24" fill="none">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                                </svg>
                                <span>Verifying...</span>
                            }
                            else
                            {
                                <span>Verify Code</span>
                            }
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "join")]
    public bool? JoinParam { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    public string? CodeParam { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? TokenParam { get; set; }

    private bool _isLoading = true;
    private bool _isCreateModalOpen;
    private bool _isCreating;

    private bool _isJoinModalOpen;
    private bool _isLookingUp;
    private bool _isJoining;
    private string _joinInput = string.Empty;
    private string? _joinError;
    private InvitationDetailsDto? _verifiedInvitation;
    private bool _hasProcessedQueryParams;
    
    private List<OrganizationDto>? _organizations;
    private List<InvitationDto>? _pendingInvitations;
    private UserDto? _user;
    private CreateOrgModel _createModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_hasProcessedQueryParams)
        {
            var codeToUse = !string.IsNullOrWhiteSpace(CodeParam) ? CodeParam : TokenParam;
            if (JoinParam == true || !string.IsNullOrWhiteSpace(codeToUse))
            {
                _hasProcessedQueryParams = true;
                _isJoinModalOpen = true;
                if (!string.IsNullOrWhiteSpace(codeToUse))
                {
                    _joinInput = codeToUse;
                    await LookupInvitation();
                }
            }
        }
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            var userTask = Http.GetFromJsonAsync<UserDto>("/api/auth/me");
            var orgsTask = Http.GetFromJsonAsync<List<OrganizationDto>>("/api/organizations/my");
            var invitesTask = Http.GetFromJsonAsync<List<InvitationDto>>("/api/organizations/invitations/pending");
            
            await Task.WhenAll(userTask, orgsTask, invitesTask);
            
            _user = userTask.Result;
            _organizations = orgsTask.Result;
            _pendingInvitations = invitesTask.Result;
        }
        catch
        {
            // Handle error
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        _createModel = new CreateOrgModel();
        _isCreateModalOpen = true;
    }

    private void CloseCreateModal()
    {
        _isCreateModalOpen = false;
    }

    private void OpenJoinModal()
    {
        _joinError = null;
        _verifiedInvitation = null;
        _isJoinModalOpen = true;
    }

    private void CloseJoinModal()
    {
        _isJoinModalOpen = false;
        _joinInput = string.Empty;
        _joinError = null;
        _verifiedInvitation = null;
    }

    private void ClearJoinInput()
    {
        _joinInput = string.Empty;
        _joinError = null;
        _verifiedInvitation = null;
    }

    private void OnJoinInputChange(ChangeEventArgs e)
    {
        _joinInput = e.Value?.ToString() ?? string.Empty;
        _verifiedInvitation = null;
        _joinError = null;
    }

    private string ExtractToken(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;
        var trimmed = input.Trim();

        // 1. Check for /join/<token> pattern
        var joinPattern = "/join/";
        var joinIndex = trimmed.IndexOf(joinPattern, StringComparison.OrdinalIgnoreCase);
        if (joinIndex >= 0)
        {
            var remainder = trimmed.Substring(joinIndex + joinPattern.Length);
            var endIdx = remainder.IndexOfAny(new[] { '?', '#', '/', '&', ' ' });
            var candidate = endIdx >= 0 ? remainder.Substring(0, endIdx) : remainder;
            return candidate.Trim().Replace("-", "");
        }

        // 2. Check for query parameters (?code= or ?token=)
        var codeIdx = trimmed.IndexOf("code=", StringComparison.OrdinalIgnoreCase);
        if (codeIdx >= 0)
        {
            var remainder = trimmed.Substring(codeIdx + 5);
            var endIdx = remainder.IndexOfAny(new[] { '&', '#', ' ', '/' });
            var candidate = endIdx >= 0 ? remainder.Substring(0, endIdx) : remainder;
            return candidate.Trim().Replace("-", "");
        }

        var tokenIdx = trimmed.IndexOf("token=", StringComparison.OrdinalIgnoreCase);
        if (tokenIdx >= 0)
        {
            var remainder = trimmed.Substring(tokenIdx + 6);
            var endIdx = remainder.IndexOfAny(new[] { '&', '#', ' ', '/' });
            var candidate = endIdx >= 0 ? remainder.Substring(0, endIdx) : remainder;
            return candidate.Trim().Replace("-", "");
        }

        // 3. Raw token: strip surrounding slashes, quotes, spaces, and remove hyphens
        var clean = trimmed.Trim('"', '\'', '/', '\\', ' ', '?');
        return clean.Replace("-", "");
    }

    private async Task HandleJoinInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (_verifiedInvitation != null)
            {
                await ConfirmJoin();
            }
            else
            {
                await LookupInvitation();
            }
        }
    }

    private async Task LookupInvitation()
    {
        var token = ExtractToken(_joinInput);
        if (string.IsNullOrWhiteSpace(token))
        {
            _joinError = "Please enter an invitation code.";
            return;
        }

        _isLookingUp = true;
        _joinError = null;
        _verifiedInvitation = null;

        try
        {
            var invite = await Http.GetFromJsonAsync<InvitationDetailsDto>($"/api/organizations/invitations/{token}");
            if (invite != null)
            {
                _verifiedInvitation = invite;
            }
            else
            {
                _joinError = "Invitation not found or has expired.";
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _joinError = "Invitation not found or has expired.";
        }
        catch (Exception)
        {
            _joinError = "Could not verify invitation. Please check the code and try again.";
        }
        finally
        {
            _isLookingUp = false;
        }
    }

    private async Task ConfirmJoin()
    {
        var token = _verifiedInvitation?.Token ?? ExtractToken(_joinInput);
        if (string.IsNullOrWhiteSpace(token)) return;

        _isJoining = true;
        _joinError = null;

        try
        {
            var response = await Http.PostAsJsonAsync("/api/organizations/join", new { Token = token });
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<JoinResponseDto>();
                if (result != null)
                {
                    ToastService.ShowSuccess($"Joined {result.OrganizationName} successfully!");
                    // Select organization and enter dashboard
                    await Http.PostAsJsonAsync($"/api/organizations/{result.OrganizationId}/select", new { });
                    AuthProvider.NotifyAuthStateChanged();
                    Nav.NavigateTo("/dashboard", forceLoad: true);
                    return;
                }
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                _joinError = !string.IsNullOrWhiteSpace(err) ? err : "Failed to join organization.";
            }
        }
        catch (Exception)
        {
            _joinError = "An error occurred while connecting to the server.";
        }
        finally
        {
            _isJoining = false;
        }
    }

    private async Task HandleCreate()
    {
        _isCreating = true;

        try
        {
            var response = await Http.PostAsJsonAsync("/api/organizations", new { Name = _createModel.Name });
            if (response.IsSuccessStatusCode)
            {
                var newOrg = await response.Content.ReadFromJsonAsync<OrganizationDto>();
                if (newOrg != null)
                {
                    await SelectOrganization(newOrg.Id);
                    ToastService.ShowSuccess("Workspace created successfully.");
                }
            }
            else
            {
                ToastService.ShowError(await response.Content.ReadAsStringAsync());
            }
        }
        catch
        {
            ToastService.ShowError("Could not connect to the server.");
        }
        finally
        {
            _isCreating = false;
        }
    }

    private async Task SelectOrganization(Guid orgId)
    {
        // Tell the server to set the active organization in the token/cookie
        var response = await Http.PostAsJsonAsync($"/api/organizations/{orgId}/select", new { });
        if (response.IsSuccessStatusCode)
        {
            AuthProvider.NotifyAuthStateChanged();
            Nav.NavigateTo("/dashboard", forceLoad: true);
        }
    }

    private async Task AcceptInvitation(string token)
    {
        var response = await Http.PostAsJsonAsync("/api/organizations/join", new { Token = token });
        if (response.IsSuccessStatusCode)
        {
            await LoadData();
            StateHasChanged();
            ToastService.ShowSuccess("Invitation accepted.");
        }
        else
        {
            ToastService.ShowError("Failed to accept invitation.");
        }
    }

    private async Task DeclineInvitation(string token)
    {
        var response = await Http.PostAsync($"/api/organizations/invitations/{token}/decline", null);
        if (response.IsSuccessStatusCode)
        {
            await LoadData();
            StateHasChanged();
            ToastService.ShowInfo("Invitation declined.");
        }
        else
        {
            ToastService.ShowError("Failed to decline invitation.");
        }
    }

    private async Task Logout()
    {
        await Http.PostAsync("/api/auth/logout", null);
        AuthProvider.NotifyAuthStateChanged();
        Nav.NavigateTo("/");
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "OC";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name.Substring(0, Math.Min(2, name.Length)).ToUpper();
    }

