@page "/payroll"
@using System.Net.Http.Json
@using OfficeCore.Web.Client.Pages.Payroll.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject OfficeCore.Web.Services.ToastService ToastService

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold tracking-tight text-white">Payroll</h1>
            <p class="mt-1 text-zinc-400 text-sm">Manage payroll periods and process employee payslips</p>
        </div>
        <div class="flex items-center gap-3">
            <button @onclick='() => Navigation.NavigateTo("/payroll/settings")' class="flex items-center gap-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white px-4 py-2 rounded-xl text-sm font-medium transition-all border border-zinc-700/50">
                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                Settings
            </button>
            <button @onclick="OpenCreateModal" class="flex items-center gap-2 bg-fuchsia-600 hover:bg-fuchsia-500 text-white px-4 py-2 rounded-xl text-sm font-medium transition-all shadow-lg shadow-fuchsia-900/20">
                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                New Payroll Period
            </button>
        </div>
    </div>

    <div class="flex items-center gap-4 bg-zinc-950 p-4 rounded-2xl border border-zinc-800">
        <div class="relative flex-1 max-w-md">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="size-4 text-zinc-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
            </div>
            <input type="text" @bind="searchTerm" @bind:event="oninput" class="w-full bg-zinc-900 border border-zinc-700 rounded-lg pl-10 pr-4 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none" placeholder="Search by date or remarks..." />
        </div>
    </div>

    @if (isLoading)
    {
        <div class="animate-pulse space-y-4">
            <div class="h-12 bg-zinc-900 rounded-xl"></div>
            <div class="h-12 bg-zinc-900 rounded-xl"></div>
        </div>
    }
    else if (periods == null || !periods.Any())
    {
        <div class="bg-zinc-900/50 border border-zinc-800/50 rounded-2xl p-8 text-center backdrop-blur-xl">
            <div class="size-12 rounded-full bg-zinc-800 flex items-center justify-center mx-auto mb-4">
                <svg class="size-6 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <h3 class="text-lg font-medium text-white mb-1">No Payroll Periods</h3>
            <p class="text-zinc-400 mb-6">You haven't created any payroll periods yet.</p>
            <button @onclick="OpenCreateModal" class="bg-white/10 hover:bg-white/20 text-white px-6 py-2.5 rounded-xl text-sm font-medium transition-all">
                Create First Period
            </button>
        </div>
    }
    else if (!FilteredPeriods.Any())
    {
        <div class="bg-zinc-900/50 border border-zinc-800/50 rounded-2xl p-8 text-center backdrop-blur-xl">
            <div class="size-12 rounded-full bg-zinc-800 flex items-center justify-center mx-auto mb-4">
                <svg class="size-6 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                </svg>
            </div>
            <h3 class="text-lg font-medium text-white mb-1">No matches found</h3>
            <p class="text-zinc-400">Try adjusting your search criteria.</p>
        </div>
    }
    else
    {
        <div class="bg-zinc-900/50 border border-zinc-800/50 rounded-2xl overflow-hidden backdrop-blur-xl">
            <table class="w-full text-left text-sm whitespace-nowrap">
                <thead class="bg-zinc-900/80 border-b border-zinc-800 text-zinc-400 uppercase tracking-wider text-[11px] font-semibold">
                    <tr>
                        <th class="px-6 py-4 cursor-pointer hover:text-white transition-colors group select-none" @onclick='() => Sort("Period")'>
                            <div class="flex items-center gap-2">
                                Period
                                @RenderSortIcon("Period")
                            </div>
                        </th>
                        <th class="px-6 py-4 cursor-pointer hover:text-white transition-colors group select-none" @onclick='() => Sort("Status")'>
                            <div class="flex items-center gap-2">
                                Status
                                @RenderSortIcon("Status")
                            </div>
                        </th>
                        <th class="px-6 py-4">Remarks</th>
                        <th class="px-6 py-4 cursor-pointer hover:text-white transition-colors group select-none" @onclick='() => Sort("Created")'>
                            <div class="flex items-center gap-2">
                                Created Date
                                @RenderSortIcon("Created")
                            </div>
                        </th>
                        <th class="px-6 py-4 text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-800/50">
                    @foreach (var p in FilteredPeriods)
                    {
                        <tr class="hover:bg-zinc-800/30 transition-colors cursor-pointer group" @onclick="() => NavigateToPeriod(p.Id)">
                            <td class="px-6 py-4">
                                <span class="font-semibold text-white">@p.StartDate.ToString("MMM dd") - @p.EndDate.ToString("MMM dd, yyyy")</span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider @GetStatusBadgeClass(p.Status)">
                                    @p.Status.ToString()
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-zinc-400 block truncate max-w-xs">@(string.IsNullOrEmpty(p.Remarks) ? "—" : p.Remarks)</span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-zinc-400">@p.CreatedAt.ToString("MMM dd, yyyy")</span>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center justify-center gap-3">
                                    <div class="text-sm text-fuchsia-400 font-medium group-hover:text-fuchsia-300 transition-colors flex items-center gap-1">
                                        View
                                        <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                                    </div>
                                    @if (p.Status == 0 || p.Status == 1) // Draft or Computed
                                    {
                                        <button @onclick="() => ShowDeleteConfirmation(p.Id)" @onclick:stopPropagation class="p-1.5 text-zinc-500 hover:text-rose-400 hover:bg-rose-500/10 rounded-lg transition-colors" title="Archive Period">
                                            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (isCreateModalOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
        <div class="bg-zinc-950 border border-zinc-800 rounded-2xl w-full max-w-md shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
            <div class="p-6 border-b border-zinc-800">
                <h2 class="text-lg font-semibold text-white">Create Payroll Period</h2>
                <p class="text-sm text-zinc-400 mt-1">Define the date range for this cutoff.</p>
            </div>
            
            <EditForm Model="newPeriod" OnValidSubmit="CreatePeriod">
                <div class="p-6 space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-zinc-300 mb-1.5">Start Date</label>
                        <InputDate @bind-Value="newPeriod.StartDate" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-fuchsia-500/50 focus:border-fuchsia-500 transition-all" />
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-zinc-300 mb-1.5">End Date</label>
                        <InputDate @bind-Value="newPeriod.EndDate" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-fuchsia-500/50 focus:border-fuchsia-500 transition-all" />
                    </div>
                    

                    
                    <div>
                        <label class="block text-sm font-medium text-zinc-300 mb-1.5">Remarks (Optional)</label>
                        <InputTextArea @bind-Value="newPeriod.Remarks" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-fuchsia-500/50 focus:border-fuchsia-500 transition-all resize-none" rows="2" />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-zinc-300 mb-1.5">Gov. Deduction Cycle</label>
                        <InputSelect @bind-Value="newPeriod.DeductionMultiplier" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-fuchsia-500/50 focus:border-fuchsia-500 transition-all">
                            <option value="1.0">Full Month (100%)</option>
                            <option value="0.5">Semi-Monthly (50%)</option>
                            <option value="0.25">Weekly (25%)</option>
                            <option value="0.0">No Deductions (0%)</option>
                        </InputSelect>
                    </div>
                </div>
                
                <div class="p-6 border-t border-zinc-800 bg-zinc-900/30 flex justify-end gap-3">
                    <button type="button" @onclick="CloseCreateModal" class="px-4 py-2 text-sm font-medium text-zinc-300 hover:text-white transition-colors">Cancel</button>
                    <button type="submit" class="bg-fuchsia-600 hover:bg-fuchsia-500 text-white px-6 py-2 rounded-xl text-sm font-medium transition-all shadow-lg shadow-fuchsia-900/20" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="flex items-center gap-2">
                                <svg class="animate-spin size-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                                Creating...
                            </span>
                        }
                        else
                        {
                            <span>Create Period</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (showDeleteModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm p-4">
        <div class="bg-zinc-950 border border-zinc-800 rounded-2xl w-full max-w-sm shadow-2xl p-6 relative">
            <h3 class="text-lg font-bold text-white mb-2">Archive Payroll Period</h3>
            <p class="text-sm text-zinc-400 mb-6">Are you sure you want to archive this payroll period? This action cannot be undone.</p>
            <div class="flex gap-3">
                <button @onclick="() => showDeleteModal = false" class="flex-1 py-2.5 rounded-lg text-sm font-medium text-zinc-400 bg-zinc-800/50 hover:bg-zinc-800 hover:text-white transition-all">Cancel</button>
                <button @onclick="ConfirmArchivePeriod" class="flex-1 py-2.5 rounded-lg text-sm font-bold text-white bg-red-600 hover:bg-red-500 shadow-lg shadow-red-900/20 transition-all">Archive</button>
            </div>
        </div>
    </div>
}

@code {
    private List<PayrollPeriodDto>? periods;
    private bool isLoading = true;
    private bool isCreateModalOpen = false;
    private bool isSubmitting = false;
    private bool showDeleteModal = false;
    private Guid? periodToDelete;
    
    private PayrollPeriodDto newPeriod = new();
    private string searchTerm = "";

    private IEnumerable<PayrollPeriodDto> FilteredPeriods
    {
        get
        {
            if (periods == null) return Enumerable.Empty<PayrollPeriodDto>();
            
            var query = periods.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.ToLower();
                query = query.Where(p => 
                    (p.Remarks != null && p.Remarks.ToLower().Contains(term)) ||
                    p.StartDate.ToString("MMM dd yyyy").ToLower().Contains(term) ||
                    p.EndDate.ToString("MMM dd yyyy").ToLower().Contains(term) ||
                    p.Status.ToString().ToLower().Contains(term)
                );
            }

            return sortColumn switch
            {
                "Period" => sortAscending ? query.OrderBy(p => p.StartDate) : query.OrderByDescending(p => p.StartDate),
                "Status" => sortAscending ? query.OrderBy(p => p.Status) : query.OrderByDescending(p => p.Status),
                "Created" => sortAscending ? query.OrderBy(p => p.CreatedAt) : query.OrderByDescending(p => p.CreatedAt),
                _ => query.OrderByDescending(p => p.StartDate)
            };
        }
    }

    private string sortColumn = "Period";
    private bool sortAscending = false;

    private void Sort(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private RenderFragment RenderSortIcon(string column) => builder =>
    {
        if (sortColumn != column)
        {
            builder.OpenElement(0, "svg");
            builder.AddAttribute(1, "class", "size-3.5 text-zinc-600 group-hover:text-zinc-400 transition-colors opacity-0 group-hover:opacity-100");
            builder.AddAttribute(2, "fill", "none");
            builder.AddAttribute(3, "viewBox", "0 0 24 24");
            builder.AddAttribute(4, "stroke", "currentColor");
            builder.AddAttribute(5, "stroke-width", "2");
            builder.OpenElement(6, "path");
            builder.AddAttribute(7, "stroke-linecap", "round");
            builder.AddAttribute(8, "stroke-linejoin", "round");
            builder.AddAttribute(9, "d", "M8 9l4-4 4 4m0 6l-4 4-4-4");
            builder.CloseElement();
            builder.CloseElement();
            return;
        }

        builder.OpenElement(0, "svg");
        builder.AddAttribute(1, "class", "size-3.5 text-fuchsia-400");
        builder.AddAttribute(2, "fill", "none");
        builder.AddAttribute(3, "viewBox", "0 0 24 24");
        builder.AddAttribute(4, "stroke", "currentColor");
        builder.AddAttribute(5, "stroke-width", "2");
        builder.OpenElement(6, "path");
        builder.AddAttribute(7, "stroke-linecap", "round");
        builder.AddAttribute(8, "stroke-linejoin", "round");
        builder.AddAttribute(9, "d", sortAscending ? "M5 15l7-7 7 7" : "M19 9l-7 7-7-7");
        builder.CloseElement();
        builder.CloseElement();
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadPeriods();
    }

    private async Task LoadPeriods()
    {
        isLoading = true;
        try
        {
            periods = await Http.GetFromJsonAsync<List<PayrollPeriodDto>>("api/payroll/periods");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading payroll periods: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        newPeriod = new PayrollPeriodDto 
        { 
            StartDate = new DateOnly(today.Year, today.Month, 1),
            EndDate = new DateOnly(today.Year, today.Month, 15)
        };
        isCreateModalOpen = true;
    }

    private void CloseCreateModal()
    {
        isCreateModalOpen = false;
    }

    private async Task CreatePeriod()
    {
        isSubmitting = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/payroll/periods", newPeriod);
            if (response.IsSuccessStatusCode)
            {
                CloseCreateModal();
                await LoadPeriods();
                ToastService.ShowSuccess("Payroll period created.");
            }
            else
            {
                ToastService.ShowError("Failed to create payroll period.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Error creating period.");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void NavigateToPeriod(Guid id)
    {
        Navigation.NavigateTo($"/payroll/{id}");
    }

    private void ShowDeleteConfirmation(Guid id)
    {
        periodToDelete = id;
        showDeleteModal = true;
    }

    private async Task ConfirmArchivePeriod()
    {
        if (periodToDelete == null) return;
        
        try
        {
            var response = await Http.DeleteAsync($"api/payroll/periods/{periodToDelete}");
            if (response.IsSuccessStatusCode)
            {
                showDeleteModal = false;
                await LoadPeriods();
                ToastService.ShowSuccess("Payroll period archived.");
            }
            else
            {
                ToastService.ShowError("Failed to archive payroll period.");
            }
        }
        catch
        {
            ToastService.ShowError("An error occurred.");
        }
        finally
        {
            periodToDelete = null;
        }
    }

    private string GetStatusBadgeClass(int status) => status switch
    {
        0 => "bg-zinc-800 text-zinc-300", // Draft
        1 => "bg-blue-500/20 text-blue-400", // Computed
        2 => "bg-fuchsia-500/20 text-fuchsia-400", // Finalized
        3 => "bg-emerald-500/20 text-emerald-400", // Paid
        _ => "bg-zinc-800 text-zinc-300"
    };

    public class PayrollPeriodDto
    {
        public Guid Id { get; set; }
        public DateOnly StartDate { get; set; }
        public DateOnly EndDate { get; set; }

        public int Status { get; set; }
        public string? Remarks { get; set; }
        public DateTime CreatedAt { get; set; }
        public decimal DeductionMultiplier { get; set; } = 1.0m;
    }
}
