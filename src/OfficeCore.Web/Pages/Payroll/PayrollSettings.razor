@page "/payroll/settings"
@attribute [Authorize(Policy = "RequirePayroll")]
@inject HttpClient Http

<PageTitle>Payroll Settings - OfficeCore</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight text-white">Payroll Settings</h1>
        <p class="mt-2 text-zinc-400">Configure default rates and government deductions used for payroll calculations.</p>
    </div>

    <div class="space-y-6 max-w-4xl">
            <!-- General Settings -->
            <div class="bg-zinc-950 border border-zinc-800 rounded-2xl p-6">
                <h2 class="text-xl font-semibold text-white mb-1">General Settings</h2>
                <p class="text-sm text-zinc-400 mb-6">Configure default rates used for payroll calculations.</p>

                @if (_generalSettings == null)
                {
                    <div class="flex items-center gap-3 text-zinc-500 text-sm">
                        <svg class="animate-spin size-4" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" /><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" /></svg>
                        Loading...
                    </div>
                }
                else
                {
                    <div class="flex items-end gap-6">
                        <div class="flex-1 max-w-xs">
                            <label class="block text-sm font-medium text-zinc-300 mb-2">Minimum Daily Rate (₱)</label>
                            <p class="text-xs text-zinc-500 mb-3">Used for approved vacation/sick leave pay and for employees without a custom daily rate.</p>
                            <div class="relative">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-zinc-400 text-sm font-medium">₱</span>
                                <input type="number" step="0.01" min="0" @bind="_generalSettings.MinimumDailyRate"
                                       class="w-full pl-7 pr-4 py-2.5 rounded-lg bg-zinc-900 border border-zinc-700 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none transition-colors" />
                            </div>
                        </div>
                        <button @onclick="SaveGeneralSettings" disabled="@_isSaving"
                                class="flex items-center gap-2 rounded-lg bg-fuchsia-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-fuchsia-500 transition-colors shadow-lg shadow-fuchsia-900/30 disabled:opacity-50">
                            @if (_isSaving)
                            {
                                <svg class="animate-spin size-4" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" /><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" /></svg>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>Save Rate</span>
                            }
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(_generalMessage))
                    {
                        <p class="mt-3 text-sm @(_generalIsError ? "text-red-400" : "text-emerald-400")">@_generalMessage</p>
                    }
                }
            </div>

            <!-- Government Deductions -->
            <div class="bg-zinc-950 border border-zinc-800 rounded-2xl p-6">
                <h2 class="text-xl font-semibold text-white mb-1">Government Deductions (Monthly)</h2>
                <p class="text-sm text-zinc-400 mb-6">Set the global monthly deduction amounts for SSS, PhilHealth, and Pag-IBIG. The system will automatically calculate the proportional amount for each payroll period.</p>

                @if (_settings == null)
                {
                    <div class="flex items-center gap-3 text-zinc-500 text-sm">
                        <svg class="animate-spin size-5" viewBox="0 0 24 24" fill="none">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                        </svg>
                        Loading settings...
                    </div>
                }
                else
                {
                    <div class="space-y-4">
                        <table class="w-full text-sm text-left">
                            <thead class="border-b border-zinc-800 text-zinc-400">
                                <tr>
                                    <th class="pb-3 font-medium">Agency</th>
                                    <th class="pb-3 font-medium">Employee Share (₱)</th>
                                    <th class="pb-3 font-medium">Employer Share (₱)</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-zinc-800/50">
                                @foreach (var setting in _settings)
                                {
                                    <tr class="hover:bg-zinc-900/50 transition-colors group">
                                        <td class="py-4 font-medium text-white">@setting.AgencyName</td>
                                        <td class="py-4">
                                            <input type="number" step="0.01" @bind="setting.EmployeeShare" class="w-32 rounded-lg bg-zinc-900 border border-zinc-700 px-3 py-1.5 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none transition-colors" />
                                        </td>
                                        <td class="py-4">
                                            <input type="number" step="0.01" @bind="setting.EmployerShare" class="w-32 rounded-lg bg-zinc-900 border border-zinc-700 px-3 py-1.5 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none transition-colors" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        @if (!string.IsNullOrEmpty(_message))
                        {
                            <p class="@(_isError ? "text-red-400" : "text-emerald-400") text-sm">@_message</p>
                        }

                        <div class="flex justify-end pt-4 border-t border-zinc-800">
                            <button @onclick="SaveSettings" disabled="@_isSaving"
                                    class="flex items-center gap-2 rounded-lg bg-fuchsia-600 px-5 py-2 text-sm font-semibold text-white hover:bg-fuchsia-500 transition-colors shadow-lg shadow-fuchsia-900/30 disabled:opacity-50">
                                @if (_isSaving)
                                {
                                    <svg class="animate-spin size-4" viewBox="0 0 24 24" fill="none">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                                    </svg>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <span>Save Changes</span>
                                }
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
</div>

@code {

    // Government deductions state
    private List<GovernmentDeductionSettingDto>? _settings;
    private bool _isSaving = false;
    private string? _message;
    private bool _isError = false;

    // General settings state
    private GeneralSettingsDto? _generalSettings;
    private string? _generalMessage;
    private bool _generalIsError = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        try
        {
            _settings = await Http.GetFromJsonAsync<List<GovernmentDeductionSettingDto>>("/api/payrollsettings/deductions");
            _generalSettings = await Http.GetFromJsonAsync<GeneralSettingsDto>("/api/payrollsettings/general");
        }
        catch (Exception)
        {
            _message = "Failed to load settings.";
            _isError = true;
        }
    }

    private async Task SaveGeneralSettings()
    {
        if (_generalSettings == null) return;
        _isSaving = true;
        _generalMessage = null;
        _generalIsError = false;
        try
        {
            var response = await Http.PutAsJsonAsync("/api/payrollsettings/general", _generalSettings);
            _generalMessage = response.IsSuccessStatusCode ? "Rate saved successfully!" : "Failed to save rate.";
            _generalIsError = !response.IsSuccessStatusCode;
        }
        catch (Exception)
        {
            _generalMessage = "An error occurred while saving.";
            _generalIsError = true;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SaveSettings()
    {
        if (_settings == null) return;
        _isSaving = true;
        _message = null;
        _isError = false;
        try
        {
            var response = await Http.PutAsJsonAsync("/api/payrollsettings/deductions", _settings);
            _message = response.IsSuccessStatusCode ? "Settings saved successfully!" : "Failed to save settings.";
            _isError = !response.IsSuccessStatusCode;
        }
        catch (Exception)
        {
            _message = "An error occurred while saving.";
            _isError = true;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private class GovernmentDeductionSettingDto
    {
        public Guid Id { get; set; }
        public string AgencyName { get; set; } = string.Empty;
        public decimal EmployeeShare { get; set; }
        public decimal EmployerShare { get; set; }
    }

    private class GeneralSettingsDto
    {
        public decimal MinimumDailyRate { get; set; }
    }
}
