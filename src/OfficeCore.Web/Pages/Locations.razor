@page "/locations"
@attribute [Authorize(Policy = "RequireLocations")]
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject OfficeCore.Web.Services.ToastService ToastService
@implements IAsyncDisposable

<PageTitle>Location - OfficeCore</PageTitle>

<div class="h-full flex flex-col space-y-4">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 shrink-0">
        <div>
            <h1 class="text-3xl font-bold tracking-tight text-white">Location</h1>
            <p class="mt-1 text-zinc-400 text-sm">Live map showing active outside employees (riders, delivery, and liaison staff).</p>
        </div>

        <div class="flex items-center gap-3">
            <button @onclick="RefreshFieldStaff" class="px-4 py-2 bg-zinc-900 hover:bg-zinc-800 text-zinc-200 border border-zinc-700 rounded-xl text-sm font-medium transition-colors flex items-center gap-2">
                <svg class="size-4 @(_isLoading ? "animate-spin" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                Refresh Map
            </button>
        </div>
    </div>

    <!-- Full Map Canvas -->
    <div class="flex-1 bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden relative shadow-2xl min-h-[620px]">
        <div id="officecore-field-map" class="w-full h-full min-h-[620px] z-0"></div>

        <!-- Floating Live Status Overlay Pill -->
        <div class="absolute top-4 left-4 z-10 bg-zinc-950/90 backdrop-blur border border-zinc-800 rounded-xl px-4 py-2.5 shadow-2xl flex items-center gap-3">
            <span class="size-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-xs font-semibold text-white">@_staffList.Count(s => s.IsOnline) Outside Staff Active</span>
        </div>
    </div>
</div>

@code {
    private List<ActiveFieldEmployeeDto> _staffList = new();
    private bool _isLoading = false;
    private bool _mapInitialized = false;

    public class ActiveFieldEmployeeDto
    {
        public string EmployeeId { get; set; } = string.Empty;
        public string EmployeeName { get; set; } = string.Empty;
        public string Department { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
        public string? ProfilePictureUrl { get; set; }
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public double? SpeedKmh { get; set; }
        public string? StatusNote { get; set; }
        public DateTime LastPingTime { get; set; }
        public bool IsOnline { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(300);
            try
            {
                await JSRuntime.InvokeVoidAsync("OfficeCoreMap.initializeMap", "officecore-field-map", 14.5995, 120.9842, 12);
                _mapInitialized = true;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error initializing map: {ex.Message}");
            }

            await RefreshFieldStaff();
        }
    }

    private async Task RefreshFieldStaff()
    {
        _isLoading = true;
        try
        {
            var result = await Http.GetFromJsonAsync<List<ActiveFieldEmployeeDto>>("api/locations/active");
            if (result != null)
            {
                _staffList = result;
                if (_mapInitialized)
                {
                    await JSRuntime.InvokeVoidAsync("OfficeCoreMap.updateStaffMarkers", _staffList);
                }
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to fetch field locations: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    public ValueTask DisposeAsync()
    {
        return ValueTask.CompletedTask;
    }
}