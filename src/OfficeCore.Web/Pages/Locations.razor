@page "/locations"
@attribute [Authorize(Policy = "RequireLocations")]
@inject HttpClient Http
@inject OfficeCore.Web.Services.ToastService ToastService
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Location - OfficeCore</PageTitle>

<div class="flex flex-col gap-3 h-[calc(100vh-125px)] overflow-hidden">
    <!-- Header -->
    <div class="flex items-center justify-between gap-3 shrink-0 flex-wrap">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-white flex items-center gap-2.5">
                <span>Location</span>
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Live Field Radar</span>
            </h1>
            <p class="text-zinc-400 text-xs mt-0.5">Live map showing active outside employees (riders, delivery, and liaison staff).</p>
        </div>

        <div class="flex items-center gap-2">
            <button @onclick="RefreshFieldStaff" disabled="@_isLoading"
                    class="px-3.5 py-1.5 bg-zinc-900 hover:bg-zinc-800 text-zinc-200 border border-zinc-700/80 rounded-xl text-xs font-medium transition-all shadow-sm flex items-center gap-2 disabled:opacity-50">
                <svg class="size-3.5 @(_isLoading ? "animate-spin" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                @(_isLoading ? "Loading…" : "Refresh Map")
            </button>
        </div>
    </div>

    <!-- Map Canvas Container -->
    <div class="flex-1 bg-zinc-950 border border-zinc-800/80 rounded-2xl overflow-hidden relative shadow-2xl flex flex-col min-h-0">

        <!-- ── Leaflet Map ── -->
        <div id="officecore-field-map" style="width:100%;height:100%;min-height:400px;z-index:0;"></div>

        <!-- ── Search Bar (top-center overlay) ── -->
        <div class="absolute top-3 left-1/2 -translate-x-1/2 z-[1000] w-full max-w-sm px-3">
            <div class="relative">
                <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-zinc-400">
                    <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
                <input @bind="_searchQuery" @bind:event="oninput"
                       @onkeydown="OnSearchKeyDown"
                       placeholder="Search location…"
                       class="w-full pl-8 pr-10 py-2 bg-zinc-900/95 backdrop-blur text-sm text-white border border-zinc-700/80 rounded-xl
                              placeholder:text-zinc-500 focus:outline-none focus:border-fuchsia-500/60 focus:ring-2 focus:ring-fuchsia-500/20
                              shadow-xl transition-all" />
                @if (!string.IsNullOrEmpty(_searchQuery))
                {
                    <button @onclick="ClearSearch"
                            class="absolute inset-y-0 right-3 flex items-center text-zinc-500 hover:text-white transition-colors">
                        <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                }
            </div>

            <!-- Search Results Dropdown -->
            @if (_searchResults.Count > 0)
            {
                <div class="mt-1.5 bg-zinc-900/98 backdrop-blur border border-zinc-700/80 rounded-xl shadow-2xl overflow-hidden">
                    @foreach (var r in _searchResults)
                    {
                        <button @onclick="() => GoToSearchResult(r)"
                                class="w-full text-left px-4 py-2.5 text-xs text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors flex items-start gap-2.5 border-b border-zinc-800/60 last:border-0">
                            <svg class="size-3.5 text-zinc-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            <span class="line-clamp-2">@r.DisplayName</span>
                        </button>
                    }
                </div>
            }

            @if (_isSearching)
            {
                <div class="mt-1.5 bg-zinc-900/95 backdrop-blur border border-zinc-700/60 rounded-xl px-4 py-3 text-xs text-zinc-400 flex items-center gap-2 shadow-xl">
                    <svg class="size-3.5 animate-spin text-fuchsia-500" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                    </svg>
                    Searching…
                </div>
            }
        </div>

        <!-- ── Active Staff Count Pill (top-left) ── -->
        <div class="absolute top-3 left-3 z-[500] bg-zinc-950/90 backdrop-blur border border-zinc-800 rounded-xl px-3.5 py-2 shadow-xl flex items-center gap-2.5">
            <span class="size-2 rounded-full @(_staffList.Any(s => s.IsOnline) ? "bg-emerald-400 animate-pulse" : "bg-zinc-600")"></span>
            <span class="text-xs font-semibold text-white">@_staffList.Count(s => s.IsOnline) Outside Staff Active</span>
        </div>

        <!-- ── Legend (top-right) ── -->
        <div class="absolute top-3 right-3 z-[500] bg-zinc-950/90 backdrop-blur border border-zinc-800 rounded-xl px-3 py-1.5 shadow-xl flex items-center gap-3 text-[11px] text-zinc-400">
            <div class="flex items-center gap-1.5">
                <span class="size-2 rounded-full bg-emerald-400"></span>
                <span>Active Transit</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-2 rounded-full bg-zinc-500"></span>
                <span>Idle</span>
            </div>
        </div>

        <!-- ── Staff sidebar panel (right side when staff selected) ── -->
        @if (_selectedStaff != null)
        {
            <div class="absolute bottom-4 left-4 z-[500] w-72 bg-zinc-900/98 backdrop-blur border border-zinc-700/80 rounded-2xl p-4 shadow-2xl text-zinc-100">
                <div class="flex items-start justify-between gap-2 mb-3">
                    <div>
                        <h4 class="text-sm font-bold text-white">@_selectedStaff.EmployeeName</h4>
                        <p class="text-[11px] text-zinc-400 mt-0.5">@_selectedStaff.Department • @_selectedStaff.Role</p>
                    </div>
                    <button @onclick="() => _selectedStaff = null" class="text-zinc-500 hover:text-white text-xs p-1 transition-colors">✕</button>
                </div>

                <div class="space-y-2 text-xs border-t border-zinc-800 pt-3">
                    <div class="flex justify-between items-center">
                        <span class="text-zinc-500">Status</span>
                        <span class="font-semibold @(_selectedStaff.IsOnline ? "text-emerald-400" : "text-zinc-400")">
                            @(_selectedStaff.IsOnline ? "● Active Outside" : "○ Idle")
                        </span>
                    </div>
                    <div class="flex justify-between items-start gap-2">
                        <span class="text-zinc-500 shrink-0">Task</span>
                        <span class="font-medium text-zinc-200 text-right">@(_selectedStaff.StatusNote ?? "Standard Delivery / Route")</span>
                    </div>
                    @if (_selectedStaff.SpeedKmh.HasValue)
                    {
                        <div class="flex justify-between">
                            <span class="text-zinc-500">Speed</span>
                            <span class="font-medium text-zinc-300">~@_selectedStaff.SpeedKmh.Value.ToString("0.0") km/h</span>
                        </div>
                    }
                    <div class="flex justify-between">
                        <span class="text-zinc-500">GPS</span>
                        <span class="font-mono text-[10px] text-zinc-400">@_selectedStaff.Latitude.ToString("0.0000"), @_selectedStaff.Longitude.ToString("0.0000")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-zinc-500">Last Ping</span>
                        <span class="text-[10px] text-zinc-400">@_selectedStaff.LastPingTime.ToLocalTime().ToString("t")</span>
                    </div>
                </div>

                <button @onclick="PanToSelectedStaff"
                        class="mt-3 w-full py-1.5 rounded-lg bg-fuchsia-600/20 hover:bg-fuchsia-600/30 border border-fuchsia-500/30 text-fuchsia-300 text-xs font-medium transition-all">
                    📍 Center on Map
                </button>
            </div>
        }

        <!-- ── No Staff Banner (shown when map is loaded but list is empty) ── -->
        @if (!_isLoading && _staffList.Count == 0 && _mapReady)
        {
            <div class="absolute bottom-4 left-1/2 -translate-x-1/2 z-[500] bg-zinc-900/95 backdrop-blur border border-zinc-800 rounded-2xl px-6 py-4 shadow-2xl text-center max-w-sm">
                <div class="size-10 rounded-xl bg-zinc-800 border border-zinc-700 flex items-center justify-center mx-auto mb-2">
                    <svg class="size-5 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                </div>
                <p class="text-xs font-semibold text-zinc-300">No Outside Staff Currently Active</p>
                <p class="text-[10px] text-zinc-500 mt-1">Active riders and field staff will appear as pins on the map.</p>
            </div>
        }
    </div>
</div>

@code {
    private List<ActiveFieldEmployeeDto> _staffList = new();
    private ActiveFieldEmployeeDto? _selectedStaff;
    private bool _isLoading = false;
    private bool _mapReady = false;

    private string _searchQuery = string.Empty;
    private bool _isSearching = false;
    private List<SearchResult> _searchResults = new();

    private DotNetObjectReference<Locations>? _dotNetRef;

    public class ActiveFieldEmployeeDto
    {
        public string EmployeeId { get; set; } = string.Empty;
        public string EmployeeName { get; set; } = string.Empty;
        public string Department { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
        public string? ProfilePictureUrl { get; set; }
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public double? SpeedKmh { get; set; }
        public string? StatusNote { get; set; }
        public DateTime LastPingTime { get; set; }
        public bool IsOnline { get; set; }
    }

    public class SearchResult
    {
        public string DisplayName { get; set; } = string.Empty;
        public double Lat { get; set; }
        public double Lng { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);

            // Allow DOM to settle then initialize the Leaflet map
            await Task.Delay(200);
            await InitializeMap();

            // Load staff data
            await RefreshFieldStaff();
        }
    }

    private async Task InitializeMap()
    {
        try
        {
            var ok = await JS.InvokeAsync<bool>("OfficeCoreMap.initializeMap", "officecore-field-map", 14.5995, 120.9842, 12);
            _mapReady = ok;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Locations] Map init error: {ex.Message}");
            _mapReady = false;
        }
        StateHasChanged();
    }

    private async Task RefreshFieldStaff()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            var result = await Http.GetFromJsonAsync<List<ActiveFieldEmployeeDto>>("api/locations/active");
            if (result != null)
            {
                _staffList = result;
            }

            if (_mapReady)
            {
                await JS.InvokeVoidAsync("OfficeCoreMap.updateStaffMarkers", _staffList);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to fetch field staff locations: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task PanToSelectedStaff()
    {
        if (_selectedStaff == null || !_mapReady) return;
        await JS.InvokeVoidAsync("OfficeCoreMap.panToStaff", _selectedStaff.Latitude, _selectedStaff.Longitude);
    }

    // ── Search ──────────────────────────────────────────────────────────────

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_searchQuery))
        {
            await TriggerSearch();
        }
        else if (e.Key == "Escape")
        {
            ClearSearch();
        }
    }

    private async Task TriggerSearch()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery) || _dotNetRef == null) return;
        _isSearching = true;
        _searchResults.Clear();
        StateHasChanged();
        await JS.InvokeVoidAsync("OfficeCoreMap.searchLocation", _searchQuery.Trim(), _dotNetRef);
    }

    [JSInvokable]
    public void OnSearchResults(List<SearchResult> results)
    {
        _isSearching = false;
        _searchResults = results ?? new();
        StateHasChanged();
    }

    private async Task GoToSearchResult(SearchResult result)
    {
        _searchQuery = result.DisplayName.Length > 60
            ? result.DisplayName[..57] + "…"
            : result.DisplayName;
        _searchResults.Clear();

        await JS.InvokeVoidAsync("OfficeCoreMap.goToLocation", result.Lat, result.Lng, result.DisplayName);
        StateHasChanged();
    }

    private void ClearSearch()
    {
        _searchQuery = string.Empty;
        _searchResults.Clear();
        _isSearching = false;
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
    }
}