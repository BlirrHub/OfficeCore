@page "/locations"
@attribute [Authorize(Policy = "RequireLocations")]
@using Microsoft.AspNetCore.SignalR.Client
@inject HttpClient Http
@inject OfficeCore.Web.Services.ToastService ToastService
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthProvider
@inject IConfiguration Configuration
@implements IAsyncDisposable

<PageTitle>Location - OfficeCore</PageTitle>

<style>
    /* Map fills its container absolutely */
    #officecore-field-map {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
    }

    /* Outer page layout */
    .loc-page {
        display: flex;
        flex-direction: column;
        gap: 10px;
        height: calc(100vh - 125px);
        overflow: hidden;
        position: relative;
        z-index: 1;
    }

    /* Map card — fills remaining vertical space */
    .loc-map-card {
        flex: 1;
        min-height: 0;
        position: relative;
        border-radius: 14px;
        overflow: hidden;
        background: #09090b;
        border: 1px solid rgba(39,39,42,0.7);
        box-shadow: 0 20px 50px rgba(0,0,0,0.6);
        isolation: isolate;
        z-index: 1;
    }

    html.light .loc-map-card {
        background: #ffffff;
        border-color: #e2e8f0;
        box-shadow: 0 10px 30px rgba(0,0,0,0.06);
    }

    /*
     * Overlay grid sits on top of the map, covers the entire card.
     * Divided into a 3×3 grid: top/mid/bot rows × left/center/right cols.
     * pointer-events:none on the grid itself so map interactions pass through,
     * pointer-events:auto re-enabled on individual interactive panels.
     */
    .loc-overlay {
        position: absolute;
        inset: 0;
        z-index: 500;
        display: grid;
        grid-template-columns: auto 1fr auto;
        grid-template-rows: auto 1fr auto;
        padding: 12px;
        gap: 8px;
        pointer-events: none;
    }

    /* Grid area shortcuts */
    .loc-tl { grid-column: 1; grid-row: 1; align-self: start; }
    .loc-tc { grid-column: 2; grid-row: 1; align-self: start; justify-self: center; }
    .loc-tr { grid-column: 3; grid-row: 1; align-self: start; }
    .loc-bl { grid-column: 1; grid-row: 3; align-self: end; }
    .loc-bc { grid-column: 2; grid-row: 3; align-self: end; justify-self: center; }
    .loc-br { grid-column: 3; grid-row: 3; align-self: end; }

    /* Re-enable pointer events for clickable panels */
    .loc-interactive { pointer-events: auto; }

    /* Staff card that sits above the legend in the BL cell — stacked inside one flex column */
    .loc-bl-stack {
        grid-column: 1;
        grid-row: 3;
        align-self: end;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
</style>

<div class="loc-page">

    <!-- ── Page header ── -->
    <div class="flex items-center justify-between gap-3 shrink-0 flex-wrap">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-white flex items-center gap-2.5">
                <span>Location</span>
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Live Field Radar</span>
            </h1>
            <p class="text-zinc-400 text-xs mt-0.5">Live map showing active outside employees.</p>
        </div>

        <div class="flex items-center gap-2">
            <!-- My Location button -->
            <button @onclick="ShowMyLocation"
                    class="px-3 py-1.5 bg-zinc-900 hover:bg-zinc-800 text-fuchsia-400 border border-fuchsia-500/30
                           rounded-xl text-xs font-medium transition-all shadow-sm flex items-center gap-1.5">
                <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="3" stroke-width="2"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 2v3m0 14v3M2 12h3m14 0h3"/>
                </svg>
                My Location
            </button>

            <!-- Refresh button -->
            <button @onclick="RefreshFieldStaff" disabled="@_isLoading"
                    class="px-3 py-1.5 bg-zinc-900 hover:bg-zinc-800 text-zinc-200 border border-zinc-700/80
                           rounded-xl text-xs font-medium transition-all shadow-sm flex items-center gap-2 disabled:opacity-50">
                <svg class="size-3.5 @(_isLoading ? "animate-spin" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                @(_isLoading ? "Loading…" : "Refresh")
            </button>
        </div>
    </div>

    <!-- ── Map card ── -->
    <div class="loc-map-card">

        <!-- Leaflet renders here -->
        <div id="officecore-field-map"></div>

        <!-- ═══════════════════════════════════════════════
             Overlay grid — 3 × 3 zones, no overlaps
        ═══════════════════════════════════════════════ -->
        <div class="loc-overlay">

            <!-- TOP-LEFT: active staff count -->
            <div class="loc-tl">
                <div class="loc-interactive bg-zinc-950/90 backdrop-blur border border-zinc-800 rounded-xl
                            px-3 py-2 shadow-xl flex items-center gap-2">
                    <span class="size-2 rounded-full shrink-0 @(_staffList.Any(s => s.IsOnline) ? "bg-emerald-400 animate-pulse" : "bg-zinc-600")"></span>
                    <span class="text-xs font-semibold text-white whitespace-nowrap">
                        @_staffList.Count(s => s.IsOnline) Outside Active
                    </span>
                </div>
            </div>

            <!-- TOP-CENTER: search bar -->
            <div class="loc-tc w-64">
                <div class="loc-interactive flex flex-col gap-1">
                    <!-- Input -->
                    <div class="relative">
                        <div class="absolute inset-y-0 left-2.5 flex items-center pointer-events-none">
                            <svg class="size-3.5 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                        </div>
                        <input @bind="_searchQuery" @bind:event="oninput"
                               @onkeydown="OnSearchKeyDown"
                               placeholder="Search location…"
                               class="w-full pl-8 pr-8 py-1.5 bg-zinc-900/96 backdrop-blur text-xs text-white
                                      border border-zinc-700/70 rounded-xl placeholder:text-zinc-600
                                      focus:outline-none focus:border-fuchsia-500/60 focus:ring-2 focus:ring-fuchsia-500/20
                                      shadow-xl transition-all" />
                        @if (!string.IsNullOrEmpty(_searchQuery))
                        {
                            <button @onclick="ClearSearch"
                                    class="absolute inset-y-0 right-2 flex items-center text-zinc-500 hover:text-white transition-colors">
                                <svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </button>
                        }
                    </div>

                    <!-- Searching spinner -->
                    @if (_isSearching)
                    {
                        <div class="bg-zinc-900/98 backdrop-blur border border-zinc-700/70 rounded-xl
                                    px-3 py-2 text-xs text-zinc-400 flex items-center gap-2 shadow-xl">
                            <svg class="size-3.5 animate-spin text-fuchsia-500" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                            </svg>
                            Searching…
                        </div>
                    }
                    else if (_searchResults.Count > 0)
                    {
                        <div class="bg-zinc-900/98 backdrop-blur border border-zinc-700/70 rounded-xl shadow-2xl overflow-hidden">
                            @foreach (var r in _searchResults)
                            {
                                <button @onclick="() => GoToSearchResult(r)"
                                        class="w-full text-left px-3 py-2 text-xs text-zinc-300 hover:bg-zinc-800
                                               hover:text-white transition-colors flex items-start gap-2
                                               border-b border-zinc-800/50 last:border-0">
                                    <svg class="size-3 text-zinc-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                    </svg>
                                    <span class="line-clamp-2 leading-relaxed">@r.DisplayName</span>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- TOP-RIGHT: spacer so Leaflet zoom control (+/−) has clearance -->
            <div class="loc-tr" style="width: 38px;"></div>

            <!-- BOTTOM-LEFT: legend + selected staff card stacked -->
            <div class="loc-bl-stack">

                <!-- Selected staff card — shown only when a pin is tapped -->
                @if (_selectedStaff != null)
                {
                    <div class="loc-interactive w-60 bg-zinc-900/98 backdrop-blur border border-zinc-700/80 rounded-2xl p-3.5 shadow-2xl">
                        <div class="flex items-start justify-between gap-2 mb-2">
                            <div class="min-w-0">
                                <h4 class="text-xs font-bold text-white truncate">@_selectedStaff.EmployeeName</h4>
                                <p class="text-[10px] text-zinc-400 truncate">@_selectedStaff.Department • @_selectedStaff.Role</p>
                            </div>
                            <button @onclick="() => _selectedStaff = null"
                                    class="text-zinc-500 hover:text-white p-1 rounded-lg hover:bg-zinc-800 shrink-0 transition-colors" title="Close">
                                <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                            </button>
                        </div>
                        <div class="space-y-1 text-[10px] border-t border-zinc-800 pt-2">
                            <div class="flex justify-between">
                                <span class="text-zinc-500">Status</span>
                                <span class="font-semibold @(_selectedStaff.IsOnline ? "text-emerald-400" : "text-zinc-400")">
                                    @(_selectedStaff.IsOnline ? "● Active" : "○ Idle")
                                </span>
                            </div>
                            <div class="flex justify-between gap-2">
                                <span class="text-zinc-500 shrink-0">Task</span>
                                <span class="text-zinc-200 text-right">@(_selectedStaff.StatusNote ?? "Standard Delivery")</span>
                            </div>
                            @if (_selectedStaff.SpeedKmh.HasValue)
                            {
                                <div class="flex justify-between">
                                    <span class="text-zinc-500">Speed</span>
                                    <span class="text-zinc-300">~@_selectedStaff.SpeedKmh.Value.ToString("0.0") km/h</span>
                                </div>
                            }
                            <div class="flex justify-between">
                                <span class="text-zinc-500">GPS</span>
                                <span class="font-mono text-[9px] text-zinc-400">@_selectedStaff.Latitude.ToString("0.0000"), @_selectedStaff.Longitude.ToString("0.0000")</span>
                            </div>
                        </div>
                        <button @onclick="PanToSelectedStaff"
                                class="mt-2.5 w-full py-1 rounded-lg bg-fuchsia-600/20 hover:bg-fuchsia-600/30
                                       border border-fuchsia-500/30 text-fuchsia-300 text-[10px] font-medium transition-all flex items-center justify-center gap-1.5 cursor-pointer">
                            <svg class="size-3 text-fuchsia-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            <span>Center on Map</span>
                        </button>
                    </div>
                }

                <!-- Legend pill — always visible -->
                <div class="bg-zinc-950/85 backdrop-blur border border-zinc-800/70 rounded-xl px-3 py-1.5 shadow-lg
                            flex items-center gap-3 text-[10px] text-zinc-400">
                    <div class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-emerald-400"></span>
                        <span>Active</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-zinc-500"></span>
                        <span>Idle</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-fuchsia-400"></span>
                        <span>You</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-violet-400"></span>
                        <span>Search</span>
                    </div>
                </div>
            </div>

            <!-- BOTTOM-CENTER: no-staff notice -->
            <div class="loc-bc">
                @if (!_isLoading && _staffList.Count == 0 && _mapReady)
                {
                    <div class="bg-zinc-900/90 backdrop-blur border border-zinc-800 rounded-2xl
                                px-5 py-3 shadow-2xl text-center" style="min-width:240px;">
                        <p class="text-xs font-semibold text-zinc-300">No Outside Staff Currently Active</p>
                        <p class="text-[10px] text-zinc-500 mt-1">Active riders and field staff will appear as pins on the map.</p>
                    </div>
                }
            </div>

            <!-- BOTTOM-RIGHT: empty (zoom is at top-right now) -->
            <div class="loc-br"></div>

        </div>
    </div>
</div>

@code {
    private List<ActiveFieldEmployeeDto> _staffList = new();
    private ActiveFieldEmployeeDto? _selectedStaff;
    private bool _isLoading = false;
    private bool _mapReady = false;

    private string _searchQuery = string.Empty;
    private bool _isSearching = false;
    private List<SearchResult> _searchResults = new();

    private DotNetObjectReference<Locations>? _dotNetRef;
    private HubConnection? _hubConnection;

    public class ActiveFieldEmployeeDto
    {
        public string EmployeeId { get; set; } = string.Empty;
        public string EmployeeName { get; set; } = string.Empty;
        public string Department { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
        public string? ProfilePictureUrl { get; set; }
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public double? SpeedKmh { get; set; }
        public string? StatusNote { get; set; }
        public DateTime LastPingTime { get; set; }
        public bool IsOnline { get; set; }
    }

    public class SearchResult
    {
        public string DisplayName { get; set; } = string.Empty;
        public double Lat { get; set; }
        public double Lng { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await Task.Delay(250);
            await InitializeMap();
            await RefreshFieldStaff();
            await ConnectToHub();
        }
    }

    private async Task InitializeMap()
    {
        try
        {
            var ok = await JS.InvokeAsync<bool>("OfficeCoreMap.initializeMap",
                "officecore-field-map", 14.5995, 120.9842, 12, _dotNetRef);
            _mapReady = ok;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Locations] Map init error: {ex.Message}");
        }
        StateHasChanged();
    }

    private async Task ShowMyLocation()
    {
        if (!_mapReady) return;

        string? profilePic = null;
        string initials = "ME";
        string displayName = "You";

        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user?.Identity?.IsAuthenticated == true)
            {
                var rawPic = user.FindFirst("ProfilePictureUrl")?.Value;
                if (!string.IsNullOrEmpty(rawPic))
                {
                    profilePic = rawPic.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                        ? rawPic
                        : (Configuration["ApiBaseUrl"] + rawPic);
                }

                var firstName = user.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value;
                var lastName = user.FindFirst(System.Security.Claims.ClaimTypes.Surname)?.Value;
                var email = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;

                if (!string.IsNullOrWhiteSpace(firstName) && !string.IsNullOrWhiteSpace(lastName))
                {
                    displayName = $"{firstName} {lastName}".Trim();
                    initials = $"{firstName[0]}{lastName[0]}".ToUpper();
                }
                else if (!string.IsNullOrWhiteSpace(firstName))
                {
                    displayName = firstName.Trim();
                    initials = firstName.Length >= 2 ? firstName[..2].ToUpper() : firstName[..1].ToUpper();
                }
                else if (!string.IsNullOrWhiteSpace(email))
                {
                    displayName = email;
                    initials = email.Length >= 2 ? email[..2].ToUpper() : "U";
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Locations] Error retrieving user profile: {ex.Message}");
        }

        await JS.InvokeVoidAsync("OfficeCoreMap.showUserLocation", profilePic, initials, displayName);
    }

    private async Task RefreshFieldStaff()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            var result = await Http.GetFromJsonAsync<List<ActiveFieldEmployeeDto>>("api/locations/active");
            if (result != null) _staffList = result;
            if (_mapReady)
                await JS.InvokeVoidAsync("OfficeCoreMap.updateStaffMarkers", _staffList);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to fetch field staff locations: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task PanToSelectedStaff()
    {
        if (_selectedStaff == null || !_mapReady) return;
        await JS.InvokeVoidAsync("OfficeCoreMap.panToStaff",
            _selectedStaff.Latitude, _selectedStaff.Longitude);
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_searchQuery))
            await TriggerSearch();
        else if (e.Key == "Escape")
            ClearSearch();
    }

    private async Task TriggerSearch()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery) || _dotNetRef == null) return;
        _isSearching = true;
        _searchResults.Clear();
        StateHasChanged();
        await JS.InvokeVoidAsync("OfficeCoreMap.searchLocation", _searchQuery.Trim(), _dotNetRef);
    }

    [JSInvokable]
    public void OnSearchResults(List<SearchResult> results)
    {
        _isSearching = false;
        _searchResults = results ?? new();
        StateHasChanged();
    }

    private async Task GoToSearchResult(SearchResult result)
    {
        _searchQuery = result.DisplayName.Length > 55
            ? result.DisplayName[..52] + "…"
            : result.DisplayName;
        _searchResults.Clear();
        await JS.InvokeVoidAsync("OfficeCoreMap.goToLocation", result.Lat, result.Lng, result.DisplayName);
        StateHasChanged();
    }

    private void ClearSearch()
    {
        _searchQuery = string.Empty;
        _searchResults.Clear();
        _isSearching = false;
    }

    [JSInvokable]
    public void OnStaffSelected(string? employeeId)
    {
        if (string.IsNullOrEmpty(employeeId))
        {
            _selectedStaff = null;
        }
        else
        {
            _selectedStaff = _staffList.FirstOrDefault(s => s.EmployeeId == employeeId);
        }
        StateHasChanged();
    }

    private async Task ConnectToHub()
    {
        try
        {
            var hubUrl = new Uri(Http.BaseAddress!, "hubs/notifications").ToString();

            _hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl)
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<ActiveFieldEmployeeDto>("FieldLocationUpdated", async (ping) =>
            {
                var existing = _staffList.FirstOrDefault(s => s.EmployeeId == ping.EmployeeId);
                if (existing != null)
                {
                    existing.Latitude = ping.Latitude;
                    existing.Longitude = ping.Longitude;
                    existing.SpeedKmh = ping.SpeedKmh;
                    existing.StatusNote = ping.StatusNote;
                    existing.LastPingTime = ping.LastPingTime;
                    existing.IsOnline = ping.IsOnline;
                    existing.Role = ping.Role;
                    existing.Department = ping.Department;
                    existing.EmployeeName = ping.EmployeeName;
                    existing.ProfilePictureUrl = ping.ProfilePictureUrl;
                }
                else
                {
                    _staffList.Insert(0, ping);
                }

                if (_selectedStaff?.EmployeeId == ping.EmployeeId)
                {
                    _selectedStaff = existing ?? ping;
                }

                if (_mapReady)
                {
                    await JS.InvokeVoidAsync("OfficeCoreMap.updateStaffMarkers", _staffList);
                }
                await InvokeAsync(StateHasChanged);
            });

            await _hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Locations] SignalR connection warning: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}