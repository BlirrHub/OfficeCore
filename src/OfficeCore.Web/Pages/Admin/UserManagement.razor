@page "/admin/users"
@attribute [Authorize(Policy = "RequireUsers")]
@inject HttpClient Http
@inject NavigationManager Nav
@inject ToastService ToastService
@inject IJSRuntime JS

<PageTitle>User Management - OfficeCore</PageTitle>

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold tracking-tight text-white">User Management</h1>
            <p class="mt-1 text-zinc-400 text-sm">Manage employee accounts and role assignments.</p>
        </div>
        <button @onclick="() => _showCreate = true"
                class="flex items-center gap-2 rounded-xl bg-fuchsia-600 px-4 py-2 text-sm font-semibold text-white hover:bg-fuchsia-500 transition-colors shadow-lg shadow-fuchsia-900/30">
            <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            Invite Member
        </button>
    </div>

    <!-- Employee table -->
    <div class="bg-zinc-950 border border-zinc-800 rounded-2xl overflow-hidden">
        @if (_users == null)
        {
            <div class="p-12 flex justify-center">
                <div class="flex items-center gap-3 text-zinc-500 text-sm">
                    <svg class="animate-spin size-5" viewBox="0 0 24 24" fill="none">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                    </svg>
                    Loading employees...
                </div>
            </div>
        }
        else if (!_users.Any())
        {
            <div class="p-12 text-center text-zinc-500 italic text-sm">No employees found.</div>
        }
        else
        {
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-zinc-800 text-zinc-400 text-left select-none">
                        <th class="px-6 py-4 font-medium cursor-pointer hover:text-white transition-colors group" @onclick='() => SortBy("Employee")'>
                            <div class="flex items-center gap-2">
                                <span class="@(_sortColumn == "Employee" ? "text-fuchsia-400 font-semibold" : "")">Employee</span>
                                @RenderSortIcon("Employee")
                            </div>
                        </th>
                        <th class="px-6 py-4 font-medium">Email</th>
                        <th class="px-6 py-4 font-medium cursor-pointer hover:text-white transition-colors group" @onclick='() => SortBy("Role")'>
                            <div class="flex items-center gap-2">
                                <span class="@(_sortColumn == "Role" ? "text-fuchsia-400 font-semibold" : "")">Role</span>
                                @RenderSortIcon("Role")
                            </div>
                        </th>
                        <th class="px-6 py-4 font-medium">Status</th>
                        <th class="px-6 py-4 font-medium cursor-pointer hover:text-white transition-colors group" @onclick='() => SortBy("EmployeeId")'>
                            <div class="flex items-center gap-2">
                                <span class="@(_sortColumn == "EmployeeId" ? "text-fuchsia-400 font-semibold" : "")">Employee ID</span>
                                @RenderSortIcon("EmployeeId")
                            </div>
                        </th>
                        <th class="px-6 py-4 font-medium cursor-pointer hover:text-white transition-colors group" @onclick='() => SortBy("DateHired")'>
                            <div class="flex items-center gap-2">
                                <span class="@(_sortColumn == "DateHired" ? "text-fuchsia-400 font-semibold" : "")">Date Hired</span>
                                @RenderSortIcon("DateHired")
                            </div>
                        </th>
                        <th class="px-6 py-4 font-medium">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-800/50">
                    @foreach (var user in SortedUsers)
                    {
                        <tr class="hover:bg-zinc-900/50 transition-colors">
                            <td class="px-6 py-4 text-white font-medium">@user.FirstName @user.LastName</td>
                            <td class="px-6 py-4 text-zinc-400">@user.Email</td>
                            <td class="px-6 py-4 text-zinc-300">
                                @if (user.IsOwner)
                                {
                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-900/40 px-2 py-0.5 text-[10px] font-bold text-amber-400 ring-1 ring-amber-500/30 uppercase tracking-wider mr-2">
                                        👑 Owner
                                    </span>
                                }
                                @if (user.Roles != null && user.Roles.Any())
                                {
                                    @string.Join(", ", user.Roles)
                                }
                                else if (!user.IsOwner)
                                {
                                    <span class="text-zinc-500 italic text-xs">No role</span>
                                }
                            </td>
                            <td class="px-6 py-4">
                                @if (user.IsActive)
                                {
                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-900/40 px-2.5 py-0.5 text-xs font-medium text-emerald-400 ring-1 ring-emerald-500/30">
                                        <span class="size-1.5 rounded-full bg-emerald-400"></span>Active
                                    </span>
                                }
                                else if (user.ResignedDate.HasValue)
                                {
                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-orange-900/40 px-2.5 py-0.5 text-xs font-medium text-orange-400 ring-1 ring-orange-500/30">
                                        <span class="size-1.5 rounded-full bg-orange-400"></span>Resigned
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-zinc-800 px-2.5 py-0.5 text-xs font-medium text-zinc-400 ring-1 ring-zinc-600/30">
                                        <span class="size-1.5 rounded-full bg-zinc-400"></span>Inactive
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 text-zinc-400">@(user.EmployeeId ?? "—")</td>
                            <td class="px-6 py-4 text-zinc-400">
                                @(user.DateHired.HasValue ? user.DateHired.Value.ToString("MMM dd, yyyy") : "—")
                            </td>
                            <td class="px-6 py-4 flex items-center gap-3">
                                <button @onclick="() => EditUser(user)"
                                        class="text-fuchsia-400 hover:text-fuchsia-300 text-xs font-medium transition-colors">
                                    Edit
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- Invite Member Modal -->
@if (_showCreate)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md p-4 transition-all">
        <div class="w-full max-w-md bg-zinc-950 border border-zinc-800/80 rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
            <!-- Header -->
            <div class="bg-gradient-to-r from-fuchsia-900/20 to-transparent p-6 pb-4 border-b border-zinc-800/50 flex items-center justify-between shrink-0">
                <div class="flex items-center gap-3">
                    <div class="size-10 rounded-xl bg-fuchsia-500/10 flex items-center justify-center border border-fuchsia-500/20">
                        <svg class="size-5 text-fuchsia-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-white tracking-tight">Invite Member</h2>
                        <p class="text-xs text-zinc-400 mt-0.5">Add someone to your workspace</p>
                    </div>
                </div>
                <button @onclick="() => { _showCreate = false; _inviteLink = null; _inviteToken = null; _copiedToken = false; _copiedLink = false; _create.Email = string.Empty; }" class="text-zinc-500 hover:text-white hover:bg-zinc-800 p-2 rounded-lg transition-colors">
                    <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="p-6 pb-2 flex-1 overflow-y-auto custom-scrollbar flex flex-col gap-6">
                <!-- Tabs -->
                <div class="flex p-1 bg-zinc-900 rounded-lg shrink-0">
                    <button type="button" @onclick="@(() => { _inviteTab = "link"; _inviteLink = null; _inviteToken = null; })" class="@($"flex-1 py-1.5 text-xs font-medium rounded-md transition-colors {(_inviteTab == "link" ? "bg-zinc-800 text-white shadow" : "text-zinc-400 hover:text-zinc-300")}")">
                        By Link / Code
                    </button>
                    <button type="button" @onclick="@(() => { _inviteTab = "email"; _inviteLink = null; _inviteToken = null; })" class="@($"flex-1 py-1.5 text-xs font-medium rounded-md transition-colors {(_inviteTab == "email" ? "bg-zinc-800 text-white shadow" : "text-zinc-400 hover:text-zinc-300")}")">
                        By Email
                    </button>
                </div>
                <div class="space-y-4">
                @if (_inviteTab == "email")
                {
                    <div>
                        <label class="block text-xs font-medium text-zinc-400 mb-1">Email Address</label>
                        <input @bind="_create.Email" type="email" placeholder="user@example.com" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none" />
                        <p class="text-[10px] text-zinc-500 mt-2">Registered users with this email will see this invitation in their Workspaces directory.</p>
                    </div>
                }
                else
                {
                    <p class="text-xs text-zinc-400">Generate an invite code and link. Team members can use either to join directly inside the Desktop App.</p>
                }
                
                @if (!string.IsNullOrEmpty(_inviteLink) && _inviteTab == "link")
                {
                    <div class="bg-emerald-950/30 border border-emerald-800/60 rounded-xl p-4 mt-2 space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-emerald-400 font-semibold flex items-center gap-1.5">
                                <span class="size-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                Invitation Generated!
                            </span>
                            <span class="text-[10px] text-zinc-500">Valid for 7 days</span>
                        </div>

                        <!-- 1. Invite Code (Desktop App Friendly) -->
                        <div class="space-y-1">
                            <label class="block text-[11px] font-medium text-zinc-300">Invite Code (for Desktop App):</label>
                            <div class="flex items-center gap-2">
                                <input readonly value="@_inviteToken" class="flex-1 bg-black/60 text-emerald-300 text-xs font-mono px-3 py-2 rounded-lg border border-emerald-900/60 outline-none select-all" />
                                <button type="button" @onclick="CopyInviteToken" class="px-3 py-2 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold rounded-lg transition-colors shrink-0 shadow-sm">
                                    @(_copiedToken ? "✓ Copied" : "Copy Code")
                                </button>
                            </div>
                            <p class="text-[10px] text-zinc-400">Team members can enter this code in the Desktop App under <strong>Workspaces → Join with invite</strong>.</p>
                        </div>

                        <!-- 2. Full Shareable Link -->
                        <div class="space-y-1 pt-2 border-t border-emerald-900/40">
                            <label class="block text-[11px] font-medium text-zinc-300">Full Invite Link:</label>
                            <div class="flex items-center gap-2">
                                <input readonly value="@_inviteLink" class="flex-1 bg-black/60 text-emerald-300/80 text-xs font-mono px-3 py-2 rounded-lg border border-emerald-900/60 outline-none select-all truncate" />
                                <button type="button" @onclick="CopyInviteLink" class="px-3 py-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 text-xs font-medium rounded-lg border border-zinc-700 transition-colors shrink-0">
                                    @(_copiedLink ? "✓ Copied" : "Copy Link")
                                </button>
                            </div>
                        </div>
                    </div>
                }
                </div>
            </div>

            <div class="flex justify-end gap-3 p-6 bg-zinc-900/50 border-t border-zinc-800 shrink-0">
                <button type="button" @onclick="() => { _showCreate = false; _inviteLink = null; _inviteToken = null; _copiedToken = false; _copiedLink = false; _create.Email = string.Empty; }"
                        class="rounded-lg px-4 py-2 text-sm text-zinc-400 hover:text-white transition-colors">Close</button>
                <button type="button" @onclick="InviteMember" disabled="@(_inviteTab == "link" && !string.IsNullOrEmpty(_inviteLink))"
                        class="rounded-lg bg-fuchsia-600 px-4 py-2 text-sm font-semibold text-white hover:bg-fuchsia-500 transition-colors disabled:opacity-50">
                    @(_inviteTab == "email" ? "Send Invitation" : "Generate Code & Link")
                </button>
            </div>
        </div>
    </div>
}

<!-- Edit User Modal -->
@if (_showEdit)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md p-4 transition-all">
        <div class="w-full max-w-lg bg-zinc-950 border border-zinc-800/80 rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
            <!-- Header -->
            <div class="bg-gradient-to-r from-fuchsia-900/20 to-transparent p-6 pb-4 border-b border-zinc-800/50 flex items-center justify-between shrink-0">
                <div class="flex items-center gap-3">
                    <div class="size-10 rounded-xl bg-fuchsia-500/10 flex items-center justify-center border border-fuchsia-500/20">
                        <svg class="size-5 text-fuchsia-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-white tracking-tight">Edit Employee</h2>
                        <p class="text-xs text-zinc-400 mt-0.5">Manage user details and permissions</p>
                    </div>
                </div>
                <button @onclick="() => _showEdit = false" class="text-zinc-500 hover:text-white hover:bg-zinc-800 p-2 rounded-lg transition-colors">
                    <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="p-6 pb-2 flex-1 overflow-y-auto custom-scrollbar flex flex-col gap-6">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-zinc-400 mb-1">First Name</label>
                        <div class="w-full rounded-lg bg-zinc-900/50 border border-zinc-800 px-3 py-2 text-sm text-zinc-500 cursor-not-allowed">
                            @_edit.FirstName
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-zinc-400 mb-1">Last Name</label>
                        <div class="w-full rounded-lg bg-zinc-900/50 border border-zinc-800 px-3 py-2 text-sm text-zinc-500 cursor-not-allowed">
                            @_edit.LastName
                        </div>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-zinc-400 mb-1">Employee ID</label>
                        <input @bind="_edit.EmployeeId" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-zinc-400 mb-1">Date Hired</label>
                        <input @bind="_edit.DateHired" type="date" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none" />
                    </div>
                </div>
                
                <label class="flex items-center gap-3 cursor-pointer @(_edit.IsOwner ? "opacity-50 pointer-events-none" : "")">
                    <input type="checkbox" @bind="_edit.IsActive" class="sr-only peer" disabled="@_edit.IsOwner" />
                    <div class="w-11 h-6 bg-zinc-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-fuchsia-600 relative"></div>
                    <span class="text-sm font-medium text-zinc-300">Account Active</span>
                </label>
                <label class="flex items-center gap-3 cursor-pointer">
                    <input type="checkbox" @bind="_edit.IsEmployee" class="sr-only peer" />
                    <div class="w-9 h-5 bg-zinc-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-fuchsia-600 relative"></div>
                    <div>
                        <span class="text-sm font-medium text-zinc-300">Is Employee</span>
                        <p class="text-xs text-zinc-500 mt-0.5">When checked, this user will be included in payroll and leave processing.</p>
                    </div>
                </label>

                @if (_edit.IsEmployee)
                {
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-medium text-zinc-400 mb-1">Daily Rate (&#8369;)</label>
                            <input @bind="_edit.DailyRate" type="number" step="0.01" min="0" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none" />
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-zinc-400 mb-1">Work Schedule</label>
                            <select @bind="_edit.WorkScheduleId" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none">
                                <option value="">-- No Schedule Assigned --</option>
                                @if (_workSchedules != null)
                                {
                                    @foreach (var schedule in _workSchedules)
                                    {
                                        <option value="@schedule.Id">@schedule.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Sick Leave Pay Rate -->
                    <div class="pt-3 border-t border-zinc-800/60">
                        <label class="flex items-center gap-3 cursor-pointer">
                            <input type="checkbox" @bind="_edit.UseCustomDailyRate" class="sr-only peer" />
                            <div class="w-9 h-5 bg-zinc-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-fuchsia-600 relative"></div>
                            <div>
                                <span class="text-sm font-medium text-zinc-300">Use own daily rate for sick leave pay</span>
                                <p class="text-xs text-zinc-500 mt-0.5">
                                    @(_edit.UseCustomDailyRate
                                        ? "Employee's personal daily rate will be used when a sick leave is approved."
                                        : "Global minimum daily rate from Payroll Settings will be used for sick leave pay.")
                                </p>
                            </div>
                        </label>
                    </div>

                    <!-- Vacation Leave Eligibility -->
                    <label class="flex items-center gap-3 cursor-pointer mb-2">
                        <input type="checkbox" @bind="_edit.IsEligibleForLeave" class="sr-only peer" />
                        <div class="w-9 h-5 bg-zinc-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-fuchsia-600 relative"></div>
                        <div>
                            <span class="text-sm font-medium text-zinc-300">Eligible for Vacation Leave</span>
                            <p class="text-xs text-zinc-500 mt-0.5">Sick leave is always available regardless of this setting.</p>
                        </div>
                    </label>
                }

                

                @if (_edit.IsOwner)
                {
                    <div>
                        <label class="block text-xs font-medium text-zinc-400 mb-2">Roles</label>
                        <p class="text-xs text-amber-500/80 italic">The workspace owner has permanent full access. Roles cannot be modified.</p>
                    </div>
                }
                else
                {
                    <div>
                        <label class="block text-xs font-medium text-zinc-400 mb-2">Assign Roles</label>
                        @if (_orgRoles != null)
                        {
                            <div class="flex flex-wrap gap-2">
                                @foreach (var role in _orgRoles)
                                {
                                    var roleName = role.Name ?? string.Empty;
                                    var selected = _edit.SelectedRoles.Contains(roleName);
                                    <button type="button"
                                            @onclick="() => ToggleRole(_edit.SelectedRoles, roleName)"
                                            class="@($"rounded-lg px-3 py-1.5 text-xs font-medium transition-all {(selected ? "bg-fuchsia-600 text-white" : "bg-zinc-800 text-zinc-400 hover:bg-zinc-700")}")">
                                        @roleName
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }

                <!-- Government Records -->
                <div class="pt-4 border-t border-zinc-800">
                    <h3 class="text-sm font-semibold text-white mb-3">Government Records</h3>
                    <label class="flex items-center gap-3 cursor-pointer mb-4">
                        <input type="checkbox" @bind="_edit.GovernmentRecord.IsEligibleForDeductions" class="sr-only peer" />
                        <div class="w-9 h-5 bg-zinc-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-fuchsia-600 relative"></div>
                        <span class="text-sm font-medium text-zinc-300">Eligible for Deductions (SSS, PhilHealth, Pag-IBIG)</span>
                    </label>

                    @if (_edit.GovernmentRecord.IsEligibleForDeductions)
                    {
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-medium text-zinc-400 mb-1">SSS Number</label>
                                <input @bind="_edit.GovernmentRecord.SssNumber" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none" />
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-zinc-400 mb-1">PhilHealth Number</label>
                                <input @bind="_edit.GovernmentRecord.PhilHealthNumber" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none" />
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-zinc-400 mb-1">Pag-IBIG Number</label>
                                <input @bind="_edit.GovernmentRecord.PagIbigNumber" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none" />
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-zinc-400 mb-1">TIN</label>
                                <input @bind="_edit.GovernmentRecord.TinNumber" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none" />
                            </div>
                        </div>
                    }
                </div>

                </div>

            <div class="flex justify-between items-center p-6 bg-zinc-900/50 border-t border-zinc-800 shrink-0">
                <div class="flex items-center gap-3">
                    @if (!_edit.IsOwner)
                    {
                        @if (_edit.IsActive)
                        {
                            <button @onclick="() => ShowResignModal(_users!.First(u => u.Id == _edit.Id))"
                                    class="rounded-lg border border-orange-900/50 bg-orange-900/20 px-4 py-2 text-sm font-medium text-orange-400 hover:bg-orange-900/40 hover:text-orange-300 transition-colors">
                                Resign
                            </button>
                        }
                        <button @onclick="() => ShowDeleteUserModal(_users!.First(u => u.Id == _edit.Id))"
                                class="rounded-lg border border-red-900/50 bg-red-900/20 px-4 py-2 text-sm font-medium text-red-400 hover:bg-red-900/40 hover:text-red-300 transition-colors">
                            Remove
                        </button>
                    }
                </div>
                <div class="flex items-center gap-3">
                    <button @onclick="() => _showEdit = false"
                            class="rounded-lg px-4 py-2 text-sm text-zinc-400 hover:text-white transition-colors">Cancel</button>
                    <button @onclick="UpdateUser"
                            class="rounded-lg bg-fuchsia-600 px-4 py-2 text-sm font-semibold text-white hover:bg-fuchsia-500 transition-colors">
                        Save Changes
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Resign Confirmation Modal -->
@if (_showResignModal && _resigningUser != null)
{
    <div class="fixed inset-0 bg-black/70 backdrop-blur-sm flex items-center justify-center z-[70] p-4">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-md shadow-2xl overflow-hidden p-6">
            <div class="flex items-center gap-4 mb-6">
                <div class="size-12 rounded-full bg-orange-900/20 text-orange-400 flex items-center justify-center border border-orange-500/20">
                    <svg class="size-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-white">Resign Employee</h3>
                    <p class="text-sm text-zinc-400">@_resigningUser.FirstName @_resigningUser.LastName</p>
                </div>
            </div>
            <p class="text-sm text-zinc-400 mb-5">This will mark the employee as resigned and archive their account. Please provide their last working date.</p>
            <div class="mb-6">
                <label class="block text-xs font-medium text-zinc-400 mb-1">Resignation Date</label>
                <input type="date" @bind="_resignDate"
                       class="w-full rounded-lg bg-zinc-950 border border-zinc-700 px-3 py-2 text-sm text-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500 focus:outline-none" />
