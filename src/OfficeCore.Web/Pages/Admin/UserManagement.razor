                        <div class="flex gap-2">
                            <button type="button" @onclick="() => LoadFingerprints(_edit.Id)"
                                    class="text-xs bg-zinc-800 hover:bg-zinc-700 text-zinc-300 px-2 py-1 rounded transition-colors flex items-center gap-1">
                                <svg class="size-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                </svg>
                                Refresh
                            </button>
                            <button type="button" @onclick="EnrollFingerprint"
                                    class="text-xs bg-emerald-600 hover:bg-emerald-500 text-white px-2 py-1 rounded transition-colors">
                                Enroll New Fingerprint
                            </button>
                        </div>
                    </div>
                    @if (_enrollmentMessage != null)
                    {
                        <p class="text-xs text-emerald-400 mb-2">@_enrollmentMessage</p>
                    }
                    @if (_fingerprints == null)
                    {
                        <p class="text-xs text-zinc-500">Loading...</p>
                    }
                    else if (!_fingerprints.Any())
                    {
                        <p class="text-xs text-zinc-500">No fingerprints enrolled for this user.</p>
                    }
                    else
                    {
                        <ul class="space-y-2">
                            @foreach (var fp in _fingerprints)
                            {
                                <li class="flex items-center justify-between bg-zinc-900 px-3 py-2 rounded-lg border border-zinc-800 text-sm">
                                    <span class="text-white">ID: <span class="font-mono text-fuchsia-400">@fp.FingerprintId</span></span>
                                    <button type="button" @onclick="() => ShowDeleteFingerprintConfirmation(fp)" class="text-zinc-500 hover:text-red-400 p-1.5 rounded bg-zinc-950/50 hover:bg-zinc-900 border border-zinc-800 transition-colors" title="Delete Fingerprint">
                                        Delete
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_modalError))
            {
                <p class="text-xs text-red-400">@_modalError</p>
            }

            <div class="flex justify-end gap-3 pt-2 border-t border-zinc-800">
                <button @onclick="() => _showEdit = false"
                        class="rounded-lg px-4 py-2 text-sm text-zinc-400 hover:text-white transition-colors">Cancel</button>
                <button @onclick="UpdateUser"
                        class="rounded-lg bg-fuchsia-600 px-4 py-2 text-sm font-semibold text-white hover:bg-fuchsia-500 transition-colors">
                    Save Changes
                </button>
            </div>
        </div>
    </div>
}

<!-- Fingerprint Delete Confirmation Modal -->
@if (_showDeleteFpModal && _fpToDelete != null)
{
    <div class="fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center z-[70] p-4">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-sm shadow-2xl overflow-hidden p-6 text-center">
            <div class="size-16 rounded-full bg-red-900/20 text-red-500 flex items-center justify-center mx-auto mb-4 border border-red-500/20">
                <svg class="size-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Delete Fingerprint?</h3>
            <p class="text-zinc-400 text-sm mb-8">Are you sure you want to delete fingerprint <strong class="text-fuchsia-400">@_fpToDelete.FingerprintId</strong>? The employee will need to enroll their fingerprint again.</p>
            
            <div class="flex gap-3">
                <button @onclick="CloseFpDeleteModal" class="flex-1 py-2.5 rounded-lg text-sm font-medium text-zinc-400 bg-zinc-800/50 hover:bg-zinc-800 hover:text-white transition-all">Cancel</button>
                <button @onclick="ConfirmDeleteFingerprint" class="flex-1 py-2.5 rounded-lg text-sm font-bold text-white bg-red-600 hover:bg-red-500 shadow-lg shadow-red-900/20 transition-all">Delete</button>
            </div>
        </div>
    </div>
}

<!-- Resign Confirmation Modal -->
@if (_showResignModal && _resigningUser != null)
{
    <div class="fixed inset-0 bg-black/70 backdrop-blur-sm flex items-center justify-center z-[70] p-4">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-md shadow-2xl overflow-hidden p-6">
            <div class="flex items-center gap-4 mb-6">
                <div class="size-12 rounded-full bg-orange-900/20 text-orange-400 flex items-center justify-center border border-orange-500/20">
                    <svg class="size-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-white">Resign Employee</h3>
                    <p class="text-sm text-zinc-400">@_resigningUser.FirstName @_resigningUser.LastName</p>
                </div>
            </div>
            <p class="text-sm text-zinc-400 mb-5">This will mark the employee as resigned and archive their account. Please provide their last working date.</p>
            <div class="mb-6">
                <label class="block text-xs font-medium text-zinc-400 mb-1">Resignation Date</label>
                <input type="date" @bind="_resignDate"
                       class="w-full rounded-lg bg-zinc-950 border border-zinc-700 px-3 py-2 text-sm text-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500 focus:outline-none" />
            </div>
            @if (!string.IsNullOrEmpty(_resignError))
            {
                <p class="text-xs text-red-400 mb-4">@_resignError</p>
            }
            <div class="flex gap-3">
                <button @onclick="CloseResignModal" class="flex-1 py-2.5 rounded-lg text-sm font-medium text-zinc-400 bg-zinc-800/50 hover:bg-zinc-800 hover:text-white transition-all">Cancel</button>
                <button @onclick="ConfirmResign" disabled="@_isResigning" class="flex-1 py-2.5 rounded-lg text-sm font-bold text-white bg-orange-600 hover:bg-orange-500 shadow-lg shadow-orange-900/20 transition-all disabled:opacity-50">Resign & Archive</button>
            </div>
        </div>
    </div>
}

@code {
    private List<UserDto>? _users;
    private List<RoleDto>? _roles;
    private List<WorkScheduleDto>? _workSchedules;
    private bool _showCreate;
    private bool _showEdit;
    private string? _modalError;
    private string? _enrollmentMessage;
    private CreateForm _create = new();
    private UpdateForm _edit = new();
    
    // Fingerprints State
    private List<FingerprintDto>? _fingerprints;
    private bool _showDeleteFpModal = false;
    private FingerprintDto? _fpToDelete;
    private HubConnection? _hubConnection;

    // Resign State
    private bool _showResignModal = false;
    private UserDto? _resigningUser;
    private DateTime _resignDate = DateTime.Today;
    private string? _resignError;
    private bool _isResigning = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(new Uri(Http.BaseAddress!, "attendanceHub"))
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<string, string>("ReceiveEnrollmentStatus", (employeeId, status) =>
        {
            if (_showEdit && _edit.Id == employeeId)
            {
                // Format the status string slightly for better UI display
                if (status.StartsWith("MODE:")) status = "Device is in enrollment mode. Please scan finger on the sensor.";
                else if (status.StartsWith("INFO:")) status = status.Substring(5).Trim();
                else if (status.StartsWith("ERROR:")) status = status.Substring(6).Trim();

                _enrollmentMessage = status;
                InvokeAsync(StateHasChanged);
            }
        });

        _hubConnection.On<string>("ReceiveEnrollmentSuccess", async (employeeId) =>
        {
            if (_showEdit && _edit.Id == employeeId)
            {
                _enrollmentMessage = "Enrollment Successful!";
                await LoadFingerprints(employeeId);
                await InvokeAsync(StateHasChanged);
            }
        });

        await _hubConnection.StartAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    private async Task LoadData()
    {
        _users = await Http.GetFromJsonAsync<List<UserDto>>("/api/user");
        _roles = await Http.GetFromJsonAsync<List<RoleDto>>("/api/role");
        _workSchedules = await Http.GetFromJsonAsync<List<WorkScheduleDto>>("/api/workschedule");
    }

    private async Task EditUser(UserDto user)
    {
        _modalError = null;
        _edit = new UpdateForm
        {
            Id = user.Id,
            FirstName = user.FirstName,
            LastName = user.LastName,
            EmployeeId = user.EmployeeId ?? string.Empty,
            DailyRate = user.DailyRate,
            UseCustomDailyRate = user.UseCustomDailyRate,
            DateHired = user.DateHired,
            IsEligibleForLeave = user.IsEligibleForLeave,
            WorkScheduleId = user.WorkScheduleId,
            IsActive = user.IsActive,
            SelectedRoles = new HashSet<string>(),
            GovernmentRecord = new GovernmentRecordDto
            {
                IsEligibleForDeductions = user.GovernmentRecord?.IsEligibleForDeductions ?? true,
                SssNumber = user.GovernmentRecord?.SssNumber,
                PagIbigNumber = user.GovernmentRecord?.PagIbigNumber,
                PhilHealthNumber = user.GovernmentRecord?.PhilHealthNumber,
                TinNumber = user.GovernmentRecord?.TinNumber
            }
        };

        try
        {
            var userRoles = await Http.GetFromJsonAsync<List<string>>($"/api/user/{user.Id}/roles");
            if (userRoles != null)
            {
                foreach (var r in userRoles)
                {
                    _edit.SelectedRoles.Add(r);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading roles: {ex.Message}");
        }

        await LoadFingerprints(user.Id);

        _showEdit = true;
    }

    private void ShowResignModal(UserDto user)
    {
        _resigningUser = user;
        _resignDate = DateTime.Today;
        _resignError = null;
        _showResignModal = true;
    }

    private void CloseResignModal()
    {
        _showResignModal = false;
        _resigningUser = null;
        _resignError = null;
    }

    private async Task ConfirmResign()
    {
        if (_resigningUser == null) return;
        _isResigning = true;
        _resignError = null;
        try
        {
            var response = await Http.PostAsJsonAsync($"/api/user/{_resigningUser.Id}/resign", new { ResignedDate = _resignDate });
            if (response.IsSuccessStatusCode)
            {
                CloseResignModal();
                await LoadData();
            }
            else
            {
                _resignError = "Failed to resign employee. Please try again.";
            }
        }
        catch
        {
            _resignError = "An error occurred.";
        }
        finally
        {
            _isResigning = false;
        }
    }

    private async Task LoadFingerprints(string employeeId)
    {
        _fingerprints = null;
        try
        {
            _fingerprints = await Http.GetFromJsonAsync<List<FingerprintDto>>($"/api/attendance/fingerprints/{employeeId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading fingerprints: {ex.Message}");
            _fingerprints = new List<FingerprintDto>();
        }
    }

    private async Task EnrollFingerprint()
    {
        _enrollmentMessage = null;
        _modalError = null;
        try
        {
            var response = await Http.PostAsync($"/api/attendance/enroll/{_edit.Id}", null);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<EnrollmentResponse>();
                _enrollmentMessage = result?.Message;
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<EnrollmentResponse>();
                _modalError = error?.Message ?? "Failed to start enrollment.";
            }
        }
        catch (Exception ex)
        {
            _modalError = "Error communicating with the API.";
        }
    }

    private void ShowDeleteFingerprintConfirmation(FingerprintDto fp)
    {
        _fpToDelete = fp;
        _showDeleteFpModal = true;
    }

    private void CloseFpDeleteModal()
    {
        _showDeleteFpModal = false;
        _fpToDelete = null;
    }

    private async Task ConfirmDeleteFingerprint()
    {
        if (_edit == null || _fpToDelete == null) return;
        
        try
        {
            var response = await Http.DeleteAsync($"/api/attendance/fingerprints/{_fpToDelete.Id}");
            if (response.IsSuccessStatusCode)
            {
                await LoadFingerprints(_edit.Id);
                CloseFpDeleteModal();
            }
            else
            {
                _modalError = "Failed to delete fingerprint.";
            }
        }
        catch (Exception ex)
        {
            _modalError = "An error occurred.";
        }
    }

    private void ToggleRole(HashSet<string> set, string role)
    {
        if (!set.Remove(role)) set.Add(role);
    }

    private async Task CreateUser()
    {
        _modalError = null;
        if (string.IsNullOrWhiteSpace(_create.Email) || string.IsNullOrWhiteSpace(_create.Password))
        {
            _modalError = "Email and password are required.";
            return;
        }

        var createPayload = new CreateUserRequestDto
        {
            Email = _create.Email,
            Password = _create.Password,
            FirstName = _create.FirstName,
            LastName = _create.LastName,
            EmployeeId = _create.EmployeeId,
            DailyRate = _create.DailyRate,
            UseCustomDailyRate = _create.UseCustomDailyRate,
            DateHired = _create.DateHired,
            IsEligibleForLeave = _create.IsEligibleForLeave,
            WorkScheduleId = _create.WorkScheduleId,
            Roles = _create.SelectedRoles.ToList(),
            GovernmentRecord = _create.GovernmentRecord
        };

        var response = await Http.PostAsJsonAsync("/api/user", createPayload);

        if (response.IsSuccessStatusCode)
        {
            _showCreate = false;
            _create = new();
            await LoadData();
        }
        else
        {
            _modalError = "Failed to create user. Check the details and try again.";
        }
    }

    private class CreateUserRequestDto
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string? EmployeeId { get; set; }
        public decimal? DailyRate { get; set; }
        public bool UseCustomDailyRate { get; set; }
        public DateTime? DateHired { get; set; }
        public bool IsEligibleForLeave { get; set; }
        public Guid? WorkScheduleId { get; set; }
        public List<string>? Roles { get; set; }
        public GovernmentRecordDto? GovernmentRecord { get; set; }
    }

    private async Task UpdateUser()
    {
        _modalError = null;
        if (string.IsNullOrWhiteSpace(_edit.FirstName) || string.IsNullOrWhiteSpace(_edit.LastName))
        {
            _modalError = "First Name and Last Name are required.";
            return;
        }

        var requestPayload = new UpdateUserRequestDto
        {
            FirstName = _edit.FirstName,
            LastName = _edit.LastName,
            EmployeeId = _edit.EmployeeId,
            DailyRate = _edit.DailyRate,
            UseCustomDailyRate = _edit.UseCustomDailyRate,
            DateHired = _edit.DateHired,
            IsEligibleForLeave = _edit.IsEligibleForLeave,
            WorkScheduleId = _edit.WorkScheduleId,
            IsActive = _edit.IsActive,
            Roles = _edit.SelectedRoles.ToList(),
            GovernmentRecord = _edit.GovernmentRecord
        };

        var response = await Http.PutAsJsonAsync($"/api/user/{_edit.Id}", requestPayload);

        if (response.IsSuccessStatusCode)
        {
            _showEdit = false;
            await LoadData();
        }
        else
        {
            _modalError = "Failed to update user. Check the details and try again.";
        }
    }

    private class UpdateUserRequestDto
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string? EmployeeId { get; set; }
        public bool IsActive { get; set; }
        public decimal? DailyRate { get; set; }
        public bool UseCustomDailyRate { get; set; }
        public DateTime? DateHired { get; set; }
        public bool IsEligibleForLeave { get; set; }
        public Guid? WorkScheduleId { get; set; }
        public List<string>? Roles { get; set; }
        public GovernmentRecordDto? GovernmentRecord { get; set; }
    }

    private class CreateForm
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string EmployeeId { get; set; } = string.Empty;
        public decimal? DailyRate { get; set; }
        public bool UseCustomDailyRate { get; set; } = false;
        public DateTime? DateHired { get; set; }
        public bool IsEligibleForLeave { get; set; } = true;
        public Guid? WorkScheduleId { get; set; }
        public HashSet<string> SelectedRoles { get; set; } = new();
        public GovernmentRecordDto GovernmentRecord { get; set; } = new() { IsEligibleForDeductions = true };
    }

    private class UpdateForm
    {
        public string Id { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string EmployeeId { get; set; } = string.Empty;
        public decimal? DailyRate { get; set; }
        public bool UseCustomDailyRate { get; set; } = false;
        public DateTime? DateHired { get; set; }
        public bool IsEligibleForLeave { get; set; } = true;
        public Guid? WorkScheduleId { get; set; }
        public bool IsActive { get; set; }
        public HashSet<string> SelectedRoles { get; set; } = new();
        public GovernmentRecordDto GovernmentRecord { get; set; } = new() { IsEligibleForDeductions = true };
    }

    private record UserDto(string Id, string Email, string FirstName, string LastName, string? EmployeeId, bool IsActive, decimal? DailyRate, bool UseCustomDailyRate, DateTime? DateHired, DateTime? ResignedDate, bool IsEligibleForLeave, Guid? WorkScheduleId, GovernmentRecordDto? GovernmentRecord);
    private record RoleDto(string Id, string? Name, string? Description);
    private record WorkScheduleDto(Guid Id, string Name);
    private record FingerprintDto(int Id, int FingerprintId, DateTimeOffset EnrolledAt);
    
    private class GovernmentRecordDto
    {
        public bool IsEligibleForDeductions { get; set; } = true;
        public string? SssNumber { get; set; }
        public string? PagIbigNumber { get; set; }
        public string? PhilHealthNumber { get; set; }
        public string? TinNumber { get; set; }
    }
    private class EnrollmentResponse { public string? Message { get; set; } }
}
