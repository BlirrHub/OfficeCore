@code {
    private List<UserDto>? _users;
    private List<RoleDto>? _orgRoles;
    private List<WorkScheduleDto>? _workSchedules;
    
    private string _sortColumn = "Employee";
    private bool _sortAscending = true;
    private bool _showCreate;
    private bool _showEdit;
    private CreateForm _create = new();
    private UpdateForm _edit = new();

    // Resign State
    private bool _showResignModal = false;
    private UserDto? _resigningUser;
    private DateTime _resignDate = DateTime.Today;
    private bool _isResigning = false;

    // Delete User State
    private bool _showDeleteUserModal = false;
    private UserDto? _userToDelete;
    private bool _isDeletingUser = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _users = await Http.GetFromJsonAsync<List<UserDto>>("/api/user");
        _orgRoles = await Http.GetFromJsonAsync<List<RoleDto>>("/api/role");
        _workSchedules = await Http.GetFromJsonAsync<List<WorkScheduleDto>>("/api/workschedule");
    }

    private async Task EditUser(UserDto user)
    {
        _edit = new UpdateForm
        {
            Id = user.Id,
            FirstName = user.FirstName,
            LastName = user.LastName,
            EmployeeId = user.EmployeeId ?? "",
            DailyRate = user.DailyRate,
            UseCustomDailyRate = user.UseCustomDailyRate,
            DateHired = user.DateHired,
            IsEligibleForLeave = user.IsEligibleForLeave,
            IsEmployee = user.IsEmployee,
            WorkScheduleId = user.WorkScheduleId,
            IsActive = user.IsActive,
            IsOwner = user.IsOwner,
            SelectedRoles = new HashSet<string>(user.Roles ?? Enumerable.Empty<string>()),
            GovernmentRecord = new GovernmentRecordDto
            {
                IsEligibleForDeductions = user.GovernmentRecord?.IsEligibleForDeductions ?? false,
                SssNumber = user.GovernmentRecord?.SssNumber,
                PagIbigNumber = user.GovernmentRecord?.PagIbigNumber,
                PhilHealthNumber = user.GovernmentRecord?.PhilHealthNumber,
                TinNumber = user.GovernmentRecord?.TinNumber
            }
        };

        try
        {
            var userRoles = await Http.GetFromJsonAsync<List<string>>($"/api/user/{user.Id}/roles");
            if (userRoles != null)
            {
                foreach (var r in userRoles)
                {
                    _edit.SelectedRoles.Add(r);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading roles: {ex.Message}");
        }

        _showEdit = true;
    }

    private IEnumerable<UserDto> SortedUsers
    {
        get
        {
            if (_users == null) return Enumerable.Empty<UserDto>();
            
            return _sortColumn switch
            {
                "Employee" => _sortAscending 
                    ? _users.OrderBy(u => u.FirstName).ThenBy(u => u.LastName) 
                    : _users.OrderByDescending(u => u.FirstName).ThenByDescending(u => u.LastName),
                "Role" => _sortAscending 
                    ? _users.OrderBy(u => u.Roles != null ? string.Join(",", u.Roles) : "") 
                    : _users.OrderByDescending(u => u.Roles != null ? string.Join(",", u.Roles) : ""),
                "EmployeeId" => _sortAscending 
                    ? _users.OrderBy(u => u.EmployeeId) 
                    : _users.OrderByDescending(u => u.EmployeeId),
                "DateHired" => _sortAscending 
                    ? _users.OrderBy(u => u.DateHired) 
                    : _users.OrderByDescending(u => u.DateHired),
                _ => _users
            };
        }
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private RenderFragment RenderSortIcon(string column) => __builder =>
    {
        if (_sortColumn == column)
        {
            if (_sortAscending)
            {
                <svg class="size-4 text-fuchsia-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5" /></svg>
            }
            else
            {
                <svg class="size-4 text-fuchsia-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
            }
        }
        else
        {
            <svg class="size-4 text-zinc-600 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 15L12 18.75 15.75 15m-7.5-6L12 5.25 15.75 9" /></svg>
        }
    };

    private void ShowResignModal(UserDto user)
    {
        _resigningUser = user;
        _resignDate = DateTime.Today;
        _showResignModal = true;
    }

    private void CloseResignModal()
    {
        _showResignModal = false;
        _resigningUser = null;
    }

    private async Task ConfirmResign()
    {
        if (_resigningUser == null) return;
        _isResigning = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"/api/user/{_resigningUser.Id}/resign", new { ResignedDate = _resignDate });
            if (response.IsSuccessStatusCode)
            {
                CloseResignModal();
                await LoadData();
                ToastService.ShowSuccess("Employee resigned and archived.");
            }
            else
            {
                ToastService.ShowError("Failed to resign employee. Please try again.");
            }
        }
        catch
        {
            ToastService.ShowError("An error occurred while resigning employee.");
        }
        finally
        {
            _isResigning = false;
        }
    }

    private void ShowDeleteUserModal(UserDto user)
    {
        _userToDelete = user;
        _showDeleteUserModal = true;
    }

    private async Task ConfirmDeleteUser()
    {
        if (_userToDelete == null) return;

        _isDeletingUser = true;
        
        try
        {
            var response = await Http.DeleteAsync($"/api/user/{_userToDelete.Id}");
            if (response.IsSuccessStatusCode)
            {
                _showDeleteUserModal = false;
                await LoadData();
                ToastService.ShowSuccess("User permanently removed.");
            }
            else
            {
                ToastService.ShowError("Failed to delete user. Please try again.");
            }
        }
        catch
        {
            ToastService.ShowError("An error occurred while deleting user.");
        }
        finally
        {
            _isDeletingUser = false;
        }
    }

    private void ToggleRole(HashSet<string> set, string role)
    {
        if (!set.Remove(role)) set.Add(role);
    }

    private string? _inviteLink;
    private string? _inviteToken;
    private bool _copiedToken;
    private bool _copiedLink;
    private string _inviteTab = "link";
    
    private class OrganizationDto { public Guid Id { get; set; } }
    private class InviteResponseDto 
    { 
        public string JoinUrl { get; set; } = string.Empty; 
        public string Token { get; set; } = string.Empty;
    }

    private async Task InviteMember()
    {
        if (_inviteTab == "email" && string.IsNullOrWhiteSpace(_create.Email))
        {
            ToastService.ShowWarning("Email is required.");
            return;
        }

        try
        {
            var orgRes = await Http.GetFromJsonAsync<OrganizationDto>("/api/organizations/current");
            if (orgRes == null) {
                ToastService.ShowError("Failed to get current organization.");
                return;
            }

            var requestBody = new { Email = _inviteTab == "email" ? _create.Email : null };
            var response = await Http.PostAsJsonAsync($"/api/organizations/{orgRes.Id}/invite", requestBody);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<InviteResponseDto>();
                if (result != null)
                {
                    if (_inviteTab == "link")
                    {
                        _inviteToken = result.Token;
                        _inviteLink = Nav.BaseUri.TrimEnd('/') + "/" + result.JoinUrl.TrimStart('/');
                        _copiedToken = false;
                        _copiedLink = false;
                        ToastService.ShowSuccess("Invitation code and link generated.");
                    }
                    else
                    {
                        ToastService.ShowSuccess($"Invitation sent successfully to {_create.Email}!");
                    }
                }
            }
            else
            {
                var errStr = await response.Content.ReadAsStringAsync();
                ToastService.ShowError(!string.IsNullOrWhiteSpace(errStr) ? errStr : "Failed to generate invitation.");
            }
        }
        catch
        {
            ToastService.ShowError("Failed to generate invitation.");
        }
    }

    private async Task CopyInviteToken()
    {
        if (string.IsNullOrEmpty(_inviteToken)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _inviteToken);
            _copiedToken = true;
            ToastService.ShowSuccess("Invite code copied to clipboard!");
            StateHasChanged();
            await Task.Delay(2500);
            _copiedToken = false;
            StateHasChanged();
        }
        catch
        {
            ToastService.ShowInfo("Press Ctrl+C to copy the selected code.");
        }
    }

    private async Task CopyInviteLink()
    {
        if (string.IsNullOrEmpty(_inviteLink)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _inviteLink);
            _copiedLink = true;
            ToastService.ShowSuccess("Invite link copied to clipboard!");
            StateHasChanged();
            await Task.Delay(2500);
            _copiedLink = false;
            StateHasChanged();
        }
        catch
        {
            ToastService.ShowInfo("Press Ctrl+C to copy the selected link.");
        }
    }



    private async Task UpdateUser()
    {
        if (string.IsNullOrWhiteSpace(_edit.FirstName) || string.IsNullOrWhiteSpace(_edit.LastName))
        {
            ToastService.ShowWarning("First Name and Last Name are required.");
            return;
        }

        var requestPayload = new UpdateUserRequestDto
        {
            FirstName = _edit.FirstName,
            LastName = _edit.LastName,
            EmployeeId = _edit.EmployeeId,
            DailyRate = _edit.DailyRate,
            UseCustomDailyRate = _edit.UseCustomDailyRate,
            DateHired = _edit.DateHired,
            IsEligibleForLeave = _edit.IsEligibleForLeave,
            IsEmployee = _edit.IsEmployee,
            WorkScheduleId = _edit.WorkScheduleId,
            IsActive = _edit.IsActive,
            Roles = _edit.SelectedRoles.ToList(),
            GovernmentRecord = _edit.GovernmentRecord
        };

        var response = await Http.PutAsJsonAsync($"/api/user/{_edit.Id}", requestPayload);

        if (response.IsSuccessStatusCode)
        {
            _showEdit = false;
            await LoadData();
            ToastService.ShowSuccess("User details updated successfully.");
        }
        else
        {
            try 
            {
                var errors = await response.Content.ReadFromJsonAsync<List<IdentityErrorDto>>();
                if (errors != null && errors.Any())
                {
                    ToastService.ShowError(string.Join(" ", errors.Select(e => e.Description)));
                }
                else 
                {
                    ToastService.ShowError("Failed to update user. Check the details and try again.");
                }
            }
            catch 
            {
                ToastService.ShowError("Failed to update user. Check the details and try again.");
            }
        }
    }

    private class UpdateUserRequestDto
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string? EmployeeId { get; set; }
        public bool IsActive { get; set; }
        public decimal? DailyRate { get; set; }
        public bool UseCustomDailyRate { get; set; }
        public DateTime? DateHired { get; set; }
        public bool IsEligibleForLeave { get; set; }
        public bool IsEmployee { get; set; } = true;
        public Guid? WorkScheduleId { get; set; }
        public List<string>? Roles { get; set; }
        public GovernmentRecordDto? GovernmentRecord { get; set; }
    }

    private class IdentityErrorDto
    {
        public string Code { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }

    private class CreateForm
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? EmployeeId { get; set; } = string.Empty;
        public decimal? DailyRate { get; set; }
        public bool UseCustomDailyRate { get; set; } = false;
        public DateTime? DateHired { get; set; }
        public bool IsEligibleForLeave { get; set; } = true;
        public bool IsEmployee { get; set; } = true;
        public Guid? WorkScheduleId { get; set; }
        public HashSet<string> SelectedRoles { get; set; } = new();
        public GovernmentRecordDto GovernmentRecord { get; set; } = new() { IsEligibleForDeductions = true };
    }

    private class UpdateForm
    {
        public string Id { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string EmployeeId { get; set; } = string.Empty;
        public decimal? DailyRate { get; set; }
        public bool UseCustomDailyRate { get; set; } = false;
        public DateTime? DateHired { get; set; }
        public bool IsEligibleForLeave { get; set; } = true;
        public bool IsEmployee { get; set; } = true;
        public Guid? WorkScheduleId { get; set; }
        public bool IsActive { get; set; }
        public bool IsOwner { get; set; }
        public HashSet<string> SelectedRoles { get; set; } = new();
        public GovernmentRecordDto GovernmentRecord { get; set; } = new() { IsEligibleForDeductions = true };
    }

    private record UserDto(string Id, string Email, string FirstName, string LastName, string? EmployeeId, bool IsActive, bool IsEmployee, decimal? DailyRate, bool UseCustomDailyRate, DateTime? DateHired, DateTime? ResignedDate, bool IsEligibleForLeave, Guid? WorkScheduleId, GovernmentRecordDto? GovernmentRecord, List<string>? Roles, bool IsOwner = false);
    private record RoleDto(string Id, string? Name, string? Description);
    private record WorkScheduleDto(Guid Id, string Name);
    private class GovernmentRecordDto
    {
        public bool IsEligibleForDeductions { get; set; } = true;
        public string? SssNumber { get; set; }
        public string? PagIbigNumber { get; set; }
        public string? PhilHealthNumber { get; set; }
        public string? TinNumber { get; set; }
    }
}
