@page "/admin/roles"
@attribute [Authorize(Policy = "RequireRoles")]
@inject HttpClient Http
@inject ToastService ToastService

<PageTitle>Role Management - OfficeCore</PageTitle>

<div class="space-y-6">
    <PageHeader Title="Role Management" Subtitle="Define roles and configure their module access.">
        <Actions>
            <div class="flex items-center gap-3">
                <button @onclick="LoadRoles" disabled="@_isLoading" class="p-2 text-zinc-400 hover:text-white bg-zinc-900 border border-zinc-800 rounded-lg transition-colors cursor-pointer" title="Refresh">
                    <svg class="size-4 @(_isLoading ? "animate-spin text-fuchsia-400" : "")" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
                </button>
                <AuthorizeView Policy="Permission:roles.create">
                    <AppButton OnClick="() => _showCreate = true">
                        <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                        </svg>
                        New Role
                    </AppButton>
                </AuthorizeView>
            </div>
        </Actions>
    </PageHeader>

    @if (_roles == null)
    {
        <div class="p-12 flex justify-center">
            <div class="flex items-center gap-3 text-zinc-500 text-sm">
                <svg class="animate-spin size-5" viewBox="0 0 24 24" fill="none">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                </svg>
                Loading roles...
            </div>
        </div>
    }
    else if (!_roles.Any())
    {
        <EmptyState Title="No roles yet"
                    Description="Define roles and configure their module access and permissions for your team."
                    ActionText="Create a Role"
                    OnAction="() => _showCreate = true">
            <Icon>
                <svg class="size-10 text-zinc-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                </svg>
            </Icon>
        </EmptyState>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var role in _roles)
            {
                <div class="bg-zinc-950/80 border border-zinc-800/80 rounded-2xl p-5 space-y-4 hover:border-zinc-700 transition-colors shadow-lg shadow-black/20">
                    <div class="flex items-start justify-between">
                        <div>
                            <h3 class="font-semibold text-white">@role.Name</h3>
                            <p class="text-xs text-zinc-500 mt-0.5">@(role.Description ?? "No description")</p>
                        </div>
                        <AuthorizeView Policy="Permission:roles.edit">
                            <button @onclick="() => SelectRole(role)"
                                    class="text-xs text-fuchsia-400 hover:text-fuchsia-300 transition-colors font-medium cursor-pointer">
                                Edit
                            </button>
                        </AuthorizeView>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-zinc-500 mb-2">Module Access</p>
                        @if (_roleModules.TryGetValue(role.Id, out var modules) && modules.Any())
                        {
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var m in modules)
                                {
                                    <AppBadge Variant="primary">@FormatModuleName(m)</AppBadge>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-xs text-zinc-600 italic">No module access assigned.</p>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Create Role Modal -->
@if (_showCreate || _editRole != null)
{
    var isEdit = _editRole != null;
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md p-4 transition-all">
        <div class="w-full max-w-3xl bg-zinc-950 border border-zinc-800 rounded-2xl shadow-2xl flex flex-col max-h-[90vh] overflow-hidden">
            <!-- Header -->
            <div class="bg-gradient-to-r from-fuchsia-900/20 via-transparent to-transparent px-6 py-5 border-b border-zinc-800/80 flex items-center justify-between shrink-0">
                <div class="flex items-center gap-3">
                    <div class="size-10 rounded-xl bg-fuchsia-500/10 border border-fuchsia-500/20 flex items-center justify-center text-fuchsia-400">
                        <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-white tracking-tight">@(isEdit ? "Edit Role" : "Create New Role")</h2>
                        <p class="text-xs text-zinc-400 mt-0.5">Configure role identity, module access, and granular action permissions.</p>
                    </div>
                </div>
                <button type="button" @onclick="CloseModal" class="text-zinc-400 hover:text-white hover:bg-zinc-800 p-2 rounded-xl transition-colors cursor-pointer">
                    <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Single Scrollable Body -->
            <div class="p-6 overflow-y-auto flex-1 custom-scrollbar space-y-6">
                <!-- Role Details Card -->
                <div class="p-4 rounded-xl bg-zinc-900/60 border border-zinc-800/80 space-y-4">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-zinc-300 mb-1.5">
                                Role Name <span class="text-fuchsia-500">*</span>
                            </label>
                            <input @bind="_newRoleName" placeholder="e.g. Finance Auditor" class="w-full rounded-xl bg-zinc-950 border border-zinc-700/80 px-3.5 py-2 text-sm text-white placeholder:text-zinc-500 focus:border-fuchsia-500 focus:ring-2 focus:ring-fuchsia-500/20 focus:outline-none transition-all" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-zinc-300 mb-1.5">
                                Description <span class="text-xs font-normal text-zinc-500">(optional)</span>
                            </label>
                            <input @bind="_newRoleDesc" placeholder="e.g. Can view financial ledgers and export reports" class="w-full rounded-xl bg-zinc-950 border border-zinc-700/80 px-3.5 py-2 text-sm text-white placeholder:text-zinc-500 focus:border-fuchsia-500 focus:ring-2 focus:ring-fuchsia-500/20 focus:outline-none transition-all" />
                        </div>
                    </div>

                    <div class="flex items-center gap-3 pt-1 border-t border-zinc-800/60">
                        <label class="relative inline-flex items-center cursor-pointer shrink-0">
                            <input type="checkbox" id="showAsTitle" @bind="_newRoleShowAsTitle" class="sr-only peer" />
                            <div class="w-9 h-5 bg-zinc-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-fuchsia-600"></div>
                        </label>
                        <label for="showAsTitle" class="cursor-pointer select-none">
                            <span class="text-xs font-medium text-zinc-200 block">Show as Primary Title</span>
                            <span class="text-[11px] text-zinc-400 block">Display this title on the employee's public profile, cards, and directory badge.</span>
                        </label>
                    </div>
                </div>

                <!-- Permissions Section Header with Stats & Global Actions -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1">
                    <div>
                        <h3 class="text-sm font-bold text-white tracking-tight flex items-center gap-2">
                            <span>Module Access & Permissions</span>
                            <span class="px-2 py-0.5 text-[11px] font-semibold rounded-full bg-fuchsia-950/70 text-fuchsia-300 border border-fuchsia-800/60">
                                @_selectedPermissions.Count active
                            </span>
                        </h3>
                        <p class="text-xs text-zinc-400 mt-0.5">Toggle modules and expand to customize action-level capabilities.</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <button type="button" @onclick="SelectAllPermissions" class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-900 hover:bg-zinc-800 text-zinc-300 transition-colors cursor-pointer border border-zinc-800">
                            Select All
                        </button>
                        <button type="button" @onclick="ClearAllPermissions" class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-900 hover:bg-zinc-800 text-zinc-400 hover:text-red-400 transition-colors cursor-pointer border border-zinc-800">
                            Clear All
                        </button>
                    </div>
                </div>

                <!-- Categories & Modules -->
                <div class="space-y-6">
                    @foreach (var category in ModuleCategories)
                    {
                        <div class="space-y-3">
                            <div class="flex items-center gap-2">
                                <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider">@category.Key</span>
                                <div class="flex-1 border-t border-zinc-800/80"></div>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 items-start">
                                @foreach (var module in category.Value)
                                {
                                    var isModuleSelected = _selectedModules.Contains(module);
                                    var modulePermissions = PermissionCatalog.ForModule(module);
                                    var activeCount = modulePermissions.Count(p => _selectedPermissions.Contains(p.Key));
                                    var totalCount = modulePermissions.Count;
                                    var isExpanded = _expandedModules.Contains(module);

                                    <div class="rounded-xl border transition-all duration-200 overflow-hidden @(isModuleSelected ? "bg-fuchsia-950/20 border-fuchsia-500/40 shadow-xs shadow-fuchsia-950/20" : "bg-zinc-900/40 border-zinc-800/80 hover:border-zinc-700")">
                                        <!-- Module Card Header -->
                                        <div class="flex items-center justify-between p-3 gap-2">
                                            <div class="flex items-center gap-2.5 min-w-0 flex-1 cursor-pointer select-none" @onclick="() => ToggleModule(module)">
                                                <input type="checkbox"
                                                       checked="@isModuleSelected"
                                                       @onchange="() => ToggleModule(module)"
                                                       @onclick:stopPropagation
                                                       class="size-4 rounded border-zinc-700 bg-zinc-950 text-fuchsia-600 focus:ring-fuchsia-500 cursor-pointer shrink-0" />
                                                <div class="min-w-0 flex-1">
                                                    <span class="text-xs font-semibold block truncate @(isModuleSelected ? "text-white" : "text-zinc-400")">
                                                        @FormatModuleName(module)
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="flex items-center gap-1.5 shrink-0">
                                                @if (isModuleSelected && totalCount > 0)
                                                {
                                                    @if (activeCount == totalCount)
                                                    {
                                                        <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-fuchsia-950/70 text-fuchsia-300 border border-fuchsia-800/50">
                                                            All @totalCount
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-amber-950/70 text-amber-300 border border-amber-800/50">
                                                            @activeCount/@totalCount
                                                        </span>
                                                    }
                                                }

                                                @if (totalCount > 0)
                                                {
                                                    <button type="button"
                                                            @onclick="() => ToggleExpandModule(module)"
                                                            class="p-1 rounded-lg text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/60 transition-transform cursor-pointer"
                                                            title="@(isExpanded ? "Collapse actions" : "Expand actions")">
                                                        <svg class="size-4 transition-transform duration-200 @(isExpanded ? "rotate-180 text-fuchsia-500" : "")" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                                                        </svg>
                                                    </button>
                                                }
                                            </div>
                                        </div>

                                        <!-- Expanded Actions List -->
                                        @if (isExpanded && totalCount > 0)
                                        {
                                            <div class="border-t border-zinc-800/80 bg-zinc-950/60 p-2.5 space-y-1.5 animate-in fade-in duration-150">
                                                <div class="flex items-center justify-between px-1 pb-1 text-[10px] text-zinc-400 font-medium">
                                                    <span>Action Permissions</span>
                                                    <div class="flex items-center gap-1.5">
                                                        <button type="button" @onclick="() => SelectModuleAll(module)" class="hover:text-fuchsia-400 cursor-pointer">All</button>
                                                        <span>•</span>
                                                        <button type="button" @onclick="() => ClearModuleAll(module)" class="hover:text-red-400 cursor-pointer">None</button>
                                                    </div>
                                                </div>
                                                @foreach (var permission in modulePermissions)
                                                {
                                                    var isPermChecked = _selectedPermissions.Contains(permission.Key);
                                                    <label class="flex items-center gap-2.5 px-2 py-1.5 rounded-lg hover:bg-zinc-800/50 cursor-pointer transition-colors text-xs select-none">
                                                        <input type="checkbox"
                                                               checked="@isPermChecked"
                                                               @onchange="() => TogglePermission(module, permission.Key)"
                                                               class="size-3.5 rounded border-zinc-700 bg-zinc-900 text-fuchsia-600 focus:ring-fuchsia-500 cursor-pointer shrink-0" />
                                                        <span class="@(isPermChecked ? "text-zinc-200 font-medium" : "text-zinc-400")">
                                                            @permission.DisplayName
                                                        </span>
                                                    </label>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Footer -->
            <div class="bg-zinc-950/80 border-t border-zinc-800/80 px-6 py-4 flex items-center justify-between shrink-0">
                @if (isEdit)
                {
                    <AuthorizeView Policy="Permission:roles.delete">
                        <button type="button" @onclick="PromptDelete" class="rounded-xl px-4 py-2 text-sm font-semibold text-red-400 hover:text-red-300 hover:bg-red-500/10 transition-colors cursor-pointer">
                            Delete Role
                        </button>
                    </AuthorizeView>
                }
                else
                {
                    <div></div> <!-- Spacer -->
                }
                <div class="flex items-center gap-3">
                    <button type="button" @onclick="CloseModal" class="rounded-xl px-4 py-2 text-sm font-medium text-zinc-400 hover:text-white hover:bg-zinc-800/60 transition-colors cursor-pointer">
                        Cancel
                    </button>
                    <button type="button" @onclick="SaveRole" class="rounded-xl bg-fuchsia-600 hover:bg-fuchsia-500 px-5 py-2 text-sm font-semibold text-white shadow-md shadow-fuchsia-600/30 transition-all cursor-pointer">
                        @(isEdit ? "Save Changes" : "Create Role")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (_showDeleteModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md p-4 transition-all">
        <div class="bg-zinc-950 border border-zinc-800 rounded-2xl w-full max-w-sm shadow-2xl p-6 relative">
            <h3 class="text-lg font-bold text-white mb-2">Delete Role</h3>
            <p class="text-sm text-zinc-400 mb-6">Are you sure you want to permanently delete this role? Employees assigned to it will be unassigned and lose access granted by this role. This action cannot be undone.</p>
            <div class="flex gap-3">
                <button type="button" @onclick="() => _showDeleteModal = false" class="flex-1 py-2.5 rounded-xl text-sm font-medium text-zinc-400 bg-zinc-800/50 hover:bg-zinc-800 hover:text-white transition-all cursor-pointer">Cancel</button>
                <button type="button" @onclick="ConfirmDeleteRole" class="flex-1 py-2.5 rounded-xl text-sm font-bold text-white bg-red-600 hover:bg-red-500 shadow-lg shadow-red-900/20 transition-all cursor-pointer">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly IReadOnlyDictionary<string, string[]> ModuleCategories = ModuleCatalog.All
        .Where(m => !m.IsDefault || m.Key == AccessModules.Boards)
        .GroupBy(m => m.Category)
        .ToDictionary(g => g.Key, g => g.Select(m => m.Key).ToArray());

    private static string FormatModuleName(string name) =>
        ModuleCatalog.All.FirstOrDefault(m => m.Key == name)?.DisplayName ?? name;

    private List<RoleDto>? _roles;
    private Dictionary<string, List<string>> _roleModules = new();
    private bool _showCreate;
    private RoleDto? _editRole;
    private string _newRoleName = string.Empty;
    private string _newRoleDesc = string.Empty;
    private bool _newRoleShowAsTitle = false;
    private bool _showDeleteModal = false;
    private HashSet<string> _selectedModules = new();
    private HashSet<string> _selectedPermissions = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _expandedModules = new();

    private bool _isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadRoles();
    }

    private async Task LoadRoles()
    {
        _isLoading = true;
        try
        {
            _roles = await Http.GetFromJsonAsync<List<RoleDto>>("/api/role");
            if (_roles != null)
            {
                foreach (var role in _roles)
                {
                    _roleModules[role.Id] = role.Modules;
                }
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SelectRole(RoleDto role)
    {
        _editRole = role;
        _newRoleName = role.Name ?? "";
        _newRoleDesc = role.Description ?? "";
        _newRoleShowAsTitle = role.ShowAsTitle;
        _selectedModules = _roleModules.TryGetValue(role.Id, out var m) ? m.ToHashSet() : new();
        _selectedPermissions = role.Permissions.Count > 0
            ? role.Permissions.ToHashSet(StringComparer.OrdinalIgnoreCase)
            : PermissionCatalog.ExpandModules(_selectedModules).ToHashSet(StringComparer.OrdinalIgnoreCase);
        _expandedModules = new HashSet<string>(_selectedModules);
    }

    private void CloseModal()
    {
        _showCreate = false;
        _editRole = null;
        _newRoleName = string.Empty;
        _newRoleDesc = string.Empty;
        _newRoleShowAsTitle = false;
        _selectedModules = new();
        _selectedPermissions = new(StringComparer.OrdinalIgnoreCase);
        _expandedModules = new();
    }

    private void ToggleExpandModule(string module)
    {
        if (!_expandedModules.Add(module))
            _expandedModules.Remove(module);
    }

    private void ToggleModule(string module)
    {
        if (_selectedModules.Remove(module))
        {
            foreach (var permission in PermissionCatalog.ForModule(module))
                _selectedPermissions.Remove(permission.Key);
            _expandedModules.Remove(module);
        }
        else
        {
            _selectedModules.Add(module);
            foreach (var permission in PermissionCatalog.ForModule(module))
                _selectedPermissions.Add(permission.Key);
            _expandedModules.Add(module);
        }
    }

    private void TogglePermission(string module, string permission)
    {
        _selectedModules.Add(module);
        if (!_selectedPermissions.Remove(permission))
        {
            _selectedPermissions.Add(permission);
            return;
        }

        if (!PermissionCatalog.ForModule(module).Any(p => _selectedPermissions.Contains(p.Key)))
            _selectedModules.Remove(module);
    }

    private void SelectAllPermissions()
    {
        foreach (var mod in ModuleCatalog.All.Where(m => !m.IsDefault || m.Key == AccessModules.Boards))
        {
            _selectedModules.Add(mod.Key);
            foreach (var p in PermissionCatalog.ForModule(mod.Key))
            {
                _selectedPermissions.Add(p.Key);
            }
        }
    }

    private void ClearAllPermissions()
    {
        _selectedModules.Clear();
        _selectedPermissions.Clear();
    }

    private void SelectModuleAll(string module)
    {
        _selectedModules.Add(module);
        foreach (var p in PermissionCatalog.ForModule(module))
        {
            _selectedPermissions.Add(p.Key);
        }
    }

    private void ClearModuleAll(string module)
    {
        _selectedModules.Remove(module);
        foreach (var p in PermissionCatalog.ForModule(module))
        {
            _selectedPermissions.Remove(p.Key);
        }
    }

    private async Task SaveRole()
    {
        if (_editRole != null)
        {
            if (string.IsNullOrWhiteSpace(_newRoleName))
            {
                ToastService.ShowWarning("Role name is required.");
                return;
            }

            var response = await Http.PutAsJsonAsync($"/api/role/{_editRole.Id}", new {
                Name = _newRoleName,
                Description = _newRoleDesc,
                ShowAsTitle = _newRoleShowAsTitle,
                Modules = _selectedModules.ToList(),
                Permissions = _selectedPermissions.ToList()
            });
            if (response.IsSuccessStatusCode)
            {
                CloseModal();
                await LoadRoles();
                ToastService.ShowSuccess("Role updated successfully.");
            }
            else
            {
                ToastService.ShowError("Failed to update role modules.");
            }
        }
        else
        {
            if (string.IsNullOrWhiteSpace(_newRoleName))
            {
                ToastService.ShowWarning("Role name is required.");
                return;
            }

            var response = await Http.PostAsJsonAsync("/api/role", new
            {
                name = _newRoleName,
                description = _newRoleDesc,
                showAsTitle = _newRoleShowAsTitle,
                modules = _selectedModules.ToList(),
                permissions = _selectedPermissions.ToList()
            });

            if (response.IsSuccessStatusCode)
            {
                CloseModal();
                await LoadRoles();
                ToastService.ShowSuccess("Role created successfully.");
            }
            else
            {
                ToastService.ShowError("Failed to create role.");
            }
        }
    }

    private void PromptDelete()
    {
        _showDeleteModal = true;
    }

    private async Task ConfirmDeleteRole()
    {
        if (_editRole == null) return;

        var response = await Http.DeleteAsync($"/api/role/{_editRole.Id}");
        if (response.IsSuccessStatusCode)
        {
            _showDeleteModal = false;
            CloseModal();
            await LoadRoles();
            ToastService.ShowSuccess("Role deleted successfully.");
        }
        else
        {
            var error = await response.Content.ReadFromJsonAsync<ApiError>();
            ToastService.ShowError(error?.Message ?? $"Failed to delete role ({(int)response.StatusCode}).");
        }
    }

    private class RoleDto 
    { 
        public string Id { get; set; } = ""; 
        public string? Name { get; set; } 
        public string? Description { get; set; } 
        public bool ShowAsTitle { get; set; } 
        public List<string> Modules { get; set; } = [];
        public List<string> Permissions { get; set; } = [];
    }

    private sealed class ApiError
    {
        public string? Message { get; set; }
    }
}
