@page "/admin/roles"
@attribute [Authorize(Policy = "RequireRoles")]
@inject HttpClient Http
@inject ToastService ToastService

<PageTitle>Role Management - OfficeCore</PageTitle>

<div class="space-y-6">
    <PageHeader Title="Role Management" Subtitle="Define roles and configure their module access.">
        <Actions>
            <div class="flex items-center gap-3">
                <button @onclick="LoadRoles" disabled="@_isLoading" class="p-2 text-zinc-400 hover:text-white bg-zinc-900 border border-zinc-800 rounded-lg transition-colors cursor-pointer" title="Refresh">
                    <svg class="size-4 @(_isLoading ? "animate-spin text-fuchsia-400" : "")" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
                </button>
                <AuthorizeView Policy="Permission:roles.create">
                    <AppButton OnClick="() => _showCreate = true">
                        <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                        </svg>
                        New Role
                    </AppButton>
                </AuthorizeView>
            </div>
        </Actions>
    </PageHeader>

    @if (_roles == null)
    {
        <div class="p-12 flex justify-center">
            <div class="flex items-center gap-3 text-zinc-500 text-sm">
                <svg class="animate-spin size-5" viewBox="0 0 24 24" fill="none">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                </svg>
                Loading roles...
            </div>
        </div>
    }
    else if (!_roles.Any())
    {
        <EmptyState Title="No roles yet"
                    Description="Define roles and configure their module access and permissions for your team."
                    ActionText="Create a Role"
                    OnAction="() => _showCreate = true">
            <Icon>
                <svg class="size-10 text-zinc-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                </svg>
            </Icon>
        </EmptyState>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var role in _roles)
            {
                <div class="bg-zinc-950/80 border border-zinc-800/80 rounded-2xl p-5 space-y-4 hover:border-zinc-700 transition-colors shadow-lg shadow-black/20">
                    <div class="flex items-start justify-between">
                        <div>
                            <h3 class="font-semibold text-white">@role.Name</h3>
                            <p class="text-xs text-zinc-500 mt-0.5">@(role.Description ?? "No description")</p>
                        </div>
                        <AuthorizeView Policy="Permission:roles.edit">
                            <button @onclick="() => SelectRole(role)"
                                    class="text-xs text-fuchsia-400 hover:text-fuchsia-300 transition-colors font-medium cursor-pointer">
                                Edit
                            </button>
                        </AuthorizeView>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-zinc-500 mb-2">Module Access</p>
                        @if (_roleModules.TryGetValue(role.Id, out var modules) && modules.Any())
                        {
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var m in modules)
                                {
                                    <AppBadge Variant="primary">@FormatModuleName(m)</AppBadge>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-xs text-zinc-600 italic">No module access assigned.</p>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Create Role Modal -->
@if (_showCreate || _editRole != null)
{
    var isEdit = _editRole != null;
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm p-4">
        <div class="w-full max-w-lg bg-zinc-950 border border-zinc-800 rounded-2xl shadow-2xl flex flex-col max-h-[90vh] overflow-hidden">
            <div class="flex items-center justify-between px-6 py-5 border-b border-zinc-800 shrink-0">
                <h2 class="text-xl font-bold text-white">@(isEdit ? "Edit Role" : "New Role")</h2>
                <button @onclick="CloseModal" class="text-zinc-500 hover:text-white transition-colors">
                    <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="px-6 py-5 space-y-4 overflow-y-auto flex-1 custom-scrollbar">
                <div>
                    <label class="block text-xs font-medium text-zinc-400 mb-1">Role Name</label>
                    <input @bind="_newRoleName" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-zinc-400 mb-1">Description (optional)</label>
                    <input @bind="_newRoleDesc" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none" />
                </div>
                <div class="flex items-center gap-3 mt-2">
                    <input type="checkbox" id="showAsTitle" @bind="_newRoleShowAsTitle" class="size-4 rounded border-zinc-700 bg-zinc-900 text-fuchsia-600 focus:ring-fuchsia-600 focus:ring-offset-zinc-950 cursor-pointer" />
                    <label for="showAsTitle" class="text-sm text-zinc-300 cursor-pointer select-none">Show as Primary Title</label>
                </div>
            </div>

            <div class="px-6 pb-4">
                <div class="space-y-4 max-h-[30vh] overflow-y-auto pr-2">
                    @foreach (var category in ModuleCategories)
                    {
                        <div>
                            <p class="text-[10px] font-bold text-zinc-600 uppercase tracking-wider mb-2">@category.Key</p>
                            <div class="grid grid-cols-2 gap-2">
                                @foreach (var module in category.Value)
                                {
                                    var sel = _selectedModules.Contains(module);
                                    <div class="rounded-lg bg-zinc-900 overflow-hidden @(sel ? "ring-1 ring-fuchsia-500/40" : "")">
                                        <button type="button"
                                                @onclick="() => ToggleModule(module)"
                                                class="@($"w-full flex items-center gap-2 px-3 py-2 text-xs font-medium text-left transition-all {(sel ? "bg-fuchsia-600/20 text-fuchsia-300" : "text-zinc-400 hover:bg-zinc-800")}")">
                                            <span class="@($"size-2 rounded-full shrink-0 {(sel ? "bg-fuchsia-400" : "bg-zinc-600")}")"></span>
                                            @FormatModuleName(module)
                                        </button>
                                        @if (sel)
                                        {
                                            <div class="border-t border-zinc-800 px-3 py-2 space-y-1.5">
                                                @foreach (var permission in PermissionCatalog.ForModule(module))
                                                {
                                                    <label class="flex items-start gap-2 text-[11px] text-zinc-400 cursor-pointer">
                                                        <input type="checkbox"
                                                               checked="@_selectedPermissions.Contains(permission.Key)"
                                                               @onchange="() => TogglePermission(module, permission.Key)"
                                                               class="mt-0.5 size-3 rounded border-zinc-700 bg-zinc-950 text-fuchsia-600" />
                                                        <span>@permission.DisplayName</span>
                                                    </label>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="flex justify-between gap-3 px-6 py-4 border-t border-zinc-800 shrink-0">
                @if (isEdit)
                {
                    <AuthorizeView Policy="Permission:roles.delete">
                        <button @onclick="PromptDelete" class="rounded-lg px-4 py-2 text-sm font-semibold text-red-500 hover:bg-red-500/10 transition-colors">Delete Role</button>
                    </AuthorizeView>
                }
                else
                {
                    <div></div> <!-- Spacer -->
                }
                <div class="flex gap-3">
                    <button @onclick="CloseModal" class="rounded-lg px-4 py-2 text-sm text-zinc-400 hover:text-white transition-colors">Cancel</button>
                    <button @onclick="SaveRole"
                            class="rounded-lg bg-fuchsia-600 px-4 py-2 text-sm font-semibold text-white hover:bg-fuchsia-500 transition-colors">
                        @(isEdit ? "Save Changes" : "Create Role")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (_showDeleteModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm p-4">
        <div class="bg-zinc-950 border border-zinc-800 rounded-2xl w-full max-w-sm shadow-2xl p-6 relative">
            <h3 class="text-lg font-bold text-white mb-2">Delete Role</h3>
            <p class="text-sm text-zinc-400 mb-6">Are you sure you want to permanently delete this role? Employees assigned to it will be unassigned and lose access granted by this role. This action cannot be undone.</p>
            <div class="flex gap-3">
                <button @onclick="() => _showDeleteModal = false" class="flex-1 py-2.5 rounded-lg text-sm font-medium text-zinc-400 bg-zinc-800/50 hover:bg-zinc-800 hover:text-white transition-all">Cancel</button>
                <button @onclick="ConfirmDeleteRole" class="flex-1 py-2.5 rounded-lg text-sm font-bold text-white bg-red-600 hover:bg-red-500 shadow-lg shadow-red-900/20 transition-all">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly IReadOnlyDictionary<string, string[]> ModuleCategories = ModuleCatalog.All
        .Where(m => !m.IsDefault || m.Key == AccessModules.Boards)
        .GroupBy(m => m.Category)
        .ToDictionary(g => g.Key, g => g.Select(m => m.Key).ToArray());

    private static string FormatModuleName(string name) =>
        ModuleCatalog.All.FirstOrDefault(m => m.Key == name)?.DisplayName ?? name;

    private List<RoleDto>? _roles;
    private Dictionary<string, List<string>> _roleModules = new();
    private bool _showCreate;
    private RoleDto? _editRole;
    private string _newRoleName = string.Empty;
    private string _newRoleDesc = string.Empty;
    private bool _newRoleShowAsTitle = false;
    private bool _showDeleteModal = false;
    private HashSet<string> _selectedModules = new();
    private HashSet<string> _selectedPermissions = new(StringComparer.OrdinalIgnoreCase);

    private bool _isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadRoles();
    }

    private async Task LoadRoles()
    {
        _isLoading = true;
        try
        {
            _roles = await Http.GetFromJsonAsync<List<RoleDto>>("/api/role");
            if (_roles != null)
            {
                foreach (var role in _roles)
                {
                    _roleModules[role.Id] = role.Modules;
                }
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SelectRole(RoleDto role)
    {
        _editRole = role;
        _newRoleName = role.Name ?? "";
        _newRoleDesc = role.Description ?? "";
        _newRoleShowAsTitle = role.ShowAsTitle;
        _selectedModules = _roleModules.TryGetValue(role.Id, out var m) ? m.ToHashSet() : new();
        _selectedPermissions = role.Permissions.Count > 0
            ? role.Permissions.ToHashSet(StringComparer.OrdinalIgnoreCase)
            : PermissionCatalog.ExpandModules(_selectedModules).ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private void CloseModal()
    {
        _showCreate = false;
        _editRole = null;
        _newRoleName = string.Empty;
        _newRoleDesc = string.Empty;
        _newRoleShowAsTitle = false;
        _selectedModules = new();
        _selectedPermissions = new(StringComparer.OrdinalIgnoreCase);
    }

    private void ToggleModule(string module)
    {
        if (_selectedModules.Remove(module))
        {
            foreach (var permission in PermissionCatalog.ForModule(module))
                _selectedPermissions.Remove(permission.Key);
        }
        else
        {
            _selectedModules.Add(module);
            foreach (var permission in PermissionCatalog.ForModule(module))
                _selectedPermissions.Add(permission.Key);
        }
    }

    private void TogglePermission(string module, string permission)
    {
        _selectedModules.Add(module);
        if (!_selectedPermissions.Remove(permission))
        {
            _selectedPermissions.Add(permission);
            return;
        }

        if (!PermissionCatalog.ForModule(module).Any(p => _selectedPermissions.Contains(p.Key)))
            _selectedModules.Remove(module);
    }

    private async Task SaveRole()
    {
        if (_editRole != null)
        {
            if (string.IsNullOrWhiteSpace(_newRoleName))
            {
                ToastService.ShowWarning("Role name is required.");
                return;
            }

            var response = await Http.PutAsJsonAsync($"/api/role/{_editRole.Id}", new {
                Name = _newRoleName,
                Description = _newRoleDesc,
                ShowAsTitle = _newRoleShowAsTitle,
                Modules = _selectedModules.ToList(),
                Permissions = _selectedPermissions.ToList()
            });
            if (response.IsSuccessStatusCode)
            {
                CloseModal();
                await LoadRoles();
                ToastService.ShowSuccess("Role updated successfully.");
            }
            else
            {
                ToastService.ShowError("Failed to update role modules.");
            }
        }
        else
        {
            if (string.IsNullOrWhiteSpace(_newRoleName))
            {
                ToastService.ShowWarning("Role name is required.");
                return;
            }

            var response = await Http.PostAsJsonAsync("/api/role", new
            {
                name = _newRoleName,
                description = _newRoleDesc,
                showAsTitle = _newRoleShowAsTitle,
                modules = _selectedModules.ToList(),
                permissions = _selectedPermissions.ToList()
            });

            if (response.IsSuccessStatusCode)
            {
                CloseModal();
                await LoadRoles();
                ToastService.ShowSuccess("Role created successfully.");
            }
            else
            {
                ToastService.ShowError("Failed to create role.");
            }
        }
    }

    private void PromptDelete()
    {
        _showDeleteModal = true;
    }

    private async Task ConfirmDeleteRole()
    {
        if (_editRole == null) return;

        var response = await Http.DeleteAsync($"/api/role/{_editRole.Id}");
        if (response.IsSuccessStatusCode)
        {
            _showDeleteModal = false;
            CloseModal();
            await LoadRoles();
            ToastService.ShowSuccess("Role deleted successfully.");
        }
        else
        {
            var error = await response.Content.ReadFromJsonAsync<ApiError>();
            ToastService.ShowError(error?.Message ?? $"Failed to delete role ({(int)response.StatusCode}).");
        }
    }

    private class RoleDto 
    { 
        public string Id { get; set; } = ""; 
        public string? Name { get; set; } 
        public string? Description { get; set; } 
        public bool ShowAsTitle { get; set; } 
        public List<string> Modules { get; set; } = [];
        public List<string> Permissions { get; set; } = [];
    }

    private sealed class ApiError
    {
        public string? Message { get; set; }
    }
}
