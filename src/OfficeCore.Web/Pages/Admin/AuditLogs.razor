@page "/admin/audit-logs"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ToastService ToastService
@inject IJSRuntime JS

<div class="space-y-6 max-w-7xl mx-auto pb-12">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-6 shadow-sm backdrop-blur-md">
        <div class="flex items-center gap-4">
            <div class="size-12 rounded-2xl bg-gradient-to-br from-indigo-500 via-purple-600 to-pink-600 flex items-center justify-center text-white shadow-lg shadow-indigo-900/30">
                <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <h1 class="text-xl font-bold text-white tracking-tight">Audit Trail &amp; Compliance Ledger</h1>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-950/60 text-emerald-300 border border-emerald-800/60 flex items-center gap-1">
                        <span class="size-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                        Immutable Active
                    </span>
                </div>
                <p class="text-xs text-zinc-400 mt-0.5">
                    Immutable chronological record of administrative operations, payroll modifications, rate adjustments, and security events.
                </p>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
            <button type="button" @onclick="ExportCsvAsync" disabled="@_isExporting"
                    class="px-3.5 py-2 rounded-xl bg-zinc-800/80 hover:bg-zinc-700 text-zinc-200 text-xs font-semibold flex items-center gap-2 transition-all border border-zinc-700/60 cursor-pointer disabled:opacity-50">
                <svg class="size-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <span>@(_isExporting ? "Exporting..." : "Export CSV Ledger")</span>
            </button>

            <button type="button" @onclick="LoadAuditLogsAsync" disabled="@_isLoading"
                    class="p-2 rounded-xl bg-zinc-800/80 hover:bg-zinc-700 text-zinc-300 transition-all border border-zinc-700/60 cursor-pointer disabled:opacity-50"
                    title="Refresh Audit Records">
                <svg class="size-4 @(_isLoading ? "animate-spin text-indigo-400" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
            </button>
        </div>
    </div>

    <!-- 4 Live Metric Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Metric 1: Total Events Logged -->
        <div class="p-5 rounded-2xl bg-zinc-900/60 border border-zinc-800/80 shadow-sm relative overflow-hidden group">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold text-zinc-400">Total Audit Events</span>
                <span class="size-8 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                </span>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-2xl font-black text-white tracking-tight">
                    @(_summary?.TotalEvents.ToString("N0") ?? "—")
                </span>
                <span class="text-[11px] text-zinc-500">records</span>
            </div>
            <p class="text-[11px] text-zinc-400 mt-1">Tenant-scoped audit history</p>
        </div>

        <!-- Metric 2: Today's Operations -->
        <div class="p-5 rounded-2xl bg-zinc-900/60 border border-zinc-800/80 shadow-sm relative overflow-hidden group">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold text-zinc-400">Today's Operations</span>
                <span class="size-8 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                </span>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-2xl font-black text-emerald-400 tracking-tight">
                    @(_summary?.TodayCount.ToString("N0") ?? "0")
                </span>
                <span class="text-[11px] text-zinc-500">events</span>
            </div>
            <p class="text-[11px] text-zinc-400 mt-1">Since 00:00 UTC today</p>
        </div>

        <!-- Metric 3: Financial & Payroll -->
        <div class="p-5 rounded-2xl bg-zinc-900/60 border border-zinc-800/80 shadow-sm relative overflow-hidden group">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold text-zinc-400">Financial &amp; Payroll</span>
                <span class="size-8 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </span>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-2xl font-black text-amber-400 tracking-tight">
                    @(_summary?.FinancialCount.ToString("N0") ?? "0")
                </span>
                <span class="text-[11px] text-zinc-500">actions</span>
            </div>
            <p class="text-[11px] text-zinc-400 mt-1">Payroll calculations &amp; advances</p>
        </div>

        <!-- Metric 4: Security & Backups -->
        <div class="p-5 rounded-2xl bg-zinc-900/60 border border-zinc-800/80 shadow-sm relative overflow-hidden group">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold text-zinc-400">Security &amp; Backups</span>
                <span class="size-8 rounded-xl bg-fuchsia-500/10 text-fuchsia-400 flex items-center justify-center">
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                </span>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-2xl font-black text-fuchsia-400 tracking-tight">
                    @(_summary?.SecurityCount.ToString("N0") ?? "0")
                </span>
                <span class="text-[11px] text-zinc-500">events</span>
            </div>
            <p class="text-[11px] text-zinc-400 mt-1">Backups, restores &amp; roles</p>
        </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-5 shadow-sm space-y-4">
        <!-- Category Tabs -->
        <div class="flex items-center gap-1.5 overflow-x-auto pb-1 border-b border-zinc-800/60 scrollbar-none">
            @foreach (var tab in _categoryTabs)
            {
                var isSelected = _selectedCategory == tab.Value;
                <button type="button" @onclick="() => SelectCategory(tab.Value)"
                        class="px-3 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-all cursor-pointer @(isSelected 
                            ? "bg-fuchsia-600 text-white shadow-sm" 
                            : "text-zinc-400 hover:text-white hover:bg-zinc-800/60")">
                    <span>@tab.Icon</span>
                    <span class="ml-1.5">@tab.Label</span>
                    @if (_summary?.EntityCounts != null && tab.Value != null && _summary.EntityCounts.TryGetValue(tab.Value, out var count))
                    {
                        <span class="ml-1 px-1.5 py-0.2 rounded-full text-[10px] @(isSelected ? "bg-white/20" : "bg-zinc-800")">
                            @count
                        </span>
                    }
                </button>
            }
        </div>

        <!-- Filter Controls Row -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-3">
            <!-- Search Input -->
            <div class="lg:col-span-2 relative">
                <input type="text" @bind="_searchTerm" @bind:event="oninput" @onkeydown="HandleSearchKeyDown"
                       placeholder="Search details, actor, email, or IP..."
                       class="w-full pl-9 pr-8 py-2 rounded-xl text-xs bg-zinc-950 border border-zinc-800 text-zinc-200 placeholder-zinc-500 focus:outline-none focus:border-indigo-500 transition-colors" />
                <svg class="size-4 text-zinc-500 absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                @if (!string.IsNullOrEmpty(_searchTerm))
                {
                    <button type="button" @onclick="ClearSearch" class="absolute right-2.5 top-2.5 text-zinc-400 hover:text-white cursor-pointer">
                        <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                }
            </div>

            <!-- Action Filter -->
            <div>
                <select @bind="_selectedAction" @bind:after="ApplyFilters"
                        class="w-full px-3 py-2 rounded-xl text-xs bg-zinc-950 border border-zinc-800 text-zinc-200 focus:outline-none focus:border-indigo-500 cursor-pointer">
                    <option value="">All Actions</option>
                    <option value="CREATE">CREATE</option>
                    <option value="UPDATE">UPDATE</option>
                    <option value="DELETE">DELETE</option>
                    <option value="APPROVE">APPROVE</option>
                    <option value="REJECT">REJECT</option>
                    <option value="CALCULATE">CALCULATE</option>
                    <option value="RESTORE">RESTORE</option>
                    <option value="SECURITY">SECURITY</option>
                </select>
            </div>

            <!-- Start Date -->
            <div>
                <input type="date" value="@(_startDate?.ToString("yyyy-MM-dd"))" @onchange="OnStartDateChanged"
                       class="w-full px-3 py-2 rounded-xl text-xs bg-zinc-950 border border-zinc-800 text-zinc-200 focus:outline-none focus:border-indigo-500 cursor-pointer" />
            </div>

            <!-- End Date -->
            <div class="flex items-center gap-2">
                <input type="date" value="@(_endDate?.ToString("yyyy-MM-dd"))" @onchange="OnEndDateChanged"
                       class="w-full px-3 py-2 rounded-xl text-xs bg-zinc-950 border border-zinc-800 text-zinc-200 focus:outline-none focus:border-indigo-500 cursor-pointer" />
                @if (HasActiveFilters)
                {
                    <button type="button" @onclick="ResetFilters" title="Reset all filters"
                            class="p-2 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-400 hover:text-white text-xs font-medium cursor-pointer transition-colors border border-zinc-700/60">
                        <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Audit Ledger Table -->
    <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl overflow-hidden shadow-sm">
        @if (_isLoading)
        {
            <div class="p-12 text-center space-y-3">
                <div class="size-9 border-2 border-indigo-500 border-t-transparent rounded-full animate-spin mx-auto"></div>
                <p class="text-xs text-zinc-400">Loading immutable audit ledger...</p>
            </div>
        }
        else if (_logs == null || !_logs.Any())
        {
            <div class="p-12 text-center space-y-3">
                <div class="size-12 rounded-2xl bg-zinc-800 flex items-center justify-center text-zinc-400 mx-auto">
                    <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                </div>
                <h3 class="text-sm font-semibold text-zinc-200">No Audit Events Found</h3>
                <p class="text-xs text-zinc-400 max-w-sm mx-auto">
                    @if (HasActiveFilters)
                    {
                        <span>No audit records match your active search or filter criteria. Try resetting filters.</span>
                    }
                    else
                    {
                        <span>Administrative and operational events will automatically be recorded here as team members take actions in the workspace.</span>
                    }
                </p>
                @if (HasActiveFilters)
                {
                    <button type="button" @onclick="ResetFilters" class="px-3 py-1.5 text-xs font-semibold rounded-xl bg-zinc-800 text-zinc-200 hover:bg-zinc-700 cursor-pointer border border-zinc-700/60">
                        Reset Filters
                    </button>
                }
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-zinc-800/80 bg-zinc-800/30 text-[11px] font-semibold text-zinc-400 uppercase tracking-wider">
                            <th class="py-3 px-4">Timestamp (UTC)</th>
                            <th class="py-3 px-4">Actor</th>
                            <th class="py-3 px-4">Action</th>
                            <th class="py-3 px-4">Category</th>
                            <th class="py-3 px-4">Event Details</th>
                            <th class="py-3 px-4 text-right">Inspection</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-800/60 text-xs">
                        @foreach (var log in _logs)
                        {
                            <tr class="hover:bg-zinc-800/40 transition-colors">
                                <!-- Timestamp -->
                                <td class="py-3.5 px-4 whitespace-nowrap">
                                    <div class="font-medium text-zinc-200">
                                        @log.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                                    </div>
                                    <div class="text-[11px] text-zinc-500 font-mono">
                                        @log.CreatedAt.ToLocalTime().ToString("hh:mm:ss tt")
                                    </div>
                                </td>

                                <!-- Actor -->
                                <td class="py-3.5 px-4">
                                    <div class="flex items-center gap-2.5">
                                        <div class="size-7 rounded-lg bg-gradient-to-br from-indigo-600 to-fuchsia-600 flex items-center justify-center text-white text-[10px] font-bold shrink-0">
                                            @GetInitials(log.UserName)
                                        </div>
                                        <div>
                                            <div class="font-semibold text-zinc-100">@log.UserName</div>
                                            @if (!string.IsNullOrEmpty(log.IpAddress))
                                            {
                                                <div class="text-[10px] text-zinc-500 font-mono flex items-center gap-1">
                                                    <span>IP: @log.IpAddress</span>
                                                    @if (log.ClientInfo?.Contains("Desktop") == true)
                                                    {
                                                        <span class="px-1 rounded bg-zinc-800 text-[9px] text-zinc-300">Station</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <!-- Action Badge -->
                                <td class="py-3.5 px-4 whitespace-nowrap">
                                    <span class="px-2 py-0.5 rounded-md text-[10px] font-bold border @GetActionBadgeClass(log.Action)">
                                        @log.Action
                                    </span>
                                </td>

                                <!-- Category Badge -->
                                <td class="py-3.5 px-4 whitespace-nowrap">
                                    <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-zinc-800/80 text-zinc-300 border border-zinc-700/60 flex items-center gap-1 w-max">
                                        <span>@GetCategoryIcon(log.EntityName)</span>
                                        <span>@log.EntityName</span>
                                    </span>
                                </td>

                                <!-- Event Details -->
                                <td class="py-3.5 px-4">
                                    <div class="text-zinc-200 font-normal leading-relaxed max-w-xl">
                                        @log.Details
                                    </div>
                                    @if (!string.IsNullOrEmpty(log.EntityId))
                                    {
                                        <div class="text-[10px] text-zinc-500 font-mono mt-0.5">
                                            Ref: @log.EntityId
                                        </div>
                                    }
                                </td>

                                <!-- Inspection Action -->
                                <td class="py-3.5 px-4 text-right whitespace-nowrap">
                                    @if (!string.IsNullOrEmpty(log.OldValues) || !string.IsNullOrEmpty(log.NewValues))
                                    {
                                        <button type="button" @onclick="() => OpenInspectModal(log)"
                                                class="px-2.5 py-1 rounded-lg bg-indigo-950/60 hover:bg-indigo-900/80 text-indigo-300 text-[11px] font-semibold border border-indigo-800/60 transition-all cursor-pointer">
                                            🔍 Diff Changes
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" @onclick="() => OpenInspectModal(log)"
                                                class="px-2.5 py-1 rounded-lg bg-zinc-800/60 hover:bg-zinc-800 text-zinc-400 text-[11px] font-medium border border-zinc-700/60 transition-all cursor-pointer">
                                            Details
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Toolbar -->
            <div class="p-4 border-t border-zinc-800/80 bg-zinc-900/40 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
                <div class="text-zinc-400">
                    Showing <span class="font-semibold text-zinc-200">@((_page - 1) * _pageSize + 1)</span> to 
                    <span class="font-semibold text-zinc-200">@(Math.Min(_page * _pageSize, _totalCount))</span> of 
                    <span class="font-semibold text-zinc-200">@_totalCount.ToString("N0")</span> records
                </div>

                <div class="flex items-center gap-2">
                    <select @bind="_pageSize" @bind:after="OnPageSizeChanged"
                            class="px-2 py-1 rounded-lg text-xs bg-zinc-950 border border-zinc-800 text-zinc-200 focus:outline-none cursor-pointer">
                        <option value="15">15 / page</option>
                        <option value="25">25 / page</option>
                        <option value="50">50 / page</option>
                        <option value="100">100 / page</option>
                    </select>

                    <button type="button" @onclick="PreviousPage" disabled="@(_page <= 1)"
                            class="px-2.5 py-1 rounded-lg bg-zinc-800 border border-zinc-700 text-zinc-300 hover:bg-zinc-700 disabled:opacity-40 cursor-pointer disabled:cursor-not-allowed">
                        Previous
                    </button>

                    <span class="text-zinc-400 px-1 font-mono">
                        @_page / @Math.Max(1, _totalPages)
                    </span>

                    <button type="button" @onclick="NextPage" disabled="@(_page >= _totalPages)"
                            class="px-2.5 py-1 rounded-lg bg-zinc-800 border border-zinc-700 text-zinc-300 hover:bg-zinc-700 disabled:opacity-40 cursor-pointer disabled:cursor-not-allowed">
                        Next
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- ========================================================================= -->
<!-- AUDIT LOG DEEP-INSPECTION MODAL                                           -->
<!-- ========================================================================= -->
@if (_inspectLog != null)
{
    <div class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-zinc-950 border border-zinc-800 rounded-3xl max-w-3xl w-full p-6 shadow-2xl space-y-5 animate-in fade-in zoom-in-95 duration-150 max-h-[90vh] overflow-y-auto">
            <!-- Modal Header -->
            <div class="flex items-center justify-between pb-4 border-b border-zinc-800">
                <div class="flex items-center gap-3">
                    <span class="px-2.5 py-1 rounded-lg text-xs font-bold border @GetActionBadgeClass(_inspectLog.Action)">
                        @_inspectLog.Action
                    </span>
                    <div>
                        <h2 class="text-base font-bold text-white">Audit Event Inspection</h2>
                        <p class="text-xs text-zinc-400 font-mono">Record ID: @_inspectLog.Id</p>
                    </div>
                </div>
                <button type="button" @onclick="() => _inspectLog = null"
                        class="size-8 rounded-full bg-zinc-800 text-zinc-400 hover:text-white flex items-center justify-center cursor-pointer transition-colors">
                    ✕
                </button>
            </div>

            <!-- Metadata Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 bg-zinc-900/60 p-3.5 rounded-2xl border border-zinc-800 text-xs">
                <div>
                    <span class="text-[10px] text-zinc-500 font-semibold uppercase">Actor</span>
                    <p class="font-semibold text-zinc-200 truncate">@_inspectLog.UserName</p>
                    <p class="text-[10px] text-zinc-500 truncate">@_inspectLog.UserEmail</p>
                </div>
                <div>
                    <span class="text-[10px] text-zinc-500 font-semibold uppercase">Category</span>
                    <p class="font-semibold text-zinc-200">@_inspectLog.EntityName</p>
                    <p class="text-[10px] text-zinc-500 truncate">Ref: @_inspectLog.EntityId</p>
                </div>
                <div>
                    <span class="text-[10px] text-zinc-500 font-semibold uppercase">IP / Client</span>
                    <p class="font-semibold text-zinc-200 font-mono">@(_inspectLog.IpAddress ?? "Unknown")</p>
                    <p class="text-[10px] text-zinc-500 truncate">@(_inspectLog.ClientInfo ?? "Direct")</p>
                </div>
                <div>
                    <span class="text-[10px] text-zinc-500 font-semibold uppercase">Timestamp</span>
                    <p class="font-semibold text-zinc-200">@_inspectLog.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</p>
                    <p class="text-[10px] text-zinc-500 font-mono">@_inspectLog.CreatedAt.ToLocalTime().ToString("hh:mm:ss tt")</p>
                </div>
            </div>

            <!-- Description -->
            <div>
                <span class="text-xs font-semibold text-zinc-400 uppercase tracking-wider">Operation Description</span>
                <p class="mt-1 text-sm font-medium text-zinc-200 bg-zinc-900/60 p-3 rounded-xl border border-zinc-800">
                    @_inspectLog.Details
                </p>
            </div>

            <!-- Diff View (Old vs New Values) -->
            @if (!string.IsNullOrEmpty(_inspectLog.OldValues) || !string.IsNullOrEmpty(_inspectLog.NewValues))
            {
                <div class="space-y-3">
                    <span class="text-xs font-semibold text-zinc-400 uppercase tracking-wider">Before &amp; After State Snapshot</span>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <!-- Old Values -->
                        <div class="space-y-1.5">
                            <span class="text-[11px] font-bold text-rose-400 flex items-center gap-1">
                                <span>-</span> Previous State (Old Values)
                            </span>
                            <div class="p-3 rounded-xl bg-zinc-900 font-mono text-[11px] text-rose-300 overflow-x-auto max-h-56 border border-zinc-800">
                                <pre>@FormatJson(_inspectLog.OldValues)</pre>
                            </div>
                        </div>

                        <!-- New Values -->
                        <div class="space-y-1.5">
                            <span class="text-[11px] font-bold text-emerald-400 flex items-center gap-1">
                                <span>+</span> New State (Updated Values)
                            </span>
                            <div class="p-3 rounded-xl bg-zinc-900 font-mono text-[11px] text-emerald-300 overflow-x-auto max-h-56 border border-zinc-800">
                                <pre>@FormatJson(_inspectLog.NewValues)</pre>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Close Button -->
            <div class="pt-3 border-t border-zinc-800 flex justify-end">
                <button type="button" @onclick="() => _inspectLog = null"
                        class="px-5 py-2 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-white text-xs font-bold transition-all cursor-pointer border border-zinc-700">
                    Close Inspection
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<AuditLogItem>? _logs;
    private AuditSummary? _summary;
    private bool _isLoading = true;
    private bool _isExporting = false;

    // Filters & Pagination State
    private string? _selectedCategory = null;
    private string _selectedAction = "";
    private string _searchTerm = "";
    private DateTime? _startDate;
    private DateTime? _endDate;
    private int _page = 1;
    private int _pageSize = 25;
    private int _totalCount = 0;
    private int _totalPages = 1;

    // Inspection Modal State
    private AuditLogItem? _inspectLog;

    private record CategoryTab(string? Value, string Label, string Icon);

    private readonly List<CategoryTab> _categoryTabs = new()
    {
        new(null, "All Categories", "📜"),
        new("Payroll", "Payroll", "💰"),
        new("Employee", "Employee & Rates", "👤"),
        new("Attendance", "Attendance", "⏱️"),
        new("Leave", "Leaves", "🌴"),
        new("Advance", "Advances", "💳"),
        new("Backup", "Backups & DB", "📦"),
        new("Roles", "Security & Roles", "🛡️")
    };

    private bool HasActiveFilters =>
        _selectedCategory != null ||
        !string.IsNullOrEmpty(_selectedAction) ||
        !string.IsNullOrEmpty(_searchTerm) ||
        _startDate.HasValue ||
        _endDate.HasValue;

    protected override async Task OnInitializedAsync()
    {
        await LoadSummaryAsync();
        await LoadAuditLogsAsync();
    }

    private async Task LoadSummaryAsync()
    {
        try
        {
            _summary = await Http.GetFromJsonAsync<AuditSummary>("api/audit/summary");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AuditLogs] Failed to load summary: {ex.Message}");
        }
    }

    private async Task LoadAuditLogsAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var query = BuildQueryString();
            var response = await Http.GetFromJsonAsync<AuditResponse>($"api/audit?{query}");
            if (response != null)
            {
                _logs = response.Items;
                _page = response.Page;
                _pageSize = response.PageSize;
                _totalCount = response.TotalCount;
                _totalPages = response.TotalPages;
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowToast(ToastLevel.Error, $"Failed to load audit records: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private string BuildQueryString()
    {
        var parameters = new List<string>
        {
            $"page={_page}",
            $"pageSize={_pageSize}"
        };

        if (!string.IsNullOrWhiteSpace(_selectedCategory))
            parameters.Add($"entity={Uri.EscapeDataString(_selectedCategory)}");

        if (!string.IsNullOrWhiteSpace(_selectedAction))
            parameters.Add($"action={Uri.EscapeDataString(_selectedAction)}");

        if (!string.IsNullOrWhiteSpace(_searchTerm))
            parameters.Add($"search={Uri.EscapeDataString(_searchTerm)}");

        if (_startDate.HasValue)
            parameters.Add($"startDate={_startDate.Value:yyyy-MM-dd}");

        if (_endDate.HasValue)
            parameters.Add($"endDate={_endDate.Value:yyyy-MM-dd}");

        return string.Join("&", parameters);
    }

    private async Task SelectCategory(string? category)
    {
        _selectedCategory = category;
        _page = 1;
        await LoadAuditLogsAsync();
    }

    private async Task ApplyFilters()
    {
        _page = 1;
        await LoadAuditLogsAsync();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _page = 1;
            await LoadAuditLogsAsync();
        }
    }

    private async Task ClearSearch()
    {
        _searchTerm = "";
        _page = 1;
        await LoadAuditLogsAsync();
    }

    private async Task OnStartDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
            _startDate = dt;
        else
            _startDate = null;

        _page = 1;
        await LoadAuditLogsAsync();
    }

    private async Task OnEndDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
            _endDate = dt;
        else
            _endDate = null;

        _page = 1;
        await LoadAuditLogsAsync();
    }

    private async Task ResetFilters()
    {
        _selectedCategory = null;
        _selectedAction = "";
        _searchTerm = "";
        _startDate = null;
        _endDate = null;
        _page = 1;
        await LoadAuditLogsAsync();
    }

    private async Task OnPageSizeChanged()
    {
        _page = 1;
        await LoadAuditLogsAsync();
    }

    private async Task PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
            await LoadAuditLogsAsync();
        }
    }

    private async Task NextPage()
    {
        if (_page < _totalPages)
        {
            _page++;
            await LoadAuditLogsAsync();
        }
    }

    private async Task ExportCsvAsync()
    {
        _isExporting = true;
        try
        {
            var query = BuildQueryString();
            var exportUrl = $"/api/audit/export?{query}";
            await JS.InvokeVoidAsync("open", exportUrl, "_blank");
            ToastService.ShowToast(ToastLevel.Success, "Audit trail export started.");
        }
        catch (Exception ex)
        {
            ToastService.ShowToast(ToastLevel.Error, $"Export failed: {ex.Message}");
        }
        finally
        {
            _isExporting = false;
        }
    }

    private void OpenInspectModal(AuditLogItem log)
    {
        _inspectLog = log;
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "SY";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name.Length >= 2 ? name[..2].ToUpper() : name.ToUpper();
    }

    private static string GetActionBadgeClass(string action) => action?.ToUpperInvariant() switch
    {
        "CREATE" => "bg-emerald-950/60 text-emerald-400 border-emerald-800/60",
        "CALCULATE" => "bg-teal-950/60 text-teal-400 border-teal-800/60",
        "UPDATE" => "bg-amber-950/60 text-amber-400 border-amber-800/60",
        "DELETE" => "bg-rose-950/60 text-rose-400 border-rose-800/60",
        "APPROVE" => "bg-blue-950/60 text-blue-400 border-blue-800/60",
        "REJECT" => "bg-orange-950/60 text-orange-400 border-orange-800/60",
        "RESTORE" => "bg-purple-950/60 text-purple-400 border-purple-800/60",
        "SECURITY" => "bg-indigo-950/60 text-indigo-400 border-indigo-800/60",
        _ => "bg-zinc-800 text-zinc-300 border-zinc-700"
    };

    private static string GetCategoryIcon(string category) => category switch
    {
        "Payroll" => "💰",
        "Employee" => "👤",
        "Attendance" => "⏱️",
        "Leave" => "🌴",
        "Advance" => "💳",
        "Backup" => "📦",
        "Roles" => "🛡️",
        "Organization" => "🏢",
        _ => "📜"
    };

    private static string FormatJson(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return "No data recorded.";
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json;
        }
    }

    public class AuditResponse
    {
        public List<AuditLogItem> Items { get; set; } = new();
        public int Page { get; set; }
        public int PageSize { get; set; }
        public int TotalCount { get; set; }
        public int TotalPages { get; set; }
    }

    public class AuditLogItem
    {
        public Guid Id { get; set; }
        public string? UserId { get; set; }
        public string UserName { get; set; } = string.Empty;
        public string? UserEmail { get; set; }
        public string Action { get; set; } = string.Empty;
        public string EntityName { get; set; } = string.Empty;
        public string? EntityId { get; set; }
        public string Details { get; set; } = string.Empty;
        public string? OldValues { get; set; }
        public string? NewValues { get; set; }
        public string? IpAddress { get; set; }
        public string? ClientInfo { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    public class AuditSummary
    {
        public int TotalEvents { get; set; }
        public int TodayCount { get; set; }
        public int FinancialCount { get; set; }
        public int SecurityCount { get; set; }
        public Dictionary<string, int> ActionCounts { get; set; } = new();
        public Dictionary<string, int> EntityCounts { get; set; } = new();
    }
}
