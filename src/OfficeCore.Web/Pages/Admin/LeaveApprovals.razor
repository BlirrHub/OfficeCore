@page "/admin/leave-approvals"
@attribute [Authorize(Roles = "Admin,HR")]
@inject HttpClient Http
@inject OfficeCore.Web.Services.ToastService ToastService

<PageTitle>Leave Approvals - OfficeCore</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight text-white">Leave Approvals</h1>
        <p class="mt-1 text-zinc-400 text-sm">Review and manage employee leave requests.</p>
    </div>

    <!-- Stats row -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6">
            <h3 class="text-zinc-400 text-sm font-medium">Pending Requests</h3>
            <p class="text-3xl font-bold text-white mt-2">@_requests?.Count(r => r.Status == 0)</p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6">
            <h3 class="text-zinc-400 text-sm font-medium">Approved Today</h3>
            <p class="text-3xl font-bold text-emerald-400 mt-2">@_requests?.Count(r => r.Status == 1 && r.CreatedAt.Date == DateTime.Today)</p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6">
            <h3 class="text-zinc-400 text-sm font-medium">Total Sick Leaves</h3>
            <p class="text-3xl font-bold text-red-400 mt-2">@_requests?.Count(r => r.Type == 0)</p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6">
            <h3 class="text-zinc-400 text-sm font-medium">Total Vacation Leaves</h3>
            <p class="text-3xl font-bold text-blue-400 mt-2">@_requests?.Count(r => r.Type == 1)</p>
        </div>
    </div>

    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden shadow-xl">
        <div class="p-4 border-b border-zinc-800 flex items-center justify-between bg-zinc-900/50">
            <div class="relative">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 size-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                <input type="text" @bind="_searchQuery" @bind:event="oninput" placeholder="Search employees..." class="bg-zinc-950 border border-zinc-800 rounded-lg pl-9 pr-4 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none w-64" />
            </div>
            <div class="flex items-center gap-2">
                <select @bind="_statusFilter" class="bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none">
                    <option value="-1">All Statuses</option>
                    <option value="0">Pending</option>
                    <option value="1">Approved</option>
                    <option value="2">Rejected</option>
                </select>
                <select @bind="_typeFilter" class="bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none">
                    <option value="-1">All Types</option>
                    <option value="0">Sick Leave</option>
                    <option value="1">Vacation Leave</option>
                </select>
                <button @onclick="() => _isCreatingLeave = true" class="px-4 py-2 text-sm font-medium text-white bg-fuchsia-600 rounded-lg hover:bg-fuchsia-500 transition-colors shadow-lg shadow-fuchsia-900/30 flex items-center gap-2">
                    <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                    Create Leave
                </button>
            </div>
        </div>

        @if (_requests == null)
        {
            <div class="p-12 text-center text-zinc-500">
                <svg class="animate-spin size-8 mx-auto mb-4" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" /><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" /></svg>
                Loading requests...
            </div>
        }
        else
        {
            var filtered = _requests.Where(r => 
                (string.IsNullOrWhiteSpace(_searchQuery) || r.EmployeeName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)) &&
                (_statusFilter == -1 || r.Status == _statusFilter) &&
                (_typeFilter == -1 || r.Type == _typeFilter)
            ).ToList();

            if (!filtered.Any())
            {
                <div class="p-12 text-center">
                    <div class="mx-auto size-16 bg-zinc-800/50 rounded-full flex items-center justify-center mb-4">
                        <svg class="size-8 text-zinc-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                    </div>
                    <h3 class="text-lg font-medium text-white mb-1">No requests found</h3>
                    <p class="text-sm text-zinc-500">Try adjusting your search or filters.</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm whitespace-nowrap">
                        <thead class="bg-zinc-950/50 text-zinc-400 font-medium">
                            <tr>
                                <th class="px-6 py-4">Employee</th>
                                <th class="px-6 py-4">Type</th>
                                <th class="px-6 py-4">Dates</th>
                                <th class="px-6 py-4">Status</th>
                                <th class="px-6 py-4 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-zinc-800/50">
                            @foreach (var request in filtered)
                            {
                                <tr class="hover:bg-zinc-800/30 transition-colors cursor-pointer" @onclick="() => SelectRequest(request)">
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-3">
                                            <div class="size-8 rounded-full bg-fuchsia-900/50 text-fuchsia-400 flex items-center justify-center font-bold text-xs border border-fuchsia-800">
                                                @request.EmployeeName[0]
                                            </div>
                                            <div>
                                                <div class="text-white font-medium">@request.EmployeeName</div>
                                                <div class="text-xs text-zinc-500">Requested: @request.CreatedAt.ToString("MMM dd")</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-2">
                                            @if (request.Type == 0)
                                            {
                                                <span class="w-2 h-2 rounded-full bg-red-400"></span>
                                                <span class="text-zinc-300">Sick Leave</span>
                                            }
                                            else
                                            {
                                                <span class="w-2 h-2 rounded-full bg-blue-400"></span>
                                                <span class="text-zinc-300">Vacation Leave</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-zinc-300">
                                        @request.StartDate.ToString("MMM dd") - @request.EndDate.ToString("MMM dd, yyyy")
                                        <div class="text-xs text-zinc-500">
                                            @((request.EndDate - request.StartDate).Days + 1) days
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        @if (request.Status == 0)
                                        {
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-yellow-500/10 text-yellow-500 border border-yellow-500/20">Pending</span>
                                        }
                                        else if (request.Status == 1)
                                        {
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Approved</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-red-500/10 text-red-400 border border-red-500/20">Rejected</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="flex items-center justify-end gap-3">
                                            <button @onclick:stopPropagation="true" @onclick="() => SelectRequest(request)" class="text-fuchsia-400 hover:text-fuchsia-300 font-medium text-xs">
                                                View Details
                                            </button>
                                            <button @onclick:stopPropagation="true" @onclick="() => ConfirmDelete(request)" class="text-red-400 hover:text-red-300 font-medium text-xs">
                                                Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>

@if (_selectedRequest != null)
{
    <div class="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-50 p-4">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-2xl shadow-2xl relative overflow-hidden flex flex-col max-h-[90vh]">
            <div class="p-6 border-b border-zinc-800 flex items-center justify-between bg-zinc-900">
                <h3 class="text-xl font-bold text-white flex items-center gap-3">
                    Leave Request Details
                    @if (_selectedRequest.Status == 0)
                    {
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-yellow-500/10 text-yellow-500 border border-yellow-500/20">Pending</span>
                    }
                    else if (_selectedRequest.Status == 1)
                    {
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Approved</span>
                    }
                    else
                    {
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-red-500/10 text-red-400 border border-red-500/20">Rejected</span>
                    }
                </h3>
                <button @onclick="() => _selectedRequest = null" class="text-zinc-500 hover:text-white transition-colors">
                    <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>

            <div class="p-6 overflow-y-auto flex-1 space-y-6">
                <!-- User Info Row -->
                <div class="flex items-center gap-4 p-4 bg-zinc-950 rounded-xl border border-zinc-800/50">
                    <div class="size-12 rounded-full bg-fuchsia-900/50 text-fuchsia-400 flex items-center justify-center font-bold text-lg border border-fuchsia-800">
                        @_selectedRequest.EmployeeName[0]
                    </div>
                    <div>
                        <div class="text-white font-medium text-lg">@_selectedRequest.EmployeeName</div>
                        <div class="text-sm text-zinc-500">Requested on @_selectedRequest.CreatedAt.ToString("MMMM dd, yyyy")</div>
                    </div>
                </div>

                <!-- Grid Details -->
                <div class="grid grid-cols-2 gap-6">
                    <div>
                        <label class="block text-xs font-medium text-zinc-500 uppercase tracking-wider mb-1">Leave Type</label>
                        <div class="text-white font-medium">
                            @(_selectedRequest.Type == 0 ? "Sick Leave" : "Vacation Leave")
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-zinc-500 uppercase tracking-wider mb-1">Duration</label>
                        <div class="text-white font-medium">
                            @((_selectedRequest.EndDate - _selectedRequest.StartDate).Days + 1) Days
                        </div>
                        <div class="text-xs text-zinc-400">
                            @_selectedRequest.StartDate.ToString("MMM dd") to @_selectedRequest.EndDate.ToString("MMM dd, yyyy")
                        </div>
                    </div>
                </div>

                <!-- Reason -->
                <div>
                    <label class="block text-xs font-medium text-zinc-500 uppercase tracking-wider mb-2">Reason provided</label>
                    <div class="p-4 bg-zinc-950 rounded-xl border border-zinc-800/50 text-zinc-300 text-sm whitespace-pre-wrap">
                        @_selectedRequest.Reason
                    </div>
                </div>

                <!-- Attachment -->
                @if (_selectedRequest.Type == 0) // Sick leave attachments
                {
                    <div>
                        <label class="block text-xs font-medium text-zinc-500 uppercase tracking-wider mb-2">Medical Attachment</label>
                        @if (string.IsNullOrEmpty(_selectedRequest.AttachmentPath))
                        {
                            <div class="p-4 bg-zinc-950 rounded-xl border border-zinc-800/50 flex items-center justify-center text-zinc-500 text-sm">
                                No attachment provided.
                            </div>
                        }
                        else
                        {
                            <div class="border border-zinc-800 rounded-xl overflow-hidden bg-zinc-950">
                                <a href="http://localhost:5033@_selectedRequest.AttachmentPath" target="_blank" class="block hover:opacity-80 transition-opacity">
                                    <img src="http://localhost:5033@_selectedRequest.AttachmentPath" class="w-full max-h-64 object-contain" alt="Medical Certificate" />
                                </a>
                                <div class="p-3 border-t border-zinc-800 bg-zinc-900/50 flex justify-between items-center">
                                    <span class="text-xs text-zinc-400">Click image to view full size</span>
                                    <a href="http://localhost:5033@_selectedRequest.AttachmentPath" target="_blank" class="text-fuchsia-400 hover:text-fuchsia-300 text-xs font-medium flex items-center gap-1">
                                        Open in new tab
                                        <svg class="size-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="p-6 border-t border-zinc-800 bg-zinc-900 flex justify-end gap-3">
                @if (_selectedRequest.Status == 0)
                {
                    <button @onclick="() => UpdateStatus(_selectedRequest, 2)" disabled="@_isUpdating" class="px-5 py-2.5 bg-red-600/10 hover:bg-red-600/20 text-red-500 border border-red-500/20 text-sm font-semibold rounded-lg transition-colors">
                        Reject Request
                    </button>
                    <button @onclick="() => UpdateStatus(_selectedRequest, 1)" disabled="@_isUpdating" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-semibold rounded-lg shadow-lg shadow-emerald-900/20 transition-colors">
                        Approve Request
                    </button>
                }
                else
                {
                    <button @onclick="() => _selectedRequest = null" class="px-5 py-2.5 bg-zinc-800 hover:bg-zinc-700 text-white text-sm font-semibold rounded-lg transition-colors">
                        Close
                    </button>
                }
            </div>
        </div>
    </div>
}

@if (_isCreatingLeave)
{
    <div class="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-50 p-4">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-xl shadow-2xl relative overflow-hidden">
            <div class="p-6 border-b border-zinc-800 flex items-center justify-between bg-zinc-900">
                <h3 class="text-xl font-bold text-white tracking-wide uppercase">Create Leave</h3>
                <button @onclick="() => _isCreatingLeave = false" class="text-zinc-500 hover:text-white transition-colors">
                    <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>

            <div class="p-6 overflow-y-auto space-y-6">
                @if (_employees == null)
                {
                    <div class="text-zinc-500 text-sm">Loading employees...</div>
                }
                else
                {
                    <EditForm Model="_newLeave" OnValidSubmit="SubmitAdminCreateLeave">
                        <DataAnnotationsValidator />
                        
                        <div class="space-y-4">
                            <div>
                                <label class="block text-sm font-medium text-zinc-400 mb-1">Employee</label>
                                <InputSelect @bind-Value="_newLeave.EmployeeId" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-white focus:border-fuchsia-500 focus:outline-none">
                                    <option value="">-- Select Employee --</option>
                                    @foreach (var emp in _employees)
                                    {
                                        <option value="@emp.Id">@emp.FirstName @emp.LastName</option>
                                    }
                                </InputSelect>
                            </div>
                            
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-zinc-400 mb-1">Leave Type</label>
                                    <InputSelect @bind-Value="_newLeave.Type" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-white focus:border-fuchsia-500 focus:outline-none">
                                        <option value="0">Sick Leave</option>
                                        <option value="1">Vacation Leave</option>
                                    </InputSelect>
                                </div>
                            </div>

                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-zinc-400 mb-1">Start Date</label>
                                    <InputDate @bind-Value="_newLeave.StartDate" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-white focus:border-fuchsia-500 focus:outline-none" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-zinc-400 mb-1">End Date</label>
                                    <InputDate @bind-Value="_newLeave.EndDate" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-white focus:border-fuchsia-500 focus:outline-none" />
                                </div>
                            </div>
                            
                            <div>
                                <label class="block text-sm font-medium text-zinc-400 mb-1">Reason</label>
                                <InputTextArea @bind-Value="_newLeave.Reason" rows="3" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-white focus:border-fuchsia-500 focus:outline-none" placeholder="Reason for leave..." />
                            </div>
                        </div>

                        <div class="mt-8 flex justify-end gap-3 border-t border-zinc-800 pt-6">
                            <button type="button" @onclick="() => _isCreatingLeave = false" class="px-5 py-2.5 text-sm font-medium text-zinc-400 hover:text-white bg-zinc-800 rounded-lg transition-colors">Cancel</button>
                            <button type="submit" class="px-5 py-2.5 text-sm font-medium text-white bg-fuchsia-600 rounded-lg hover:bg-fuchsia-500 transition-colors shadow-lg shadow-fuchsia-900/30">Create & Approve</button>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
}

@if (_requestToDelete != null)
{
    <div class="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-[60] p-4">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-md shadow-2xl relative overflow-hidden">
            <div class="p-6 border-b border-zinc-800 flex items-center justify-between bg-zinc-900">
                <h3 class="text-xl font-bold text-white tracking-wide uppercase">Delete Leave</h3>
                <button @onclick="() => _requestToDelete = null" class="text-zinc-500 hover:text-white transition-colors">
                    <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>
            <div class="p-6 space-y-6">
                <p class="text-zinc-400">Are you sure you want to delete this leave request for <span class="text-white font-medium">@_requestToDelete.EmployeeName</span>?</p>
                <div class="flex justify-end gap-3 pt-4 border-t border-zinc-800">
                    <button type="button" @onclick="() => _requestToDelete = null" class="px-5 py-2.5 rounded-lg text-sm font-medium text-zinc-300 hover:text-white hover:bg-zinc-800 transition-colors">Cancel</button>
                    <button type="button" @onclick="DeleteRequest" class="px-5 py-2.5 rounded-lg text-sm font-bold text-white bg-red-600 hover:bg-red-500 transition-colors shadow-lg shadow-red-900/20">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<LeaveRequestAdminDto>? _requests;
    private string _searchQuery = "";
    private int _statusFilter = -1;
    private int _typeFilter = -1;
    
    private LeaveRequestAdminDto? _selectedRequest;
    private bool _isUpdating = false;

    // Admin Create State
    private bool _isCreatingLeave = false;
    private AdminCreateLeaveRequestDto _newLeave = new() { StartDate = DateTime.Today, EndDate = DateTime.Today };
    private List<EmployeeDto>? _employees;
    
    // Delete State
    private LeaveRequestAdminDto? _requestToDelete;

    private void ConfirmDelete(LeaveRequestAdminDto request)
    {
        _requestToDelete = request;
    }

    private async Task DeleteRequest()
    {
        if (_requestToDelete == null) return;
        try
        {
            var response = await Http.DeleteAsync($"/api/leaverequest/{_requestToDelete.Id}");
            if (response.IsSuccessStatusCode)
            {
                _requestToDelete = null;
                await LoadRequests();
                ToastService.ShowSuccess("Leave request deleted.");
            }
            else
            {
                ToastService.ShowError("Failed to delete request.");
            }
        }
        catch
        {
            ToastService.ShowError("An error occurred.");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadRequests();
        await LoadEmployees();
    }

    private async Task LoadEmployees()
    {
        _employees = await Http.GetFromJsonAsync<List<EmployeeDto>>("/api/user");
        _employees = _employees?.Where(e => e.IsActive && e.IsEmployee).ToList() ?? new List<EmployeeDto>();
    }

    private async Task LoadRequests()
    {
        _requests = await Http.GetFromJsonAsync<List<LeaveRequestAdminDto>>("/api/leaverequest");
    }

    private void SelectRequest(LeaveRequestAdminDto request)
    {
        _selectedRequest = request;
    }

    private async Task UpdateStatus(LeaveRequestAdminDto request, int newStatus)
    {
        _isUpdating = true;
        try
        {
            var response = await Http.PutAsJsonAsync($"/api/leaverequest/{request.Id}/status", new { Status = newStatus });
            if (response.IsSuccessStatusCode)
            {
                await LoadRequests();
                _selectedRequest = null;
                ToastService.ShowSuccess($"Request {(newStatus == 1 ? "approved" : "rejected")}.");
            }
            else
            {
                ToastService.ShowError("Failed to update status.");
            }
        }
        finally
        {
            _isUpdating = false;
        }
    }

    private async Task SubmitAdminCreateLeave()
    {
        if (string.IsNullOrWhiteSpace(_newLeave.EmployeeId) || string.IsNullOrWhiteSpace(_newLeave.Reason)) return;
        
        var response = await Http.PostAsJsonAsync("/api/leaverequest/admin-create", _newLeave);
        if (response.IsSuccessStatusCode)
        {
            _isCreatingLeave = false;
            _newLeave = new() { StartDate = DateTime.Today, EndDate = DateTime.Today };
            await LoadRequests();
            ToastService.ShowSuccess("Leave created and approved.");
        }
        else
        {
            ToastService.ShowError("Failed to create leave.");
        }
    }

    private class LeaveRequestAdminDto
    {
        public Guid Id { get; set; }
        public string EmployeeId { get; set; } = string.Empty;
        public string EmployeeName { get; set; } = string.Empty;
        public int Type { get; set; }
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }
        public string Reason { get; set; } = string.Empty;
        public string? AttachmentPath { get; set; }
        public int Status { get; set; }
        public DateTime CreatedAt { get; set; }
    }
    
    public class AdminCreateLeaveRequestDto
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string EmployeeId { get; set; } = string.Empty;
        public int Type { get; set; }
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }
        [System.ComponentModel.DataAnnotations.Required]
        public string Reason { get; set; } = string.Empty;
    }

    public class EmployeeDto
    {
        public string Id { get; set; } = string.Empty;
