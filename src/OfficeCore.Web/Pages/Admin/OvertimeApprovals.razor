@page "/admin/overtime-approvals"
@attribute [Authorize(Policy = "RequireOvertimeApprovals")]
@inject HttpClient Http
@inject HubConnectionFactory HubFactory
@inject OfficeCore.Web.Services.ToastService ToastService
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client
@using OfficeCore.Web.Services

<PageTitle>Overtime Approvals - OfficeCore</PageTitle>

<div class="space-y-6">
    <PageHeader Title="Overtime Approvals" Subtitle="Review, approve, and audit pre-shift requests and auto-detected post-shift punches.">
        <Actions>
            <div class="flex items-center gap-3">
                <button @onclick="RefreshData" disabled="@_isLoading" class="p-2 text-zinc-400 hover:text-white bg-zinc-900 border border-zinc-800 rounded-lg transition-colors cursor-pointer" title="Refresh">
                    <svg class="size-4 @(_isLoading ? "animate-spin text-fuchsia-400" : "")" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
                </button>
                <AuthorizeView Policy="Permission:overtime-approvals.manage">
                    <AppButton OnClick="OpenCreateModal">
                        <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                        Log Overtime
                    </AppButton>
                </AuthorizeView>
            </div>
        </Actions>
    </PageHeader>

    <!-- Stats row -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5 shadow-lg">
            <div class="flex items-center justify-between text-zinc-400 text-xs font-semibold uppercase tracking-wider">
                <span>Pending Review</span>
                <span class="size-2 rounded-full bg-amber-400 animate-pulse"></span>
            </div>
            <p class="text-3xl font-bold text-white mt-2">@(_requests?.Count(r => r.Status == 0) ?? 0)</p>
            <p class="text-xs text-zinc-500 mt-1">Requires manager resolution</p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5 shadow-lg">
            <div class="flex items-center justify-between text-zinc-400 text-xs font-semibold uppercase tracking-wider">
                <span>Approved Hours</span>
                <span class="size-2 rounded-full bg-emerald-400"></span>
            </div>
            <p class="text-3xl font-bold text-emerald-400 mt-2">
                @((_requests?.Where(r => r.Status == 1).Sum(r => r.ApprovedHours ?? r.RequestedHours) ?? 0).ToString("0.##")) <span class="text-sm font-normal text-zinc-400">hrs</span>
            </p>
            <p class="text-xs text-zinc-500 mt-1">Credited into payroll</p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5 shadow-lg">
            <div class="flex items-center justify-between text-zinc-400 text-xs font-semibold uppercase tracking-wider">
                <span>Pre-Overtime</span>
                <span class="size-2 rounded-full bg-fuchsia-400"></span>
            </div>
            <p class="text-3xl font-bold text-fuchsia-400 mt-2">@(_requests?.Count(r => r.Type == 0) ?? 0)</p>
            <p class="text-xs text-zinc-500 mt-1">Advance requests</p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5 shadow-lg">
            <div class="flex items-center justify-between text-zinc-400 text-xs font-semibold uppercase tracking-wider">
                <span>Post-Overtime</span>
                <span class="size-2 rounded-full bg-cyan-400"></span>
            </div>
            <p class="text-3xl font-bold text-cyan-400 mt-2">@(_requests?.Count(r => r.Type == 1) ?? 0)</p>
            <p class="text-xs text-zinc-500 mt-1">15m+ post-shift punches</p>
        </div>
    </div>

    <!-- Main Card -->
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden shadow-xl">
        <div class="p-4 border-b border-zinc-800 flex items-center justify-between gap-4 bg-zinc-900/50">
            <div class="relative w-64 sm:w-72 shrink-0">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 size-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                <input type="text" @bind="_searchQuery" @bind:event="oninput" @bind:after="ResetPage" placeholder="Search employee or reason..." class="bg-zinc-950 border border-zinc-800 rounded-lg pl-9 pr-4 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none w-full" />
            </div>
            <div class="flex items-center gap-2 shrink-0">
                <select @bind="_statusFilter" @bind:after="ResetPage" class="bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none cursor-pointer">
                    <option value="-1">All Statuses</option>
                    <option value="0">Pending</option>
                    <option value="1">Approved</option>
                    <option value="2">Rejected</option>
                    <option value="3">Cancelled</option>
                </select>
                <select @bind="_typeFilter" @bind:after="ResetPage" class="bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none cursor-pointer">
                    <option value="-1">All Types</option>
                    <option value="0">Pre-Overtime</option>
                    <option value="1">Post-Overtime</option>
                </select>
            </div>
        </div>

        @if (_requests == null)
        {
            <div class="p-12 text-center text-zinc-500">
                <svg class="animate-spin size-8 mx-auto mb-4 text-fuchsia-400" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" /><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" /></svg>
                Loading overtime requests...
            </div>
        }
        else
        {
            var filtered = _requests.Where(r =>
                (string.IsNullOrWhiteSpace(_searchQuery) ||
                 r.EmployeeName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                 r.EmployeeNumber.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                 (r.Reason != null && r.Reason.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))) &&
                (_statusFilter == -1 || r.Status == _statusFilter) &&
                (_typeFilter == -1 || r.Type == _typeFilter)
            ).ToList();

            if (!filtered.Any())
            {
                <EmptyState Card="false"
                            Title="No overtime requests found"
                            Description="Try adjusting your search or filters." />
            }
            else
            {
                var paged = filtered.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm whitespace-nowrap">
                        <thead class="bg-zinc-950/50 text-zinc-400 font-medium border-b border-zinc-800/80">
                            <tr>
                                <th class="px-6 py-4">Employee</th>
                                <th class="px-6 py-4">Work Date</th>
                                <th class="px-6 py-4">Type</th>
                                <th class="px-6 py-4">Time Window</th>
                                <th class="px-6 py-4">Hours</th>
                                <th class="px-6 py-4">Reason / Punch Details</th>
                                <th class="px-6 py-4">Status & Audit</th>
                                <th class="px-6 py-4 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-zinc-800/60 text-zinc-300">
                            @foreach (var req in paged)
                            {
                                <tr class="hover:bg-zinc-800/30 transition-colors">
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-3">
                                            <div class="size-8 rounded-full bg-zinc-800 border border-zinc-700/60 flex items-center justify-center font-bold text-xs text-fuchsia-400">
                                                @(string.IsNullOrWhiteSpace(req.EmployeeName) ? "E" : req.EmployeeName[0].ToString().ToUpper())
                                            </div>
                                            <div>
                                                <div class="font-medium text-white">@req.EmployeeName</div>
                                                <div class="text-[11px] text-zinc-500 font-mono">@req.EmployeeNumber</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="font-medium text-white">@req.Date.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                        <div class="text-[11px] text-zinc-500">@req.Date.ToLocalTime().ToString("dddd")</div>
                                    </td>
                                    <td class="px-6 py-4">
                                        @if (req.Type == 0)
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-fuchsia-950/80 text-fuchsia-300 border border-fuchsia-800/60">
                                                <span class="size-1.5 rounded-full bg-fuchsia-400"></span>
                                                Pre-Overtime
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-cyan-950/80 text-cyan-300 border border-cyan-800/60">
                                                <span class="size-1.5 rounded-full bg-cyan-400"></span>
                                                Post-Overtime
                                            </span>
                                        }
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="font-mono text-xs text-zinc-200">
                                            @FormatTimeSpanString(req.StartTime) — @FormatTimeSpanString(req.EndTime)
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="font-semibold text-white">
                                            @(req.ApprovedHours.HasValue ? req.ApprovedHours.Value.ToString("0.##") : req.RequestedHours.ToString("0.##")) hrs
                                        </div>
                                        @if (req.ApprovedHours.HasValue && req.ApprovedHours.Value != req.RequestedHours)
                                        {
                                            <div class="text-[10px] text-zinc-500 line-through">Requested: @req.RequestedHours.ToString("0.##") hrs</div>
                                        }
                                    </td>
                                    <td class="px-6 py-4 max-w-xs">
                                        <div class="truncate text-xs text-zinc-400" title="@req.Reason">
                                            @(string.IsNullOrWhiteSpace(req.Reason) ? "—" : req.Reason)
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        @if (req.Status == 0)
                                        {
                                            <AppBadge Variant="warning" Dot="true">Pending Review</AppBadge>
                                        }
                                        else if (req.Status == 1)
                                        {
                                            <div class="flex flex-col gap-0.5">
                                                <AppBadge Variant="success" Dot="true">Approved</AppBadge>
                                                @if (!string.IsNullOrEmpty(req.ReviewedByName))
                                                {
                                                    <span class="text-[10px] text-zinc-500">By @req.ReviewedByName</span>
                                                }
                                            </div>
                                        }
                                        else if (req.Status == 2)
                                        {
                                            <div class="flex flex-col gap-0.5">
                                                <AppBadge Variant="danger" Dot="true">Rejected</AppBadge>
                                                <span class="text-[10px] text-zinc-500" title="@req.RejectionReason">
                                                    @(string.IsNullOrWhiteSpace(req.RejectionReason) ? "Clamped to shift end" : req.RejectionReason)
                                                </span>
                                            </div>
                                        }
                                        else if (req.Status == 3)
                                        {
                                            <AppBadge Variant="default" Dot="true">Cancelled</AppBadge>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        @if (req.Status == 0)
                                        {
                                            <AuthorizeView Policy="Permission:overtime-approvals.manage">
                                                <Authorized>
                                                    <div class="flex items-center justify-end gap-2">
                                                        <button @onclick="() => OpenApproveModal(req)" class="px-2.5 py-1 text-xs font-semibold text-emerald-400 hover:text-white bg-emerald-950/40 hover:bg-emerald-600 rounded-lg border border-emerald-800/40 transition-colors cursor-pointer" title="Approve Overtime">
                                                            Approve
                                                        </button>
                                                        <button @onclick="() => OpenRejectModal(req)" class="px-2.5 py-1 text-xs font-semibold text-red-400 hover:text-white bg-red-950/40 hover:bg-red-600 rounded-lg border border-red-800/40 transition-colors cursor-pointer" title="Reject Overtime (Clamps down to shift end)">
                                                            Reject
                                                        </button>
                                                    </div>
                                                </Authorized>
                                                <NotAuthorized>
                                                    <span class="text-zinc-600 text-xs">—</span>
                                                </NotAuthorized>
                                            </AuthorizeView>
                                        }
                                        else
                                        {
                                            <span class="text-zinc-600 text-xs">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <PaginationToolbar @bind-Page="_page" @bind-PageSize="_pageSize" TotalCount="filtered.Count" />
            }
        }
    </div>
</div>

<!-- Modal 1: Approve Overtime Modal -->
@if (_approveTarget != null)
{
    <div class="fixed inset-0 bg-black/75 backdrop-blur-sm flex items-center justify-center z-50 p-4 animate-in fade-in duration-200">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-md shadow-2xl flex flex-col overflow-hidden">
            <div class="px-6 py-4 border-b border-zinc-800 flex items-center justify-between shrink-0 bg-zinc-950/40">
                <div>
                    <h3 class="text-base font-bold text-white tracking-wide">Approve Overtime</h3>
                    <p class="text-xs text-zinc-400 mt-0.5">Credit overtime hours for @_approveTarget.EmployeeName</p>
                </div>
                <button type="button" @onclick="() => _approveTarget = null" class="text-zinc-500 hover:text-white transition-colors cursor-pointer">
                    <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>

            <div class="p-6 space-y-4">
                <div class="p-3 bg-zinc-950 rounded-xl border border-zinc-800 space-y-1.5 text-xs">
                    <div class="flex justify-between">
                        <span class="text-zinc-400">Work Date:</span>
                        <span class="font-medium text-white">@_approveTarget.Date.ToLocalTime().ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-zinc-400">Type:</span>
                        <span class="font-medium text-white">@_approveTarget.TypeName</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-zinc-400">Time Window:</span>
                        <span class="font-mono text-zinc-200">@FormatTimeSpanString(_approveTarget.StartTime) — @FormatTimeSpanString(_approveTarget.EndTime)</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-zinc-400">Requested:</span>
                        <span class="font-semibold text-fuchsia-400">@_approveTarget.RequestedHours.ToString("0.##") hours</span>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Approved Hours to Credit</label>
                    <input type="number" step="0.25" min="0.25" @bind="_approvedHoursInput" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:border-emerald-500 focus:outline-none font-mono" />
                    <p class="text-[11px] text-zinc-500 mt-1">Leave as requested (@_approveTarget.RequestedHours.ToString("0.##") hrs) or adjust as needed.</p>
                </div>
            </div>

            <div class="px-6 py-4 border-t border-zinc-800 flex justify-end gap-3 shrink-0 bg-zinc-950/40">
                <button type="button" @onclick="() => _approveTarget = null" class="px-4 py-2 text-xs font-medium text-zinc-400 hover:text-white bg-zinc-800 hover:bg-zinc-700 rounded-lg transition-colors cursor-pointer">
                    Cancel
                </button>
                <button type="button" @onclick="ConfirmApprove" disabled="@_isSubmittingAction" class="px-4 py-2 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-500 rounded-lg transition-colors shadow-lg shadow-emerald-900/30 flex items-center gap-2 cursor-pointer disabled:opacity-50">
                    @if (_isSubmittingAction)
                    {
                        <svg class="animate-spin size-3.5" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" /><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" /></svg>
                    }
                    <span>Confirm Approval</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- Modal 2: Reject Overtime Modal -->
@if (_rejectTarget != null)
{
    <div class="fixed inset-0 bg-black/75 backdrop-blur-sm flex items-center justify-center z-50 p-4 animate-in fade-in duration-200">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-md shadow-2xl flex flex-col overflow-hidden">
            <div class="px-6 py-4 border-b border-zinc-800 flex items-center justify-between shrink-0 bg-zinc-950/40">
                <div>
                    <h3 class="text-base font-bold text-white tracking-wide">Reject Overtime</h3>
                    <p class="text-xs text-zinc-400 mt-0.5">Time will clamp down to scheduled shift end.</p>
                </div>
                <button type="button" @onclick="() => _rejectTarget = null" class="text-zinc-500 hover:text-white transition-colors cursor-pointer">
                    <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>

            <div class="p-6 space-y-4">
                <div class="p-3 bg-red-950/30 rounded-xl border border-red-900/40 text-xs text-red-300">
                    <p class="font-medium">Rule Warning:</p>
                    <p class="mt-0.5 text-zinc-400">
                        Rejecting this overtime will automatically round down the employee's effective clock-out to their scheduled shift end (zero overtime pay credited).
                    </p>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Rejection Reason (Optional)</label>
                    <textarea @bind="_rejectionReasonInput" rows="3" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2 text-sm text-white focus:border-red-500 focus:outline-none placeholder-zinc-600" placeholder="e.g. Unscheduled work, no prior authorization, or non-work-related delay..."></textarea>
                </div>
            </div>

            <div class="px-6 py-4 border-t border-zinc-800 flex justify-end gap-3 shrink-0 bg-zinc-950/40">
                <button type="button" @onclick="() => _rejectTarget = null" class="px-4 py-2 text-xs font-medium text-zinc-400 hover:text-white bg-zinc-800 hover:bg-zinc-700 rounded-lg transition-colors cursor-pointer">
                    Cancel
                </button>
                <button type="button" @onclick="ConfirmReject" disabled="@_isSubmittingAction" class="px-4 py-2 text-xs font-semibold text-white bg-red-600 hover:bg-red-500 rounded-lg transition-colors shadow-lg shadow-red-900/30 flex items-center gap-2 cursor-pointer disabled:opacity-50">
                    @if (_isSubmittingAction)
                    {
                        <svg class="animate-spin size-3.5" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" /><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" /></svg>
                    }
                    <span>Confirm Rejection</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- Modal 3: Administrative Log Overtime Modal -->
@if (_isCreatingManual)
{
    <div class="fixed inset-0 bg-black/75 backdrop-blur-sm flex items-center justify-center z-50 p-4 animate-in fade-in duration-200">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-lg shadow-2xl flex flex-col overflow-hidden">
            <div class="px-6 py-4 border-b border-zinc-800 flex items-center justify-between shrink-0 bg-zinc-950/40">
                <div>
                    <h3 class="text-base font-bold text-white tracking-wide">Log Overtime Entry</h3>
                    <p class="text-xs text-zinc-400 mt-0.5">Directly record or approve overtime for an employee.</p>
                </div>
                <button type="button" @onclick="() => _isCreatingManual = false" class="text-zinc-500 hover:text-white transition-colors cursor-pointer">
                    <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>

            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Employee</label>
                    <select @bind="_manualEmployeeId" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none cursor-pointer">
                        <option value="">Select Employee...</option>
                        @if (_employees != null)
                        {
                            @foreach (var emp in _employees)
                            {
                                <option value="@emp.Id">@emp.FirstName @emp.LastName (@emp.EmployeeId)</option>
                            }
                        }
                    </select>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Work Date</label>
                        <input type="date" @bind="_manualDate" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none cursor-pointer" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Type</label>
                        <select @bind="_manualType" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none cursor-pointer">
                            <option value="0">Pre-Overtime</option>
                            <option value="1">Post-Overtime</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Start Time</label>
                        <input type="time" @bind="_manualStartTime" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none font-mono cursor-pointer" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">End Time</label>
                        <input type="time" @bind="_manualEndTime" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none font-mono cursor-pointer" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Reason / Deliverable</label>
                    <textarea @bind="_manualReason" rows="2" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2 text-sm text-white focus:border-fuchsia-500 focus:outline-none placeholder-zinc-600" placeholder="Administrative overtime justification..."></textarea>
                </div>

                <div class="flex items-center gap-2 pt-1">
                    <input type="checkbox" id="autoApproveCheck" @bind="_manualAutoApprove" class="rounded border-zinc-700 bg-zinc-950 text-fuchsia-600 focus:ring-fuchsia-500 cursor-pointer" />
                    <label for="autoApproveCheck" class="text-xs text-zinc-300 font-medium cursor-pointer">Immediately mark as Approved and credit hours</label>
                </div>

                @if (!string.IsNullOrEmpty(_manualModalError))
                {
                    <div class="p-3 bg-red-950/50 border border-red-900/50 rounded-lg">
                        <p class="text-xs text-red-400 font-medium">@_manualModalError</p>
                    </div>
                }
            </div>

            <div class="px-6 py-4 border-t border-zinc-800 flex justify-end gap-3 shrink-0 bg-zinc-950/40">
                <button type="button" @onclick="() => _isCreatingManual = false" class="px-4 py-2 text-xs font-medium text-zinc-400 hover:text-white bg-zinc-800 hover:bg-zinc-700 rounded-lg transition-colors cursor-pointer">
                    Cancel
                </button>
                <button type="button" @onclick="SubmitManualCreate" disabled="@_isSubmittingAction" class="px-4 py-2 text-xs font-semibold text-white bg-fuchsia-600 hover:bg-fuchsia-500 rounded-lg transition-colors shadow-lg shadow-fuchsia-900/30 flex items-center gap-2 cursor-pointer disabled:opacity-50">
                    @if (_isSubmittingAction)
                    {
                        <svg class="animate-spin size-3.5" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" /><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" /></svg>
                    }
                    <span>Save Entry</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<AdminOvertimeDto>? _requests;
    private List<EmployeeOptionDto>? _employees;
    private bool _isLoading = true;
    private bool _isSubmittingAction = false;

    private string _searchQuery = "";
    private int _statusFilter = -1;
    private int _typeFilter = -1;

    private int _page = 1;
    private int _pageSize = 10;

    private AdminOvertimeDto? _approveTarget;
    private double _approvedHoursInput;

    private AdminOvertimeDto? _rejectTarget;
    private string _rejectionReasonInput = "";

    private bool _isCreatingManual = false;
    private string _manualEmployeeId = "";
    private DateTime _manualDate = DateTime.Today;
    private int _manualType = 0;
    private TimeOnly _manualStartTime = new TimeOnly(17, 0);
    private TimeOnly _manualEndTime = new TimeOnly(19, 30);
    private string _manualReason = "";
    private bool _manualAutoApprove = true;
    private string? _manualModalError;

    private HubConnection? _hubConnection;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await SetupSignalR();
    }

    private async Task SetupSignalR()
    {
        try
        {
            _hubConnection = HubFactory.Create("hubs/notifications");

            _hubConnection.On("OvertimeUpdated", async () =>
            {
                await InvokeAsync(async () =>
                {
                    await LoadData();
                    StateHasChanged();
                });
            });

            await _hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SignalR] Could not connect to notifications hub: {ex.Message}");
        }
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            _requests = await Http.GetFromJsonAsync<List<AdminOvertimeDto>>("api/overtime/admin");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load overtime requests: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshData()
    {
        await LoadData();
        ToastService.ShowSuccess("Overtime queue refreshed.");
    }

    private void ResetPage()
    {
        _page = 1;
    }

    private void OpenApproveModal(AdminOvertimeDto req)
    {
        _approveTarget = req;
        _approvedHoursInput = req.RequestedHours;
    }

    private async Task ConfirmApprove()
    {
        if (_approveTarget == null) return;
        _isSubmittingAction = true;
        try
        {
            var payload = new { ApprovedHours = _approvedHoursInput };
            var res = await Http.PostAsJsonAsync($"api/overtime/admin/{_approveTarget.Id}/approve", payload);
            if (res.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess($"Overtime approved for {_approveTarget.EmployeeName}.");
                _approveTarget = null;
                await LoadData();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                ToastService.ShowError($"Could not approve: {err}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            _isSubmittingAction = false;
        }
    }

    private void OpenRejectModal(AdminOvertimeDto req)
    {
        _rejectTarget = req;
        _rejectionReasonInput = "";
    }

    private async Task ConfirmReject()
    {
        if (_rejectTarget == null) return;
        _isSubmittingAction = true;
        try
        {
            var payload = new { Reason = _rejectionReasonInput };
            var res = await Http.PostAsJsonAsync($"api/overtime/admin/{_rejectTarget.Id}/reject", payload);
            if (res.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess($"Overtime rejected. Shift clamped to scheduled end.");
                _rejectTarget = null;
                await LoadData();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                ToastService.ShowError($"Could not reject: {err}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            _isSubmittingAction = false;
        }
    }

    private async Task OpenCreateModal()
    {
        _manualModalError = null;
        _isCreatingManual = true;
        if (_employees == null)
        {
            try
            {
                var allUsers = await Http.GetFromJsonAsync<List<EmployeeOptionDto>>("/api/user");
                _employees = allUsers?.Where(u => u.IsActive && u.IsEmployee).ToList() ?? new List<EmployeeOptionDto>();
            }
            catch
            {
                _employees = new List<EmployeeOptionDto>();
            }
        }
    }

    private async Task SubmitManualCreate()
    {
        _manualModalError = null;
        if (string.IsNullOrWhiteSpace(_manualEmployeeId))
        {
            _manualModalError = "Please select an employee.";
            return;
        }

        var startTs = _manualStartTime.ToTimeSpan();
        var endTs = _manualEndTime.ToTimeSpan();
        if (endTs <= startTs)
        {
            _manualModalError = "End time must be after start time.";
            return;
        }

        _isSubmittingAction = true;
        try
        {
            var duration = (endTs - startTs).TotalHours;
            var payload = new
            {
                EmployeeId = _manualEmployeeId,
                Date = _manualDate,
                Type = _manualType,
                StartTime = startTs,
                EndTime = endTs,
                ApprovedHours = duration,
                Reason = string.IsNullOrWhiteSpace(_manualReason) ? "Administrative overtime entry" : _manualReason,
                AutoApprove = _manualAutoApprove
            };

            var res = await Http.PostAsJsonAsync("api/overtime/admin/create", payload);
            if (res.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("Overtime entry saved successfully.");
                _isCreatingManual = false;
                await LoadData();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                _manualModalError = string.IsNullOrWhiteSpace(err) ? "Failed to save overtime entry." : err;
            }
        }
        catch (Exception ex)
        {
            _manualModalError = ex.Message;
        }
        finally
        {
            _isSubmittingAction = false;
        }
    }

    private string FormatTimeSpanString(string? tsStr)
    {
        if (string.IsNullOrEmpty(tsStr)) return "—";
        if (TimeSpan.TryParse(tsStr, out var ts))
        {
            var dt = DateTime.Today.Add(ts);
            return dt.ToString("hh:mm tt");
        }
        return tsStr;
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    public class AdminOvertimeDto
    {
        public Guid Id { get; set; }
        public string EmployeeId { get; set; } = string.Empty;
        public string EmployeeName { get; set; } = string.Empty;
        public string EmployeeNumber { get; set; } = string.Empty;
        public DateTime Date { get; set; }
        public int Type { get; set; }
        public string TypeName { get; set; } = string.Empty;
        public string StartTime { get; set; } = string.Empty;
        public string EndTime { get; set; } = string.Empty;
        public double RequestedHours { get; set; }
        public double? ApprovedHours { get; set; }
        public string? Reason { get; set; }
        public int Status { get; set; }
        public string StatusName { get; set; } = string.Empty;
        public string? ReviewedByUserId { get; set; }
        public string? ReviewedByName { get; set; }
        public DateTime? ActionTakenAt { get; set; }
        public string? RejectionReason { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    public class EmployeeOptionDto
    {
        public string Id { get; set; } = string.Empty;
        public string EmployeeId { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public bool IsActive { get; set; }
        public bool IsEmployee { get; set; }
    }
}
