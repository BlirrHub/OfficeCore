@code {
    private bool _isLoading = true;
    private bool _isOperating = false;
    private bool _showCreateModal = false;
    private bool _showRestoreModal = false;
    private bool _showUploadModal = false;
    private bool _showSettingsModal = false;
    private bool _confirmRestoreChecked = false;

    private string? _newBackupLabel;
    private string _searchQuery = string.Empty;
    private string _typeFilter = "all";

    private List<BackupItemDto>? _backups;
    private BackupItemDto? _targetBackup;
    private IBrowserFile? _selectedUploadFile;

    private bool _isPgToolsAvailable = true;
    private string? _pgBinPath;
    private long _totalSizeBytes = 0;
    private BackupSettingsDto? _settings;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            var res = await Http.GetFromJsonAsync<BackupOverviewDto>("/api/backup");
            if (res != null)
            {
                _backups = res.Backups;
                _isPgToolsAvailable = res.IsPgToolsAvailable;
                _pgBinPath = res.PgBinPath;
                _totalSizeBytes = res.TotalSizeBytes;
                _settings = res.Settings;
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load backups: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private List<BackupItemDto> _filteredBackups
    {
        get
        {
            if (_backups == null) return new();
            return _backups
                .Where(b =>
                {
                    if (_typeFilter == "auto" && !b.IsAutomatic) return false;
                    if (_typeFilter == "manual" && (b.IsAutomatic || b.IsPreRestore)) return false;
                    if (_typeFilter == "prerestore" && !b.IsPreRestore) return false;

                    if (!string.IsNullOrWhiteSpace(_searchQuery))
                    {
                        var q = _searchQuery.Trim().ToLowerInvariant();
                        var nameMatch = b.FileName.ToLowerInvariant().Contains(q);
                        var labelMatch = b.Label?.ToLowerInvariant().Contains(q) == true;
                        return nameMatch || labelMatch;
                    }
                    return true;
                })
                .OrderByDescending(b => b.CreatedAt)
                .ToList();
        }
    }

    private void OpenCreateBackupModal()
    {
        _newBackupLabel = string.Empty;
        _showCreateModal = true;
    }

    private async Task ExecuteCreateBackup()
    {
        _isOperating = true;
        StateHasChanged();

        try
        {
            var req = new { Label = _newBackupLabel };
            var res = await Http.PostAsJsonAsync("/api/backup/create", req);
            if (res.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("Database snapshot created successfully!");
                _showCreateModal = false;
                await LoadData();
            }
            else
            {
                var err = await res.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                var msg = err.TryGetProperty("message", out var m) ? m.GetString() : "Creation failed.";
                ToastService.ShowError(msg ?? "Failed to create snapshot.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error creating snapshot: {ex.Message}");
        }
        finally
        {
            _isOperating = false;
            StateHasChanged();
        }
    }

    private void DownloadBackup(string fileName)
    {
        Navigation.NavigateTo($"/api/backup/{fileName}/download", forceLoad: true);
    }

    private void PromptRestore(BackupItemDto backup)
    {
        _targetBackup = backup;
        _confirmRestoreChecked = false;
        _showRestoreModal = true;
    }

    private async Task ExecuteRestore()
    {
        if (_targetBackup == null) return;

        _isOperating = true;
        StateHasChanged();

        try
        {
            var res = await Http.PostAsync($"/api/backup/{_targetBackup.FileName}/restore", null);
            if (res.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("Database restored successfully! A safety snapshot was archived.");
                _showRestoreModal = false;
                await LoadData();
            }
            else
            {
                var err = await res.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                var msg = err.TryGetProperty("message", out var m) ? m.GetString() : "Restore failed.";
                ToastService.ShowError(msg ?? "Restore operation failed.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error restoring database: {ex.Message}");
        }
        finally
        {
            _isOperating = false;
            StateHasChanged();
        }
    }

    private async Task PromptDelete(BackupItemDto backup)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to permanently delete backup {backup.FileName}?");
        if (!confirmed) return;

        try
        {
            var res = await Http.DeleteAsync($"/api/backup/{backup.FileName}");
            if (res.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("Backup snapshot deleted.");
                await LoadData();
            }
            else
            {
                ToastService.ShowError("Failed to delete snapshot.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error deleting snapshot: {ex.Message}");
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        _selectedUploadFile = e.File;
    }

    private async Task ExecuteUpload()
    {
        if (_selectedUploadFile == null) return;

        _isOperating = true;
        StateHasChanged();

        try
        {
            using var content = new MultipartFormDataContent();
            var stream = _selectedUploadFile.OpenReadStream(maxAllowedSize: 500 * 1024 * 1024);
            var streamContent = new StreamContent(stream);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/octet-stream");
            content.Add(streamContent, "file", _selectedUploadFile.Name);

            var res = await Http.PostAsync("/api/backup/upload", content);
            if (res.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("Backup uploaded and restored successfully!");
                _showUploadModal = false;
                _selectedUploadFile = null;
                await LoadData();
            }
            else
            {
                var err = await res.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                var msg = err.TryGetProperty("message", out var m) ? m.GetString() : "Upload failed.";
                ToastService.ShowError(msg ?? "Failed to upload snapshot.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Upload error: {ex.Message}");
        }
        finally
        {
            _isOperating = false;
            StateHasChanged();
        }
    }

    private async Task SaveSettings()
    {
        if (_settings == null) return;

        try
        {
            var res = await Http.PutAsJsonAsync("/api/backup/settings", _settings);
            if (res.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("Backup settings saved!");
                _showSettingsModal = false;
                await LoadData();
            }
            else
            {
                ToastService.ShowError("Failed to update backup settings.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving settings: {ex.Message}");
        }
    }

    private string GetBreakdownText()
    {
        if (_backups == null || !_backups.Any()) return "No backups created yet";
        var auto = _backups.Count(b => b.IsAutomatic);
        var manual = _backups.Count(b => !b.IsAutomatic && !b.IsPreRestore);
        var pre = _backups.Count(b => b.IsPreRestore);
        return $"{auto} auto • {manual} manual • {pre} safety";
    }

    private string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "0 B";
        string[] suffixes = { "B", "KB", "MB", "GB", "TB" };
        int i = (int)Math.Floor(Math.Log(bytes, 1024));
        i = Math.Min(i, suffixes.Length - 1);
        double num = bytes / Math.Pow(1024, i);
        return $"{num:F1} {suffixes[i]}";
    }

    public class BackupOverviewDto
    {
        public List<BackupItemDto> Backups { get; set; } = new();
        public string? PgBinPath { get; set; }
        public bool IsPgToolsAvailable { get; set; }
        public long TotalSizeBytes { get; set; }
        public BackupSettingsDto? Settings { get; set; }
    }

    public class BackupItemDto
    {
        public string FileName { get; set; } = string.Empty;
        public long SizeBytes { get; set; }
        public DateTime CreatedAt { get; set; }
        public bool IsAutomatic { get; set; }
        public bool IsPreRestore { get; set; }
        public string? Label { get; set; }
    }

    public class BackupSettingsDto
    {
        public bool AutoBackupEnabled { get; set; } = true;
        public string ScheduledTime { get; set; } = "23:00";
        public int RetentionCount { get; set; } = 14;
        public string? CustomPgBinPath { get; set; }
        public DateTime? LastBackupAt { get; set; }
        public string? LastBackupStatus { get; set; }
    }
}
