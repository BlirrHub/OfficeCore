@page "/admin/workschedules"
@attribute [Authorize(Policy = "RequireWorkSchedules")]
@inject HttpClient Http
@inject ToastService ToastService

<PageTitle>Work Schedules - OfficeCore</PageTitle>

<div class="space-y-6 h-full flex flex-col">
    <div class="flex items-center justify-between shrink-0">
        <div>
            <h1 class="text-3xl font-bold tracking-tight text-white">Work Schedules</h1>
            <p class="mt-1 text-zinc-400 text-sm">Manage work schedules, shifts, and paid hours</p>
        </div>
        <div class="flex items-center gap-3">
            <button @onclick="LoadData" disabled="@_isLoading" class="p-2 text-zinc-400 hover:text-white bg-zinc-900 border border-zinc-800 rounded-lg transition-colors cursor-pointer" title="Refresh">
                <svg class="size-4 @(_isLoading ? "animate-spin text-fuchsia-400" : "")" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
            </button>
            <button @onclick="CreateNewSchedule" class="px-4 py-2 text-sm font-bold text-white bg-fuchsia-600 rounded-lg hover:bg-fuchsia-500 shadow-lg shadow-fuchsia-900/30 transition-colors flex items-center gap-2 cursor-pointer">
                <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                Add New Schedule
            </button>
        </div>
    </div>

    <div class="flex flex-1 bg-zinc-950 border border-zinc-800 rounded-2xl overflow-hidden">
        <!-- Sidebar for list of schedules -->
        <div class="w-72 border-r border-zinc-800 bg-zinc-900/50 overflow-y-auto flex flex-col">
            <div class="p-4 border-b border-zinc-800">
                <div class="relative">
                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 size-4 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <input type="text" placeholder="Search schedules" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-9 pr-3 py-1.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none" />
                </div>
            </div>
        
        <div class="flex-1 overflow-y-auto p-4 space-y-2">
            @if (_schedules == null)
            {
                <div class="text-sm text-zinc-500">Loading...</div>
            }
            else if (!_schedules.Any())
            {
                <div class="text-sm text-zinc-500">No schedules added yet.</div>
            }
            else
            {
                foreach (var schedule in _schedules)
                {
                    <button @onclick="() => SelectSchedule(schedule)" class="@($"w-full text-left px-3 py-2 rounded-lg text-sm font-medium transition-colors {(_selectedSchedule?.Id == schedule.Id ? "bg-zinc-800 text-white" : "text-zinc-400 hover:bg-zinc-900 hover:text-zinc-300")}")">
                        @schedule.Name
                    </button>
                }
            }
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="flex-1 bg-zinc-950 overflow-y-auto p-8 relative">
        @if (_isEditing || _isCreating)
        {
            <div class="max-w-3xl mx-auto space-y-8">
                <div class="flex items-center justify-between">
                    <h2 class="text-xl font-bold text-white uppercase tracking-wider">Schedule Editor</h2>
                    <div class="flex gap-3 items-center">
                        <button @onclick="CancelEdit" class="px-4 py-2 text-sm font-medium text-zinc-400 hover:text-white transition-colors">Cancel</button>
                        <button @onclick="SaveSchedule" class="px-4 py-2 text-sm font-bold text-white bg-fuchsia-600 rounded-lg hover:bg-fuchsia-500 shadow-lg shadow-fuchsia-900/30 transition-colors">Save Schedule</button>
                    </div>
                </div>

                <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 space-y-8">
                    <!-- Schedule Name -->
                    <div class="flex gap-8 items-center">
                        <label class="w-40 text-sm font-medium text-zinc-400">Schedule name</label>
                        <input type="text" @bind="_editModel.Name" class="flex-1 bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none" placeholder="e.g. Regular Hours" />
                    </div>

                    <!-- Work Arrangement -->
                    <div class="flex gap-8 items-center">
                        <label class="w-40 text-sm font-medium text-zinc-400">Work arrangement</label>
                        <div class="flex bg-zinc-950 border border-zinc-800 rounded-lg overflow-hidden">
                            <button class="@($"px-6 py-2 text-sm font-medium transition-colors {(_editModel.WorkArrangement == 0 ? "bg-zinc-800 text-fuchsia-400" : "text-zinc-400 hover:text-zinc-300 hover:bg-zinc-900")}")" @onclick="() => _editModel.WorkArrangement = 0">Fixed</button>
                            <button class="@($"px-6 py-2 text-sm font-medium transition-colors border-l border-zinc-800 {(_editModel.WorkArrangement == 1 ? "bg-zinc-800 text-fuchsia-400" : "text-zinc-400 hover:text-zinc-300 hover:bg-zinc-900")}")" @onclick="() => _editModel.WorkArrangement = 1">Flexible</button>
                            <button class="@($"px-6 py-2 text-sm font-medium transition-colors border-l border-zinc-800 {(_editModel.WorkArrangement == 2 ? "bg-zinc-800 text-fuchsia-400" : "text-zinc-400 hover:text-zinc-300 hover:bg-zinc-900")}")" @onclick="() => _editModel.WorkArrangement = 2">Weekly</button>
                            <button class="@($"px-6 py-2 text-sm font-medium transition-colors border-l border-zinc-800 {(_editModel.WorkArrangement == 3 ? "bg-zinc-800 text-fuchsia-400" : "text-zinc-400 hover:text-zinc-300 hover:bg-zinc-900")}")" @onclick="() => _editModel.WorkArrangement = 3">No Schedule</button>
                        </div>
                    </div>

                    @if (_editModel.WorkArrangement == 0)
                    {
                        <div class="flex gap-8 items-center pt-2">
                            <label class="w-40 text-sm font-medium text-zinc-400">Pay mode</label>
                            <div class="flex items-center gap-6">
                                <label class="flex items-center gap-2 cursor-pointer">
                                    <input type="radio" name="paymode" checked="@(!_editModel.IsFixedWeeklyRate)" @onchange="() => _editModel.IsFixedWeeklyRate = false" class="text-fuchsia-600 bg-zinc-900 border-zinc-700 focus:ring-fuchsia-600 focus:ring-offset-zinc-950" />
                                    <span class="text-sm text-zinc-300">Tracked Hours (Requires Attendance)</span>
                                </label>
                                <label class="flex items-center gap-2 cursor-pointer">
                                    <input type="radio" name="paymode" checked="@(_editModel.IsFixedWeeklyRate)" @onchange="() => _editModel.IsFixedWeeklyRate = true" class="text-fuchsia-600 bg-zinc-900 border-zinc-700 focus:ring-fuchsia-600 focus:ring-offset-zinc-950" />
                                    <span class="text-sm text-zinc-300">Weekly Rate (No Attendance)</span>
                                </label>
                            </div>
                        </div>
                    }

                    @if (_editModel.WorkArrangement == 0 || _editModel.WorkArrangement == 1)
                    {
                        <!-- Days of the week selection -->
                        <div class="flex gap-8 items-start">
                            <label class="w-40 text-sm font-medium text-zinc-400 mt-2">Days of the week</label>
                            <div class="flex gap-1 border border-zinc-800 rounded-lg p-1 bg-zinc-950">
                                @foreach (var day in _editModel.Days.OrderBy(d => (int)d.DayOfWeek == 0 ? 7 : (int)d.DayOfWeek))
                                {
                                    var initial = day.DayOfWeek.ToString().Substring(0, 1);
                                    <button class="@($"size-10 rounded-md flex items-center justify-center text-sm font-medium transition-colors {(!day.IsRestDay ? "text-fuchsia-400 bg-fuchsia-900/20" : "text-zinc-400 hover:bg-zinc-900")}")" 
                                            @onclick="() => ToggleRestDay(day)">
                                        @initial
                                    </button>
                                }
                            </div>
                        </div>

                        @if (!(_editModel.WorkArrangement == 0 && _editModel.IsFixedWeeklyRate))
                        {
                            <!-- Daily Times -->
                            <div class="space-y-4 pl-[12.5rem]">
                                @foreach (var day in _editModel.Days.OrderBy(d => (int)d.DayOfWeek == 0 ? 7 : (int)d.DayOfWeek))
                                {
                                    <div class="flex items-center gap-4">
                                        <span class="w-24 text-sm text-zinc-400 font-medium">@day.DayOfWeek.ToString()</span>
                                        @if (day.IsRestDay)
                                        {
                                            <span class="text-sm text-zinc-600 italic">Rest day</span>
                                        }
                                        else if (_editModel.WorkArrangement == 0) // Fixed
                                        {
                                            <div class="flex items-center gap-2">
                                                <input type="time" @bind:get="day.StartTime.HasValue ? TimeOnly.FromTimeSpan(day.StartTime.Value) : (TimeOnly?)null" @bind:set="(value) => day.StartTime = value?.ToTimeSpan()" class="bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-1.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none" />
                                                <span class="text-zinc-500 text-sm">to</span>
                                                <input type="time" @bind:get="day.EndTime.HasValue ? TimeOnly.FromTimeSpan(day.EndTime.Value) : (TimeOnly?)null" @bind:set="(value) => day.EndTime = value?.ToTimeSpan()" class="bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-1.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none" />
                                            </div>
                                        }
                                        else // Flexible
                                        {
                                            <div class="flex items-center gap-2">
                                                <input type="number" step="0.5" min="0" max="24" @bind="day.WorkingHours" class="w-24 bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-1.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none" />
                                                <span class="text-zinc-500 text-sm">hours</span>
                                            </div>
                                        }
                                    </div>
                            }
                            </div>
                        }
                    }
                    else if (_editModel.WorkArrangement == 2) // Weekly
                    {
                        <div class="flex gap-8 items-center">
                            <label class="w-40 text-sm font-medium text-zinc-400">Total weekly hours</label>
                            <div class="flex items-center gap-2">
                                <input type="number" step="0.5" min="0" max="168" @bind="_editModel.TotalWeeklyHours" class="w-32 bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none" />
                                <span class="text-zinc-500 text-sm">hours</span>
                            </div>
                        </div>
                    }
                    else if (_editModel.WorkArrangement == 3) // No Schedule
                    {
                        <div class="flex gap-8 items-center">
                            <label class="w-40 text-sm font-medium text-zinc-400"></label>
                            <p class="text-sm text-zinc-500">Employees with this schedule can track time freely without any fixed hours or constraints.</p>
                        </div>
                    }

                    <div class="border-t border-zinc-800 pt-6">
                        <label class="flex items-center gap-3 cursor-pointer">
                            <input type="checkbox" @bind="_editModel.IncludeTimeTrackedBeforeScheduledStartTime" class="sr-only peer" />
                            <div class="w-5 h-5 rounded border border-zinc-700 bg-zinc-900 peer-checked:bg-fuchsia-600 peer-checked:border-fuchsia-600 flex items-center justify-center text-white transition-colors">
                                <svg class="size-3.5 opacity-0 peer-checked:opacity-100 transition-opacity" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                            </div>
                            <span class="text-sm text-zinc-300">Include time tracked before scheduled start time</span>
                        </label>
                        <label class="flex items-center gap-3 cursor-pointer mt-4">
                            <input type="checkbox" @bind="_editModel.AutoClockOut" class="sr-only peer" />
                            <div class="w-5 h-5 rounded border border-zinc-700 bg-zinc-900 peer-checked:bg-fuchsia-600 peer-checked:border-fuchsia-600 flex items-center justify-center text-white transition-colors">
                                <svg class="size-3.5 opacity-0 peer-checked:opacity-100 transition-opacity" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                            </div>
                            <span class="text-sm text-zinc-300">Auto clock out at end of shift</span>
                        </label>
                    </div>

                    <!-- Breaks Section -->
                    <div class="border-t border-zinc-800 pt-6">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-sm font-medium text-white">Scheduled Breaks</h3>
                            <button type="button" @onclick="AddBreak" class="flex items-center gap-2 text-fuchsia-400 text-xs font-medium hover:text-fuchsia-300 transition-colors">
                                <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                                Add break
                            </button>
                        </div>
                        
                        <div class="space-y-3">
                            @if (_editModel.Breaks == null || !_editModel.Breaks.Any())
                            {
                                <p class="text-xs text-zinc-500 italic">No breaks scheduled.</p>
                            }
                            else
                            {
                                @foreach (var b in _editModel.Breaks)
                                {
                                    <div class="flex items-center gap-3 bg-zinc-950 border border-zinc-800 p-3 rounded-lg">
                                        <input type="text" @bind="b.Name" placeholder="Break name (e.g. Lunch)" class="flex-1 bg-zinc-900 border border-zinc-800 rounded-md px-3 py-1.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none" />
                                        
                                        <div class="flex items-center gap-2">
                                            <input type="time" @bind:get="TimeOnly.FromTimeSpan(b.StartTime)" @bind:set="(value) => b.StartTime = value.ToTimeSpan()" class="w-28 bg-zinc-900 border border-zinc-800 rounded-md px-2 py-1.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none" />
                                            <span class="text-zinc-500 text-xs">to</span>
                                            <input type="time" @bind:get="TimeOnly.FromTimeSpan(b.EndTime)" @bind:set="(value) => b.EndTime = value.ToTimeSpan()" class="w-28 bg-zinc-900 border border-zinc-800 rounded-md px-2 py-1.5 text-sm text-white focus:border-fuchsia-500 focus:outline-none" />
                                        </div>

                                        <label class="flex items-center gap-2 cursor-pointer ml-2">
                                            <input type="checkbox" @bind="b.IsPaid" class="sr-only peer" />
                                            <div class="w-4 h-4 rounded border border-zinc-700 bg-zinc-900 peer-checked:bg-fuchsia-600 peer-checked:border-fuchsia-600 flex items-center justify-center text-white transition-colors">
                                                <svg class="size-2.5 opacity-0 peer-checked:opacity-100 transition-opacity" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                                            </div>
                                            <span class="text-xs text-zinc-300">Paid</span>
                                        </label>

                                        <button type="button" @onclick="() => RemoveBreak(b)" class="ml-2 text-zinc-500 hover:text-red-400 transition-colors p-1 rounded hover:bg-zinc-900">
                                            <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <!-- Time & Attendance Rules Section -->
                    <div class="border-t border-zinc-800 pt-6 space-y-6">
                        <div>
                            <h3 class="text-base font-bold text-white tracking-tight flex items-center gap-2">
                                <svg class="size-5 text-fuchsia-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <span>Time-In & Half-Day Rules</span>
                            </h3>
                            <p class="text-xs text-zinc-400 mt-1">Configure arrival grace periods, early punches, and lunch half-day snapping.</p>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <!-- Late Grace Period -->
                            <div class="p-4 rounded-xl bg-zinc-950 border border-zinc-800 space-y-2">
                                <div class="flex items-center justify-between">
                                    <label class="text-xs font-semibold text-zinc-200">Late Grace Period</label>
                                    <div class="flex items-center gap-1.5">
                                        <input type="number" min="0" max="60" @bind="_editModel.LateGracePeriodMinutes" class="w-16 bg-zinc-900 border border-zinc-700 rounded-lg px-2.5 py-1 text-xs text-white text-right focus:border-fuchsia-500 focus:outline-none" />
                                        <span class="text-xs text-zinc-500">mins</span>
                                    </div>
                                </div>
                                <p class="text-[11px] text-zinc-500">Employees arriving within this window are not penalized as tardy.</p>
                            </div>

                            <!-- Half-Day Lunch Auto-Normalization -->
                            <div class="p-4 rounded-xl bg-zinc-950 border border-zinc-800 space-y-2">
                                <label class="flex items-center justify-between cursor-pointer">
                                    <span class="text-xs font-semibold text-zinc-200">Half-Day Lunch Snapping</span>
                                    <input type="checkbox" @bind="_editModel.AutoNormalizeHalfDay" class="sr-only peer" />
                                    <div class="w-8 h-4.5 rounded-full bg-zinc-800 peer-checked:bg-fuchsia-600 transition-colors relative after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:rounded-full after:size-3.5 after:transition-transform peer-checked:after:translate-x-3.5"></div>
                                </label>
                                <p class="text-[11px] text-zinc-500">Punches between 12:00 PM – 1:00 PM auto-snap to 12:00 PM (Out) or 1:00 PM (In) for clean 4.0h half-days.</p>
                            </div>
                        </div>

                        <!-- Early Tracking Toggle -->
                        <div class="p-4 rounded-xl bg-zinc-950 border border-zinc-800 flex items-center justify-between">
                            <div>
                                <span class="text-xs font-semibold text-zinc-200">Include Early Time Tracked</span>
                                <p class="text-[11px] text-zinc-500 mt-0.5">Pay for time worked before the scheduled start time (e.g. before 8:00 AM).</p>
                            </div>
                            <label class="cursor-pointer">
                                <input type="checkbox" @bind="_editModel.IncludeTimeTrackedBeforeScheduledStartTime" class="sr-only peer" />
                                <div class="w-8 h-4.5 rounded-full bg-zinc-800 peer-checked:bg-fuchsia-600 transition-colors relative after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:rounded-full after:size-3.5 after:transition-transform peer-checked:after:translate-x-3.5"></div>
                            </label>
                        </div>
                    </div>

                    <!-- Overtime Rules Section (Master Toggle) -->
                    <div class="border-t border-zinc-800 pt-6 space-y-6">
                        <div class="flex items-center justify-between">
                            <div>
                                <h3 class="text-base font-bold text-white tracking-tight flex items-center gap-2">
                                    <svg class="size-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                    </svg>
                                    <span>Clock-Out & Overtime Policy</span>
                                </h3>
                                <p class="text-xs text-zinc-400 mt-1">Configure threshold clamping, auto-submission for manager approvals, and OT rates.</p>
                            </div>
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="checkbox" @bind="_editModel.HasOvertimePolicy" class="sr-only peer" />
                                <div class="w-10 h-5.5 rounded-full bg-zinc-800 peer-checked:bg-fuchsia-600 transition-colors relative after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:rounded-full after:size-4.5 after:transition-transform peer-checked:after:translate-x-4.5"></div>
                                <span class="text-xs font-semibold text-white">Enable Overtime</span>
                            </label>
                        </div>

                        @if (_editModel.HasOvertimePolicy)
                        {
                            <div class="space-y-6">
                                <!-- Clamping Threshold & Approval Submission Controls -->
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div class="p-4 rounded-xl bg-zinc-950 border border-zinc-800 space-y-2">
                                        <div class="flex items-center justify-between">
                                            <label class="text-xs font-semibold text-zinc-200">Overtime Minimum Threshold</label>
                                            <div class="flex items-center gap-1.5">
                                                <input type="number" min="5" max="120" step="5" @bind="_editModel.OvertimeThresholdMinutes" class="w-16 bg-zinc-900 border border-zinc-700 rounded-lg px-2.5 py-1 text-xs text-white text-right focus:border-fuchsia-500 focus:outline-none" />
                                                <span class="text-xs text-zinc-500">mins</span>
                                            </div>
                                        </div>
                                        <p class="text-[11px] text-zinc-500">Punches past shift end by less than this (e.g. &lt; 15 min) clamp down to scheduled end time.</p>
                                    </div>

                                    <div class="p-4 rounded-xl bg-zinc-950 border border-zinc-800 space-y-2">
                                        <label class="flex items-center justify-between cursor-pointer">
                                            <span class="text-xs font-semibold text-zinc-200">Auto-Submit for Approvals</span>
                                            <input type="checkbox" @bind="_editModel.AutoSubmitOvertimeApproval" class="sr-only peer" />
                                            <div class="w-8 h-4.5 rounded-full bg-zinc-800 peer-checked:bg-fuchsia-600 transition-colors relative after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:rounded-full after:size-3.5 after:transition-transform peer-checked:after:translate-x-3.5"></div>
                                        </label>
                                        <p class="text-[11px] text-zinc-500">Punches exceeding threshold automatically create pending requests in Overtime Approvals.</p>
                                    </div>
                                </div>

                                    <div class="p-4 rounded-xl bg-zinc-950 border border-zinc-800 space-y-2">
                                        <div class="flex items-center justify-between">
                                            <label class="text-xs font-semibold text-zinc-200">Overtime Multiplier</label>
                                            <div class="flex items-center gap-1.5">
                                                <input type="number" min="1.0" max="5.0" step="0.05" @bind="_editModel.OvertimeMultiplier" class="w-20 bg-zinc-900 border border-zinc-700 rounded-lg px-2.5 py-1 text-xs text-white text-right focus:border-fuchsia-500 focus:outline-none" />
                                                <span class="text-xs text-zinc-500">x</span>
                                            </div>
                                        </div>
                                        <p class="text-[11px] text-zinc-500">The rate multiplier for overtime pay (e.g. 1.25 for time-and-a-quarter).</p>
                                    </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else if (_selectedSchedule != null)
        {
            <!-- View Mode -->
             <div class="max-w-3xl mx-auto space-y-8">
                <div class="flex items-center justify-between">
                    <h2 class="text-xl font-bold text-white uppercase tracking-wider">Schedule</h2>
                    <div class="flex gap-3">
                        <button @onclick="PromptDelete" class="px-4 py-2 text-sm font-medium text-red-400 hover:bg-red-950 hover:text-red-300 rounded-lg transition-colors">Delete</button>
                        <button @onclick="EditSchedule" class="px-4 py-2 text-sm font-medium text-zinc-300 hover:text-white bg-zinc-800 hover:bg-zinc-700 rounded-lg transition-colors">Edit</button>
                    </div>
                </div>

                <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 space-y-8">
                     <div class="flex gap-8 items-center">
                        <label class="w-40 text-sm font-medium text-zinc-500">Schedule name</label>
                        <div class="text-sm text-white font-medium">@_selectedSchedule.Name</div>
                    </div>
                     <div class="flex gap-8 items-center">
                        <label class="w-40 text-sm font-medium text-zinc-500">Work arrangement</label>
                        <div class="text-sm text-white">@(_selectedSchedule.WorkArrangement == 0 ? "Fixed" : _selectedSchedule.WorkArrangement == 1 ? "Flexible" : _selectedSchedule.WorkArrangement == 2 ? "Weekly" : "No Schedule")</div>
                    </div>
                    
                    @if (_selectedSchedule.WorkArrangement == 0 || _selectedSchedule.WorkArrangement == 1)
                    {
                        <div class="space-y-4 pl-[12.5rem]">
                            @foreach (var day in _selectedSchedule.Days.OrderBy(d => (int)d.DayOfWeek == 0 ? 7 : (int)d.DayOfWeek))
                            {
                                <div class="flex items-center gap-4">
                                    <span class="w-24 text-sm text-zinc-400 font-medium">@day.DayOfWeek.ToString()</span>
                                    @if (day.IsRestDay)
                                    {
                                        <span class="text-sm text-zinc-600 italic">Rest day</span>
                                    }
                                    else
                                    {
                                        <div class="flex items-center gap-2 text-sm text-white">
                                            @if (_selectedSchedule.WorkArrangement == 0)
                                            {
                                                <span>@(day.StartTime?.ToString(@"hh\:mm") ?? "00:00")</span>
                                                <span class="text-zinc-500 mx-1">to</span>
                                                <span>@(day.EndTime?.ToString(@"hh\:mm") ?? "00:00")</span>
                                            }
                                            else
                                            {
                                                <span>@(day.WorkingHours?.ToString("0.##") ?? "0") hours</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (_selectedSchedule.WorkArrangement == 2)
                    {
                        <div class="flex gap-8 items-center">
                            <label class="w-40 text-sm font-medium text-zinc-500">Total weekly hours</label>
                            <div class="text-sm text-white">@(_selectedSchedule.TotalWeeklyHours?.ToString("0.##") ?? "0") hours</div>
                        </div>
                    }
                    else if (_selectedSchedule.WorkArrangement == 3)
                    {
                        <div class="flex gap-8 items-center">
                            <label class="w-40 text-sm font-medium text-zinc-500"></label>
                            <p class="text-sm text-zinc-500">Employees with this schedule can track time freely without any fixed hours or constraints.</p>
                        </div>
                    }

                    <!-- View Breaks -->
                    @if (_selectedSchedule.Breaks != null && _selectedSchedule.Breaks.Any())
                    {
                        <div class="border-t border-zinc-800 pt-6">
                            <label class="block text-sm font-medium text-zinc-500 mb-4">Scheduled Breaks</label>
                            <div class="space-y-2">
                                @foreach (var b in _selectedSchedule.Breaks.OrderBy(br => br.StartTime))
                                {
                                    <div class="flex items-center gap-4 bg-zinc-950 border border-zinc-800 p-3 rounded-lg">
                                        <div class="w-40 text-sm text-white font-medium">@b.Name</div>
                                        <div class="flex-1 text-sm text-zinc-400">
                                            @b.StartTime.ToString(@"hh\:mm") - @b.EndTime.ToString(@"hh\:mm")
                                        </div>
                                        <div class="text-xs font-medium px-2 py-1 rounded @(b.IsPaid ? "bg-emerald-900/30 text-emerald-400" : "bg-zinc-800 text-zinc-400")">
                                            @(b.IsPaid ? "Paid" : "Unpaid")
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }


                    <!-- View Time & Attendance Rules -->
                    <div class="border-t border-zinc-800 pt-6">
                        <label class="block text-sm font-medium text-zinc-500 mb-4">Time-In & Attendance Rules</label>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                            <div class="bg-zinc-950 border border-zinc-800 p-3 rounded-lg">
                                <span class="text-xs text-zinc-500 block">Late Grace Period</span>
                                <span class="text-sm font-semibold text-white">@(_selectedSchedule.LateGracePeriodMinutes > 0 ? $"{_selectedSchedule.LateGracePeriodMinutes} mins" : "None (0 min)")</span>
                            </div>
                            <div class="bg-zinc-950 border border-zinc-800 p-3 rounded-lg">
                                <span class="text-xs text-zinc-500 block">Half-Day Lunch Snapping</span>
                                <span class="text-sm font-semibold @(_selectedSchedule.AutoNormalizeHalfDay ? "text-emerald-400" : "text-zinc-400")">
                                    @(_selectedSchedule.AutoNormalizeHalfDay ? "Enabled (12:00-1:00 PM)" : "Disabled")
                                </span>
                            </div>
                            <div class="bg-zinc-950 border border-zinc-800 p-3 rounded-lg">
                                <span class="text-xs text-zinc-500 block">Early Time Tracked</span>
                                <span class="text-sm font-semibold @(_selectedSchedule.IncludeTimeTrackedBeforeScheduledStartTime ? "text-emerald-400" : "text-zinc-400")">
                                    @(_selectedSchedule.IncludeTimeTrackedBeforeScheduledStartTime ? "Included" : "Ignored (Shift start)")
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- View Overtime & Clock-Out Policy -->
                    <div class="border-t border-zinc-800 pt-6">
                        <div class="flex items-center justify-between mb-4">
                            <label class="block text-sm font-medium text-zinc-500">Clock-Out & Overtime Policy</label>
                            <span class="text-xs px-2.5 py-0.5 rounded-full font-medium @(_selectedSchedule.HasOvertimePolicy ? "bg-amber-900/30 text-amber-400 border border-amber-800/40" : "bg-zinc-800 text-zinc-500")">
                                @(_selectedSchedule.HasOvertimePolicy ? "OT Policy Active" : "Disabled")
                            </span>
                        </div>

                        @if (_selectedSchedule.HasOvertimePolicy)
                        {
                            <div class="space-y-4">
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                                    <div class="bg-zinc-950 border border-zinc-800 p-3 rounded-lg">
                                        <span class="text-xs text-zinc-500 block">Overtime Minimum Threshold</span>
                                        <span class="text-sm font-semibold text-amber-400">@_selectedSchedule.OvertimeThresholdMinutes mins</span>
                                        <p class="text-[11px] text-zinc-500 mt-1">Punches &lt; @_selectedSchedule.OvertimeThresholdMinutes mins clamp to shift end; &ge; @_selectedSchedule.OvertimeThresholdMinutes mins submit for OT approval.</p>
                                    </div>
                                    <div class="bg-zinc-950 border border-zinc-800 p-3 rounded-lg">
                                        <span class="text-xs text-zinc-500 block">Overtime Approvals</span>
                                        <span class="text-sm font-semibold @(_selectedSchedule.AutoSubmitOvertimeApproval ? "text-emerald-400" : "text-zinc-400")">
                                            @(_selectedSchedule.AutoSubmitOvertimeApproval ? "Auto-Submit Requests" : "Manual Log Only")
                                        </span>
                                        <p class="text-[11px] text-zinc-500 mt-1">Sends overtime scans directly to manager approval inbox.</p>
                                    </div>
                                    <div class="bg-zinc-950 border border-zinc-800 p-3 rounded-lg">
                                        <span class="text-xs text-zinc-500 block">Overtime Multiplier</span>
                                        <span class="text-sm font-semibold text-amber-400">@_selectedSchedule.OvertimeMultiplier.ToString("0.00")x</span>
                                        <p class="text-[11px] text-zinc-500 mt-1">The rate multiplier for overtime pay (e.g. 1.25 for time-and-a-quarter).</p>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="text-xs text-zinc-500 italic">No overtime policy configured for this schedule.</p>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="absolute inset-0 flex flex-col items-center justify-center p-8">
                <EmptyState Card="false"
                            Title="No schedule selected"
                            Description="Select a schedule from the sidebar or create a new one to manage work arrangements and daily hours."
                            ActionText="Add New Schedule"
                            OnAction="CreateNewSchedule">
                    <Icon>
                        <svg class="size-10 text-zinc-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5m-9-6h.008v.008H12v-.008zM12 15h.008v.008H12V15zm0 2.25h.008v.008H12v-.008zM9.75 15h.008v.008H9.75V15zm0 2.25h.008v.008H9.75v-.008zM7.5 15h.008v.008H7.5V15zm0 2.25h.008v.008H7.5v-.008zm6.75-4.5h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V15zm0 2.25h.008v.008h-.008v-.008zm2.25-4.5h.008v.008H16.5v-.008zm0 2.25h.008v.008H16.5V15z" />
                        </svg>
                    </Icon>
                </EmptyState>
            </div>
        }
    </div>
</div>
</div>

<!-- Delete Confirmation Modal -->
@if (_showDeleteModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm p-4">
        <div class="bg-zinc-950 border border-zinc-800 rounded-2xl w-full max-w-sm shadow-2xl p-6 relative">
            <h3 class="text-lg font-bold text-white mb-2">Delete Schedule</h3>
            <p class="text-sm text-zinc-400 mb-6">Are you sure you want to permanently delete this work schedule? This action cannot be undone.</p>
            <div class="flex gap-3">
                <button @onclick="() => _showDeleteModal = false" class="flex-1 py-2.5 rounded-lg text-sm font-medium text-zinc-400 bg-zinc-800/50 hover:bg-zinc-800 hover:text-white transition-all">Cancel</button>
                <button @onclick="ConfirmDeleteSchedule" class="flex-1 py-2.5 rounded-lg text-sm font-bold text-white bg-red-600 hover:bg-red-500 shadow-lg shadow-red-900/20 transition-all">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<WorkScheduleDto>? _schedules;
    private WorkScheduleDto? _selectedSchedule;
    private WorkScheduleDto _editModel = new();
    private bool _isCreating = false;
    private bool _isEditing = false;
    private bool _showDeleteModal = false;

    private bool _isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            _schedules = await Http.GetFromJsonAsync<List<WorkScheduleDto>>("/api/workschedule");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void CreateNewSchedule()
    {
        _selectedSchedule = null;
        _isEditing = false;
        _isCreating = true;
        _editModel = new WorkScheduleDto
        {
            Name = "",
            WorkArrangement = 0,
            Days = Enum.GetValues<DayOfWeek>().Select(d => new WorkScheduleDayDto
            {
                DayOfWeek = d,
                IsRestDay = d == DayOfWeek.Saturday || d == DayOfWeek.Sunday,
                StartTime = d == DayOfWeek.Saturday || d == DayOfWeek.Sunday ? null : new TimeSpan(9, 0, 0),
                EndTime = d == DayOfWeek.Saturday || d == DayOfWeek.Sunday ? null : new TimeSpan(17, 0, 0)
            }).ToList(),
            Breaks = new List<WorkScheduleBreakDto>(),
            HasOvertimePolicy = true,
            OvertimeMultiplier = 1.25
        };
    }

    private void SelectSchedule(WorkScheduleDto schedule)
    {
        _selectedSchedule = schedule;
        _isCreating = false;
        _isEditing = false;
    }

    private void EditSchedule()
    {
        if (_selectedSchedule == null) return;
        
        _isEditing = true;
        _editModel = new WorkScheduleDto
        {
            Id = _selectedSchedule.Id,
            Name = _selectedSchedule.Name,
            WorkArrangement = _selectedSchedule.WorkArrangement,
            IncludeTimeTrackedBeforeScheduledStartTime = _selectedSchedule.IncludeTimeTrackedBeforeScheduledStartTime,
            AutoClockOut = _selectedSchedule.AutoClockOut,
            SplitTimesheetsAt = _selectedSchedule.SplitTimesheetsAt,
            TotalWeeklyHours = _selectedSchedule.TotalWeeklyHours,
            Days = _selectedSchedule.Days.Select(d => new WorkScheduleDayDto
            {
                DayOfWeek = d.DayOfWeek,
                IsRestDay = d.IsRestDay,
                StartTime = d.StartTime,
                EndTime = d.EndTime,
                WorkingHours = d.WorkingHours
            }).ToList(),
            Breaks = _selectedSchedule.Breaks?.Select(b => new WorkScheduleBreakDto
            {
                Name = b.Name,
                IsPaid = b.IsPaid,
                StartTime = b.StartTime,
                EndTime = b.EndTime
            }).ToList() ?? new List<WorkScheduleBreakDto>(),
            HasOvertimePolicy = _selectedSchedule.HasOvertimePolicy,
            OvertimeMultiplier = _selectedSchedule.OvertimeMultiplier
        };
    }

    private void CancelEdit()
    {
        _isCreating = false;
        _isEditing = false;
    }

    private void ToggleRestDay(WorkScheduleDayDto day)
    {
        day.IsRestDay = !day.IsRestDay;
        if (!day.IsRestDay && day.StartTime == null)
        {
            day.StartTime = new TimeSpan(9, 0, 0);
            day.EndTime = new TimeSpan(17, 0, 0);
        }
    }

    private void AddBreak()
    {
        _editModel.Breaks.Add(new WorkScheduleBreakDto
        {
            Name = "Lunch Break",
            IsPaid = false,
            StartTime = new TimeSpan(12, 0, 0),
            EndTime = new TimeSpan(13, 0, 0)
        });
    }

    private void RemoveBreak(WorkScheduleBreakDto b)
    {
        _editModel.Breaks.Remove(b);
    }


    private async Task SaveSchedule()
    {
        if (string.IsNullOrWhiteSpace(_editModel.Name))
        {
            ToastService.ShowWarning("Schedule name is required.");
            return;
        }

        if (_isCreating)
        {
            var response = await Http.PostAsJsonAsync("/api/workschedule", _editModel);
            if (response.IsSuccessStatusCode)
            {
                await LoadData();
                _isCreating = false;
                ToastService.ShowSuccess("Work schedule created successfully!");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ToastService.ShowError($"Failed to create schedule: {error}");
            }
        }
        else if (_isEditing)
        {
            var response = await Http.PutAsJsonAsync($"/api/workschedule/{_editModel.Id}", _editModel);
            if (response.IsSuccessStatusCode)
            {
                await LoadData();
                _isEditing = false;
                _selectedSchedule = _schedules?.FirstOrDefault(s => s.Id == _editModel.Id);
                ToastService.ShowSuccess("Work schedule updated successfully!");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ToastService.ShowError($"Failed to update schedule: {error}");
            }
        }
    }

    private void PromptDelete()
    {
        _showDeleteModal = true;
    }

    private async Task ConfirmDeleteSchedule()
    {
        if (_selectedSchedule == null) return;
        
        try
        {
            var response = await Http.DeleteAsync($"/api/workschedule/{_selectedSchedule.Id}");
            if (response.IsSuccessStatusCode)
            {
                _selectedSchedule = null;
                _showDeleteModal = false;
                await LoadData();
                ToastService.ShowSuccess("Work schedule deleted successfully.");
            }
            else
            {
                ToastService.ShowError("Failed to delete work schedule.");
            }
        }
        catch
        {
            ToastService.ShowError("An error occurred while deleting the work schedule.");
        }
    }

    public class WorkScheduleDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public int WorkArrangement { get; set; }
        public bool IncludeTimeTrackedBeforeScheduledStartTime { get; set; }
        public bool AutoClockOut { get; set; }
        public TimeSpan SplitTimesheetsAt { get; set; }
        public double? TotalWeeklyHours { get; set; }
        public bool IsFixedWeeklyRate { get; set; }
        public int LateGracePeriodMinutes { get; set; } = 0;
        public int OvertimeThresholdMinutes { get; set; } = 15;
        public bool AutoNormalizeHalfDay { get; set; } = true;
        public bool AutoSubmitOvertimeApproval { get; set; } = true;
        public List<WorkScheduleDayDto> Days { get; set; } = new();
        public List<WorkScheduleBreakDto> Breaks { get; set; } = new();
        public bool HasOvertimePolicy { get; set; }
        public double OvertimeMultiplier { get; set; } = 1.25;
    }

    public class WorkScheduleDayDto
    {
        public DayOfWeek DayOfWeek { get; set; }
        public bool IsRestDay { get; set; }
        public TimeSpan? StartTime { get; set; }
        public TimeSpan? EndTime { get; set; }
        public double? WorkingHours { get; set; }
    }

    public class WorkScheduleBreakDto
    {
        public string Name { get; set; } = string.Empty;
        public bool IsPaid { get; set; }
        public TimeSpan StartTime { get; set; }
        public TimeSpan EndTime { get; set; }
    }
}
