@page "/"
@layout EmptyLayout
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthProvider

<PageTitle>OfficeCore - The Modern Workspace</PageTitle>

<div class="min-h-screen bg-zinc-950 text-white selection:bg-fuchsia-500 selection:text-white relative overflow-hidden">
    
    <!-- Decorative Background Elements -->
    <div class="absolute inset-0 z-0">
        <div class="absolute -top-[30%] -left-[10%] w-[70%] h-[70%] rounded-full bg-fuchsia-600/20 blur-[120px]"></div>
        <div class="absolute top-[20%] -right-[20%] w-[60%] h-[60%] rounded-full bg-violet-600/20 blur-[120px]"></div>
        <div class="absolute -bottom-[40%] left-[20%] w-[80%] h-[80%] rounded-full bg-blue-600/10 blur-[120px]"></div>
    </div>

    <!-- Navigation -->
    <nav class="relative z-10 border-b border-white/10 bg-zinc-950/50 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-fuchsia-500 to-violet-600 flex items-center justify-center shadow-lg shadow-fuchsia-500/20">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                </div>
                <span class="text-xl font-bold tracking-tight text-white">Office<span class="text-fuchsia-400">Core</span></span>
            </div>
            
            <div class="flex items-center gap-3 sm:gap-4">
                <ThemeToggle />

                <AuthorizeView>
                    <Authorized>
                        <a href="/workspaces" class="text-sm font-medium px-5 py-2.5 rounded-full bg-fuchsia-600 text-white hover:bg-fuchsia-500 transition-colors shadow-lg shadow-fuchsia-900/30 flex items-center gap-2">
                            <span>Go to Workspace</span>
                            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="text-sm font-medium text-zinc-400 hover:text-zinc-100 transition-colors">Log in</a>
                        <a href="/register" class="text-sm font-medium px-5 py-2.5 rounded-full bg-fuchsia-600 text-white hover:bg-fuchsia-500 transition-colors shadow-lg shadow-fuchsia-900/30">Get Started</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <main class="relative z-10 max-w-7xl mx-auto px-6 pt-32 pb-24 text-center">
        <div class="home-badge inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-sm text-zinc-300 mb-8 backdrop-blur-md">
            <span class="w-2 h-2 rounded-full bg-fuchsia-500 animate-pulse"></span>
            OfficeCore 2.0 is now live
        </div>
        
        <h1 class="home-hero-headline text-5xl md:text-7xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-br from-white via-white to-zinc-500 mb-8 max-w-4xl mx-auto leading-tight">
            The intelligent operating system for your company.
        </h1>
        
        <p class="text-xl text-zinc-400 mb-12 max-w-2xl mx-auto leading-relaxed">
            Manage your teams, projects, payroll, and chat in one beautifully designed workspace. Built for modern organizations that move fast.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <AuthorizeView>
                <Authorized>
                    <a href="/workspaces" class="w-full sm:w-auto px-8 py-4 rounded-full bg-gradient-to-r from-fuchsia-600 to-violet-600 text-white font-semibold hover:from-fuchsia-500 hover:to-violet-500 transition-all shadow-xl shadow-fuchsia-600/20 flex items-center justify-center gap-2">
                        Enter your workspace
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                        </svg>
                    </a>
                </Authorized>
                <NotAuthorized>
                    <a href="/register" class="w-full sm:w-auto px-8 py-4 rounded-full bg-gradient-to-r from-fuchsia-600 to-violet-600 text-white font-semibold hover:from-fuchsia-500 hover:to-violet-500 transition-all shadow-xl shadow-fuchsia-600/20 flex items-center justify-center gap-2">
                        Start your workspace
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                        </svg>
                    </a>
                    <a href="/login" class="w-full sm:w-auto px-8 py-4 rounded-full bg-white/5 text-white font-semibold hover:bg-white/10 border border-white/10 transition-all flex items-center justify-center gap-2 backdrop-blur-md">
                        Sign in to your team
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
        
        <!-- App Preview Mockup -->
        <div class="mt-24 relative mx-auto max-w-5xl">
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-transparent to-transparent z-10 rounded-xl pointer-events-none"></div>
            <div class="rounded-xl border border-white/10 bg-zinc-900/80 p-2 backdrop-blur-sm shadow-2xl shadow-black/50 overflow-hidden relative">
                <div class="flex items-center gap-2 px-4 py-3 border-b border-white/5 bg-black/20">
                    <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
                    <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
                    <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
                </div>
                <div class="h-[400px] w-full bg-zinc-950 flex relative overflow-hidden">
                    <!-- Sidebar Mockup -->
                    <div class="w-64 border-r border-white/5 p-4 flex flex-col gap-4">
                        <div class="h-8 w-3/4 rounded bg-white/10"></div>
                        <div class="space-y-2 mt-4">
                            <div class="h-4 w-full rounded bg-white/5"></div>
                            <div class="h-4 w-5/6 rounded bg-white/5"></div>
                            <div class="h-4 w-4/6 rounded bg-white/5"></div>
                        </div>
                    </div>
                    <!-- Main Content Mockup -->
                    <div class="flex-1 p-8">
                        <div class="h-8 w-1/3 rounded bg-white/10 mb-8"></div>
                        <div class="grid grid-cols-3 gap-6">
                            <div class="h-32 rounded-xl bg-white/5 border border-white/5"></div>
                            <div class="h-32 rounded-xl bg-white/5 border border-white/5"></div>
                            <div class="h-32 rounded-xl bg-white/5 border border-white/5"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
    
</div>

