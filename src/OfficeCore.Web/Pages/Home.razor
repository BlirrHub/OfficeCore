@page "/"
@layout EmptyLayout
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthProvider

<PageTitle>OfficeCore - The Modern Enterprise Workspace</PageTitle>

<div class="min-h-screen bg-zinc-950 text-white selection:bg-fuchsia-500 selection:text-white relative overflow-hidden">
    
    <!-- Ambient Radial Background Lighting -->
    <div class="absolute inset-0 z-0 pointer-events-none">
        <div class="absolute -top-[25%] -left-[10%] w-[65%] h-[65%] rounded-full bg-fuchsia-600/15 blur-[140px]"></div>
        <div class="absolute top-[15%] -right-[15%] w-[55%] h-[55%] rounded-full bg-violet-600/15 blur-[140px]"></div>
        <div class="absolute -bottom-[30%] left-[20%] w-[70%] h-[70%] rounded-full bg-blue-600/10 blur-[150px]"></div>
    </div>

    <!-- Navigation Header -->
    <nav class="relative z-20 border-b border-white/10 bg-zinc-950/60 backdrop-blur-xl sticky top-0 transition-all">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="relative size-10 rounded-xl bg-gradient-to-br from-fuchsia-500 to-violet-600 flex items-center justify-center shadow-lg shadow-fuchsia-500/25">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                </div>
                <div class="flex flex-col">
                    <span class="text-xl font-bold tracking-tight text-white leading-none">Office<span class="text-fuchsia-400">Core</span></span>
                    <span class="text-[10px] text-zinc-400 tracking-wider uppercase font-semibold mt-1">Enterprise Platform</span>
                </div>
            </div>

            <!-- Nav Links (Desktop) -->
            <div class="hidden md:flex items-center gap-8 text-sm font-medium text-zinc-400">
                <a href="#features" class="hover:text-white transition-colors">Features</a>
                <a href="#biometrics" class="hover:text-white transition-colors">Biometrics</a>
                <a href="#payroll" class="hover:text-white transition-colors">Payroll</a>
                <a href="#security" class="hover:text-white transition-colors">On-Premises</a>
            </div>
            
            <div class="flex items-center gap-3 sm:gap-4">
                <ThemeToggle />

                <AuthorizeView>
                    <Authorized>
                        <a href="/workspaces" class="text-xs sm:text-sm font-semibold px-5 py-2.5 rounded-full bg-gradient-to-r from-fuchsia-600 to-violet-600 text-white hover:from-fuchsia-500 hover:to-violet-500 transition-all shadow-lg shadow-fuchsia-950/40 flex items-center gap-2">
                            <span>Open Workspace</span>
                            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="text-xs sm:text-sm font-semibold text-zinc-300 hover:text-white px-3 py-2 transition-colors">Sign in</a>
                        <a href="/register" class="text-xs sm:text-sm font-semibold px-4 sm:px-5 py-2.5 rounded-full bg-gradient-to-r from-fuchsia-600 to-violet-600 text-white hover:from-fuchsia-500 hover:to-violet-500 transition-all shadow-lg shadow-fuchsia-950/40">
                            Get Started
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <main class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 sm:pt-28 pb-20 text-center">
        <!-- Live Pill Badge -->
        <div class="home-badge inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs sm:text-sm text-zinc-300 mb-8 backdrop-blur-md shadow-sm">
            <span class="w-2 h-2 rounded-full bg-fuchsia-400 animate-pulse"></span>
            <span class="font-medium">OfficeCore 2.0 LTS is now live</span>
            <span class="text-zinc-500 hidden sm:inline">•</span>
            <span class="text-zinc-400 text-xs hidden sm:inline">Unified POS & Cloud Architecture</span>
        </div>
        
        <h1 class="home-hero-headline text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-br from-white via-white to-zinc-400 mb-6 max-w-4xl mx-auto leading-[1.1]">
            The intelligent operating system for your company.
        </h1>
        
        <p class="text-base sm:text-lg md:text-xl text-zinc-400 mb-10 max-w-2xl mx-auto leading-relaxed">
            Unify biometric time attendance, automated Philippine payroll, collaborative Kanban boards, real-time messaging, and multi-tenant teams in a single minimalist ecosystem.
        </p>
        
        <!-- CTA Actions -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 max-w-md mx-auto">
            <AuthorizeView>
                <Authorized>
                    <a href="/workspaces" class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-gradient-to-r from-fuchsia-600 to-violet-600 text-white font-semibold hover:from-fuchsia-500 hover:to-violet-500 transition-all shadow-xl shadow-fuchsia-600/25 flex items-center justify-center gap-2">
                        <span>Go to your workspace</span>
                        <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                    </a>
                </Authorized>
                <NotAuthorized>
                    <a href="/register" class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-gradient-to-r from-fuchsia-600 to-violet-600 text-white font-semibold hover:from-fuchsia-500 hover:to-violet-500 transition-all shadow-xl shadow-fuchsia-600/25 flex items-center justify-center gap-2 cursor-pointer">
                        <span>Start Free Workspace</span>
                        <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                    </a>
                    <a href="/login" class="w-full sm:w-auto px-7 py-3.5 rounded-full bg-zinc-900/90 text-zinc-200 font-semibold hover:bg-zinc-800 hover:text-white border border-zinc-800 transition-all flex items-center justify-center gap-2 backdrop-blur-md cursor-pointer">
                        <span>Sign In</span>
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <!-- Metric Badges Row -->
        <div class="mt-14 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto text-left">
            <div class="glass-card rounded-xl p-4 border border-zinc-800/80">
                <div class="text-2xl font-bold text-white tracking-tight">100%</div>
                <div class="text-xs text-zinc-400 font-medium mt-0.5">On-Premises / LAN Private</div>
            </div>
            <div class="glass-card rounded-xl p-4 border border-zinc-800/80">
                <div class="text-2xl font-bold text-white tracking-tight">0.1s</div>
                <div class="text-xs text-zinc-400 font-medium mt-0.5">Biometric Sensor Response</div>
            </div>
            <div class="glass-card rounded-xl p-4 border border-zinc-800/80">
                <div class="text-2xl font-bold text-white tracking-tight">SSS / PH</div>
                <div class="text-xs text-zinc-400 font-medium mt-0.5">PhilHealth & Pag-IBIG Ready</div>
            </div>
            <div class="glass-card rounded-xl p-4 border border-zinc-800/80">
                <div class="text-2xl font-bold text-white tracking-tight">Multi-Tenant</div>
                <div class="text-xs text-zinc-400 font-medium mt-0.5">Role-Based Isolated Teams</div>
            </div>
        </div>
        
        <!-- App Preview Mockup Window -->
        <div class="mt-16 relative mx-auto max-w-5xl">
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-transparent to-transparent z-10 rounded-2xl pointer-events-none"></div>
            
            <div class="rounded-2xl border border-zinc-800 bg-zinc-900/80 backdrop-blur-md shadow-2xl shadow-black/80 overflow-hidden relative text-left">
                <!-- Browser Header Bar -->
                <div class="flex items-center justify-between px-4 py-3 border-b border-zinc-800 bg-zinc-950/60">
                    <div class="flex items-center gap-2">
                        <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
                        <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
                        <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
                        <span class="ml-2 text-[11px] font-mono text-zinc-500">app.officecore.local:5026/dashboard</span>
                    </div>
                    <div class="flex items-center gap-2 text-xs text-zinc-400 font-medium">
                        <span class="inline-block size-2 rounded-full bg-emerald-500"></span>
                        <span>Server Connected</span>
                    </div>
                </div>

                <!-- Inner UI Mockup -->
                <div class="min-h-[380px] w-full bg-zinc-950/90 flex flex-col md:flex-row relative">
                    <!-- Left Sidebar Preview -->
                    <div class="w-full md:w-56 border-b md:border-b-0 md:border-r border-zinc-800/80 p-4 flex flex-col gap-3">
                        <div class="flex items-center gap-2.5 pb-3 border-b border-zinc-800/60">
                            <div class="size-7 rounded-lg bg-fuchsia-600/30 border border-fuchsia-500/40 flex items-center justify-center text-xs font-bold text-fuchsia-400">DC</div>
                            <div>
                                <div class="text-xs font-semibold text-white leading-none">Demo Corp</div>
                                <div class="text-[10px] text-zinc-500">HQ Workspace</div>
                            </div>
                        </div>

                        <div class="space-y-1 text-xs font-medium">
                            <div class="px-2.5 py-1.5 rounded-lg bg-fuchsia-600/20 text-fuchsia-300 flex items-center justify-between">
                                <span>📊 Dashboard</span>
                                <span class="size-1.5 rounded-full bg-fuchsia-400"></span>
                            </div>
                            <div class="px-2.5 py-1.5 rounded-lg text-zinc-400 hover:text-white transition-colors">⏰ Attendance & Biometrics</div>
                            <div class="px-2.5 py-1.5 rounded-lg text-zinc-400 hover:text-white transition-colors">💰 Payroll Engine</div>
                            <div class="px-2.5 py-1.5 rounded-lg text-zinc-400 hover:text-white transition-colors">📋 Kanban Boards</div>
                            <div class="px-2.5 py-1.5 rounded-lg text-zinc-400 hover:text-white transition-colors">💬 Team Chat</div>
                        </div>
                    </div>

                    <!-- Main Dashboard Content Preview -->
                    <div class="flex-1 p-5 md:p-6 space-y-4">
                        <div class="flex items-center justify-between">
                            <div>
                                <h3 class="text-sm font-semibold text-white">Company Operations Overview</h3>
                                <p class="text-[11px] text-zinc-400">Real-time attendance & cutoff status</p>
                            </div>
                            <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full bg-emerald-950/60 border border-emerald-800 text-emerald-400">Cutoff: Finalized</span>
                        </div>

                        <!-- 3 Stat Cards -->
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                            <div class="rounded-xl border border-zinc-800/80 bg-zinc-900/60 p-3.5">
                                <div class="text-[11px] font-medium text-zinc-400">Active Staff Clocked In</div>
                                <div class="text-xl font-bold text-white mt-1">42 / 45</div>
                                <div class="text-[10px] text-emerald-400 mt-0.5">93.3% on-time attendance</div>
                            </div>
                            <div class="rounded-xl border border-zinc-800/80 bg-zinc-900/60 p-3.5">
                                <div class="text-[11px] font-medium text-zinc-400">Net Payroll Batch</div>
                                <div class="text-xl font-bold text-white mt-1">₱542,800.00</div>
                                <div class="text-[10px] text-fuchsia-400 mt-0.5">Semi-monthly cycle</div>
                            </div>
                            <div class="rounded-xl border border-zinc-800/80 bg-zinc-900/60 p-3.5">
                                <div class="text-[11px] font-medium text-zinc-400">Hardware Biometrics</div>
                                <div class="text-xl font-bold text-emerald-400 mt-1">Online</div>
                                <div class="text-[10px] text-zinc-400 mt-0.5">ESP32 • Optical AS608</div>
                            </div>
                        </div>

                        <!-- Activity Table Preview -->
                        <div class="rounded-xl border border-zinc-800/80 bg-zinc-900/40 p-3">
                            <div class="text-[11px] font-semibold text-zinc-400 mb-2">Live Attendance Feed</div>
                            <div class="space-y-1.5 font-mono text-[11px]">
                                <div class="flex items-center justify-between text-zinc-300 py-1 border-b border-zinc-800/40">
                                    <span>👤 Juan Dela Cruz</span>
                                    <span class="text-emerald-400">Clock-In 07:58 AM</span>
                                    <span class="text-zinc-500 text-[10px]">Biometric (Device 1)</span>
                                </div>
                                <div class="flex items-center justify-between text-zinc-300 py-1">
                                    <span>👤 Maria Santos</span>
                                    <span class="text-emerald-400">Clock-In 08:00 AM</span>
                                    <span class="text-zinc-500 text-[10px]">Biometric (Device 1)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Feature Pillar Highlights -->
        <div id="features" class="mt-28 text-left">
            <div class="text-center mb-16">
                <span class="text-xs uppercase tracking-wider text-fuchsia-400 font-semibold">Everything You Need</span>
                <h2 class="text-3xl sm:text-4xl font-bold text-white mt-2 tracking-tight">Engineered for fast, reliable teamwork</h2>
                <p class="text-zinc-400 text-sm sm:text-base max-w-xl mx-auto mt-2">Zero clunky third-party subscriptions. Every operational module integrated out of the box.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="glass-card rounded-2xl p-6 border border-zinc-800/80 hover:border-fuchsia-500/30 transition-all">
                    <div class="size-10 rounded-xl bg-fuchsia-500/10 border border-fuchsia-500/20 text-fuchsia-400 flex items-center justify-center mb-4">
                        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    </div>
                    <h3 class="text-lg font-bold text-white">Biometric Hardware Attendance</h3>
                    <p class="text-zinc-400 text-xs sm:text-sm mt-2 leading-relaxed">
                        Direct connection to optical fingerprint scanners over USB Web Serial or local Wi-Fi TCP sockets. Zero buddy punching and automated shift overtime calculation.
                    </p>
                </div>

                <div class="glass-card rounded-2xl p-6 border border-zinc-800/80 hover:border-violet-500/30 transition-all">
                    <div class="size-10 rounded-xl bg-violet-500/10 border border-violet-500/20 text-violet-400 flex items-center justify-center mb-4">
                        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l4-2 4 2 4-2 4 2z" /></svg>
                    </div>
                    <h3 class="text-lg font-bold text-white">Automated Philippine Payroll</h3>
                    <p class="text-zinc-400 text-xs sm:text-sm mt-2 leading-relaxed">
                        Computes base pay across hourly and weekly scheduled contracts with SSS, PhilHealth, Pag-IBIG statutory deduction cycle multipliers and cash advance loan amortization.
                    </p>
                </div>

                <div class="glass-card rounded-2xl p-6 border border-zinc-800/80 hover:border-blue-500/30 transition-all">
                    <div class="size-10 rounded-xl bg-blue-500/10 border border-blue-500/20 text-blue-400 flex items-center justify-center mb-4">
                        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                    </div>
                    <h3 class="text-lg font-bold text-white">Kanban Boards & Live Chat</h3>
                    <p class="text-zinc-400 text-xs sm:text-sm mt-2 leading-relaxed">
                        Trello-style drag-and-drop task boards with checklist subtasks, multi-assignees, and global team channels powered by high-speed SignalR WebSockets.
                    </p>
                </div>
            </div>
        </div>

        <!-- Footer Callout -->
        <div class="mt-28 py-12 border-t border-zinc-800 flex flex-col sm:flex-row items-center justify-between text-xs text-zinc-500 gap-4">
            <div class="flex items-center gap-2">
                <span class="font-bold text-zinc-300">OfficeCore</span>
                <span>© @DateTime.Now.Year. All rights reserved.</span>
            </div>
            <div class="flex items-center gap-6">
                <a href="/login" class="hover:text-zinc-300 transition-colors">Sign In</a>
                <a href="/register" class="hover:text-zinc-300 transition-colors">Create Account</a>
                <a href="/join" class="hover:text-zinc-300 transition-colors">Join Organization</a>
            </div>
        </div>
    </main>
</div>

