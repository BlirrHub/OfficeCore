@page "/"
@layout EmptyLayout
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthProvider

<PageTitle>OfficeCore - Welcome</PageTitle>

<div class="min-h-screen bg-zinc-950 text-white selection:bg-fuchsia-500 selection:text-white flex flex-col justify-between relative overflow-y-auto">
    <!-- Ambient subtle background glow -->
    <div class="fixed inset-0 pointer-events-none z-0">
        <div class="absolute -top-[20%] left-1/2 -translate-x-1/2 w-[700px] h-[500px] rounded-full bg-gradient-to-b from-fuchsia-600/15 via-violet-600/10 to-transparent blur-[120px]"></div>
        <div class="absolute bottom-[-10%] right-[10%] w-[400px] h-[400px] rounded-full bg-violet-600/10 blur-[130px]"></div>
    </div>

    <!-- Top Navigation Header -->
    <header class="relative z-10 border-b border-white/5 bg-zinc-950/70 backdrop-blur-md sticky top-0">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="size-9 rounded-xl bg-gradient-to-br from-fuchsia-500 to-violet-600 flex items-center justify-center text-white font-bold text-sm shadow-md shadow-fuchsia-500/20">
                    OC
                </div>
                <span class="text-lg font-bold tracking-tight text-white">Office<span class="text-fuchsia-400">Core</span></span>
            </div>

            <div class="flex items-center gap-3">
                <ThemeToggle />

                <AuthorizeView>
                    <Authorized>
                        <a href="/workspaces" class="text-xs sm:text-sm font-semibold px-4 py-2 rounded-xl bg-gradient-to-r from-fuchsia-600 to-violet-600 text-white hover:opacity-95 transition-all shadow-md shadow-fuchsia-950/40 flex items-center gap-1.5">
                            <span>Open Workspace</span>
                            <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="text-xs sm:text-sm font-medium text-zinc-300 hover:text-white px-3 py-1.5 transition-colors">
                            Sign In
                        </a>
                        <a href="/register" class="text-xs sm:text-sm font-semibold px-4 py-2 rounded-xl bg-gradient-to-r from-fuchsia-600 to-violet-600 text-white hover:opacity-95 transition-all shadow-md shadow-fuchsia-950/40">
                            Get Started
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </header>

    <!-- Main Scrollable Welcome Content -->
    <main class="relative z-10 flex-1 max-w-4xl mx-auto w-full px-4 sm:px-6 py-12 sm:py-20 flex flex-col justify-center">
        <!-- Hero Section -->
        <div class="text-center space-y-6">
            <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/5 border border-white/10 text-xs text-zinc-300 backdrop-blur-sm">
                <span class="size-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>Simple, private on-premises workspace</span>
            </div>

            <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white leading-tight">
                Welcome to <span class="bg-gradient-to-r from-fuchsia-400 via-pink-400 to-violet-400 bg-clip-text text-transparent">OfficeCore</span>
            </h1>

            <p class="text-base sm:text-lg text-zinc-400 max-w-xl mx-auto leading-relaxed">
                A clean, straightforward platform for your team's attendance, payroll, task boards, and daily workplace operations.
            </p>

            <!-- Action Buttons -->
            <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3.5">
                <AuthorizeView>
                    <Authorized>
                        <a href="/workspaces" class="w-full sm:w-auto px-7 py-3 rounded-xl bg-gradient-to-r from-fuchsia-600 to-violet-600 text-white font-semibold hover:opacity-95 transition-all shadow-lg shadow-fuchsia-950/40 flex items-center justify-center gap-2">
                            <span>Continue to Workspace</span>
                            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="w-full sm:w-auto px-7 py-3 rounded-xl bg-gradient-to-r from-fuchsia-600 to-violet-600 text-white font-semibold hover:opacity-95 transition-all shadow-lg shadow-fuchsia-950/40 flex items-center justify-center gap-2">
                            <span>Sign In</span>
                            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                        </a>
                        <a href="/register" class="w-full sm:w-auto px-6 py-3 rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-200 font-semibold hover:bg-zinc-800 hover:text-white transition-all flex items-center justify-center">
                            <span>Create Account</span>
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <!-- Simple Overview Cards (Scrollable) -->
        <div class="mt-16 sm:mt-20 grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="rounded-2xl border border-zinc-800/80 bg-zinc-900/40 p-5 backdrop-blur-sm">
                <div class="size-9 rounded-lg bg-fuchsia-500/10 border border-fuchsia-500/20 text-fuchsia-400 flex items-center justify-center mb-3">
                    <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <h2 class="text-sm font-semibold text-white">Time & Attendance</h2>
                <p class="text-xs text-zinc-400 mt-1.5 leading-relaxed">
                    Track staff hours, biometric shifts, and daily attendance records with automated cutoffs.
                </p>
            </div>

            <div class="rounded-2xl border border-zinc-800/80 bg-zinc-900/40 p-5 backdrop-blur-sm">
                <div class="size-9 rounded-lg bg-violet-500/10 border border-violet-500/20 text-violet-400 flex items-center justify-center mb-3">
                    <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                </div>
                <h2 class="text-sm font-semibold text-white">Payroll Engine</h2>
                <p class="text-xs text-zinc-400 mt-1.5 leading-relaxed">
                    Calculate gross and net salaries with contributions, tax deductions, and itemized payslips.
                </p>
            </div>

            <div class="rounded-2xl border border-zinc-800/80 bg-zinc-900/40 p-5 backdrop-blur-sm">
                <div class="size-9 rounded-lg bg-blue-500/10 border border-blue-500/20 text-blue-400 flex items-center justify-center mb-3">
                    <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" /></svg>
                </div>
                <h2 class="text-sm font-semibold text-white">Tasks & Collaboration</h2>
                <p class="text-xs text-zinc-400 mt-1.5 leading-relaxed">
                    Organize team priorities with interactive Kanban boards and fast internal messaging.
                </p>
            </div>
        </div>
    </main>

    <!-- Clean Footer -->
    <footer class="relative z-10 border-t border-white/5 py-6 bg-zinc-950/60 text-center text-xs text-zinc-500">
        <div class="max-w-4xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-3">
            <div>OfficeCore &bull; Private On-Premises Workplace Platform</div>
            <div class="flex items-center gap-4">
                <a href="/login" class="hover:text-zinc-300 transition-colors">Sign In</a>
                <a href="/register" class="hover:text-zinc-300 transition-colors">Register</a>
                <a href="/join" class="hover:text-zinc-300 transition-colors">Join Organization</a>
            </div>
        </div>
    </footer>
</div>

