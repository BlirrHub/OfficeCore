@page "/change-password"
@attribute [Authorize]
@layout OfficeCore.Web.Client.Layout.EmptyLayout
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject CookieAuthStateProvider AuthProvider
@inject ToastService Toast

<div class="min-h-screen flex flex-col items-center justify-center bg-black px-4 py-8">
    <div class="w-full max-w-[420px]">
        <div class="text-center mb-6">
            <div class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-br from-fuchsia-600 to-purple-700 text-white shadow-lg shadow-fuchsia-900/30 mb-3">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                </svg>
            </div>
            <h1 class="text-xl font-bold text-white tracking-tight">Set a New Password</h1>
            <p class="mt-1 text-xs text-zinc-400">Your account requires a password update before continuing.</p>
        </div>

        <div class="rounded-2xl border border-zinc-800/80 bg-zinc-950/90 p-6 shadow-2xl">
            <EditForm Model="@_model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="space-y-4">
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="rounded-xl border border-rose-500/30 bg-rose-500/10 px-3.5 py-2.5 text-xs text-rose-300">
                            @_errorMessage
                        </div>
                    }

                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Current / Temporary Password</label>
                        <InputText @bind-Value="_model.CurrentPassword" type="password"
                                   class="w-full rounded-xl border border-zinc-800 bg-zinc-900/70 px-3.5 py-2.5 text-sm text-white placeholder-zinc-500 focus:border-fuchsia-500 focus:outline-none"
                                   placeholder="Enter current password" />
                        <ValidationMessage For="@(() => _model.CurrentPassword)" class="mt-1 text-xs text-rose-400" />
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">New Password</label>
                        <InputText @bind-Value="_model.NewPassword" type="password"
                                   class="w-full rounded-xl border border-zinc-800 bg-zinc-900/70 px-3.5 py-2.5 text-sm text-white placeholder-zinc-500 focus:border-fuchsia-500 focus:outline-none"
                                   placeholder="At least 8 characters with digit &amp; lowercase" />
                        <ValidationMessage For="@(() => _model.NewPassword)" class="mt-1 text-xs text-rose-400" />
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Confirm New Password</label>
                        <InputText @bind-Value="_model.ConfirmPassword" type="password"
                                   class="w-full rounded-xl border border-zinc-800 bg-zinc-900/70 px-3.5 py-2.5 text-sm text-white placeholder-zinc-500 focus:border-fuchsia-500 focus:outline-none"
                                   placeholder="Re-enter new password" />
                        <ValidationMessage For="@(() => _model.ConfirmPassword)" class="mt-1 text-xs text-rose-400" />
                    </div>

                    <button type="submit" disabled="@_isSubmitting"
                            class="w-full rounded-xl bg-fuchsia-600 hover:bg-fuchsia-500 disabled:opacity-50 text-white py-2.5 px-4 text-sm font-semibold transition-all active:scale-[0.98]">
                        @(_isSubmitting ? "Updating Password..." : "Update Password & Continue")
                    </button>
                </div>
            </EditForm>

            <div class="mt-4 pt-4 border-t border-zinc-800/70 flex justify-center">
                <button type="button" @onclick="SignOut"
                        class="text-xs text-zinc-400 hover:text-zinc-200 transition-colors">
                    Sign out and switch account
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private ChangePasswordModel _model = new();
    private string? _errorMessage;
    private bool _isSubmitting;

    private async Task HandleSubmit()
    {
        _errorMessage = null;
        if (_model.NewPassword != _model.ConfirmPassword)
        {
            _errorMessage = "New passwords do not match.";
            return;
        }

        _isSubmitting = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/auth/change-password", new
            {
                currentPassword = _model.CurrentPassword,
                newPassword = _model.NewPassword
            });

            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Password updated successfully.");
                AuthProvider.NotifyAuthStateChanged();
                Nav.NavigateTo("/workspaces", forceLoad: true);
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                _errorMessage = ParseErrorMessage(body);
            }
        }
        catch
        {
            _errorMessage = "Unable to update password right now. Please try again.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task SignOut()
    {
        try
        {
            await Http.PostAsync("/api/auth/logout", null);
        }
        catch { }

        AuthProvider.NotifyAuthStateChanged();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    private static string ParseErrorMessage(string rawBody)
    {
        if (string.IsNullOrWhiteSpace(rawBody))
            return "Failed to update password.";

        try
        {
            using var doc = JsonDocument.Parse(rawBody);
            if (doc.RootElement.ValueKind == JsonValueKind.Array)
            {
                var descriptions = doc.RootElement.EnumerateArray()
                    .Select(e => e.TryGetProperty("description", out var d) ? d.GetString() : null)
                    .Where(d => !string.IsNullOrWhiteSpace(d))
                    .ToList();
                if (descriptions.Count > 0)
                    return string.Join(" ", descriptions);
            }
            else if (doc.RootElement.ValueKind == JsonValueKind.Object &&
                     doc.RootElement.TryGetProperty("message", out var msg))
            {
                return msg.GetString() ?? "Failed to update password.";
            }
        }
        catch { }

        return rawBody;
    }

    private class ChangePasswordModel
    {
        [Required(ErrorMessage = "Current password is required")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "New password is required")]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your new password")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
