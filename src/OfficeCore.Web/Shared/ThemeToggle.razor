@inject IJSRuntime JS

<button type="button" 
        @onclick="ToggleTheme"
        class="@($"relative p-2 rounded-xl transition-all duration-200 border group focus:outline-none {GetButtonClasses()} {Class}")"
        title="@(_isLightMode ? "Switch to Dark Mode" : "Switch to Light Mode")"
        aria-label="@(_isLightMode ? "Switch to Dark Mode" : "Switch to Light Mode")">
    
    @if (_isLightMode)
    {
        <!-- Moon Icon for Light Mode (Click to enter Dark Mode) -->
        <svg class="size-4.5 text-zinc-600 group-hover:text-fuchsia-600 transition-transform duration-200 group-hover:-rotate-12" 
             fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" 
                  d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
        </svg>
    }
    else
    {
        <!-- Sun Icon for Dark Mode (Click to enter Light Mode) -->
        <svg class="size-4.5 text-zinc-400 group-hover:text-amber-400 transition-transform duration-200 group-hover:rotate-45" 
             fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" 
                  d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
        </svg>
    }
</button>

@code {
    [Parameter] public string? Class { get; set; }

    private bool _isLightMode = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var theme = await JS.InvokeAsync<string>("themeInterop.getTheme");
                _isLightMode = theme == "light";
                StateHasChanged();
            }
            catch
            {
                // Fallback gracefully if JS not ready yet
            }
        }
    }

    private async Task ToggleTheme()
    {
        try
        {
            var next = await JS.InvokeAsync<string>("themeInterop.toggleTheme");
            _isLightMode = next == "light";
        }
        catch
        {
            _isLightMode = !_isLightMode;
        }
    }

    private string GetButtonClasses()
    {
        return _isLightMode 
            ? "bg-zinc-100 hover:bg-zinc-200/80 border-zinc-200 text-zinc-700 shadow-xs" 
            : "bg-zinc-900/60 hover:bg-zinc-900 border-zinc-800 text-zinc-400 hover:border-zinc-700 shadow-inner";
    }
}
