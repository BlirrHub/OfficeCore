@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager Navigation
@inject HttpClient Http
@inject ToastService ToastService
@implements IAsyncDisposable

<style>
    .oc-notif-dropdown {
        background-color: #18181b !important;
        opacity: 1 !important;
    }
    .oc-notif-header, .oc-notif-footer {
        background-color: #09090b !important;
        opacity: 1 !important;
    }
    .oc-notif-item {
        background-color: #18181b !important;
    }
    .oc-notif-item:hover {
        background-color: #27272a !important;
    }
    html.light .oc-notif-dropdown {
        background-color: #ffffff !important;
        border-color: #e2e8f0 !important;
        box-shadow: 0 20px 45px rgba(0,0,0,0.15) !important;
    }
    html.light .oc-notif-header, html.light .oc-notif-footer {
        background-color: #f8fafc !important;
        border-color: #e2e8f0 !important;
    }
    html.light .oc-notif-item {
        background-color: #ffffff !important;
    }
    html.light .oc-notif-item:hover {
        background-color: #f1f5f9 !important;
    }
</style>

<div class="relative">
    <!-- Notification Bell Button -->
    <button @onclick="ToggleDropdown"
            class="relative text-zinc-400 hover:text-white transition-colors p-2 rounded-xl hover:bg-zinc-900 border border-transparent hover:border-zinc-800"
            aria-label="Notifications"
            title="Notifications">
        <svg class="size-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
        </svg>

        @if (UnreadCount > 0)
        {
            <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 rounded-full bg-fuchsia-600 text-white text-[10px] font-bold flex items-center justify-center border-2 border-zinc-950 animate-in fade-in zoom-in shadow-md shadow-fuchsia-900/40">
                @(UnreadCount > 9 ? "9+" : UnreadCount.ToString())
            </span>
        }
    </button>

    <!-- Dropdown Popover -->
    @if (_isOpen)
    {
        <!-- Transparent backdrop to dismiss on outside click -->
        <div class="fixed inset-0 z-[90] bg-transparent" @onclick="CloseDropdown"></div>

        <div class="absolute right-0 mt-2 w-80 sm:w-96 rounded-2xl border border-zinc-800 shadow-2xl shadow-black z-[100] overflow-hidden flex flex-col max-h-[480px] oc-notif-dropdown">
            <!-- Header -->
            <div class="px-4 py-3 border-b border-zinc-800 flex items-center justify-between oc-notif-header">
                <div class="flex items-center gap-2">
                    <span class="text-xs font-bold text-white uppercase tracking-wider">Notifications</span>
                    @if (UnreadCount > 0)
                    {
                        <span class="px-1.5 py-0.5 rounded-md bg-fuchsia-500/10 text-fuchsia-400 border border-fuchsia-500/20 text-[10px] font-semibold">
                            @UnreadCount new
                        </span>
                    }
                </div>
                @if (_notifications.Any(n => !n.IsRead))
                {
                    <button @onclick="MarkAllAsRead"
                            class="text-[11px] text-fuchsia-400 hover:text-fuchsia-300 font-medium transition-colors">
                        Mark all as read
                    </button>
                }
            </div>

            <!-- Notification List -->
            <div class="overflow-y-auto flex-1 divide-y divide-zinc-800 custom-scrollbar oc-notif-dropdown">
                @if (_notifications.Count == 0)
                {
                    <div class="p-8 text-center space-y-2 oc-notif-item">
                        <div class="size-10 rounded-full bg-zinc-800 mx-auto flex items-center justify-center text-zinc-400">
                            <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" /></svg>
                        </div>
                        <p class="text-xs font-medium text-zinc-300">You're all caught up!</p>
                        <p class="text-[11px] text-zinc-500">Live workspace notifications will appear here in real time.</p>
                    </div>
                }
                else
                {
                    @foreach (var item in _notifications)
                    {
                        <div @onclick="() => OnItemClick(item)"
                             class="p-3.5 transition-colors cursor-pointer flex items-start gap-3 relative group oc-notif-item @(!item.IsRead ? "bg-fuchsia-950/20" : "")">
                            
                            <!-- Icon Pill -->
                            <div class="size-8 rounded-xl bg-zinc-800/80 flex items-center justify-center shrink-0 border border-zinc-700/60">
                                @if (item.Category == "Leave")
                                {
                                    <svg class="size-4 text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
                                }
                                else if (item.Category == "Advance")
                                {
                                    <svg class="size-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                }
                                else if (item.Category == "Location")
                                {
                                    <svg class="size-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
                                }
                                else
                                {
                                    <svg class="size-4 text-fuchsia-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" /></svg>
                                }
                            </div>

                            <!-- Content -->
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center justify-between gap-2">
                                    <p class="text-xs font-semibold text-zinc-100 truncate @(!item.IsRead ? "text-white" : "text-zinc-300")">
                                        @item.Title
                                    </p>
                                    <span class="text-[10px] text-zinc-500 shrink-0">
                                        @FormatTimeAgo(item.Timestamp)
                                    </span>
                                </div>
                                <p class="text-[11px] text-zinc-400 line-clamp-2 mt-0.5 leading-relaxed">
                                    @item.Message
                                </p>
                            </div>

                            <!-- Unread Indicator Dot -->
                            @if (!item.IsRead)
                            {
                                <span class="size-1.5 rounded-full bg-fuchsia-500 shrink-0 self-center"></span>
                            }
                        </div>
                    }
                }
            </div>

            <!-- Footer -->
            @if (_notifications.Count > 0)
            {
                <div class="p-2 border-t border-zinc-800 flex items-center justify-between text-[11px] oc-notif-footer">
                    <span class="text-zinc-500 pl-2">Real-time alerts active</span>
                    <button @onclick="ClearAll"
                            class="px-2.5 py-1 rounded-lg text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800 transition-colors">
                        Clear all
                    </button>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool _isOpen = false;
    private HubConnection? _hubConnection;
    private List<NotificationEntry> _notifications = new();

    private int UnreadCount => _notifications.Count(n => !n.IsRead);

    public class NotificationEntry
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string Title { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
        public string? TargetUrl { get; set; }
        public DateTime Timestamp { get; set; } = DateTime.UtcNow;
        public bool IsRead { get; set; } = false;
    }

    protected override async Task OnInitializedAsync()
    {
        // Seed default initial welcome alert if list empty
        if (_notifications.Count == 0)
        {
            _notifications.Add(new NotificationEntry
            {
                Title = "Welcome to OfficeCore",
                Message = "Your workstation is connected and operational.",
                Category = "System",
                Timestamp = DateTime.UtcNow,
                IsRead = false,
                TargetUrl = "/dashboard"
            });
        }

        await ConnectToNotificationHub();
    }

    private async Task ConnectToNotificationHub()
    {
        try
        {
            var hubUrl = new Uri(Http.BaseAddress!, "hubs/notifications").ToString();

            _hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl)
                .WithAutomaticReconnect()
                .Build();

            // 1. Leave Requests
            _hubConnection.On<object>("LeaveRequestCreated", (data) =>
            {
                AddNotification(new NotificationEntry
                {
                    Title = "New Leave Request Submitted",
                    Message = "An employee submitted a time-off request awaiting review.",
                    Category = "Leave",
                    TargetUrl = "/admin/leave-approvals"
                });
            });

            _hubConnection.On<object>("LeaveRequestUpdated", (data) =>
            {
                AddNotification(new NotificationEntry
                {
                    Title = "Leave Request Status Updated",
                    Message = "A leave request was reviewed or modified.",
                    Category = "Leave",
                    TargetUrl = "/myleaves"
                });
            });

            // 2. Advance / E-Loan Requests
            _hubConnection.On<object>("AdvanceRequestCreated", (data) =>
            {
                AddNotification(new NotificationEntry
                {
                    Title = "New Advance Request Filed",
                    Message = "An employee filed a salary advance or E-Loan request.",
                    Category = "Advance",
                    TargetUrl = "/ledger"
                });
            });

            _hubConnection.On<object>("AdvanceRequestUpdated", (data) =>
            {
                AddNotification(new NotificationEntry
                {
                    Title = "Advance / Loan Updated",
                    Message = "An advance request status has been updated.",
                    Category = "Advance",
                    TargetUrl = "/advances"
                });
            });

            // 3. Field Location Pings
            _hubConnection.On<object>("FieldLocationUpdated", (data) =>
            {
                AddNotification(new NotificationEntry
                {
                    Title = "Field Worker Active",
                    Message = "A team member broadcast their live location.",
                    Category = "Location",
                    TargetUrl = "/locations"
                });
            });

            await _hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[NotificationCenter] SignalR connection warning: {ex.Message}");
        }
    }

    private void AddNotification(NotificationEntry entry)
    {
        _notifications.Insert(0, entry);
        if (_notifications.Count > 30)
        {
            _notifications.RemoveAt(_notifications.Count - 1);
        }
        InvokeAsync(StateHasChanged);
    }

    private void ToggleDropdown()
    {
        _isOpen = !_isOpen;
    }

    private void CloseDropdown()
    {
        _isOpen = false;
    }

    private void MarkAllAsRead()
    {
        foreach (var n in _notifications)
        {
            n.IsRead = true;
        }
    }

    private void ClearAll()
    {
        _notifications.Clear();
        _isOpen = false;
    }

    private void OnItemClick(NotificationEntry item)
    {
        item.IsRead = true;
        _isOpen = false;
        if (!string.IsNullOrEmpty(item.TargetUrl))
        {
            Navigation.NavigateTo(item.TargetUrl);
        }
    }

    private string FormatTimeAgo(DateTime timestamp)
    {
        var diff = DateTime.UtcNow - timestamp;
        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return timestamp.ToLocalTime().ToString("MMM dd");
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}
