@inject ToastService ToastService
@implements IDisposable

<div class="fixed top-4 right-4 z-50 flex flex-col gap-2 pointer-events-none">
    @foreach (var toast in _toasts.OrderBy(t => t.Timestamp))
    {
        <div @key="toast.Id" class="pointer-events-auto min-w-[300px] max-w-sm rounded-lg shadow-lg border p-4 transition-all duration-300 translate-y-0 opacity-100 @GetToastClasses(toast.Level)">
            <div class="flex items-start gap-3">
                <div class="flex-shrink-0 mt-0.5">
                    @switch (toast.Level)
                    {
                        case ToastLevel.Success:
                            <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            break;
                        case ToastLevel.Error:
                            <svg class="w-4 h-4 text-rose-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
                            break;
                        case ToastLevel.Warning:
                            <svg class="w-4 h-4 text-amber-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>
                            break;
                        case ToastLevel.Info:
                            <svg class="w-4 h-4 text-blue-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"/></svg>
                            break;
                    }
                </div>
                <div class="flex-1">
                    @if (!string.IsNullOrEmpty(toast.Title))
                    {
                        <h4 class="text-sm font-bold text-white mb-0.5">@toast.Title</h4>
                    }
                    <p class="text-sm text-zinc-300">@toast.Message</p>
                </div>
                <button @onclick="() => RemoveToast(toast.Id)" aria-label="Dismiss notification" class="flex-shrink-0 text-zinc-400 hover:text-white transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
        </div>
    }
</div>

@code {
    private List<ToastMessage> _toasts = new();

    protected override void OnInitialized()
    {
        ToastService.OnShow += ShowToast;
        ToastService.OnHide += RemoveToast;
    }

    private async void ShowToast(ToastMessage toast)
    {
        _toasts.Add(toast);
        await InvokeAsync(StateHasChanged);

        // Auto remove after 5 seconds
        await Task.Delay(5000);
        RemoveToast(toast.Id);
    }

    private async void RemoveToast(Guid id)
    {
        var toast = _toasts.FirstOrDefault(t => t.Id == id);
        if (toast != null)
        {
            _toasts.Remove(toast);
            await InvokeAsync(StateHasChanged);
        }
    }

    private string GetToastClasses(ToastLevel level) => level switch
    {
        ToastLevel.Success => "bg-zinc-900 border-emerald-500/30 shadow-emerald-900/20",
        ToastLevel.Error => "bg-zinc-900 border-rose-500/30 shadow-rose-900/20",
        ToastLevel.Warning => "bg-zinc-900 border-amber-500/30 shadow-amber-900/20",
        ToastLevel.Info => "bg-zinc-900 border-blue-500/30 shadow-blue-900/20",
        _ => "bg-zinc-900 border-zinc-700"
    };

    public void Dispose()
    {
        ToastService.OnShow -= ShowToast;
        ToastService.OnHide -= RemoveToast;
    }
}
