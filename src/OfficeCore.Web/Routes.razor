<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.EmptyLayout)">
            <NotAuthorized>
                @if (!context.User.Identity?.IsAuthenticated ?? true)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <div class="min-h-screen bg-black flex items-center justify-center">
                        <div class="text-center space-y-4">
                            <p class="text-4xl font-bold text-white">403</p>
                            <p class="text-zinc-400">You don't have permission to view this page.</p>
                        </div>
                    </div>
                }
            </NotAuthorized>
            <Authorizing>
                <div class="min-h-screen bg-black flex items-center justify-center">
                    <div class="animate-spin size-8 text-fuchsia-500 border-2 border-fuchsia-500/20 border-t-fuchsia-500 rounded-full"></div>
                </div>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="typeof(Layout.EmptyLayout)">
            <div class="min-h-screen bg-black flex flex-col items-center justify-center p-4">
                <h1 class="text-6xl font-bold text-white mb-4">404</h1>
                <p class="text-zinc-400 text-lg mb-8">Sorry, there's nothing at this address.</p>
                <a href="/" class="text-fuchsia-400 hover:text-fuchsia-300 underline">Return home</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
