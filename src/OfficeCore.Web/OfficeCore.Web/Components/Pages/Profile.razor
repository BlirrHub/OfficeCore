@page "/profile"
@attribute [Authorize]

<PageTitle>My Profile - OfficeCore</PageTitle>

<div class="max-w-3xl space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight text-white">My Profile</h1>
        <p class="mt-2 text-zinc-400">Manage your personal information and preferences.</p>
    </div>

    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 space-y-8">
        <div>
            <h2 class="text-lg font-medium text-white">Personal Information</h2>
            <div class="mt-4 grid grid-cols-1 gap-y-6 sm:grid-cols-2 sm:gap-x-4">
                <div>
                    <label class="block text-sm font-medium text-zinc-400">First name</label>
                    <div class="mt-1">
                        <input type="text" class="block w-full rounded-lg bg-zinc-950 border border-zinc-800 px-3 py-2 text-white focus:border-fuchsia-500 focus:ring-fuchsia-500 sm:text-sm" placeholder="John">
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-zinc-400">Last name</label>
                    <div class="mt-1">
                        <input type="text" class="block w-full rounded-lg bg-zinc-950 border border-zinc-800 px-3 py-2 text-white focus:border-fuchsia-500 focus:ring-fuchsia-500 sm:text-sm" placeholder="Doe">
                    </div>
                </div>
                <div class="sm:col-span-2">
                    <label class="block text-sm font-medium text-zinc-400">Email address</label>
                    <div class="mt-1">
                        <input type="email" class="block w-full rounded-lg bg-zinc-950 border border-zinc-800 px-3 py-2 text-zinc-500 sm:text-sm cursor-not-allowed" value="john.doe@company.com" disabled>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="flex justify-end pt-4 border-t border-zinc-800">
            <button type="button" class="rounded-lg bg-fuchsia-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-fuchsia-500 transition-colors">
                Save changes
            </button>
        </div>
    </div>
</div>
