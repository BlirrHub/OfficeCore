@inherits LayoutComponentBase

<div class="flex h-screen bg-gray-950 text-gray-100 font-sans">
    <!-- Sidebar -->
    <aside class="w-64 shrink-0 bg-gray-900 border-r border-gray-800 flex flex-col">
        <NavMenu />
    </aside>

    <!-- Main content -->
    <div class="flex flex-col flex-1 overflow-hidden">
        <!-- Top bar -->
        <header class="flex items-center justify-end h-14 px-6 bg-gray-900 border-b border-gray-800 shrink-0">
            <a href="https://learn.microsoft.com/aspnet/core/"
               target="_blank"
               class="text-sm text-indigo-400 hover:text-indigo-300 transition-colors">
                Docs ↗
            </a>
        </header>

        <!-- Page body -->
        <main class="flex-1 overflow-y-auto p-6">
            @Body
        </main>
    </div>
</div>

<!-- Blazor error UI -->
<div id="blazor-error-ui" data-nosnippet
     class="fixed bottom-4 right-4 z-50 hidden flex items-center gap-3
            rounded-xl bg-red-900/90 backdrop-blur-sm border border-red-700
            px-5 py-3 text-sm text-white shadow-2xl">
    An unhandled error has occurred.
    <a href="." class="ml-2 underline hover:no-underline">Reload</a>
    <span class="cursor-pointer text-lg leading-none select-none dismiss">✕</span>
</div>
