@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>User Management - OfficeCore</PageTitle>

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold tracking-tight text-white">User Management</h1>
            <p class="mt-1 text-zinc-400 text-sm">Manage employee accounts and role assignments.</p>
        </div>
        <button @onclick="() => _showCreate = true"
                class="flex items-center gap-2 rounded-xl bg-fuchsia-600 px-4 py-2 text-sm font-semibold text-white hover:bg-fuchsia-500 transition-colors shadow-lg shadow-fuchsia-900/30">
            <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            Add Employee
        </button>
    </div>

    <!-- Employee table -->
    <div class="bg-zinc-950 border border-zinc-800 rounded-2xl overflow-hidden">
        @if (_users == null)
        {
            <div class="p-12 flex justify-center">
                <div class="flex items-center gap-3 text-zinc-500 text-sm">
                    <svg class="animate-spin size-5" viewBox="0 0 24 24" fill="none">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                    </svg>
                    Loading employees...
                </div>
            </div>
        }
        else if (!_users.Any())
        {
            <div class="p-12 text-center text-zinc-500 italic text-sm">No employees found.</div>
        }
        else
        {
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-zinc-800 text-zinc-400 text-left">
                        <th class="px-6 py-4 font-medium">Employee</th>
                        <th class="px-6 py-4 font-medium">Email</th>
                        <th class="px-6 py-4 font-medium">Status</th>
                        <th class="px-6 py-4 font-medium">Employee ID</th>
                        <th class="px-6 py-4 font-medium">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-800/50">
                    @foreach (var user in _users)
                    {
                        <tr class="hover:bg-zinc-900/50 transition-colors">
                            <td class="px-6 py-4 text-white font-medium">@user.FirstName @user.LastName</td>
                            <td class="px-6 py-4 text-zinc-400">@user.Email</td>
                            <td class="px-6 py-4">
                                @if (user.IsActive)
                                {
                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-900/40 px-2.5 py-0.5 text-xs font-medium text-emerald-400 ring-1 ring-emerald-500/30">
                                        <span class="size-1.5 rounded-full bg-emerald-400"></span>Active
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-zinc-800 px-2.5 py-0.5 text-xs font-medium text-zinc-400 ring-1 ring-zinc-600/30">
                                        <span class="size-1.5 rounded-full bg-zinc-400"></span>Inactive
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 text-zinc-400">@(user.EmployeeId ?? "—")</td>
                            <td class="px-6 py-4">
                                <button @onclick="() => EditUser(user)"
                                        class="text-fuchsia-400 hover:text-fuchsia-300 text-xs font-medium transition-colors">
                                    Edit
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- Create User Modal -->
@if (_showCreate)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm p-4">
        <div class="w-full max-w-lg bg-zinc-950 border border-zinc-800 rounded-2xl shadow-2xl p-6 space-y-6">
            <div class="flex items-center justify-between">
                <h2 class="text-xl font-bold text-white">Add Employee</h2>
                <button @onclick="() => _showCreate = false" class="text-zinc-500 hover:text-white transition-colors">
                    <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-zinc-400 mb-1">First Name</label>
                        <input @bind="_create.FirstName" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-zinc-400 mb-1">Last Name</label>
                        <input @bind="_create.LastName" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none" />
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-medium text-zinc-400 mb-1">Email</label>
                    <input @bind="_create.Email" type="email" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-zinc-400 mb-1">Password</label>
                    <input @bind="_create.Password" type="password" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-zinc-400 mb-1">Employee ID (optional)</label>
                    <input @bind="_create.EmployeeId" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-zinc-400 mb-2">Assign Roles</label>
                    @if (_roles != null)
                    {
                        <div class="flex flex-wrap gap-2">
                            @foreach (var role in _roles)
                            {
                                var roleName = role.Name ?? string.Empty;
                                var selected = _create.SelectedRoles.Contains(roleName);
                                <button type="button"
                                        @onclick="() => ToggleRole(_create.SelectedRoles, roleName)"
                                        class="@($"rounded-lg px-3 py-1.5 text-xs font-medium transition-all {(selected ? "bg-fuchsia-600 text-white" : "bg-zinc-800 text-zinc-400 hover:bg-zinc-700")}")">
                                    @roleName
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_modalError))
            {
                <p class="text-xs text-red-400">@_modalError</p>
            }

            <div class="flex justify-end gap-3 pt-2 border-t border-zinc-800">
                <button @onclick="() => _showCreate = false"
                        class="rounded-lg px-4 py-2 text-sm text-zinc-400 hover:text-white transition-colors">Cancel</button>
                <button @onclick="CreateUser"
                        class="rounded-lg bg-fuchsia-600 px-4 py-2 text-sm font-semibold text-white hover:bg-fuchsia-500 transition-colors">
                    Create Employee
                </button>
            </div>
        </div>
    </div>
}

<!-- Edit User Modal -->
@if (_showEdit)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm p-4">
        <div class="w-full max-w-lg bg-zinc-950 border border-zinc-800 rounded-2xl shadow-2xl p-6 space-y-6">
            <div class="flex items-center justify-between">
                <h2 class="text-xl font-bold text-white">Edit Employee</h2>
                <button @onclick="() => _showEdit = false" class="text-zinc-500 hover:text-white transition-colors">
                    <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-zinc-400 mb-1">First Name</label>
                        <input @bind="_edit.FirstName" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-zinc-400 mb-1">Last Name</label>
                        <input @bind="_edit.LastName" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none" />
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-medium text-zinc-400 mb-1">Employee ID</label>
                    <input @bind="_edit.EmployeeId" class="w-full rounded-lg bg-zinc-900 border border-zinc-700 px-3 py-2 text-sm text-white focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none" />
                </div>
                
                <label class="flex items-center gap-3 cursor-pointer">
                    <input type="checkbox" @bind="_edit.IsActive" class="sr-only peer" />
                    <div class="w-11 h-6 bg-zinc-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-fuchsia-600 relative"></div>
                    <span class="text-sm font-medium text-zinc-300">Account Active</span>
                </label>

                <div>
                    <label class="block text-xs font-medium text-zinc-400 mb-2">Assign Roles</label>
                    @if (_roles != null)
                    {
                        <div class="flex flex-wrap gap-2">
                            @foreach (var role in _roles)
                            {
                                var roleName = role.Name ?? string.Empty;
                                var selected = _edit.SelectedRoles.Contains(roleName);
                                <button type="button"
                                        @onclick="() => ToggleRole(_edit.SelectedRoles, roleName)"
                                        class="@($"rounded-lg px-3 py-1.5 text-xs font-medium transition-all {(selected ? "bg-fuchsia-600 text-white" : "bg-zinc-800 text-zinc-400 hover:bg-zinc-700")}")">
                                    @roleName
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_modalError))
            {
                <p class="text-xs text-red-400">@_modalError</p>
            }

            <div class="flex justify-end gap-3 pt-2 border-t border-zinc-800">
                <button @onclick="() => _showEdit = false"
                        class="rounded-lg px-4 py-2 text-sm text-zinc-400 hover:text-white transition-colors">Cancel</button>
                <button @onclick="UpdateUser"
                        class="rounded-lg bg-fuchsia-600 px-4 py-2 text-sm font-semibold text-white hover:bg-fuchsia-500 transition-colors">
                    Save Changes
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<UserDto>? _users;
    private List<RoleDto>? _roles;
    private bool _showCreate;
    private bool _showEdit;
    private string? _modalError;
    private CreateForm _create = new();
    private UpdateForm _edit = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _users = await Http.GetFromJsonAsync<List<UserDto>>("/api/user");
        _roles = await Http.GetFromJsonAsync<List<RoleDto>>("/api/role");
    }

    private async Task EditUser(UserDto user)
    {
        _modalError = null;
        _edit = new UpdateForm
        {
            Id = user.Id,
            FirstName = user.FirstName,
            LastName = user.LastName,
            EmployeeId = user.EmployeeId ?? string.Empty,
            IsActive = user.IsActive,
            SelectedRoles = new HashSet<string>()
        };

        try
        {
            var userRoles = await Http.GetFromJsonAsync<List<string>>($"/api/user/{user.Id}/roles");
            if (userRoles != null)
            {
                foreach (var r in userRoles)
                {
                    _edit.SelectedRoles.Add(r);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading roles: {ex.Message}");
        }

        _showEdit = true;
    }

    private void ToggleRole(HashSet<string> set, string role)
    {
        if (!set.Remove(role)) set.Add(role);
    }

    private async Task CreateUser()
    {
        _modalError = null;
        if (string.IsNullOrWhiteSpace(_create.Email) || string.IsNullOrWhiteSpace(_create.Password))
        {
            _modalError = "Email and password are required.";
            return;
        }

        var createPayload = new CreateUserRequestDto
        {
            Email = _create.Email,
            Password = _create.Password,
            FirstName = _create.FirstName,
            LastName = _create.LastName,
            EmployeeId = _create.EmployeeId,
            Roles = _create.SelectedRoles.ToList()
        };

        var response = await Http.PostAsJsonAsync("/api/user", createPayload);

        if (response.IsSuccessStatusCode)
        {
            _showCreate = false;
            _create = new();
            await LoadData();
        }
        else
        {
            _modalError = "Failed to create user. Check the details and try again.";
        }
    }

    private class CreateUserRequestDto
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string? EmployeeId { get; set; }
        public List<string>? Roles { get; set; }
    }

    private async Task UpdateUser()
    {
        _modalError = null;
        if (string.IsNullOrWhiteSpace(_edit.FirstName) || string.IsNullOrWhiteSpace(_edit.LastName))
        {
            _modalError = "First Name and Last Name are required.";
            return;
        }

        var requestPayload = new UpdateUserRequestDto
        {
            FirstName = _edit.FirstName,
            LastName = _edit.LastName,
            EmployeeId = _edit.EmployeeId,
            IsActive = _edit.IsActive,
            Roles = _edit.SelectedRoles.ToList()
        };

        var response = await Http.PutAsJsonAsync($"/api/user/{_edit.Id}", requestPayload);

        if (response.IsSuccessStatusCode)
        {
            _showEdit = false;
            await LoadData();
        }
        else
        {
            _modalError = "Failed to update user. Check the details and try again.";
        }
    }

    private class UpdateUserRequestDto
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string? EmployeeId { get; set; }
        public bool IsActive { get; set; }
        public List<string>? Roles { get; set; }
    }

    private class CreateForm
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string EmployeeId { get; set; } = string.Empty;
        public HashSet<string> SelectedRoles { get; set; } = new();
    }

    private class UpdateForm
    {
        public string Id { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string EmployeeId { get; set; } = string.Empty;
        public bool IsActive { get; set; }
        public HashSet<string> SelectedRoles { get; set; } = new();
    }

    private record UserDto(string Id, string Email, string FirstName, string LastName, string? EmployeeId, bool IsActive);
    private record RoleDto(string Id, string? Name, string? Description);
}
