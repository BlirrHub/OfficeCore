<!-- Footer Profile & Sign out -->
<div class="p-3 border-t border-zinc-800/80 shrink-0">
    <AuthorizeView>
        <Authorized Context="authContext">
            @{
                var user = authContext.User;
                var firstName = user.FindFirst("FirstName")?.Value;
                var lastName = user.FindFirst("LastName")?.Value;
                var email = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
                
                var fullName = string.IsNullOrWhiteSpace(firstName) && string.IsNullOrWhiteSpace(lastName) 
                    ? email ?? "User" 
                    : $"{firstName} {lastName}".Trim();
                    
                var titleRole = user.FindFirst("TitleRole")?.Value;
                var roles = user.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
                var roleText = !string.IsNullOrWhiteSpace(titleRole) ? titleRole : (roles.Any() ? string.Join(", ", roles) : "Employee");
                var profilePictureUrl = user.FindFirst("ProfilePictureUrl")?.Value;
            }
            <a href="/settings" title="Settings" class="@($"mb-2 bg-zinc-900/60 rounded-xl border border-zinc-800/80 flex items-center hover:bg-zinc-900 hover:border-zinc-700 transition-all {(IsCollapsed ? "justify-center p-2" : "gap-3 p-2.5")}")">
                @if (!string.IsNullOrEmpty(profilePictureUrl))
                {
                    <img src="@(Configuration["ApiBaseUrl"] + profilePictureUrl)" alt="Profile" class="size-8 rounded-full object-cover border border-fuchsia-900/50 shrink-0" />
                }
                else
                {
                    <div class="size-8 rounded-full bg-gradient-to-br from-fuchsia-950 to-zinc-900 border border-fuchsia-500/30 flex items-center justify-center text-fuchsia-400 font-semibold text-xs shrink-0 shadow-inner">
                        @(fullName.Length >= 2 ? fullName.Substring(0, 2).ToUpper() : "U")
                    </div>
                }
                <div class="overflow-hidden min-w-0 @(IsCollapsed ? "hidden" : "block")">
                    <div class="text-xs font-semibold text-zinc-200 truncate">@fullName</div>
                    <div class="text-[10px] text-zinc-500 uppercase tracking-wider truncate font-medium">@roleText</div>
                </div>
            </a>
            <button type="button" @onclick="Logout"
                    class="flex items-center gap-2.5 text-xs font-medium text-zinc-400 hover:text-red-300 hover:bg-red-950/20 px-3 py-2 rounded-xl transition-colors w-full @(IsCollapsed ? "justify-center" : "")">
                <svg class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
                </svg>
                <span class="@(IsCollapsed ? "hidden" : "block")">Sign out</span>
            </button>
        </Authorized>
    </AuthorizeView>
</div>

@inject HttpClient Http
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject AuthenticationStateProvider AuthProvider

@code {
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public EventCallback OnToggleCollapse { get; set; }

    private string GetNavLinkClass() => $"group flex items-center gap-3 py-2 {(IsCollapsed ? "justify-center px-0" : "px-3")} rounded-xl text-sm text-zinc-400 hover:text-zinc-100 hover:bg-zinc-900/80 border border-transparent transition-all duration-150";

    private async Task Logout()
    {
        // Call the API to clear the cookie
        await Http.PostAsync("api/auth/logout", null);
        
        // Notify the Blazor app that the user is logged out
        if (AuthProvider is OfficeCore.Web.Client.Auth.CookieAuthStateProvider cookieProvider)
        {
            cookieProvider.NotifyAuthStateChanged();
        }
        
        // Redirect to login page
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
