<!-- Brand / logo -->
<div class="flex items-center justify-between px-5 h-16 border-b border-zinc-900 shrink-0">
    <div class="flex items-center gap-3 @(IsCollapsed ? "hidden" : "block")">
        <div class="size-8 rounded-lg bg-fuchsia-600 flex items-center justify-center text-white font-bold text-sm">
            OC
        </div>
        <span class="font-semibold text-white tracking-wide">OfficeCore</span>
    </div>
    <button @onclick="OnToggleCollapse" class="text-zinc-400 hover:text-fuchsia-400 transition-colors p-1.5 rounded-lg hover:bg-zinc-900 @(IsCollapsed ? "mx-auto" : "")">
        <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
    </button>
</div>

<!-- Nav links -->
<nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
    <AuthorizeView>
        <Authorized>
            @{
                var hasMain = context.User.HasClaim("ModuleAccess", "Dashboard") || context.User.HasClaim("ModuleAccess", "Clients") || context.User.HasClaim("ModuleAccess", "Attendance") || context.User.HasClaim("ModuleAccess", "Boards") || context.User.HasClaim("ModuleAccess", "MyLeaves");
                var hasFinance = context.User.HasClaim("ModuleAccess", "Advances") || context.User.HasClaim("ModuleAccess", "Ledger") || context.User.HasClaim("ModuleAccess", "Payroll") || context.User.HasClaim("ModuleAccess", "Invoices");
                var hasAdmin = context.User.HasClaim("ModuleAccess", "Users") || context.User.HasClaim("ModuleAccess", "Roles") || context.User.HasClaim("ModuleAccess", "LeaveApprovals") || context.User.HasClaim("ModuleAccess", "WorkSchedules") || context.User.HasClaim("ModuleAccess", "TimeOff") || context.User.HasClaim("ModuleAccess", "Locations") || context.User.HasClaim("ModuleAccess", "Organization");
            }

            @if (hasMain)
            {
                <!-- Main Group -->
                @if (IsCollapsed)
                {
                    <div class="px-4 py-2"><hr class="border-zinc-800"/></div>
                }
                else
                {
                    <div class="px-3 pt-2 pb-1">
                        <p class="text-[10px] font-bold text-zinc-600 uppercase tracking-wider">Main</p>
                    </div>
                }

                @if (context.User.HasClaim("ModuleAccess", "Dashboard"))
                {
                    <NavLink href="" Match="NavLinkMatch.All" class="@GetNavLinkClass()" ActiveClass="bg-fuchsia-600/20 text-fuchsia-400 font-medium">
                        <svg class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 9.75L12 3l9 6.75V21a.75.75 0 01-.75.75H15.75a.75.75 0 01-.75-.75v-5.25H9V21a.75.75 0 01-.75.75H3.75A.75.75 0 013 21V9.75z" /></svg>
                        <span class="@(IsCollapsed ? "hidden" : "block")">Dashboard</span>
                    </NavLink>
                }
                @if (context.User.HasClaim("ModuleAccess", "Clients"))
                {
                    <NavLink href="clients" class="@GetNavLinkClass()" ActiveClass="bg-fuchsia-600/20 text-fuchsia-400 font-medium">
                        <svg class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
                        <span class="@(IsCollapsed ? "hidden" : "block")">Clients</span>
                    </NavLink>
                }
                @if (context.User.HasClaim("ModuleAccess", "Attendance"))
                {
                    <NavLink href="attendance" class="@GetNavLinkClass()" ActiveClass="bg-fuchsia-600/20 text-fuchsia-400 font-medium">
                        <svg class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <span class="@(IsCollapsed ? "hidden" : "block")">Attendance</span>
                    </NavLink>
                }
                @if (context.User.HasClaim("ModuleAccess", "Boards"))
                {
                    <NavLink href="boards" class="@GetNavLinkClass()" ActiveClass="bg-fuchsia-600/20 text-fuchsia-400 font-medium">
                        <svg class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" /></svg>
                        <span class="@(IsCollapsed ? "hidden" : "block")">Boards</span>
                    </NavLink>
                }
                @if (context.User.HasClaim("ModuleAccess", "MyLeaves"))
                {
                    <NavLink href="myleaves" class="@GetNavLinkClass()" ActiveClass="bg-fuchsia-600/20 text-fuchsia-400 font-medium">
                        <svg class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" /></svg>
                        <span class="@(IsCollapsed ? "hidden" : "block")">My Leaves</span>
                    </NavLink>
                }
            }

            @if (hasFinance)
            {
                <!-- Finance Group -->
                @if (IsCollapsed)
                {
                    <div class="px-4 py-3"><hr class="border-zinc-800"/></div>
                }
                else
                {
                    <div class="px-3 pt-6 pb-1">
                        <p class="text-[10px] font-bold text-zinc-600 uppercase tracking-wider">Finance</p>
                    </div>
                }

                @if (context.User.HasClaim("ModuleAccess", "Advances"))
                {
                    <NavLink href="advances" class="@GetNavLinkClass()" ActiveClass="bg-fuchsia-600/20 text-fuchsia-400 font-medium">
                        <svg class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <span class="@(IsCollapsed ? "hidden" : "block")">Advances & Loans</span>
                    </NavLink>
                }
                @if (context.User.HasClaim("ModuleAccess", "Ledger"))
                {
                    <NavLink href="ledger" class="@GetNavLinkClass()" ActiveClass="bg-fuchsia-600/20 text-fuchsia-400 font-medium">
                        <svg class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6" /></svg>
                        <span class="@(IsCollapsed ? "hidden" : "block")">Ledger</span>
                    </NavLink>
                }
                @if (context.User.HasClaim("ModuleAccess", "Payroll"))
                {
                    <NavLink href="payroll" class="@GetNavLinkClass()" ActiveClass="bg-fuchsia-600/20 text-fuchsia-400 font-medium">
                        <svg class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <span class="@(IsCollapsed ? "hidden" : "block")">Payroll</span>
                    </NavLink>
                }
                @if (context.User.HasClaim("ModuleAccess", "Invoices"))
                {
                    <NavLink href="invoices" class="@GetNavLinkClass()" ActiveClass="bg-fuchsia-600/20 text-fuchsia-400 font-medium">
                        <svg class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V4.22c0-.756-.728-1.296-1.453-1.096a60.07 60.07 0 01-15.797 2.101c-.727.198-1.453.738-1.453 1.492v10.536c0 .756.728 1.296 1.453 1.096V18.75z" /></svg>
                        <span class="@(IsCollapsed ? "hidden" : "block")">Invoices</span>
                    </NavLink>
                }
            }

            @if (hasAdmin)
            {
                <!-- Administration Group -->
                @if (IsCollapsed)
                {
                    <div class="px-4 py-3"><hr class="border-zinc-800"/></div>
                }
                else
                {
                    <div class="px-3 pt-6 pb-1">
                        <p class="text-[10px] font-bold text-zinc-600 uppercase tracking-wider">Administration</p>
                    </div>
                }

                @if (context.User.HasClaim("ModuleAccess", "Users"))
                {
                    <NavLink href="admin/users" class="@GetNavLinkClass()" ActiveClass="bg-fuchsia-600/20 text-fuchsia-400 font-medium">
                        <svg class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
                        <span class="@(IsCollapsed ? "hidden" : "block")">Users</span>
                    </NavLink>
                }
                @if (context.User.HasClaim("ModuleAccess", "Roles"))
                {
                    <NavLink href="admin/roles" class="@GetNavLinkClass()" ActiveClass="bg-fuchsia-600/20 text-fuchsia-400 font-medium">
                        <svg class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>
                        <span class="@(IsCollapsed ? "hidden" : "block")">Roles</span>
                    </NavLink>
                }
                @if (context.User.HasClaim("ModuleAccess", "LeaveApprovals"))
                {
                    <NavLink href="admin/leave-approvals" class="@GetNavLinkClass()" Match="NavLinkMatch.All" ActiveClass="bg-fuchsia-600/20 text-fuchsia-400 font-medium">
                        <svg class="size-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                        <span class="@(IsCollapsed ? "hidden" : "block")">Leave Approvals</span>
                    </NavLink>
                }
                @if (context.User.HasClaim("ModuleAccess", "WorkSchedules"))
                {
                    <NavLink href="admin/workschedules" class="@GetNavLinkClass()" Match="NavLinkMatch.All" ActiveClass="bg-fuchsia-600/20 text-fuchsia-400 font-medium">
                        <svg class="size-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <span class="@(IsCollapsed ? "hidden" : "block")">Work Schedules</span>
                    </NavLink>
                }
                @if (context.User.HasClaim("ModuleAccess", "TimeOff"))
                {
                    <NavLink href="time-off" class="@GetNavLinkClass()" ActiveClass="bg-fuchsia-600/20 text-fuchsia-400 font-medium">
                        <svg class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" /></svg>
                        <span class="@(IsCollapsed ? "hidden" : "block")">Time Off & Holidays</span>
                    </NavLink>
                }
                @if (context.User.HasClaim("ModuleAccess", "Locations"))
                {
                    <NavLink href="locations" class="@GetNavLinkClass()" ActiveClass="bg-fuchsia-600/20 text-fuchsia-400 font-medium">
                        <svg class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
                        <span class="@(IsCollapsed ? "hidden" : "block")">Locations</span>
                    </NavLink>
                }
                @if (context.User.HasClaim("ModuleAccess", "Organization"))
                {
                    <NavLink href="organization" class="@GetNavLinkClass()" Match="NavLinkMatch.All" ActiveClass="bg-fuchsia-600/20 text-fuchsia-400 font-medium">
                        <svg class="size-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                        <span class="@(IsCollapsed ? "hidden" : "block")">Company Profile</span>
                    </NavLink>
                }
            }
        </Authorized>
    </AuthorizeView>
</nav>

<!-- Footer Profile & Sign out -->
<div class="p-4 border-t border-zinc-900 shrink-0">
    <AuthorizeView>
        <Authorized Context="authContext">
            @{
                var user = authContext.User;
                var firstName = user.FindFirst("FirstName")?.Value;
                var lastName = user.FindFirst("LastName")?.Value;
                var email = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
                
                var fullName = string.IsNullOrWhiteSpace(firstName) && string.IsNullOrWhiteSpace(lastName) 
                    ? email ?? "User" 
                    : $"{firstName} {lastName}".Trim();
                    
                var titleRole = user.FindFirst("TitleRole")?.Value;
                var roles = user.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
                var roleText = !string.IsNullOrWhiteSpace(titleRole) ? titleRole : (roles.Any() ? string.Join(", ", roles) : "Employee");
                var profilePictureUrl = user.FindFirst("ProfilePictureUrl")?.Value;
            }
            <a href="/profile" class="@($"mb-4 bg-zinc-900/40 rounded-xl border border-zinc-800/80 flex items-center shadow-inner hover:bg-zinc-900 transition-colors {(IsCollapsed ? "justify-center p-2" : "gap-3 p-3")}")">
                @if (!string.IsNullOrEmpty(profilePictureUrl))
                {
                    <img src="@(Configuration["ApiBaseUrl"] + profilePictureUrl)" alt="Profile" class="size-9 rounded-full object-cover border border-fuchsia-900/50 shrink-0" />
                }
                else
                {
                    <div class="size-9 rounded-full bg-fuchsia-900/30 border border-fuchsia-900/50 flex items-center justify-center text-fuchsia-400 shrink-0">
                        <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
                    </div>
                }
                <div class="overflow-hidden @(IsCollapsed ? "hidden" : "block")">
                    <div class="text-sm font-semibold text-zinc-200 truncate">@fullName</div>
                    <div class="text-[10px] text-zinc-500 uppercase tracking-wider truncate font-medium mt-0.5">@roleText</div>
                </div>
            </a>
            <button type="button" @onclick="Logout"
                    class="flex items-center gap-2 text-sm text-zinc-400 hover:text-white hover:bg-zinc-900 px-3 py-2.5 rounded-lg transition-colors w-full @(IsCollapsed ? "justify-center" : "")">
                <svg class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
                </svg>
                <span class="@(IsCollapsed ? "hidden" : "block")">Sign out</span>
            </button>
        </Authorized>
    </AuthorizeView>
</div>

@inject HttpClient Http
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject AuthenticationStateProvider AuthProvider

@code {
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public EventCallback OnToggleCollapse { get; set; }

    private string GetNavLinkClass() => $"flex items-center gap-3 py-2 {(IsCollapsed ? "justify-center px-0" : "px-3")} rounded-lg text-sm text-zinc-400 hover:bg-zinc-900 hover:text-white transition-colors";

    private async Task Logout()
    {
        // Call the API to clear the cookie
        await Http.PostAsync("api/auth/logout", null);
        
        // Notify the Blazor app that the user is logged out
        if (AuthProvider is OfficeCore.Web.Client.Auth.CookieAuthStateProvider cookieProvider)
        {
            cookieProvider.NotifyAuthStateChanged();
        }
        
        // Redirect to login page
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
