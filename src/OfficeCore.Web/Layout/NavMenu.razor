<!-- Brand / logo -->
<div class="flex items-center justify-between px-5 h-14 border-b border-zinc-800/80 shrink-0">
    <div class="flex items-center gap-3 @(IsCollapsed ? "hidden" : "flex")">
        <div class="size-7 rounded-lg bg-gradient-to-br from-fuchsia-600 to-violet-600 flex items-center justify-center text-white font-bold text-xs shadow-md shadow-fuchsia-900/30">
            OC
        </div>
        <div class="flex flex-col">
            <span class="font-bold text-white tracking-tight text-sm leading-none">OfficeCore</span>
            <span class="text-[9px] text-zinc-500 font-medium tracking-wide mt-0.5">WORKSPACE</span>
        </div>
    </div>
    <button @onclick="OnToggleCollapse" class="text-zinc-400 hover:text-white transition-colors p-1.5 rounded-lg hover:bg-zinc-900 @(IsCollapsed ? "mx-auto" : "")" title="Toggle Sidebar">
        <svg class="size-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
    </button>
</div>

<!-- Nav links -->
<nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
    <AuthorizeView>
        <Authorized>
            @{
                var hasFinance = context.User.HasClaim("ModuleAccess", "Ledger") || context.User.HasClaim("ModuleAccess", "Payroll") || context.User.HasClaim("ModuleAccess", "Invoices");
                var hasAdmin = context.User.HasClaim("ModuleAccess", "Clients") || context.User.HasClaim("ModuleAccess", "Attendance") || context.User.HasClaim("ModuleAccess", "Users") || context.User.HasClaim("ModuleAccess", "Roles") || context.User.HasClaim("ModuleAccess", "LeaveApprovals") || context.User.HasClaim("ModuleAccess", "OvertimeApprovals") || context.User.HasClaim("ModuleAccess", "WorkSchedules") || context.User.HasClaim("ModuleAccess", "TimeOff") || context.User.HasClaim("ModuleAccess", "Locations") || context.User.HasClaim("ModuleAccess", "Organization") || context.User.HasClaim("ModuleAccess", "AuditLogs");
            }

            <!-- Main Group (Always visible for all authenticated accounts) -->
            @if (IsCollapsed)
            {
                <div class="px-4 py-2"><hr class="border-zinc-800"/></div>
            }
            else
            {
                <div class="px-3 pt-2 pb-1">
                    <p class="text-[10px] font-bold text-zinc-600 uppercase tracking-wider">Main</p>
                </div>
            }

            <NavLink href="dashboard" Match="NavLinkMatch.All" class="@GetNavLinkClass()" ActiveClass="bg-fuchsia-600/20 text-fuchsia-400 font-medium">
                <svg class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 9.75L12 3l9 6.75V21a.75.75 0 01-.75.75H15.75a.75.75 0 01-.75-.75v-5.25H9V21a.75.75 0 01-.75.75H3.75A.75.75 0 013 21V9.75z" /></svg>
                <span class="@(IsCollapsed ? "hidden" : "block")">Dashboard</span>
            </NavLink>

            <NavLink href="my-attendance" class="@GetNavLinkClass()" ActiveClass="bg-fuchsia-600/20 text-fuchsia-400 font-medium">
                <svg class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span class="@(IsCollapsed ? "hidden" : "block")">My Attendance</span>
            </NavLink>

            <NavLink href="my-overtime" class="@GetNavLinkClass()" ActiveClass="bg-fuchsia-600/20 text-fuchsia-400 font-medium">
                <svg class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span class="@(IsCollapsed ? "hidden" : "block")">My Overtime</span>
            </NavLink>

            <NavLink href="boards" class="@GetNavLinkClass()" ActiveClass="bg-fuchsia-600/20 text-fuchsia-400 font-medium">
                <svg class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" /></svg>
