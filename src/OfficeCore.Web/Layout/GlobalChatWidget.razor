@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components.Authorization
@using OfficeCore.Web.Client.Pages.Components
@using OfficeCore.Web.Services
@inject HttpClient Http
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject ToastService ToastService
@inject IJSRuntime JS
@implements IAsyncDisposable

<!-- Chat Widget Container -->
<div class="fixed bottom-6 right-6 z-50 flex flex-col items-end">
    
    <!-- Chat Window -->
    @if (_isOpen)
    {
        <div class="bg-zinc-950 border border-zinc-800 rounded-2xl shadow-2xl w-96 h-[600px] mb-4 flex flex-col overflow-hidden transition-all duration-300 relative select-none">
            @if (_activeRoom == null)
            {
                <!-- Rooms List Header -->
                <div class="p-3.5 border-b border-zinc-800 bg-zinc-900/60 flex items-center justify-between shrink-0">
                    <div class="flex items-center gap-2">
                        <div class="size-2 rounded-full bg-emerald-400 animate-pulse"></div>
                        <h3 class="font-bold text-white text-base tracking-wide">Messages</h3>
                        @if (_totalUnread > 0)
                        {
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-fuchsia-600/20 text-fuchsia-400 border border-fuchsia-500/30">
                                @_totalUnread unread
                            </span>
                        }
                    </div>
                    <div class="flex items-center gap-1.5">
                        <button type="button" @onclick="OpenNewGroupChat" title="New Group Chat" 
                                class="size-8 rounded-xl bg-zinc-800/80 hover:bg-zinc-700 text-zinc-300 hover:text-white flex items-center justify-center transition-all hover:scale-105 active:scale-95 border border-zinc-700/60 group cursor-pointer">
                            <svg class="size-4 group-hover:text-fuchsia-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                            </svg>
                        </button>
                        <button type="button" @onclick="OpenNewDirectMessage" title="New Direct Message" 
                                class="size-8 rounded-xl bg-fuchsia-600 hover:bg-fuchsia-500 text-white flex items-center justify-center transition-all hover:scale-105 active:scale-95 shadow-md shadow-fuchsia-900/30 cursor-pointer">
                            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Room Type Filter Tabs -->
                <div class="px-3 py-2 border-b border-zinc-800/80 bg-zinc-950/40 flex items-center gap-1.5 shrink-0">
                    <button type="button" @onclick='() => _roomFilter = "all"' 
                            class="px-2.5 py-1 rounded-lg text-xs font-medium transition-colors cursor-pointer @(_roomFilter == "all" ? "bg-zinc-800 text-white shadow-xs" : "text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900")">
                        All (@_rooms.Count)
                    </button>
                    <button type="button" @onclick='() => _roomFilter = "direct"' 
                            class="px-2.5 py-1 rounded-lg text-xs font-medium transition-colors cursor-pointer @(_roomFilter == "direct" ? "bg-zinc-800 text-white shadow-xs" : "text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900")">
                        Direct (@_rooms.Count(r => r.Type == 0))
                    </button>
                    <button type="button" @onclick='() => _roomFilter = "group"' 
                            class="px-2.5 py-1 rounded-lg text-xs font-medium transition-colors cursor-pointer @(_roomFilter == "group" ? "bg-fuchsia-950/40 text-fuchsia-300 border border-fuchsia-500/30 shadow-xs" : "text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900")">
                        Groups (@_rooms.Count(r => r.Type == 1))
                    </button>
                </div>

                <!-- New Message / Create Group Modal View -->
                @if (_showNewMessage)
                {
                    <div class="absolute inset-0 bg-zinc-950 z-20 flex flex-col animate-fade-in">
                        <!-- Modal Header -->
                        <div class="p-3 border-b border-zinc-800 bg-zinc-900 flex items-center justify-between shrink-0">
                            <div class="flex items-center gap-2">
                                <button type="button" @onclick="() => _showNewMessage = false" class="size-8 rounded-full hover:bg-zinc-800 text-zinc-400 hover:text-white flex items-center justify-center transition-colors cursor-pointer">
                                    <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                                </button>
                                <h4 class="font-bold text-white text-sm">
                                    @(_newChatTab == "group" ? "Create Group Chat" : "New Direct Message")
                                </h4>
                            </div>
                            
                            <!-- Toggle Tab Switcher -->
                            <div class="flex rounded-lg bg-zinc-950 p-0.5 border border-zinc-800">
                                <button type="button" @onclick='() => _newChatTab = "direct"' 
                                        class="px-2.5 py-1 rounded-md text-[11px] font-semibold transition-all cursor-pointer @(_newChatTab == "direct" ? "bg-zinc-800 text-white shadow-xs" : "text-zinc-400 hover:text-zinc-200")">
                                    Direct
                                </button>
                                <button type="button" @onclick='() => _newChatTab = "group"' 
                                        class="px-2.5 py-1 rounded-md text-[11px] font-semibold transition-all cursor-pointer @(_newChatTab == "group" ? "bg-fuchsia-600 text-white shadow-xs" : "text-zinc-400 hover:text-zinc-200")">
                                    Group
                                </button>
                            </div>
                        </div>

                        @if (_newChatTab == "direct")
                        {
                            <!-- Direct Message View -->
                            <div class="p-3 border-b border-zinc-800 shrink-0 space-y-2">
                                <input type="text" @bind="_userSearchQuery" @bind:event="oninput" 
                                       placeholder="Search colleagues..." 
                                       class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-3.5 py-2 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-fuchsia-500 transition-colors" />

                                <!-- Quick button to switch to group -->
                                <button type="button" @onclick='() => _newChatTab = "group"' 
                                        class="w-full py-2 px-3 rounded-xl bg-fuchsia-950/20 border border-fuchsia-500/20 text-fuchsia-300 hover:bg-fuchsia-950/40 text-xs font-semibold flex items-center justify-between transition-colors cursor-pointer">
                                    <span class="flex items-center gap-2">
                                        <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                                        <span>Create a Group Chat instead</span>
                                    </span>
                                    <span class="text-fuchsia-400">→</span>
                                </button>
                            </div>

                            <div class="flex-1 overflow-y-auto custom-scrollbar p-2">
                                @if (!_filteredUsers.Any())
                                {
                                    <div class="text-center py-8 text-zinc-500 text-xs">
                                        No colleagues found.
                                    </div>
                                }
                                else
                                {
                                    @foreach (var user in _filteredUsers)
                                    {
                                        <div @onclick="() => StartDirectMessage(user.Id)" 
                                             class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-zinc-900 cursor-pointer transition-colors group">
                                            <div class="size-9 rounded-full bg-zinc-800 flex items-center justify-center overflow-hidden border border-zinc-700 shrink-0">
                                                @if (!string.IsNullOrEmpty(user.ProfilePictureUrl))
                                                {
                                                    <img src="@(Configuration["ApiBaseUrl"] + user.ProfilePictureUrl)" class="w-full h-full object-cover" />
                                                }
                                                else
                                                {
                                                    <span class="text-xs font-bold text-zinc-400">@(user.FirstName?.FirstOrDefault() ?? '?')</span>
                                                }
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <p class="text-xs font-semibold text-white group-hover:text-fuchsia-300 transition-colors truncate">@user.FirstName @user.LastName</p>
                                                <p class="text-[10px] text-zinc-500">Click to start conversation</p>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <!-- Group Chat Creation View -->
                            <div class="p-3 border-b border-zinc-800 bg-zinc-900/40 shrink-0 space-y-3">
                                <div class="flex items-center gap-3">
                                    <div class="relative shrink-0">
                                        <label for="new-group-pic" title="Set group picture"
                                               class="size-12 rounded-2xl bg-zinc-900 border border-zinc-800 hover:border-fuchsia-500/50 flex flex-col items-center justify-center overflow-hidden transition-all cursor-pointer group/pic relative">
                                            @if (!string.IsNullOrEmpty(_newGroupPictureDataUrl))
                                            {
                                                <img src="@_newGroupPictureDataUrl" class="w-full h-full object-cover" />
                                            }
                                            else
                                            {
                                                <svg class="size-5 text-zinc-400 group-hover/pic:text-fuchsia-400 mb-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                                                </svg>
                                                <span class="text-[8px] text-zinc-500 font-semibold group-hover/pic:text-fuchsia-300">Photo</span>
                                            }
                                        </label>
                                        <InputFile id="new-group-pic" OnChange="HandleNewGroupPictureSelected" class="hidden" accept="image/png,image/jpeg,image/webp,image/gif" />
                                        @if (!string.IsNullOrEmpty(_newGroupPictureDataUrl))
                                        {
                                            <button type="button" @onclick="ClearNewGroupPicture" title="Remove selected photo"
                                                    class="absolute -top-1.5 -right-1.5 size-4 rounded-full bg-zinc-800 text-zinc-300 hover:text-white flex items-center justify-center border border-zinc-600 cursor-pointer shadow">
                                                <svg class="size-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                                            </button>
                                        }
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <label class="block text-[11px] font-semibold text-zinc-300 mb-1">Group Name</label>
                                        <input type="text" @bind="_newGroupName" @bind:event="oninput" 
                                               placeholder="e.g. Design Team, Project Alpha..." 
                                               class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-2 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-fuchsia-500 transition-colors" />
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(_createGroupError))
                                {
                                    <div class="p-2 rounded-lg bg-red-950/50 border border-red-900/60 text-red-300 text-[11px] flex items-center gap-1.5">
                                        <svg class="size-3.5 shrink-0 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                        <span>@_createGroupError</span>
                                    </div>
                                }

                                <!-- Selected Members Chips -->
                                <div>
                                    <div class="flex items-center justify-between mb-1">
                                        <label class="block text-[11px] font-semibold text-zinc-300">
                                            Members (@_selectedMemberIds.Count selected)
                                        </label>
                                        @if (_selectedMemberIds.Any())
                                        {
                                            <button type="button" @onclick="() => _selectedMemberIds.Clear()" class="text-[10px] text-zinc-400 hover:text-zinc-200 cursor-pointer">
                                                Clear all
                                            </button>
                                        }
                                    </div>

                                    @if (_selectedMemberIds.Any())
                                    {
                                        <div class="flex flex-wrap gap-1.5 max-h-20 overflow-y-auto custom-scrollbar p-1.5 bg-zinc-950/60 rounded-xl border border-zinc-800/80">
                                            @foreach (var memberId in _selectedMemberIds)
                                            {
                                                var member = _allUsers.FirstOrDefault(u => u.Id == memberId);
                                                if (member != null)
                                                {
                                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-fuchsia-950/60 border border-fuchsia-500/30 text-[10px] text-fuchsia-200">
                                                        <span>@member.FirstName @member.LastName</span>
                                                        <button type="button" @onclick="() => ToggleGroupMember(memberId)" class="hover:text-white cursor-pointer ml-0.5 font-bold">×</button>
                                                    </span>
                                                }
                                            }
                                        </div>
                                    }

                                    <!-- Candidate Filter Search -->
                                    <input type="text" @bind="_groupSearchQuery" @bind:event="oninput" 
                                           placeholder="Search colleagues to add..." 
                                           class="w-full mt-2 bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-1.5 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-fuchsia-500 transition-colors" />
                                </div>
                            </div>

                            <!-- Colleagues Selection Checkbox List -->
                            <div class="flex-1 overflow-y-auto custom-scrollbar p-2">
                                @if (!_filteredGroupCandidates.Any())
                                {
                                    <div class="text-center py-6 text-zinc-500 text-xs">
                                        No colleagues found.
                                    </div>
                                }
                                else
                                {
                                    @foreach (var user in _filteredGroupCandidates)
                                    {
                                        var isSelected = _selectedMemberIds.Contains(user.Id);
                                        <div @onclick="() => ToggleGroupMember(user.Id)" 
                                             class="flex items-center justify-between p-2 rounded-xl hover:bg-zinc-900 cursor-pointer transition-colors @(isSelected ? "bg-fuchsia-950/20 border border-fuchsia-500/20" : "")">
                                            <div class="flex items-center gap-2.5 min-w-0">
                                                <div class="size-8 rounded-full bg-zinc-800 flex items-center justify-center overflow-hidden border border-zinc-700 shrink-0">
                                                    @if (!string.IsNullOrEmpty(user.ProfilePictureUrl))
                                                    {
                                                        <img src="@(Configuration["ApiBaseUrl"] + user.ProfilePictureUrl)" class="w-full h-full object-cover" />
                                                    }
                                                    else
                                                    {
                                                        <span class="text-xs font-bold text-zinc-400">@(user.FirstName?.FirstOrDefault() ?? '?')</span>
                                                    }
                                                </div>
                                                <p class="text-xs font-medium text-white truncate">@user.FirstName @user.LastName</p>
                                            </div>

                                            <div class="size-5 rounded-md border flex items-center justify-center transition-colors @(isSelected ? "bg-fuchsia-600 border-fuchsia-500 text-white" : "border-zinc-700 bg-zinc-900")">
                                                @if (isSelected)
                                                {
                                                    <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                            </div>

                            <!-- Footer Action Button -->
                            <div class="p-3 bg-zinc-900 border-t border-zinc-800 shrink-0 flex gap-2">
                                <button type="button" @onclick="() => _showNewMessage = false" 
                                        class="flex-1 py-2 px-3 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-xs font-semibold text-zinc-300 hover:text-white transition-colors cursor-pointer">
                                    Cancel
                                </button>
                                <button type="button" @onclick="CreateGroupChat" 
                                        disabled="@(string.IsNullOrWhiteSpace(_newGroupName) || !_selectedMemberIds.Any() || _isCreatingGroup)"
                                        class="flex-1 py-2 px-3 rounded-xl bg-fuchsia-600 hover:bg-fuchsia-500 disabled:opacity-50 disabled:cursor-not-allowed text-xs font-semibold text-white transition-all shadow-md shadow-fuchsia-900/30 flex items-center justify-center gap-1.5 cursor-pointer">
                                    @if (_isCreatingGroup)
                                    {
                                        <div class="animate-spin size-3.5 border-2 border-white/20 border-t-white rounded-full"></div>
                                        <span>Creating...</span>
                                    }
                                    else
                                    {
                                        <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                                        <span>Create Group</span>
                                    }
                                </button>
                            </div>
                        }
                    </div>
                }

                <!-- Rooms List Content -->
                <div class="flex-1 overflow-y-auto custom-scrollbar p-2">
                    @if (_isLoadingRooms)
                    {
                        <div class="flex justify-center p-8">
                            <div class="animate-spin size-6 border-2 border-zinc-800 border-t-fuchsia-600 rounded-full"></div>
                        </div>
                    }
                    else if (!_filteredRooms.Any())
                    {
                        <div class="flex flex-col items-center justify-center h-full text-center p-6 text-zinc-500">
                            <div class="size-14 rounded-2xl bg-zinc-900/80 border border-zinc-800 flex items-center justify-center mb-3">
                                <svg class="size-7 opacity-30 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                                </svg>
                            </div>
                            <p class="text-xs font-semibold text-zinc-400">No conversations here</p>
                            <p class="text-[11px] mt-1 text-zinc-500">Start a direct message or create a group chat!</p>
                            <div class="mt-4 flex gap-2">
                                <button type="button" @onclick="OpenNewDirectMessage" class="px-3 py-1.5 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-xs font-medium text-white transition-colors cursor-pointer">
                                    Direct Message
                                </button>
                                <button type="button" @onclick="OpenNewGroupChat" class="px-3 py-1.5 rounded-lg bg-fuchsia-600 hover:bg-fuchsia-500 text-xs font-medium text-white transition-colors cursor-pointer">
                                    New Group
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        @foreach (var room in _filteredRooms.OrderByDescending(r => _pinnedRoomIds.Contains(r.Id)).ThenByDescending(r => r.LastMessage?.CreatedAt))
                        {
                            <div @onclick="() => OpenRoom(room)" class="w-full flex items-center gap-3 p-2.5 rounded-xl hover:bg-zinc-900 cursor-pointer transition-colors group">
                                <div class="relative shrink-0">
                                    @if (room.Type == 0) // Direct Message
                                    {
                                        var otherMember = room.Members.FirstOrDefault(m => m.UserId != _currentEmployeeId);
                                        <div class="size-11 rounded-full bg-zinc-800 flex items-center justify-center overflow-hidden border border-zinc-700">
                                            @if (otherMember != null && !string.IsNullOrEmpty(otherMember.ProfilePictureUrl))
                                            {
                                                <img src="@(Configuration["ApiBaseUrl"] + otherMember.ProfilePictureUrl)" class="w-full h-full object-cover" />
                                            }
                                            else
                                            {
                                                <span class="font-bold text-zinc-400 text-sm">@(otherMember?.FirstName?.FirstOrDefault() ?? '?')</span>
                                            }
                                        </div>
                                    }
                                    else // Group Chat
                                    {
                                        if (!string.IsNullOrEmpty(room.PictureUrl))
                                        {
                                            <img src="@(Configuration["ApiBaseUrl"] + room.PictureUrl)" class="size-11 rounded-2xl object-cover ring-1 ring-fuchsia-500/30 shadow-md shadow-fuchsia-950/20" />
                                        }
                                        else
                                        {
                                            <div class="size-11 rounded-2xl bg-gradient-to-br from-fuchsia-600 to-violet-700 flex items-center justify-center shadow-md shadow-fuchsia-900/30 text-white font-bold text-xs border border-fuchsia-400/30">
                                                @GetGroupInitials(room.Name)
                                            </div>
                                        }
                                        <div class="absolute -bottom-1 -right-1 px-1 rounded-full bg-zinc-900 border border-zinc-700 text-[9px] font-semibold text-zinc-300">
                                            @room.Members.Count
                                        </div>
                                    }

                                    @if (room.UnreadCount > 0)
                                    {
                                        <div class="absolute -top-1 -right-1 size-5 rounded-full bg-fuchsia-600 border-2 border-zinc-950 flex items-center justify-center">
                                            <span class="text-[9px] font-bold text-white">@room.UnreadCount</span>
                                        </div>
                                    }
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-baseline justify-between mb-0.5">
                                        <h4 class="font-semibold text-xs text-zinc-100 truncate pr-2 flex items-center gap-1.5">
                                            @if (room.Type == 0)
                                            {
                                                var otherMember = room.Members.FirstOrDefault(m => m.UserId != _currentEmployeeId);
                                                <span>@(otherMember?.FirstName) @(otherMember?.LastName)</span>
                                            }
                                            else
                                            {
                                                <span class="truncate">@room.Name</span>
                                                <span class="px-1.5 py-0.2 rounded bg-fuchsia-500/10 text-fuchsia-400 text-[9px] font-medium border border-fuchsia-500/20">Group</span>
                                            }
                                        </h4>
                                        <div class="flex items-center gap-1 shrink-0">
                                            <button type="button" @onclick="() => TogglePin(room.Id)" @onclick:stopPropagation 
                                                    class="size-5 rounded hover:bg-zinc-800 flex items-center justify-center transition-colors @(_pinnedRoomIds.Contains(room.Id) ? "opacity-100 text-amber-400" : "opacity-0 group-hover:opacity-100 text-zinc-500 hover:text-zinc-300")" title="@(_pinnedRoomIds.Contains(room.Id) ? "Unpin chat" : "Pin chat")">
                                                <svg class="size-3.5" fill="currentColor" viewBox="0 0 32 32"><path d="M19 16V6h2V4H11v2h2v10l-3 4v2h5v8h2v-8h5v-2l-3-4z"/></svg>
                                            </button>
                                            <span class="text-[10px] font-medium text-zinc-500">
                                                @(room.LastMessage?.CreatedAt.ToLocalTime().ToString("MMM dd"))
                                            </span>
                                        </div>
                                    </div>
                                    <p class="text-xs text-zinc-400 truncate @(room.UnreadCount > 0 ? "font-semibold text-white" : "")">
                                        @if (room.Type == 1 && room.LastMessage != null)
                                        {
                                            <span class="text-zinc-500 font-medium">
                                                @(room.LastMessage.SenderId == _currentEmployeeId ? "You: " : $"{room.LastMessage.SenderName?.Split(' ').FirstOrDefault()}: ")
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(room.LastMessage?.Content))
                                        {
                                            <span>@GetPreviewText(room.LastMessage.Content)</span>
                                        }
                                        else if (!string.IsNullOrEmpty(room.LastMessage?.AttachmentUrl))
                                        {
                                            <span class="inline-flex items-center gap-1 text-fuchsia-400">
                                                <svg class="size-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" /></svg>
                                                <span>@(room.LastMessage.AttachmentName ?? "Attachment")</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span>No messages yet</span>
                                        }
                                    </p>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
            else
            {
                <!-- Active Chat View -->
                <div class="p-3 border-b border-zinc-800 bg-zinc-900 flex items-center justify-between shrink-0">
                    <div class="flex items-center gap-2.5 min-w-0 flex-1">
                        <button type="button" @onclick="CloseRoom" class="size-8 rounded-full hover:bg-zinc-800 text-zinc-400 hover:text-white flex items-center justify-center transition-colors cursor-pointer shrink-0">
                            <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                        </button>
                        
                        <div class="relative shrink-0">
                            @if (_activeRoom.Type == 0)
                            {
                                var otherMember = _activeRoom.Members.FirstOrDefault(m => m.UserId != _currentEmployeeId);
                                <div class="size-8 rounded-full bg-zinc-800 flex items-center justify-center overflow-hidden border border-zinc-700">
                                    @if (otherMember != null && !string.IsNullOrEmpty(otherMember.ProfilePictureUrl))
                                    {
                                        <img src="@(Configuration["ApiBaseUrl"] + otherMember.ProfilePictureUrl)" class="w-full h-full object-cover" />
                                    }
                                    else
                                    {
                                        <span class="font-bold text-zinc-400 text-xs">@(otherMember?.FirstName?.FirstOrDefault() ?? '?')</span>
                                    }
                                </div>
                            }
                            else
                            {
                                if (!string.IsNullOrEmpty(_activeRoom.PictureUrl))
                                {
                                    <img src="@(Configuration["ApiBaseUrl"] + _activeRoom.PictureUrl)" class="size-8 rounded-xl object-cover ring-1 ring-fuchsia-500/30 shadow-sm cursor-pointer" @onclick="ToggleGroupDetails" />
                                }
                                else
                                {
                                    <div @onclick="ToggleGroupDetails" class="size-8 rounded-xl bg-gradient-to-br from-fuchsia-600 to-violet-700 flex items-center justify-center text-white font-bold text-[10px] shadow-sm cursor-pointer border border-fuchsia-400/30">
                                        @GetGroupInitials(_activeRoom.Name)
                                    </div>
                                }
                            }
                        </div>
                        
                        <div class="flex-1 min-w-0">
                            <h4 class="font-bold text-white text-xs truncate">
                                @if (_activeRoom.Type == 0)
                                {
                                    var otherMember = _activeRoom.Members.FirstOrDefault(m => m.UserId != _currentEmployeeId);
                                    <text>@(otherMember?.FirstName) @(otherMember?.LastName)</text>
                                }
                                else
                                {
                                    @_activeRoom.Name
                                }
                            </h4>
                            <p class="text-[10px] text-zinc-400 truncate">
                                @if (_activeRoom.Type == 0)
                                {
                                    <span>Direct Message</span>
                                }
                                else
                                {
                                    <span>@_activeRoom.Members.Count members: @string.Join(", ", _activeRoom.Members.Select(m => m.UserId == _currentEmployeeId ? "You" : m.FirstName))</span>
                                }
                            </p>
                        </div>
                    </div>

                    <!-- Search & Info Buttons -->
                    <div class="flex items-center gap-1.5 shrink-0">
                        <button type="button" @onclick="() => _showChatSearch = !_showChatSearch" title="Search Chat"
                                class="size-8 rounded-lg hover:bg-zinc-800 text-zinc-400 hover:text-white flex items-center justify-center transition-colors cursor-pointer shrink-0 @(_showChatSearch ? "bg-zinc-800 text-fuchsia-400" : "")">
                            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                        </button>
                        <button type="button" @onclick="ToggleGroupDetails" title="Chat Info"
                                class="size-8 rounded-lg hover:bg-zinc-800 text-zinc-400 hover:text-white flex items-center justify-center transition-colors cursor-pointer shrink-0 @(_showGroupDetails ? "bg-zinc-800 text-fuchsia-400" : "")">
                            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </button>
                    </div>
                </div>

                @if (_showChatSearch)
                {
                    <div class="px-3 py-2 bg-zinc-900 border-b border-zinc-800 shrink-0 shadow-sm z-10">
                        <input type="text" @bind="_chatSearchQuery" @bind:event="oninput" 
                               placeholder="Search messages in this chat..." 
                               class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-2.5 py-1.5 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-fuchsia-500 transition-colors" />
                    </div>
                }

                <!-- Group Details Side/Overlay Drawer -->
                @if (_showGroupDetails && _activeRoom != null)
                {
                    <div class="absolute inset-x-0 top-[57px] bottom-0 bg-zinc-950/95 backdrop-blur-md z-30 flex flex-col p-4 animate-fade-in custom-scrollbar overflow-y-auto">
                        <!-- Drawer Header Bar -->
                        <div class="flex items-center justify-between pb-3 mb-3 border-b border-zinc-800 shrink-0">
                            <div class="flex items-center gap-2">
                                <div class="size-2 rounded-full bg-fuchsia-500"></div>
                                <span class="text-xs font-bold text-white uppercase tracking-wider">@(_activeRoom.Type == 1 ? "Group Info" : "Chat Info")</span>
                            </div>
                            <button type="button" @onclick="ToggleGroupDetails" class="size-7 rounded-lg bg-zinc-900 hover:bg-zinc-800 text-zinc-400 hover:text-white flex items-center justify-center cursor-pointer transition-colors border border-zinc-800" title="Close">
                                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </button>
                        </div>

                        <!-- Group Header & Avatar Card -->
                        <div class="flex flex-col items-center justify-center py-4 bg-zinc-900/50 rounded-2xl p-4 mb-3 border border-zinc-800/80 shadow-sm">
                            @if (_activeRoom.Type == 0)
                            {
                                var otherMember = _activeRoom.Members.FirstOrDefault(m => m.UserId != _currentEmployeeId);
                                <div class="size-20 rounded-2xl bg-zinc-800 flex items-center justify-center overflow-hidden border border-zinc-700 shadow-xl shadow-zinc-950/40 ring-2 ring-zinc-700/40 mb-2.5">
                                    @if (otherMember != null && !string.IsNullOrEmpty(otherMember.ProfilePictureUrl))
                                    {
                                        <img src="@(Configuration["ApiBaseUrl"] + otherMember.ProfilePictureUrl)" class="w-full h-full object-cover" />
                                    }
                                    else
                                    {
                                        <span class="font-bold text-zinc-400 text-3xl">@(otherMember?.FirstName?.FirstOrDefault() ?? '?')</span>
                                    }
                                </div>
                                <h4 class="font-bold text-base text-white text-center mt-1">@(otherMember?.FirstName) @(otherMember?.LastName)</h4>
                                <p class="text-xs text-zinc-400 text-center">Direct Message</p>
                            }
                            else
                            {
                                <div class="relative mb-2.5">
                                @if (!string.IsNullOrEmpty(_activeRoom.PictureUrl))
                                {
                                    <img src="@(Configuration["ApiBaseUrl"] + _activeRoom.PictureUrl)" class="size-20 rounded-2xl object-cover ring-2 ring-fuchsia-500/40 shadow-xl shadow-fuchsia-950/40" />
                                }
                                else
                                {
                                    <div class="size-20 rounded-2xl bg-gradient-to-br from-fuchsia-600 via-purple-600 to-violet-700 flex items-center justify-center text-white font-black text-2xl shadow-xl shadow-fuchsia-950/40 border border-fuchsia-400/30">
                                        @GetGroupInitials(_activeRoom.Name)
                                    </div>
                                }

                                <!-- Floating quick camera badge on bottom-right -->
                                <label for="active-group-pic-upload" class="absolute -bottom-1 -right-1 size-7 rounded-full bg-fuchsia-600 hover:bg-fuchsia-500 text-white flex items-center justify-center shadow-lg border-2 border-zinc-950 cursor-pointer transition-transform hover:scale-105" title="Change group photo">
                                    <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                                    </svg>
                                </label>
                            </div>
                            <InputFile id="active-group-pic-upload" OnChange="HandleGroupPictureUpload" class="hidden" accept="image/png,image/jpeg,image/webp,image/gif" />

                            <h4 class="font-bold text-base text-white text-center mt-1">@_activeRoom.Name</h4>
                            <p class="text-xs text-zinc-400 text-center">@_activeRoom.Members.Count members</p>

                            @if (_isUploadingGroupPicture)
                            {
                                <div class="flex items-center gap-1.5 text-xs text-fuchsia-400 font-medium py-1 mt-2 animate-pulse">
                                    <div class="animate-spin size-3.5 border-2 border-fuchsia-400 border-t-transparent rounded-full"></div>
                                    <span>Uploading photo...</span>
                                </div>
                            }
                            else
                            {
                                <div class="flex items-center gap-2 mt-2.5">
                                    <label for="active-group-pic-upload" class="px-2.5 py-1 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-fuchsia-300 hover:text-white text-[11px] font-medium transition-colors cursor-pointer border border-zinc-700/60 flex items-center gap-1.5">
                                        <svg class="size-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                                        </svg>
                                        <span>Change Photo</span>
                                    </label>
                                    @if (!string.IsNullOrEmpty(_activeRoom.PictureUrl))
                                    {
                                        <button type="button" @onclick="RemoveGroupPicture" disabled="@_isRemovingGroupPicture" class="px-2.5 py-1 rounded-lg bg-red-950/40 hover:bg-red-900/50 text-red-400 hover:text-red-300 text-[11px] font-medium transition-colors cursor-pointer border border-red-800/40">
                                            @(_isRemovingGroupPicture ? "..." : "Remove")
                                        </button>
                                    }
                                </div>
                            }
                        }
                        </div>

                        <!-- Shared Media/Files -->
                        <div class="py-3 border-b border-zinc-800">

                            <div class="space-y-1.5">
                                <label class="block text-xs font-semibold text-zinc-200">Shared Media & Files</label>
                                @{
                                    var attachedFiles = _messages.Where(m => !string.IsNullOrEmpty(m.AttachmentUrl)).OrderByDescending(m => m.CreatedAt).ToList();
                                }
                                @if (!attachedFiles.Any())
                                {
                                    <p class="text-[11px] text-zinc-500 text-center py-2">No files or media shared yet.</p>
                                }
                                else
                                {
                                    <div class="flex flex-col gap-1.5 max-h-32 overflow-y-auto custom-scrollbar">
                                        @foreach (var file in attachedFiles)
                                        {
                                            bool isImg = IsImageAttachment(file.AttachmentUrl);
                                            <div class="flex items-center gap-2.5 p-1.5 rounded-lg hover:bg-zinc-800 cursor-pointer transition-colors" @onclick="() => OpenAttachmentViewer(file)">
                                                <div class="size-8 rounded border border-zinc-700 bg-zinc-900 shrink-0 overflow-hidden flex items-center justify-center text-zinc-400">
                                                    @if (isImg)
                                                    {
                                                        <img src="@(MediaUrlHelper.Resolve(file.AttachmentUrl, Configuration))" class="w-full h-full object-cover" />
                                                    }
                                                    else
                                                    {
                                                        <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" /></svg>
                                                    }
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <p class="text-xs text-white truncate font-medium">@(file.AttachmentName ?? "File")</p>
                                                    <p class="text-[9px] text-zinc-500">@file.CreatedAt.ToLocalTime().ToString("MMM dd")</p>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        @if (_activeRoom.Type == 1)
                        {
                            <!-- Add Member Section -->
                            <div class="py-3 border-b border-zinc-800">
                            <div class="flex items-center justify-between gap-2 mb-2.5">
                                <span class="text-xs font-semibold text-zinc-200">Group Members</span>
                                <button type="button" @onclick="() => _showAddMembers = !_showAddMembers" 
                                        class="px-2.5 py-1 rounded-lg bg-fuchsia-950/60 hover:bg-fuchsia-900/60 text-fuchsia-300 hover:text-fuchsia-200 border border-fuchsia-800/50 text-[11px] font-semibold flex items-center gap-1 transition-all cursor-pointer shrink-0">
                                    <svg class="size-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                                    <span>Add Colleagues</span>
                                </button>
                            </div>

                            @if (_showAddMembers)
                            {
                                <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-3 mb-3 space-y-2">
                                    <input type="text" @bind="_addMemberSearchQuery" @bind:event="oninput" 
                                           placeholder="Search colleagues to add..." 
                                           class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-2.5 py-1.5 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-fuchsia-500 transition-colors" />

                                    <div class="max-h-36 overflow-y-auto custom-scrollbar space-y-1">
                                        @if (!_availableMembersToAdd.Any())
                                        {
                                            <p class="text-[11px] text-zinc-500 text-center py-2">All colleagues are already in this group.</p>
                                        }
                                        else
                                        {
                                            @foreach (var user in _availableMembersToAdd)
                                            {
                                                var isSelected = _selectedAddMemberIds.Contains(user.Id);
                                                <div @onclick="() => ToggleAddMemberCandidate(user.Id)" 
                                                     class="flex items-center justify-between p-1.5 rounded-lg hover:bg-zinc-800 cursor-pointer @(isSelected ? "bg-fuchsia-950/40 text-fuchsia-200" : "")">
                                                    <span class="text-xs">@user.FirstName @user.LastName</span>
                                                    <input type="checkbox" checked="@isSelected" class="rounded text-fuchsia-600 focus:ring-0" />
                                                </div>
                                            }
                                        }
                                    </div>

                                    @if (_selectedAddMemberIds.Any())
                                    {
                                        <button type="button" @onclick="AddMembersToActiveGroup" disabled="@_isAddingMembers" 
                                                class="w-full py-1.5 rounded-lg bg-fuchsia-600 hover:bg-fuchsia-500 text-white text-xs font-semibold transition-all cursor-pointer">
                                            @(_isAddingMembers ? "Adding..." : $"Add {_selectedAddMemberIds.Count} Member(s)")
                                        </button>
                                    }
                                </div>
                            }

                            <!-- Members List -->
                            <div class="space-y-1.5 max-h-48 overflow-y-auto custom-scrollbar">
                                @foreach (var member in _activeRoom.Members)
                                {
                                    <div class="flex items-center justify-between p-2 rounded-xl bg-zinc-900/60 border border-zinc-800/80">
                                        <div class="flex items-center gap-2.5 min-w-0">
                                            <div class="size-7 rounded-full bg-zinc-800 flex items-center justify-center overflow-hidden border border-zinc-700 shrink-0">
                                                @if (!string.IsNullOrEmpty(member.ProfilePictureUrl))
                                                {
                                                    <img src="@(Configuration["ApiBaseUrl"] + member.ProfilePictureUrl)" class="w-full h-full object-cover" />
                                                }
                                                else
                                                {
                                                    <span class="text-[10px] font-bold text-zinc-400">@(member.FirstName?.FirstOrDefault() ?? '?')</span>
                                                }
                                            </div>
                                            <span class="text-xs font-medium text-white truncate">
                                                @member.FirstName @member.LastName
                                                @if (member.UserId == _currentEmployeeId)
                                                {
                                                    <span class="text-zinc-500 text-[10px] font-normal ml-1">(You)</span>
                                                }
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                            <!-- Leave Group Option -->
                            <div class="mt-auto pt-4">
                                <button type="button" @onclick="LeaveActiveGroup" disabled="@_isLeavingGroup"
                                        class="w-full py-2 px-3 rounded-xl bg-red-950/30 border border-red-900/50 hover:bg-red-950/60 text-red-400 text-xs font-semibold transition-colors flex items-center justify-center gap-2 cursor-pointer">
                                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
                                    <span>@(_isLeavingGroup ? "Leaving group..." : "Leave Group Chat")</span>
                                </button>
                            </div>
                        }
                    </div>
                }

                <!-- Messages Area -->
                <div class="flex-1 overflow-y-auto custom-scrollbar p-4 space-y-4 flex flex-col-reverse" id="chat-messages-container">
                    @if (_isLoadingMessages)
                    {
                        <div class="flex justify-center p-4">
                            <div class="animate-spin size-5 border-2 border-zinc-800 border-t-fuchsia-600 rounded-full"></div>
                        </div>
                    }

                    <div class="space-y-4 flex flex-col">
                        @{
                            var displayMessages = string.IsNullOrWhiteSpace(_chatSearchQuery) 
                                ? _messages 
                                : _messages.Where(m => (!string.IsNullOrEmpty(m.Content) && m.Content.Contains(_chatSearchQuery, StringComparison.OrdinalIgnoreCase)) || 
                                                       (!string.IsNullOrEmpty(m.AttachmentName) && m.AttachmentName.Contains(_chatSearchQuery, StringComparison.OrdinalIgnoreCase))).ToList();
                        }
                        @if (!displayMessages.Any() && !string.IsNullOrWhiteSpace(_chatSearchQuery))
                        {
                            <div class="text-center py-8 text-zinc-500 text-xs">No messages match your search.</div>
                        }
                        @foreach (var msg in displayMessages.DistinctBy(m => m.Id).OrderBy(m => m.CreatedAt))
                        {
                            bool isMine = msg.SenderId == _currentEmployeeId;
                            bool hasAttachment = !string.IsNullOrEmpty(msg.AttachmentUrl);
                            bool isAttachmentImg = hasAttachment && IsImageAttachment(msg.AttachmentUrl);
                            bool isAttachmentPdf = hasAttachment && IsPdfAttachment(msg.AttachmentUrl);

                            <div class="flex gap-2 w-full @(isMine ? "justify-end" : "justify-start")">
                                @if (!isMine)
                                {
                                    <div class="size-6 rounded-full bg-zinc-800 shrink-0 overflow-hidden self-end mb-1 border border-zinc-700">
                                        @if (!string.IsNullOrEmpty(msg.ProfilePictureUrl))
                                        {
                                            <img src="@(MediaUrlHelper.Resolve(msg.ProfilePictureUrl, Configuration))" class="w-full h-full object-cover" />
                                        }
                                        else
                                        {
                                            <div class="w-full h-full flex items-center justify-center">
                                                <span class="text-[9px] font-bold text-zinc-400">@(msg.SenderName?.FirstOrDefault() ?? '?')</span>
                                            </div>
                                        }
                                    </div>
                                }
                                
                                <div class="max-w-[78%] flex flex-col @(isMine ? "items-end" : "items-start")">
                                    @if (!isMine && _activeRoom?.Type == 1)
                                    {
                                        <!-- In group chat, show sender's name above message -->
                                        <span class="text-[10px] font-semibold text-fuchsia-400 mb-0.5 ml-1">@msg.SenderName</span>
                                    }

                                    <div class="flex flex-col gap-1.5 @(isMine ? "items-end" : "items-start")">
                                        @if (hasAttachment)
                                        {
                                            <div class="rounded-2xl overflow-hidden border transition-all cursor-pointer @(isMine ? "bg-fuchsia-700/80 border-fuchsia-500/50 hover:border-fuchsia-400 shadow-md shadow-fuchsia-950/40" : "bg-zinc-800/90 border-zinc-700/70 hover:border-zinc-500 shadow-sm")"
                                                 @onclick="() => OpenAttachmentViewer(msg)">
                                                @if (isAttachmentImg)
                                                {
                                                    <div class="relative group/att w-48 h-36 bg-zinc-950/50 flex items-center justify-center overflow-hidden">
                                                        <img src="@(MediaUrlHelper.Resolve(msg.AttachmentUrl, Configuration))" class="w-full h-full object-cover group-hover/att:scale-105 transition-transform duration-300" />
                                                        <div class="absolute inset-0 bg-black/30 opacity-0 group-hover/att:opacity-100 transition-opacity flex items-center justify-center">
                                                            <span class="px-2 py-1 rounded-md bg-black/70 text-white text-[10px] font-semibold flex items-center gap-1 backdrop-blur-xs">
                                                                <svg class="size-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                                                <span>View</span>
                                                            </span>
                                                        </div>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(msg.AttachmentName))
                                                    {
                                                        <div class="px-2.5 py-1 text-[10px] text-zinc-300 truncate max-w-48 bg-zinc-900/60 flex items-center justify-between gap-1">
                                                            <span class="truncate">@msg.AttachmentName</span>
                                                            @if (msg.AttachmentSize.HasValue)
                                                            {
                                                                <span class="text-[9px] text-zinc-400 shrink-0">@FormatFileSize(msg.AttachmentSize.Value)</span>
                                                            }
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="p-2.5 flex items-center gap-2.5 max-w-56">
                                                        <div class="size-9 rounded-xl flex items-center justify-center shrink-0 @(isAttachmentPdf ? "bg-rose-500/20 text-rose-300 border border-rose-500/30" : "bg-zinc-700 text-zinc-300")">
                                                            @if (isAttachmentPdf)
                                                            {
                                                                <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                                                </svg>
                                                            }
                                                            else
                                                            {
                                                                <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                                                </svg>
                                                            }
                                                        </div>
                                                        <div class="flex-1 min-w-0">
                                                            <p class="text-xs font-semibold text-white truncate">@(msg.AttachmentName ?? "Document")</p>
                                                            <p class="text-[10px] text-zinc-400 flex items-center gap-1.5">
                                                                @if (msg.AttachmentSize.HasValue)
                                                                {
                                                                    <span>@FormatFileSize(msg.AttachmentSize.Value)</span>
                                                                    <span>•</span>
                                                                }
                                                                <span class="text-fuchsia-300 font-medium">Click to view</span>
                                                            </p>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(msg.Content))
                                        {
                                            <div class="px-3 py-2 text-xs rounded-2xl break-words whitespace-pre-wrap select-text @(isMine ? "bg-fuchsia-600 text-white rounded-br-xs shadow-md shadow-fuchsia-950/40" : "bg-zinc-800 text-zinc-100 rounded-bl-xs")">
                                                @FormatMessageContent(msg.Content, isMine)
                                            </div>
                                        }
                                    </div>
                                    <span class="text-[9px] text-zinc-500 mt-1 px-1">@msg.CreatedAt.ToLocalTime().ToString("h:mm tt")</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Input Area -->
                <div class="p-3 bg-zinc-900 border-t border-zinc-800 shrink-0 space-y-2">
                    @if (_isTyping)
                    {
                        <div class="text-[10px] text-zinc-400 px-2 italic flex items-center gap-1.5">
                            <span class="size-1.5 rounded-full bg-fuchsia-400 animate-ping"></span>
                            <span>@(_typingUserName ?? "Someone") is typing...</span>
                        </div>
                    }

                    <!-- Pending Attachment Preview Banner -->
                    @if (!string.IsNullOrEmpty(_pendingAttachmentUrl))
                    {
                        <div class="flex items-center justify-between p-2 rounded-xl bg-zinc-950 border border-zinc-800 shadow-sm animate-fade-in">
                            <div class="flex items-center gap-2.5 min-w-0">
                                @if (IsImageAttachment(_pendingAttachmentUrl))
                                {
                                    <div class="size-9 rounded-lg overflow-hidden shrink-0 border border-zinc-700 bg-zinc-900">
                                        <img src="@(MediaUrlHelper.Resolve(_pendingAttachmentUrl, Configuration))" class="w-full h-full object-cover" />
                                    </div>
                                }
                                else
                                {
                                    <div class="size-9 rounded-lg bg-zinc-800 text-fuchsia-400 flex items-center justify-center shrink-0 border border-zinc-700">
                                        <svg class="size-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                        </svg>
                                    </div>
                                }
                                <div class="min-w-0">
                                    <p class="text-xs font-semibold text-white truncate max-w-[180px]">@_pendingAttachmentName</p>
                                    @if (_pendingAttachmentSize.HasValue)
                                    {
                                        <p class="text-[10px] text-zinc-400">@FormatFileSize(_pendingAttachmentSize.Value)</p>
                                    }
                                </div>
                            </div>
                            <button type="button" @onclick="ClearPendingAttachment" title="Remove attachment"
                                    class="size-6 rounded-lg hover:bg-zinc-800 text-zinc-400 hover:text-white flex items-center justify-center transition-colors cursor-pointer">
                                <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                            </button>
                        </div>
                    }

                    <form @onsubmit="SendMessage" class="flex items-end gap-2">
                        <!-- Attachment Input & Button -->
                        <label for="chat-file-input" title="Attach image or document"
                               class="size-8.5 rounded-xl bg-zinc-800/90 hover:bg-zinc-700 text-zinc-400 hover:text-white flex items-center justify-center transition-colors shrink-0 cursor-pointer border border-zinc-700/60 mb-1 @(_isUploadingAttachment ? "pointer-events-none opacity-50" : "")">
                            @if (_isUploadingAttachment)
                            {
                                <div class="animate-spin size-3.5 border-2 border-fuchsia-400 border-t-transparent rounded-full"></div>
                            }
                            else
                            {
                                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
                                </svg>
                            }
                        </label>
                        <InputFile @key="_inputFileKey" id="chat-file-input" OnChange="HandleChatFileUpload" class="hidden" accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.txt" />

                        <div class="flex-1 relative flex flex-col">
                            <!-- Mention Autocomplete -->
                            @if (_showMentions && _mentionCandidates.Any())
                            {
                                <div class="absolute bottom-full left-0 mb-2 w-56 bg-zinc-900 border border-zinc-700 rounded-xl shadow-xl overflow-hidden z-50 flex flex-col max-h-48 custom-scrollbar overflow-y-auto">
                                    <div class="px-2.5 py-1.5 bg-zinc-800 text-[10px] font-semibold text-zinc-400">Mentions</div>
                                    @foreach(var user in _mentionCandidates)
                                    {
                                        <div class="px-3 py-2 text-xs text-zinc-300 hover:bg-zinc-800 hover:text-white cursor-pointer flex items-center gap-2 transition-colors" @onclick="() => InsertMention(user)">
                                            <div class="size-5 rounded-full bg-zinc-700 flex items-center justify-center overflow-hidden shrink-0">
                                                @if (!string.IsNullOrEmpty(user.ProfilePictureUrl))
                                                {
                                                    <img src="@(MediaUrlHelper.Resolve(user.ProfilePictureUrl, Configuration))" class="w-full h-full object-cover" />
                                                }
                                                else
                                                {
                                                    <span class="text-[8px] font-bold">@(user.FirstName?.FirstOrDefault() ?? '?')</span>
                                                }
                                            </div>
                                            <span class="truncate">@user.FirstName @user.LastName</span>
                                        </div>
                                    }
                                </div>
                            }
                            
                            <!-- Tag Autocomplete -->
                            @if (_showTags && _tagCandidates.Any())
                            {
                                <div class="absolute bottom-full left-0 mb-2 w-72 bg-zinc-900 border border-zinc-700 rounded-xl shadow-xl overflow-hidden z-50 flex flex-col max-h-56 custom-scrollbar overflow-y-auto">
                                    <div class="px-2.5 py-1.5 bg-zinc-800 text-[10px] font-semibold text-zinc-400">Boards & Tasks</div>
                                    @foreach(var tag in _tagCandidates)
                                    {
                                        <div class="px-3 py-2 text-xs text-zinc-300 hover:bg-zinc-800 hover:text-white cursor-pointer flex flex-col gap-0.5 transition-colors" @onclick="() => InsertTag(tag)">
                                            <div class="flex items-center gap-2">
                                                @if (tag.Type == "Board")
                                                {
                                                    <svg class="size-3.5 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" /></svg>
                                                    <span class="font-bold text-amber-400 truncate">@tag.Name</span>
                                                }
                                                else
                                                {
                                                    <svg class="size-3.5 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>
                                                    <span class="font-bold text-emerald-400 truncate">@tag.Name</span>
                                                }
                                            </div>
                                            @if (tag.Type == "Task" && !string.IsNullOrEmpty(tag.BoardName))
                                            {
                                                <span class="text-[10px] text-zinc-500 ml-5.5 truncate">in @tag.BoardName</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            
                            <textarea id="chat-input-textarea"
                                      @bind="_newMessageContent" @bind:event="oninput" 
                                      @onkeydown="HandleKeyDown" @onkeyup="HandleKeyUp"
                                      rows="3"
                                      placeholder="@(_activeRoom?.Type == 1 ? $"Message {_activeRoom?.Name}..." : "Type a message... (Shift+Enter for newline)")" 
                                      class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-fuchsia-500 transition-colors resize-none custom-scrollbar min-h-[72px] max-h-[130px] leading-relaxed"></textarea>
                        </div>

                        <button type="submit" disabled="@(string.IsNullOrWhiteSpace(_newMessageContent) && string.IsNullOrEmpty(_pendingAttachmentUrl))" 
                                class="size-8.5 rounded-xl bg-fuchsia-600 text-white flex items-center justify-center disabled:opacity-50 disabled:cursor-not-allowed hover:bg-fuchsia-500 transition-colors shrink-0 shadow-md shadow-fuchsia-900/30 cursor-pointer mb-1"
                                title="Send message (Enter)">
                            <svg class="size-3.5 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
                        </button>
                    </form>
                </div>
            }
        </div>
    }

    <!-- In-App Media Viewer Modal for Chat Attachments -->
    <MediaViewerModal @bind-IsOpen="_showMediaViewer"
                      FileUrl="@_selectedMediaUrl"
                      FileName="@_selectedMediaName"
                      Title="Chat Attachment" />

    <!-- Floating Bubble Button -->
    <button type="button" @onclick="ToggleChat" 
            class="size-14 rounded-full bg-fuchsia-600 text-white shadow-xl shadow-fuchsia-900/30 flex items-center justify-center hover:bg-fuchsia-500 hover:scale-105 active:scale-95 transition-all duration-300 relative group z-50 cursor-pointer">
        @if (_isOpen)
        {
            <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        }
        else
        {
            <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
            @if (_totalUnread > 0)
            {
                <span class="absolute -top-1 -right-1 size-5 rounded-full bg-red-500 border-2 border-zinc-950 flex items-center justify-center text-[10px] font-bold animate-pulse">@_totalUnread</span>
            }
        }
    </button>
</div>

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #3f3f46; border-radius: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #52525b; }
</style>

@code {
    private Dictionary<string, string> _draftMentions = new(StringComparer.OrdinalIgnoreCase);

    private bool _isOpen = false;
    private HubConnection? _hubConnection;
    private string _currentUserId = string.Empty;  // ApplicationUser.Id from claims
    private string _currentEmployeeId = string.Empty; // Employee.Id in current org

    private bool _isLoadingRooms = true;
    private List<ChatRoomDto> _rooms = new();
    private string _roomFilter = "all"; // "all", "direct", "group"
    private int _totalUnread => _rooms.Sum(r => r.UnreadCount);

    private ChatRoomDto? _activeRoom = null;
    private bool _isLoadingMessages = false;
    private List<ChatMessageDto> _messages = new();
    private string _chatSearchQuery = string.Empty;
    private bool _showChatSearch = false;
    private HashSet<Guid> _pinnedRoomIds = new();
    
    private HashSet<string> _myBoardIds = new();
    
    private string _newMessageContentValue = string.Empty;
    private string _newMessageContent 
    {
        get => _newMessageContentValue;
        set 
        {
            _newMessageContentValue = value;
            CheckForMentions(value);
        }
    }

    private bool _showMentions = false;
    private List<UserDto> _mentionCandidates = new();
    private string _currentMentionSearch = string.Empty;

    private bool _showTags = false;
    private List<SearchTagDto> _tagCandidates = new();
    private string _currentTagSearch = string.Empty;

    private void CheckForMentions(string text)
    {
        if (string.IsNullOrEmpty(text))
        {
            _showMentions = false;
            _showTags = false;
            return;
        }

        var lastWord = text.Split(new[] { ' ', '\n' }).LastOrDefault();
        if (lastWord != null && lastWord.StartsWith("@"))
        {
            _showTags = false;
            _showMentions = true;
            _currentMentionSearch = lastWord.Substring(1);
            _mentionCandidates = _allUsers.Where(u => 
                (u.FirstName + u.LastName).Contains(_currentMentionSearch, StringComparison.OrdinalIgnoreCase) ||
                u.FirstName.Contains(_currentMentionSearch, StringComparison.OrdinalIgnoreCase)
            ).Take(5).ToList();
        }
        else if (lastWord != null && lastWord.StartsWith("#"))
        {
            _showMentions = false;
            _showTags = true;
            _currentTagSearch = lastWord.Substring(1);
            _ = SearchTagsAsync(_currentTagSearch);
        }
        else
        {
            _showMentions = false;
            _showTags = false;
        }
    }

    private void InsertMention(UserDto user)
    {
        var lastIndex = _newMessageContentValue.LastIndexOf('@');
        if (lastIndex >= 0)
        {
            var plainText = $"@{user.FirstName}{user.LastName}";
            var markdown = $"[{user.FirstName} {user.LastName}](@user-{user.Id})";
            _draftMentions[plainText] = markdown;
            _newMessageContentValue = _newMessageContentValue.Substring(0, lastIndex) + $"{plainText} ";
        }
        _showMentions = false;
    }

    private void InsertTag(SearchTagDto tag)
    {
        if (tag.Type == "Board")
        {
            _myBoardIds.Add(tag.Id);
        }
        else if (!string.IsNullOrEmpty(tag.BoardId))
        {
            _myBoardIds.Add(tag.BoardId);
        }

        var lastIndex = _newMessageContentValue.LastIndexOf('#');
        if (lastIndex >= 0)
        {
            var plainText = $"#{tag.Name.Replace(" ", "-")}";
            var prefix = tag.Type == "Board" ? "#board-" : $"#task-{tag.BoardId}_";
            var markdown = $"[{tag.Name}]({prefix}{tag.Id})";
            _draftMentions[plainText] = markdown;
            _newMessageContentValue = _newMessageContentValue.Substring(0, lastIndex) + $"{plainText} ";
        }
        _showTags = false;
    }

    private async Task SearchTagsAsync(string q)
    {
        try 
        {
            var res = await Http.GetFromJsonAsync<SearchTagsResponse>($"/api/boards/search?q={Uri.EscapeDataString(q)}");
            if (res != null)
            {
                var candidates = new List<SearchTagDto>();
                candidates.AddRange(res.Boards);
                candidates.AddRange(res.Tasks);
                _tagCandidates = candidates;
                foreach (var b in res.Boards) _myBoardIds.Add(b.Id);
                foreach (var t in res.Tasks) if (!string.IsNullOrEmpty(t.BoardId)) _myBoardIds.Add(t.BoardId);
                StateHasChanged();
            }
        }
        catch { }
    }

    private string GetPreviewText(string content)
    {
        if (string.IsNullOrEmpty(content)) return content;
        // Strip out user mention markdown into clean @Name
        var text = System.Text.RegularExpressions.Regex.Replace(content, @"\[([^\]]+)\]\(@user-[a-zA-Z0-9\-_]+\)", "@$1");
        // Strip out the (#id) part from markdown links but keep the display text
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\[([^\]]+)\]\(#(board|task)-.*?\)", "$1");
        // Also strip any raw @user-id into @user if any exists
        text = System.Text.RegularExpressions.Regex.Replace(text, @"@user-[a-zA-Z0-9\-_]+", "@user");
        return text;
    }

    private MarkupString FormatMessageContent(string content, bool isMine)
    {
        if (string.IsNullOrWhiteSpace(content)) return new MarkupString("");
        
        var encoded = System.Net.WebUtility.HtmlEncode(content);
        
        // 1. Parse Markdown links for User Mentions: [Name](@user-id)
        encoded = System.Text.RegularExpressions.Regex.Replace(
            encoded,
            @"\[([^\]]+)\]\(@user-([a-zA-Z0-9\-_]+)\)",
            match =>
            {
                var name = match.Groups[1].Value;
                var userId = match.Groups[2].Value;
                if (isMine)
                {
                    return $"<span class=\"inline-flex items-center gap-0.5 font-bold text-white bg-white/20 hover:bg-white/30 px-1.5 py-0.5 rounded-md text-xs transition-colors align-baseline\" title=\"Mentioned: {name}\">&#64;{name}</span>";
                }
                else
                {
                    return $"<span class=\"inline-flex items-center gap-0.5 font-medium text-fuchsia-300 bg-fuchsia-500/15 hover:bg-fuchsia-500/25 border border-fuchsia-500/20 px-1.5 py-0.5 rounded-md text-xs transition-colors align-baseline\" title=\"Mentioned: {name}\">&#64;{name}</span>";
                }
            },
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        // 2. Fallbacks for raw @user-id if any exists
        encoded = System.Text.RegularExpressions.Regex.Replace(
            encoded,
            @"(?<!\]\()@user-([a-zA-Z0-9\-_]+)",
            match =>
            {
                var uid = match.Groups[1].Value;
                var u = _allUsers.FirstOrDefault(x => x.Id == uid);
                var displayName = u != null ? $"{u.FirstName} {u.LastName}".Trim() : "user";
                if (isMine)
                {
                    return $"<span class=\"inline-flex items-center gap-0.5 font-bold text-white bg-white/20 hover:bg-white/30 px-1.5 py-0.5 rounded-md text-xs transition-colors align-baseline\" title=\"Mentioned: {displayName}\">&#64;{displayName}</span>";
                }
                else
                {
                    return $"<span class=\"inline-flex items-center gap-0.5 font-medium text-fuchsia-300 bg-fuchsia-500/15 hover:bg-fuchsia-500/25 border border-fuchsia-500/20 px-1.5 py-0.5 rounded-md text-xs transition-colors align-baseline\" title=\"Mentioned: {displayName}\">&#64;{displayName}</span>";
                }
            },
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        // 3. Highlight loose Mentions: @Word (avoiding HTML tag attributes, entities or already replaced spans)
        encoded = System.Text.RegularExpressions.Regex.Replace(
            encoded, 
            @"(?<![a-zA-Z0-9/""'=&#;])@([a-zA-Z0-9_]+)", 
            match =>
            {
                var name = match.Groups[1].Value;
                if (isMine)
                {
                    return $"<span class=\"font-bold text-white bg-white/20 px-1.5 py-0.5 rounded-md text-xs\">&#64;{name}</span>";
                }
                else
                {
                    return $"<span class=\"font-medium text-fuchsia-300 bg-fuchsia-500/15 px-1.5 py-0.5 rounded-md text-xs\">&#64;{name}</span>";
                }
            });

        // 4. Parse Markdown links for Boards and Tasks: [Name](#type-ids)
        encoded = System.Text.RegularExpressions.Regex.Replace(
            encoded, 
            @"\[([^\]]+)\]\(#(board|task)-([a-zA-Z0-9\-_]+)\)", 
            match => {
                var name = match.Groups[1].Value;
                var type = match.Groups[2].Value.ToLower(); // "board" or "task"
                var ids = match.Groups[3].Value; 
                
                string boardId = ids;
                string? taskId = null;
                if (type == "task" && ids.Contains("_"))
                {
                    var parts = ids.Split('_');
                    boardId = parts[0];
                    taskId = parts[1];
                }

                // Add to known boards
                _myBoardIds.Add(boardId);

                var href = type == "board" ? $"/boards/{boardId}" : $"/boards/{boardId}?taskId={taskId}";
                var colorClass = type == "board"
                    ? (isMine ? "text-amber-300 hover:text-amber-200" : "text-amber-400 hover:text-amber-300")
                    : (isMine ? "text-emerald-300 hover:text-emerald-200" : "text-emerald-400 hover:text-emerald-300");
                var iconPath = type == "board" 
                    ? "M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" 
                    : "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4";

                return $"<a href=\"{href}\" class=\"font-bold {colorClass} hover:underline inline-flex items-center gap-1 transition-colors\"><svg class=\"size-3 shrink-0\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"{iconPath}\" /></svg>{name}</a>";
            }, 
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        // Fallbacks for raw #task-id and #board-id
        encoded = System.Text.RegularExpressions.Regex.Replace(
            encoded, 
            @"(?<!\]\()#(task|board)-([a-zA-Z0-9\-_]+)", 
            match => {
                var type = match.Groups[1].Value.ToLower();
                var fullId = match.Groups[2].Value;
                var shortDisplay = fullId.Length > 13 ? fullId.Substring(0, 13) + "..." : fullId;
                
                string boardId = fullId;
                string? taskId = null;
                if (type == "task" && fullId.Contains("_"))
                {
                    var parts = fullId.Split('_');
                    boardId = parts[0];
                    taskId = parts[1];
                }

                // Add to known boards
                _myBoardIds.Add(boardId);

                var href = type == "board" ? $"/boards/{boardId}" : $"/boards/{boardId}?taskId={taskId}";
                var colorClass = type == "board"
                    ? (isMine ? "text-amber-300 hover:text-amber-200" : "text-amber-400 hover:text-amber-300")
                    : (isMine ? "text-emerald-300 hover:text-emerald-200" : "text-emerald-400 hover:text-emerald-300");
                var iconPath = type == "board" 
                    ? "M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" 
                    : "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4";

                return $"<a href=\"{href}\" class=\"font-bold {colorClass} hover:underline inline-flex items-center gap-1 transition-colors\"><svg class=\"size-3 shrink-0\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"{iconPath}\" /></svg>#{shortDisplay}</a>";
            }, 
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        return new MarkupString(encoded);
    }

