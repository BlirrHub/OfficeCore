@inherits LayoutComponentBase
@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="flex h-screen bg-zinc-950 text-zinc-100 font-sans overflow-hidden">
    <!-- Mobile Backdrop Overlay -->
    @if (_isMobileSidebarOpen)
    {
        <div class="fixed inset-0 z-40 bg-black/80 backdrop-blur-sm md:hidden transition-opacity duration-300"
             @onclick="CloseMobileSidebar"></div>
    }

    <!-- Sidebar: Off-canvas drawer on mobile, collapsible on desktop -->
    <aside class="fixed inset-y-0 left-0 z-50 md:static shrink-0 bg-zinc-950 border-r border-zinc-800/80 flex flex-col transition-all duration-300 ease-in-out
        @(_isMobileSidebarOpen ? "translate-x-0 shadow-2xl shadow-black/80" : "-translate-x-full md:translate-x-0")
        @(_isSidebarCollapsed ? "md:w-20" : "md:w-64") w-72">
        <NavMenu IsCollapsed="@_isSidebarCollapsed" OnToggleCollapse="ToggleSidebar" />
    </aside>

    <!-- Main Content Area -->
    <div class="flex flex-col flex-1 min-w-0 overflow-hidden bg-zinc-950">
        <!-- Top Bar Header -->
        <header class="flex items-center justify-between h-14 px-4 sm:px-6 bg-zinc-950/80 backdrop-blur-md border-b border-zinc-800/80 shrink-0 z-30">
            <div class="flex items-center gap-3">
                <!-- Mobile Menu Button -->
                <button @onclick="ToggleMobileSidebar"
                        class="p-2 -ml-2 text-zinc-400 hover:text-white rounded-xl hover:bg-zinc-900 md:hidden transition-colors"
                        aria-label="Toggle navigation menu">
                    <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                    </svg>
                </button>

                <!-- Workspace Switcher -->
                <div class="relative">
                    <button @onclick="() => _isOrgDropdownOpen = !_isOrgDropdownOpen"
                            class="flex items-center gap-2.5 px-3 py-1.5 rounded-xl border border-zinc-800/80 bg-zinc-900/50 hover:bg-zinc-900 hover:border-zinc-700 transition-all text-left">
                        <div class="size-6 rounded-lg bg-gradient-to-br from-fuchsia-600 to-violet-600 flex items-center justify-center text-white text-[10px] font-bold shadow-sm shadow-fuchsia-900/30">
                            @GetInitials(_currentOrganization?.Name)
                        </div>
                        <span class="text-sm font-medium text-zinc-200 max-w-[140px] sm:max-w-[200px] truncate">
                            @(_currentOrganization?.Name ?? "Select Workspace")
                        </span>
                        <svg class="w-3.5 h-3.5 text-zinc-400 transition-transform @(_isOrgDropdownOpen ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>
                    
                    @if (_isOrgDropdownOpen)
                    {
                        <div class="absolute top-full left-0 mt-2 w-64 rounded-2xl bg-zinc-900 border border-zinc-800 shadow-2xl shadow-black/80 overflow-hidden z-50 py-1.5 backdrop-blur-xl">
                            <div class="px-3.5 py-2 border-b border-zinc-800/60">
                                <p class="text-[10px] font-semibold text-zinc-500 uppercase tracking-wider">Active Workspace</p>
                                <p class="text-xs font-medium text-zinc-200 truncate mt-0.5">@(_currentOrganization?.Name ?? "None")</p>
                            </div>

                            <div class="py-1 max-h-56 overflow-y-auto">
                                @if (_organizations == null)
                                {
                                    <div class="px-4 py-3 text-xs text-zinc-500 text-center">Loading workspaces...</div>
                                }
                                else if (_organizations.Count == 0)
                                {
                                    <div class="px-4 py-3 text-xs text-zinc-500 text-center">No other workspaces</div>
                                }
                                else
                                {
                                    @foreach (var org in _organizations)
                                    {
                                        var isSelected = org.Id == _currentOrganization?.Id;
                                        <button @onclick="() => SelectOrganization(org.Id)"
                                                class="w-full text-left px-3.5 py-2 text-xs text-zinc-300 hover:text-white hover:bg-zinc-800/60 transition-colors flex items-center justify-between group @(isSelected ? "bg-fuchsia-600/10 text-fuchsia-300" : "")">
                                            <div class="flex items-center gap-2.5 min-w-0">
                                                <div class="size-6 rounded-lg bg-zinc-800 flex items-center justify-center text-[9px] font-bold shrink-0 text-zinc-300 group-hover:text-white">
                                                    @GetInitials(org.Name)
                                                </div>
                                                <span class="truncate font-medium">@org.Name</span>
                                            </div>
                                            @if (isSelected)
                                            {
                                                <span class="size-1.5 rounded-full bg-fuchsia-400 shrink-0"></span>
                                            }
                                        </button>
                                    }
                                }
                            </div>

                            <div class="border-t border-zinc-800/60 mt-1 pt-1 px-1.5">
                                <a href="/workspaces" class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-xs font-medium text-zinc-400 hover:text-white hover:bg-zinc-800 transition-colors">
                                    <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
                                    <span>All Workspaces</span>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Header Right Section -->
            <div class="flex items-center gap-3">
                <!-- System Status Indicator -->
                <div class="hidden sm:flex items-center gap-2 px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-medium">
                    <span class="size-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>Live</span>
                </div>

                <!-- Theme Switcher (Light / Dark Mode) -->
                <ThemeToggle />

                <!-- Notification Bell -->
                <button class="relative text-zinc-400 hover:text-white transition-colors p-2 rounded-xl hover:bg-zinc-900 border border-transparent hover:border-zinc-800"
                        aria-label="Notifications">
                    <svg class="size-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
                    </svg>
                    <span class="absolute top-2 right-2 size-1.5 rounded-full bg-fuchsia-500 ring-2 ring-zinc-950"></span>
                </button>
            </div>
        </header>

        <!-- Main Viewport Body -->
        <main class="flex-1 overflow-x-hidden overflow-y-auto bg-zinc-950 p-4 sm:p-6 md:p-8 custom-scrollbar">
            @Body
        </main>

        <ToastContainer />
    </div>
</div>

<GlobalChatWidget />

@code {
    private bool _isSidebarCollapsed = false;
    private bool _isMobileSidebarOpen = false;
    private bool _isOrgDropdownOpen = false;
    private List<OrganizationDto>? _organizations;
    private OrganizationDto? _currentOrganization;

    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private Auth.CookieAuthStateProvider CookieAuthProvider { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        await CheckPasswordResetGuard();
        await LoadOrganizations();
        await LoadCurrentOrganization();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Globally load webserial.js so the auto-connect logic runs in the background
                await JS.InvokeAsync<IJSObjectReference>("import", "./js/webserial.js");
            }
            catch (Exception ex)
            {
                Console.WriteLine("Failed to load webserial background script: " + ex.Message);
            }
        }
    }

    private async Task LoadOrganizations()
    {
        try
        {
            _organizations = await Http.GetFromJsonAsync<List<OrganizationDto>>("/api/organizations/my");
        }
        catch
        {
            _organizations = new List<OrganizationDto>();
        }
    }

    private async Task LoadCurrentOrganization()
    {
        try
        {
            _currentOrganization = await Http.GetFromJsonAsync<OrganizationDto>("/api/organizations/current");
        }
        catch
        {
            _currentOrganization = null;
        }
    }

    private async Task SelectOrganization(Guid orgId)
    {
        _isOrgDropdownOpen = false;
        var response = await Http.PostAsJsonAsync($"/api/organizations/{orgId}/select", new { });
        if (response.IsSuccessStatusCode)
        {
            CookieAuthProvider.NotifyAuthStateChanged();
            Nav.NavigateTo(Nav.Uri, forceLoad: true);
        }
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "OC";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name.Substring(0, Math.Min(2, name.Length)).ToUpper();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _isOrgDropdownOpen = false;
        _isMobileSidebarOpen = false;
        StateHasChanged();
        _ = CheckPasswordResetGuard();
    }

    private async Task CheckPasswordResetGuard()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var mustChangeClaim = authState.User.FindFirst("MustChangePassword")?.Value;
        
        if (mustChangeClaim == "true" && !Nav.Uri.EndsWith("/change-password"))
        {
            Nav.NavigateTo("/change-password");
        }
    }

    private class OrganizationDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public DateTime JoinedAt { get; set; }
    }

    private void ToggleSidebar()
    {
        _isSidebarCollapsed = !_isSidebarCollapsed;
    }

    private void ToggleMobileSidebar()
    {
        _isMobileSidebarOpen = !_isMobileSidebarOpen;
    }

    private void CloseMobileSidebar()
    {
        _isMobileSidebarOpen = false;
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}

<!-- Blazor error UI -->
<div id="blazor-error-ui" data-nosnippet
     class="fixed bottom-4 right-4 z-50 hidden flex items-center gap-3
            rounded-xl bg-red-900/90 backdrop-blur-sm border border-red-700
            px-5 py-3 text-sm text-white shadow-2xl">
    An unhandled error has occurred.
    <a href="." class="ml-2 underline hover:no-underline">Reload</a>
    <span class="cursor-pointer text-lg leading-none select-none dismiss">✕</span>
</div>
